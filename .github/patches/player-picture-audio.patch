+        SliderRow("Saturation", signed(state.saturation), state.saturation.toFloat(), -50f..50f) { edit(state.copy(saturation = it.roundToInt())) }
+        if (support.gamma) {
+            SliderRow("Gamma", signed(state.gamma), state.gamma.toFloat(), -30f..30f) { edit(state.copy(gamma = it.roundToInt())) }
+        }
+        if (support.sharpen) {
+            StepRow("Sharpen", state.sharpen) { edit(state.copy(sharpen = it)) }
+        }
+        if (support.denoise) {
+            StepRow("Denoise", state.denoise) { edit(state.copy(denoise = it)) }
+        }
+        if (support.deband) {
+            ToggleRow("Remove banding", "Smooths colour steps in skies and dark scenes", state.deband) { edit(state.copy(deband = it)) }
+        }
+        if (support.toneMapping) {
+            Text("HDR tone mapping", color = Color.White, fontSize = 15.sp)
+            Row(
+                modifier = Modifier.fillMaxWidth().horizontalScroll(rememberScrollState()),
+                horizontalArrangement = Arrangement.spacedBy(8.dp),
+            ) {
+                ToneMapping.values().forEach { tone ->
+                    Chip(tone.label, state.toneMapping == tone) { PlayerEffects.setPicture(state.copy(toneMapping = tone)) }
+                }
+            }
+        }
+        if (support.interpolation) {
+            ToggleRow("Smooth motion", "Frame interpolation. Can look like a soap opera.", state.interpolation) {
+                PlayerEffects.setPicture(state.copy(interpolation = it))
+            }
+        }
+        if (support.refreshRate) {
+            ToggleRow("Match refresh rate", "Switches the screen to the video's frame rate when it can", state.matchRefreshRate) {
+                PlayerEffects.setPicture(state.copy(matchRefreshRate = it))
+            }
+        }
+        ToggleRow("Auto Smart Enhance", "Turns it on for sources under 720p or under 2 Mbps", autoEnhance) { PlayerEffects.setAutoEnhance(it) }
+        ToggleRow("Remember per title", "Keeps these picture and sound choices for each title", rememberTitle) { PlayerEffects.setRememberPerTitle(it) }
+        ToggleRow("Prefer best picture", "Auto-play picks the highest resolution and best codec", bestQuality) { PlayerEffects.setPreferBestQuality(it) }
+        if (!support.toneMapping || !support.denoise) {
+            Text(
+                text = "More picture options are available with the libmpv player engine.",
+                color = Color.White.copy(alpha = 0.55f),
+                fontSize = 12.sp,
+            )
+        }
+    }
+}
