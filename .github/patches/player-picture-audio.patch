+/** What the active engine can apply; the picture panel only offers these. */
+internal data class PictureSupport(
+    val gamma: Boolean = false,
+    val sharpen: Boolean = false,
+    val denoise: Boolean = false,
+    val deband: Boolean = false,
+    val toneMapping: Boolean = false,
+    val interpolation: Boolean = false,
+    val refreshRate: Boolean = false,
+)
