+/** A slider that runs top (loud) to bottom (quiet), for the equaliser bands. Steps are half a dB. */
+@Composable
+private fun VerticalBandSlider(value: Float, enabled: Boolean, onValueChange: (Float) -> Unit) {
+    val min = -12f
+    val max = 12f
+    var heightPx by remember { mutableStateOf(1f) }
+    val latestChange by rememberUpdatedState(onValueChange)
+    val latestEnabled by rememberUpdatedState(enabled)
+    val latestHeight by rememberUpdatedState(heightPx)
+    fun fromY(y: Float): Float {
+        val fraction = (y / latestHeight).coerceIn(0f, 1f)
+        return (max - fraction * (max - min)).let { (it * 2f).roundToInt() / 2f }
+    }
+    val alpha = if (enabled) 1f else 0.4f
+    Box(
+        modifier = Modifier
+            .width(40.dp)
+            .height(160.dp)
+            .onSizeChanged { heightPx = it.height.toFloat().coerceAtLeast(1f) }
+            .pointerInput(Unit) {
+                detectTapGestures { offset -> if (latestEnabled) latestChange(fromY(offset.y)) }
+            }
+            .pointerInput(Unit) {
+                detectVerticalDragGestures(
+                    onDragStart = { offset -> if (latestEnabled) latestChange(fromY(offset.y)) },
+                    onVerticalDrag = { change, _ ->
+                        change.consume()
+                        if (latestEnabled) latestChange(fromY(change.position.y))
+                    },
+                )
+            }
+            .drawBehind {
+                val x = size.width / 2f
+                val thumbRadius = 9.dp.toPx()
+                val trackTop = thumbRadius
+                val trackBottom = size.height - thumbRadius
+                val thumbY = trackTop + (max - value.coerceIn(min, max)) / (max - min) * (trackBottom - trackTop)
+                val centreY = (trackTop + trackBottom) / 2f
+                drawLine(Color.White.copy(alpha = 0.25f * alpha), Offset(x, trackTop), Offset(x, trackBottom), strokeWidth = 3.dp.toPx(), cap = StrokeCap.Round)
+                drawLine(PanelAccent.copy(alpha = alpha), Offset(x, centreY), Offset(x, thumbY), strokeWidth = 3.dp.toPx(), cap = StrokeCap.Round)
+                drawCircle(PanelAccent.copy(alpha = alpha), radius = thumbRadius, center = Offset(x, thumbY))
+            },
+    )
+}
