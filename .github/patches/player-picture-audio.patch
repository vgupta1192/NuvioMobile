+internal enum class PicturePreset(val id: String, val label: String) {
+    ORIGINAL("original", "Original"),
+    VIVID("vivid", "Vivid"),
+    CINEMA("cinema", "Cinema"),
+    CLEAN("clean", "Clean"),
+    ANIME("anime", "Anime"),
+    CUSTOM("custom", "Custom");
+
+    companion object {
+        fun fromId(id: String?): PicturePreset = values().firstOrNull { it.id == id } ?: ORIGINAL
+    }
+}
+
+/** HDR to SDR tone mapping curves (libmpv only). A null [mpv] leaves the engine's own choice. */
+internal enum class ToneMapping(val id: String, val label: String, val mpv: String?) {
+    AUTO("auto", "Auto", null),
+    BT2390("bt2390", "BT.2390", "bt.2390"),
+    HABLE("hable", "Hable", "hable"),
+    MOBIUS("mobius", "Mobius", "mobius"),
+    REINHARD("reinhard", "Reinhard", "reinhard");
+
+    companion object {
+        fun fromId(id: String?): ToneMapping = values().firstOrNull { it.id == id } ?: AUTO
+    }
+}
+
+/**
+ * Picture controls. Sliders are in percent steps; [sharpen] and [denoise] run 0 (off) to 3 (high).
+ * [smartEnhance] is filled in when the state is handed to the engine, from the Smart Enhance button.
+ */
+internal data class PictureState(
+    val preset: PicturePreset = PicturePreset.ORIGINAL,
+    val brightness: Int = 0,
+    val contrast: Int = 0,
+    val saturation: Int = 0,
+    val gamma: Int = 0,
+    val sharpen: Int = 0,
+    val denoise: Int = 0,
+    val deband: Boolean = false,
+    val toneMapping: ToneMapping = ToneMapping.AUTO,
+    val interpolation: Boolean = false,
+    val matchRefreshRate: Boolean = true,
+    val smartEnhance: Boolean = false,
+) {
+    /** True when the frame needs the custom sharpen, denoise, deband or gamma shader (ExoPlayer). */
+    val usesShader: Boolean get() = sharpen > 0 || denoise > 0 || deband || gamma != 0
+
+    fun withPreset(next: PicturePreset): PictureState = when (next) {
+        PicturePreset.ORIGINAL -> copy(preset = next, brightness = 0, contrast = 0, saturation = 0, gamma = 0, sharpen = 0, denoise = 0, deband = false)
+        PicturePreset.VIVID -> copy(preset = next, brightness = 0, contrast = 10, saturation = 22, gamma = 0, sharpen = 1, denoise = 0, deband = false)
+        PicturePreset.CINEMA -> copy(preset = next, brightness = -3, contrast = 8, saturation = 4, gamma = 0, sharpen = 0, denoise = 0, deband = false)
+        PicturePreset.CLEAN -> copy(preset = next, brightness = 0, contrast = 4, saturation = 6, gamma = 0, sharpen = 1, denoise = 2, deband = true)
+        PicturePreset.ANIME -> copy(preset = next, brightness = 0, contrast = 6, saturation = 14, gamma = 0, sharpen = 2, denoise = 0, deband = true)
+        PicturePreset.CUSTOM -> copy(preset = next)
+    }
+
+    fun encode(): String = listOf(
+        preset.id, brightness, contrast, saturation, gamma, sharpen, denoise,
+        if (deband) 1 else 0, toneMapping.id, if (interpolation) 1 else 0, if (matchRefreshRate) 1 else 0,
+    ).joinToString("|")
+
+    companion object {
+        fun decode(value: String?): PictureState {
+            val p = value?.split("|") ?: return PictureState()
+            if (p.size < 11) return PictureState()
+            return PictureState(
+                preset = PicturePreset.fromId(p[0]),
+                brightness = p[1].toIntOrNull()?.coerceIn(-30, 30) ?: 0,
+                contrast = p[2].toIntOrNull()?.coerceIn(-30, 30) ?: 0,
+                saturation = p[3].toIntOrNull()?.coerceIn(-50, 50) ?: 0,
+                gamma = p[4].toIntOrNull()?.coerceIn(-30, 30) ?: 0,
+                sharpen = p[5].toIntOrNull()?.coerceIn(0, 3) ?: 0,
+                denoise = p[6].toIntOrNull()?.coerceIn(0, 3) ?: 0,
+                deband = p[7] == "1",
+                toneMapping = ToneMapping.fromId(p[8]),
+                interpolation = p[9] == "1",
+                matchRefreshRate = p[10] != "0",
+            )
+        }
+    }
+}
