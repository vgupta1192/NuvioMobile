+package com.nuvio.app.features.player
+
+import android.content.Context
+import android.media.audiofx.BassBoost
+import android.media.audiofx.Equalizer
+import android.media.audiofx.Virtualizer
+import android.opengl.GLES20
+import android.util.Log
+import androidx.media3.common.C
+import androidx.media3.common.Effect
+import androidx.media3.common.PlaybackException
+import androidx.media3.common.Player
+import androidx.media3.common.VideoFrameProcessingException
+import androidx.media3.common.util.GlProgram
+import androidx.media3.common.util.GlUtil
+import androidx.media3.common.util.Size
+import androidx.media3.effect.BaseGlShaderProgram
+import androidx.media3.effect.Brightness
+import androidx.media3.effect.Contrast
+import androidx.media3.effect.GlEffect
+import androidx.media3.effect.GlShaderProgram
+import androidx.media3.effect.HslAdjustment
+import androidx.media3.exoplayer.ExoPlayer
+import kotlin.math.abs
+import kotlin.math.ln
+import kotlin.math.roundToInt
+
+private const val FX_TAG = "NuvioPlayerEffects"
+
+/**
+ * Audio effect panel on ExoPlayer: Android's equaliser, bass boost and virtualizer on the player's audio session.
+ * Effects are created on first use and switched off again when the panel is back on Original, so they cost
+ * nothing for people who never open it.
+ */
+internal class ExoAudioEffects(private val player: ExoPlayer) : Player.Listener {
+    private var state = AudioFxState()
+    private var equalizer: Equalizer? = null
+    private var bassBoost: BassBoost? = null
+    private var virtualizer: Virtualizer? = null
+    private var sessionId = C.AUDIO_SESSION_ID_UNSET
+    private var failedSessionId = C.AUDIO_SESSION_ID_UNSET
+    private var released = false
+
+    init {
+        player.addListener(this)
+    }
+
+    fun apply(next: AudioFxState) {
+        state = next
+        refresh()
+    }
+
+    override fun onAudioSessionIdChanged(audioSessionId: Int) {
+        refresh()
+    }
+
+    private fun refresh() {
+        if (released) return
+        if (!state.isActive) {
+            disableAll()
+            return
+        }
+        val session = player.audioSessionId
+        if (session == C.AUDIO_SESSION_ID_UNSET || session == failedSessionId) return
+        if (session != sessionId) {
+            releaseEffects()
+            createEffects(session)
+        }
+        applyEqualizer()
+        applyBassBoost()
+        applyVirtualizer()
+    }
+
+    private fun createEffects(session: Int) {
+        equalizer = runCatching { Equalizer(0, session) }
+            .onFailure { Log.w(FX_TAG, "Equalizer unavailable: ${it.message}") }
+            .getOrNull()
+        bassBoost = runCatching { BassBoost(0, session) }.getOrNull()
+        virtualizer = runCatching { Virtualizer(0, session) }.getOrNull()
+        if (equalizer == null && bassBoost == null && virtualizer == null) {
+            failedSessionId = session
+            return
+        }
+        sessionId = session
+    }
+
+    private fun applyEqualizer() {
+        val effect = equalizer ?: return
+        runCatching {
+            val range = effect.bandLevelRange
+            val minLevel = range[0].toInt()
+            val maxLevel = range[1].toInt()
+            val gains = state.effectiveBandsDb()
+            for (band in 0 until effect.numberOfBands.toInt()) {
+                val centreHz = effect.getCenterFreq(band.toShort()) / 1000
+                val target = nearestPanelBand(centreHz)
+                val level = (gains[target] * 100f).roundToInt().coerceIn(minLevel, maxLevel)
+                effect.setBandLevel(band.toShort(), level.toShort())
+            }
+            effect.setEnabled(true)
+        }.onFailure { Log.w(FX_TAG, "Equalizer failed: ${it.message}") }
+    }
+
+    private fun applyBassBoost() {
+        val effect = bassBoost ?: return
+        runCatching {
+            val strength = state.bassBoostStrength
+            if (strength > 0 && effect.strengthSupported) {
+                effect.setStrength(strength.toShort())
+                effect.setEnabled(true)
+            } else {
+                effect.setEnabled(false)
+            }
+        }
+    }
+
+    private fun applyVirtualizer() {
+        val effect = virtualizer ?: return
+        runCatching {
+            val strength = state.virtualizerStrength
+            if (strength > 0 && effect.strengthSupported) {
+                effect.setStrength(strength.toShort())
+                effect.setEnabled(true)
+            } else {
+                effect.setEnabled(false)
+            }
+        }
+    }
+
+    /** The panel band whose centre is closest, on a log scale, to the device band centre. */
+    private fun nearestPanelBand(centreHz: Int): Int {
+        val target = ln(centreHz.coerceAtLeast(1).toDouble())
+        var best = 0
+        var bestDistance = Double.MAX_VALUE
+        EQ_BAND_FREQUENCIES_HZ.forEachIndexed { index, hz ->
+            val distance = abs(ln(hz.toDouble()) - target)
+            if (distance < bestDistance) {
+                bestDistance = distance
+                best = index
+            }
+        }
+        return best
+    }
+
+    private fun disableAll() {
+        equalizer?.let { runCatching { it.setEnabled(false) } }
+        bassBoost?.let { runCatching { it.setEnabled(false) } }
+        virtualizer?.let { runCatching { it.setEnabled(false) } }
+    }
+
+    private fun releaseEffects() {
+        equalizer?.let { runCatching { it.release() } }
+        bassBoost?.let { runCatching { it.release() } }
+        virtualizer?.let { runCatching { it.release() } }
+        equalizer = null
+        bassBoost = null
+        virtualizer = null
+        sessionId = C.AUDIO_SESSION_ID_UNSET
+    }
+
+    fun release() {
+        released = true
+        player.removeListener(this)
+        releaseEffects()
+    }
+}
+
+/**
+ * Picture panel on ExoPlayer, as GL effects on the decoded frames: brightness, contrast and saturation use
+ * media3's own effects, and sharpen, denoise, debanding and gamma share one small shader. If the shader ever
+ * fails to run on a device, it is switched off for the session and playback carries on without it.
+ */
+internal class ExoPictureEffects(private val player: ExoPlayer) : Player.Listener {
+    private var state = PictureState()
+    private var shaderBroken = false
+    private var released = false
+
+    init {
+        player.addListener(this)
+    }
+
+    fun apply(next: PictureState) {
+        state = next
+        push()
+        runCatching {
+            player.setVideoChangeFrameRateStrategy(
+                if (next.matchRefreshRate) {
+                    C.VIDEO_CHANGE_FRAME_RATE_STRATEGY_ONLY_IF_SEAMLESS
+                } else {
+                    C.VIDEO_CHANGE_FRAME_RATE_STRATEGY_OFF
+                },
+            )
+        }
+    }
+
+    private fun push() {
+        if (released) return
+        val effects = ArrayList<Effect>()
+        val current = state
+        if (!shaderBroken && current.usesShader) {
+            effects += PictureShaderEffect(
+                sharpen = current.sharpen * 0.4f,
+                denoise = current.denoise / 3f * 0.85f,
+                deband = if (current.deband) 0.9f else 0f,
+                gamma = 1f / (1f + current.gamma / 100f),
+            )
+        }
+        val brightness = current.brightness / 100f + if (current.smartEnhance) 0.02f else 0f
+        val contrast = current.contrast / 100f + if (current.smartEnhance) 0.12f else 0f
+        val saturation = current.saturation.toFloat() + if (current.smartEnhance) 16f else 0f
+        if (abs(brightness) > 0.001f) effects += Brightness(brightness.coerceIn(-1f, 1f))
+        if (abs(contrast) > 0.001f) effects += Contrast(contrast.coerceIn(-1f, 1f))
+        if (abs(saturation) > 0.5f || current.smartEnhance) {
+            effects += HslAdjustment.Builder()
+                .adjustSaturation(saturation.coerceIn(-100f, 100f))
+                .adjustLightness(if (current.smartEnhance) 2f else 0f)
+                .build()
+        }
+        runCatching { player.setVideoEffects(effects) }
+            .onFailure { Log.w(FX_TAG, "Picture effects could not be applied", it) }
+    }
+
+    override fun onPlayerError(error: PlaybackException) {
+        if (error.errorCode == PlaybackException.ERROR_CODE_VIDEO_FRAME_PROCESSING_FAILED && !shaderBroken) {
+            Log.w(FX_TAG, "Picture shader failed, turning it off", error)
+            shaderBroken = true
+            push()
+            runCatching { player.prepare() }
+        }
+    }
+
+    fun release() {
+        released = true
+        player.removeListener(this)
+    }
+}
+
+/** Sharpen, denoise, deband and gamma in one pass. Strengths of 0 skip that step. */
+internal class PictureShaderEffect(
+    private val sharpen: Float,
+    private val denoise: Float,
+    private val deband: Float,
+    private val gamma: Float,
+) : GlEffect {
+    override fun toGlShaderProgram(context: Context, useHdr: Boolean): GlShaderProgram =
+        PictureShaderProgram(useHdr, sharpen, denoise, deband, gamma)
+}
+
+private class PictureShaderProgram(
+    useHdr: Boolean,
+    private val sharpen: Float,
+    private val denoise: Float,
+    private val deband: Float,
+    private val gamma: Float,
+) : BaseGlShaderProgram(useHdr, 1) {
+    private val glProgram: GlProgram
+
+    init {
+        try {
+            glProgram = GlProgram(VERTEX_SHADER, FRAGMENT_SHADER)
+            glProgram.setBufferAttribute(
+                "aFramePosition",
+                GlUtil.getNormalizedCoordinateBounds(),
+                GlUtil.HOMOGENEOUS_COORDINATE_VECTOR_SIZE,
+            )
+        } catch (e: GlUtil.GlException) {
+            throw VideoFrameProcessingException(e)
+        }
+    }
+
+    override fun configure(inputWidth: Int, inputHeight: Int): Size {
+        glProgram.setFloatsUniform("uTexel", floatArrayOf(1f / inputWidth, 1f / inputHeight))
+        return Size(inputWidth, inputHeight)
+    }
+
+    override fun drawFrame(inputTexId: Int, presentationTimeUs: Long) {
+        try {
+            glProgram.use()
+            glProgram.setSamplerTexIdUniform("uTexSampler", inputTexId, 0)
+            glProgram.setFloatUniform("uSharpen", sharpen)
+            glProgram.setFloatUniform("uDenoise", denoise)
+            glProgram.setFloatUniform("uDeband", deband)
+            glProgram.setFloatUniform("uGamma", gamma)
+            glProgram.bindAttributesAndUniforms()
+            GLES20.glDrawArrays(GLES20.GL_TRIANGLE_STRIP, 0, 4)
+        } catch (e: GlUtil.GlException) {
+            throw VideoFrameProcessingException(e, presentationTimeUs)
+        }
+    }
+
+    override fun release() {
+        super.release()
+        try {
+            glProgram.delete()
+        } catch (e: GlUtil.GlException) {
+            throw VideoFrameProcessingException(e)
+        }
+    }
+
+    private companion object {
+        const val VERTEX_SHADER = """
+attribute vec4 aFramePosition;
+varying vec2 vTexSamplingCoord;
+void main() {
+  gl_Position = aFramePosition;
+  vTexSamplingCoord = vec2(aFramePosition.x * 0.5 + 0.5, aFramePosition.y * 0.5 + 0.5);
+}
+"""
+
+        const val FRAGMENT_SHADER = """
+#ifdef GL_FRAGMENT_PRECISION_HIGH
+precision highp float;
+#else
+precision mediump float;
+#endif
+uniform sampler2D uTexSampler;
+uniform vec2 uTexel;
+uniform float uSharpen;
+uniform float uDenoise;
+uniform float uDeband;
+uniform float uGamma;
+varying vec2 vTexSamplingCoord;
+
+float noise(vec2 p) {
+  return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453);
+}
+
+void main() {
+  vec2 uv = vTexSamplingCoord;
+  vec4 src = texture2D(uTexSampler, uv);
+  vec3 col = src.rgb;
+  if (uDenoise > 0.0) {
+    vec3 acc = col;
+    float weightSum = 1.0;
+    for (int i = -1; i <= 1; i++) {
+      for (int j = -1; j <= 1; j++) {
+        if (i == 0 && j == 0) {
+          continue;
+        }
+        vec3 s = texture2D(uTexSampler, uv + vec2(float(i), float(j)) * uTexel).rgb;
+        vec3 d = s - col;
+        float w = exp(-dot(d, d) * 90.0);
+        acc += s * w;
+        weightSum += w;
+      }
+    }
+    col = mix(col, acc / weightSum, uDenoise);
+  }
+  if (uDeband > 0.0) {
+    vec3 acc = col;
+    float n = 1.0;
+    vec2 step = uTexel * 3.0;
+    vec3 a = texture2D(uTexSampler, uv + vec2(step.x, 0.0)).rgb;
+    vec3 b = texture2D(uTexSampler, uv - vec2(step.x, 0.0)).rgb;
+    vec3 c = texture2D(uTexSampler, uv + vec2(0.0, step.y)).rgb;
+    vec3 e = texture2D(uTexSampler, uv - vec2(0.0, step.y)).rgb;
+    vec3 da = abs(a - col);
+    vec3 db = abs(b - col);
+    vec3 dc = abs(c - col);
+    vec3 de = abs(e - col);
+    if (max(da.r, max(da.g, da.b)) < 0.03) { acc += a; n += 1.0; }
+    if (max(db.r, max(db.g, db.b)) < 0.03) { acc += b; n += 1.0; }
+    if (max(dc.r, max(dc.g, dc.b)) < 0.03) { acc += c; n += 1.0; }
+    if (max(de.r, max(de.g, de.b)) < 0.03) { acc += e; n += 1.0; }
+    col = mix(col, acc / n, uDeband);
+    col += (noise(uv * 1000.0) - 0.5) * (1.5 / 255.0) * uDeband;
+  }
+  if (uSharpen > 0.0) {
+    vec3 blur = (
+      texture2D(uTexSampler, uv + vec2(uTexel.x, 0.0)).rgb +
+      texture2D(uTexSampler, uv - vec2(uTexel.x, 0.0)).rgb +
+      texture2D(uTexSampler, uv + vec2(0.0, uTexel.y)).rgb +
+      texture2D(uTexSampler, uv - vec2(0.0, uTexel.y)).rgb
+    ) * 0.25;
+    col += (col - blur) * uSharpen;
+  }
+  if (uGamma != 1.0) {
+    col = pow(max(col, vec3(0.0)), vec3(uGamma));
+  }
+  gl_FragColor = vec4(clamp(col, 0.0, 1.0), src.a);
+}
+"""
+    }
+}
