+internal enum class EffectsPanel { AUDIO, PICTURE }
+
+/**
+ * Fork: shared state for the picture and audio effect panels. Settings persist, can be remembered per title,
+ * and Smart Enhance can switch itself on for low-resolution or low-bitrate sources.
+ */
+internal object PlayerEffects {
+    private const val PATH = "settings/player_effects"
+    private const val TITLES_PATH = "settings/player_effects_titles"
+    private const val MAX_TITLES = 200
+    private const val LOW_RESOLUTION_HEIGHT = 720
+    private const val LOW_BITRATE = 2_000_000
+
+    private val _audio = MutableStateFlow(AudioFxState())
+    val audio: StateFlow<AudioFxState> = _audio.asStateFlow()
+
+    private val _picture = MutableStateFlow(PictureState())
+    val picture: StateFlow<PictureState> = _picture.asStateFlow()
+
+    private val _autoEnhance = MutableStateFlow(false)
+    val autoEnhance: StateFlow<Boolean> = _autoEnhance.asStateFlow()
+
+    private val _preferBestQuality = MutableStateFlow(false)
+    val preferBestQuality: StateFlow<Boolean> = _preferBestQuality.asStateFlow()
+
+    private val _rememberPerTitle = MutableStateFlow(true)
+    val rememberPerTitle: StateFlow<Boolean> = _rememberPerTitle.asStateFlow()
+
+    private val _panel = MutableStateFlow<EffectsPanel?>(null)
+    val panel: StateFlow<EffectsPanel?> = _panel.asStateFlow()
+
+    /** True while the current engine can apply audio effects; the toolbar button only shows then. */
+    val audioAvailable = MutableStateFlow(false)
+
+    private var loaded = false
+    private var currentTitle: String? = null
+    private var enhanceUserSet = false
+    private var titles: LinkedHashMap<String, String>? = null
+
+    fun ensureLoaded() {
+        if (loaded) return
+        loaded = true
+        loadGlobal()
+    }
+
+    private fun loadGlobal() {
+        val values = HashMap<String, String>()
+        AppFileCache.read(PATH)?.lineSequence()?.forEach { line ->
+            val at = line.indexOf('=')
+            if (at > 0) values[line.substring(0, at)] = line.substring(at + 1)
+        }
+        _audio.value = AudioFxState.decode(values["audio"])
+        _picture.value = PictureState.decode(values["picture"])
+        _autoEnhance.value = values["auto"] == "1"
+        _preferBestQuality.value = values["best"] == "1"
+        _rememberPerTitle.value = values["remember"] != "0"
+    }
+
+    private fun saveGlobal() {
+        val text = listOf(
+            "audio=${_audio.value.encode()}",
+            "picture=${_picture.value.encode()}",
+            "auto=${if (_autoEnhance.value) 1 else 0}",
+            "best=${if (_preferBestQuality.value) 1 else 0}",
+            "remember=${if (_rememberPerTitle.value) 1 else 0}",
+        ).joinToString("\n")
+        runCatching { AppFileCache.write(PATH, text) }
+    }
+
+    fun openPanel(panel: EffectsPanel) {
+        _panel.value = panel
+    }
+
+    fun closePanel() {
+        _panel.value = null
+    }
+
+    fun setPicture(next: PictureState) {
+        _picture.value = next
+        saveGlobal()
+        rememberTitle()
+    }
+
+    fun setAudio(next: AudioFxState) {
+        _audio.value = next
+        saveGlobal()
+        rememberTitle()
+    }
+
+    fun setAutoEnhance(enabled: Boolean) {
+        _autoEnhance.value = enabled
+        saveGlobal()
+    }
+
+    fun setPreferBestQuality(enabled: Boolean) {
+        _preferBestQuality.value = enabled
+        saveGlobal()
+    }
+
+    fun setRememberPerTitle(enabled: Boolean) {
+        _rememberPerTitle.value = enabled
+        saveGlobal()
+        if (enabled) rememberTitle()
+    }
+
+    /** Called when a title starts playing: restores what was last used on it, else the last global choice. */
+    fun enterTitle(key: String?) {
+        ensureLoaded()
+        currentTitle = key?.takeIf { it.isNotBlank() }
+        enhanceUserSet = false
+        loadGlobal()
+        val entry = currentTitle?.takeIf { _rememberPerTitle.value }?.let { titleEntries()[it] }
+        if (entry == null) {
+            SmartEnhance.restorePersisted()
+            return
+        }
+        val parts = entry.split("\t")
+        _picture.value = PictureState.decode(parts.getOrNull(0))
+        _audio.value = AudioFxState.decode(parts.getOrNull(1))
+        SmartEnhance.setQuiet(parts.getOrNull(2) == "1")
+    }
+
+    fun onEnhanceToggled(enabled: Boolean) {
+        enhanceUserSet = true
+        rememberTitle()
+    }
+
+    /** Switches Smart Enhance on for sources that look soft: under 720p, or under about 2 Mbps. */
+    fun maybeAutoEnhance(heightPx: Int?, bitrate: Int?) {
+        if (!_autoEnhance.value || enhanceUserSet) return
+        val lowResolution = heightPx != null && heightPx in 1 until LOW_RESOLUTION_HEIGHT
+        val lowBitrate = bitrate != null && bitrate in 1 until LOW_BITRATE
+        if (lowResolution || lowBitrate) SmartEnhance.applyAuto()
+    }
+
+    private fun titleEntries(): LinkedHashMap<String, String> {
+        titles?.let { return it }
+        val map = LinkedHashMap<String, String>()
+        AppFileCache.read(TITLES_PATH)?.lineSequence()?.forEach { line ->
+            val at = line.indexOf('\t')
+            if (at > 0) map[line.substring(0, at)] = line.substring(at + 1)
+        }
+        titles = map
+        return map
+    }
+
+    private fun rememberTitle() {
+        val key = currentTitle ?: return
+        if (!_rememberPerTitle.value) return
+        val map = titleEntries()
+        map.remove(key)
+        map[key] = listOf(
+            _picture.value.encode(),
+            _audio.value.encode(),
+            if (SmartEnhance.enabled.value) "1" else "0",
+        ).joinToString("\t")
+        while (map.size > MAX_TITLES) map.remove(map.keys.first())
+        runCatching { AppFileCache.write(TITLES_PATH, map.entries.joinToString("\n") { "${it.key}\t${it.value}" }) }
+    }
+}
+
+private val QUALITY_UHD = Regex("(2160p|\\b4k\\b|\\buhd\\b)", RegexOption.IGNORE_CASE)
+private val QUALITY_QHD = Regex("1440p", RegexOption.IGNORE_CASE)
+private val QUALITY_FHD = Regex("1080p", RegexOption.IGNORE_CASE)
+private val QUALITY_HD = Regex("720p", RegexOption.IGNORE_CASE)
+private val QUALITY_SD = Regex("(576p|480p)", RegexOption.IGNORE_CASE)
+private val QUALITY_HDR = Regex("(hdr10|\\bhdr\\b|\\bdv\\b|dolby.?vision)", RegexOption.IGNORE_CASE)
+private val QUALITY_EFFICIENT_CODEC = Regex("(x265|hevc|h\\.?265)", RegexOption.IGNORE_CASE)
+private val QUALITY_AV1 = Regex("\\bav1\\b", RegexOption.IGNORE_CASE)
+private val QUALITY_SOURCE = Regex("(remux|blu-?ray|web-?dl)", RegexOption.IGNORE_CASE)
+private val QUALITY_POOR = Regex("(\\bcam\\b|hdcam|telesync|\\bts\\b|telecine|\\bscr\\b)", RegexOption.IGNORE_CASE)
+
+/** Rough picture-quality score read from a stream's labels; higher is better. Used to bias auto-play. */
+internal fun StreamItem.pictureQualityScore(): Int {
+    val text = listOf(name.orEmpty(), streamLabel, streamSubtitle.orEmpty(), description.orEmpty()).joinToString(" ")
+    var score = when {
+        QUALITY_UHD.containsMatchIn(text) -> 40
+        QUALITY_QHD.containsMatchIn(text) -> 34
+        QUALITY_FHD.containsMatchIn(text) -> 30
+        QUALITY_HD.containsMatchIn(text) -> 20
+        QUALITY_SD.containsMatchIn(text) -> 10
+        else -> 0
+    }
+    if (QUALITY_HDR.containsMatchIn(text)) score += 3
+    if (QUALITY_EFFICIENT_CODEC.containsMatchIn(text)) score += 4
+    if (QUALITY_AV1.containsMatchIn(text)) score += 5
+    if (QUALITY_SOURCE.containsMatchIn(text)) score += 3
+    if (QUALITY_POOR.containsMatchIn(text)) score -= 50
+    return score
+}
