index 00000000..93ed73c1
--- /dev/null
+++ b/composeApp/src/iosMain/kotlin/com/nuvio/app/features/player/IosFeaturePersistence.kt
@@ -0,0 +1,22 @@
+package com.nuvio.app.features.player
+
+import com.nuvio.app.features.player.seekpreview.LocalSeekPreviewSettings
+import com.nuvio.app.features.player.seekpreview.SeekrKeyRepository
+import com.nuvio.app.features.player.volumeboost.VolumeBoost
+import platform.Foundation.NSUserDefaults
+
+internal fun installIosFeaturePersistence() {
+    val defaults = NSUserDefaults.standardUserDefaults
+    VolumeBoost.installPersistence(
+        load = { if (defaults.objectForKey("nuvio_volume_boost_enabled") != null) defaults.boolForKey("nuvio_volume_boost_enabled") else true },
+        save = { defaults.setBool(it, forKey = "nuvio_volume_boost_enabled") },
+    )
+    SeekrKeyRepository.installPersistence(
+        load = { defaults.stringForKey("nuvio_seekr_user_api_key") },
+        save = { defaults.setObject(it, forKey = "nuvio_seekr_user_api_key") },
+    )
+    LocalSeekPreviewSettings.installPersistence(
+        load = { if (defaults.objectForKey("nuvio_seekr_local_previews") != null) defaults.boolForKey("nuvio_seekr_local_previews") else null },
+        save = { defaults.setBool(it, forKey = "nuvio_seekr_local_previews") },
+    )
+}
