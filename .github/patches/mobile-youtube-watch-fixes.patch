+private fun clock(ms: Long): String {
+    val total = (ms / 1000).coerceAtLeast(0)
+    val h = total / 3600
+    val m = (total % 3600) / 60
+    val s = total % 60
+    val two = { v: Long -> v.toString().padStart(2, '0') }
+    return if (h > 0) "$h:${two(m)}:${two(s)}" else "$m:${two(s)}"
+}
+
+/**
+ * Controls drawn over the inline YouTube player: back and the four actions (Autoplay, Watch later,
+ * Channel, Full player) on top, play/pause in the middle, and the seek bar with the times at the bottom.
+ * A tap on the picture shows or hides them.
+ */
+@Composable
+internal fun WatchPlayerOverlay(
+    snapshot: PlayerPlaybackSnapshot,
+    autoplay: Boolean,
+    watchLater: Boolean,
+    hasChannel: Boolean,
+    onBack: () -> Unit,
+    onPlayPause: () -> Unit,
+    onSeek: (Long) -> Unit,
+    onAutoplay: () -> Unit,
+    onWatchLater: () -> Unit,
+    onChannel: () -> Unit,
+    onFullPlayer: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    var visible by remember { mutableStateOf(true) }
+    var tick by remember { mutableStateOf(0) }
+    var scrub by remember { mutableStateOf<Float?>(null) }
+    val accent = MaterialTheme.colorScheme.primary
+    LaunchedEffect(visible, tick, snapshot.isPlaying) {
+        if (visible && snapshot.isPlaying && scrub == null) {
+            kotlinx.coroutines.delay(3500)
+            visible = false
+        }
+    }
+    Box(
+        modifier = modifier.clickable(
+            interactionSource = remember { MutableInteractionSource() },
+            indication = null,
+        ) { visible = !visible; tick++ },
+    ) {
+        if (!visible) return@Box
+        Box(Modifier.fillMaxSize().background(Brush.verticalGradient(listOf(Color(0x99000000), Color.Transparent, Color(0x99000000)))))
+        Row(
+            Modifier.fillMaxWidth().align(Alignment.TopCenter).padding(horizontal = 4.dp),
+            verticalAlignment = Alignment.CenterVertically,
+        ) {
+            IconButton(onClick = onBack) {
+                Icon(Icons.AutoMirrored.Rounded.ArrowBack, contentDescription = "Close player", tint = Color.White)
+            }
+            Box(Modifier.weight(1f))
+            IconButton(onClick = { onAutoplay(); tick++ }) {
+                Icon(Icons.Rounded.PlayCircle, contentDescription = if (autoplay) "Autoplay next on" else "Autoplay next off", tint = if (autoplay) accent else Color.White)
+            }
+            IconButton(onClick = { onWatchLater(); tick++ }) {
+                Icon(Icons.Rounded.WatchLater, contentDescription = "Watch later", tint = if (watchLater) accent else Color.White)
+            }
+            if (hasChannel) {
+                IconButton(onClick = onChannel) {
+                    Icon(Icons.Rounded.AccountCircle, contentDescription = "Channel", tint = Color.White)
+                }
+            }
+            IconButton(onClick = onFullPlayer) {
+                Icon(Icons.Rounded.Fullscreen, contentDescription = "Full player", tint = Color.White)
+            }
+        }
+        IconButton(onClick = { onPlayPause(); tick++ }, modifier = Modifier.align(Alignment.Center).size(56.dp)) {
+            Icon(
+                if (snapshot.isPlaying) Icons.Rounded.Pause else Icons.Rounded.PlayArrow,
+                contentDescription = if (snapshot.isPlaying) "Pause" else "Play",
+                tint = Color.White,
+                modifier = Modifier.size(44.dp),
+            )
+        }
+        Column(Modifier.fillMaxWidth().align(Alignment.BottomCenter).padding(horizontal = 12.dp)) {
+            val duration = snapshot.durationMs.coerceAtLeast(1L)
+            val fraction = scrub ?: (snapshot.positionMs.toFloat() / duration).coerceIn(0f, 1f)
+            Slider(
+                value = fraction,
+                onValueChange = { scrub = it; tick++ },
+                onValueChangeFinished = {
+                    scrub?.let { onSeek((it * duration).toLong()) }
+                    scrub = null
+                },
+                colors = SliderDefaults.colors(
+                    thumbColor = accent,
+                    activeTrackColor = accent,
+                    inactiveTrackColor = Color(0x66FFFFFF),
+                ),
+                modifier = Modifier.fillMaxWidth().padding(bottom = 0.dp),
+            )
+            Row(Modifier.fillMaxWidth().padding(bottom = 6.dp), horizontalArrangement = Arrangement.SpaceBetween) {
+                Text(clock(scrub?.let { (it * duration).toLong() } ?: snapshot.positionMs), color = Color.White, style = MaterialTheme.typography.labelSmall)
+                Text(clock(snapshot.durationMs), color = Color.White, style = MaterialTheme.typography.labelSmall)
+            }
+        }
+    }
+}
