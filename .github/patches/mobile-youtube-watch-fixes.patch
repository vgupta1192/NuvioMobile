+package com.nuvio.app.features.youtube
+
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+/**
+ * Resolutions the extractor found for the YouTube video in the app's player, and the height cap the
+ * viewer picked for that one video. The cap applies to that video id only, so trailers stay on best.
+ */
+object YouTubeStreamQuality {
+    private val _heights = MutableStateFlow<Pair<String, List<Int>>>("" to emptyList())
+    val heights: StateFlow<Pair<String, List<Int>>> = _heights.asStateFlow()
+
+    private var capVideoId: String = ""
+    private var capHeight: Int = 0
+
+    fun publish(videoId: String, list: List<Int>) {
+        _heights.value = videoId to list
+    }
+
+    fun setCap(videoId: String, height: Int?) {
+        capVideoId = videoId
+        capHeight = height ?: 0
+    }
+
+    fun capFor(videoId: String): Int? = capHeight.takeIf { it > 0 && videoId == capVideoId }
+}
