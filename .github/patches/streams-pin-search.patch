+        StreamBadgeSettingsRepository.uiState
+    }.collectAsStateWithLifecycle()
+    var query by rememberSaveable { mutableStateOf("") }
+    val enabled = settings.showStreamSearch
+    val terms = remember(query, enabled) {
+        if (enabled) query.trim().lowercase().split(' ').filter { it.isNotEmpty() } else emptyList()
+    }
+    val filtered = remember(uiState, terms) {
+        if (terms.isEmpty()) {
+            uiState
+        } else {
+            uiState.copy(groups = uiState.groups.map { group -> group.copy(streams = group.streams.filter { it.matchesSearchTerms(terms) }) })
+        }
+    }
+    return StreamSearchState(
+        enabled = enabled,
+        query = query,
+        onQueryChange = { query = it },
+        uiState = filtered,
+        isEmptyBecauseOfSearch = terms.isNotEmpty() && uiState.hasAnyStreams && !filtered.hasAnyStreams,
+    )
+}
+
+private fun StreamItem.matchesSearchTerms(terms: List<String>): Boolean {
+    val haystack = buildString {
+        name?.let { append(it).append(' ') }
+        title?.let { append(it).append(' ') }
+        description?.let { append(it).append(' ') }
+        sourceName?.let { append(it).append(' ') }
+        append(addonName).append(' ')
+        behaviorHints.filename?.let { append(it).append(' ') }
+        badges.forEach { badge -> append(badge.name).append(' ') }
+    }.lowercase()
+    return terms.all { haystack.contains(it) }
+}
+
+@Composable
+internal fun StreamSearchBar(search: StreamSearchState, modifier: Modifier = Modifier) {
+    if (!search.enabled) return
+    val trailingContent: (@Composable () -> Unit)? = if (search.query.isEmpty()) null else {
+        {
+            IconButton(onClick = { search.onQueryChange("") }) {
+                Icon(
+                    imageVector = Icons.Rounded.Close,
+                    contentDescription = stringResource(Res.string.streams_search_clear),
+                    tint = MaterialTheme.nuvio.colors.textMuted,
+                )
+            }
+        }
+    }
+    NuvioInputField(
+        value = search.query,
+        onValueChange = search.onQueryChange,
+        placeholder = stringResource(Res.string.streams_search_placeholder),
+        modifier = modifier.padding(horizontal = 12.dp, vertical = 4.dp),
+        trailingContent = trailingContent,
+    )
+}
