@@ -0,0 +1,75 @@
+package com.nuvio.app.features.details
+
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.setValue
+import com.nuvio.app.features.addons.httpGetTextWithHeaders
+import com.nuvio.app.features.tmdb.TmdbMetadataService
+import com.nuvio.app.features.trakt.TraktConfig
+import kotlinx.coroutines.CancellationException
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.doubleOrNull
+import kotlinx.serialization.json.intOrNull
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+
+/** Per-episode ratings from services other than IMDb (TMDB, Trakt), keyed by (season, episode). */
+object EpisodeExtraRatings {
+    private val json = Json { ignoreUnknownKeys = true; isLenient = true }
+    private val cache = mutableMapOf<String, Map<Pair<Int, Int>, List<Pair<String, Double>>>>()
+
+    var current by mutableStateOf<Map<Pair<Int, Int>, List<Pair<String, Double>>>>(emptyMap())
+        private set
+
+    fun clear() {
+        current = emptyMap()
+    }
+
+    suspend fun load(imdbId: String?, tmdbId: Int?, seasons: List<Int>) {
+        val seasonList = seasons.filter { it > 0 }.distinct().sorted()
+        if (seasonList.isEmpty() || (imdbId == null && tmdbId == null)) {
+            current = emptyMap()
+            return
+        }
+        val key = "${imdbId ?: ""}:${tmdbId ?: ""}:${seasonList.joinToString(",")}"
+        cache[key]?.let { current = it; return }
+        val tmdb = tmdbId?.let { runCatching { TmdbMetadataService.fetchEpisodeVoteAverages(it, seasonList) }.getOrNull() }
+            .orEmpty()
+        val trakt = (imdbId ?: tmdbId?.toString())?.let { fetchTrakt(it) }.orEmpty()
+        val merged = mutableMapOf<Pair<Int, Int>, MutableList<Pair<String, Double>>>()
+        tmdb.forEach { (k, v) -> merged.getOrPut(k) { mutableListOf() }.add("TMDB" to v) }
+        trakt.forEach { (k, v) -> merged.getOrPut(k) { mutableListOf() }.add("Trakt" to v) }
+        if (merged.isNotEmpty()) cache[key] = merged
+        current = merged
+    }
+
+    private suspend fun fetchTrakt(showId: String): Map<Pair<Int, Int>, Double> {
+        return try {
+            val text = httpGetTextWithHeaders(
+                url = "https://api.trakt.tv/shows/$showId/seasons?extended=episodes,full",
+                headers = mapOf(
+                    "trakt-api-version" to "2",
+                    "trakt-api-key" to TraktConfig.CLIENT_ID,
+                    "Content-Type" to "application/json",
+                ),
+            )
+            val out = mutableMapOf<Pair<Int, Int>, Double>()
+            json.parseToJsonElement(text).jsonArray.forEach { seasonEl ->
+                val season = seasonEl.jsonObject
+                val sn = season["number"]?.jsonPrimitive?.intOrNull ?: return@forEach
+                season["episodes"]?.jsonArray?.forEach { epEl ->
+                    val ep = epEl.jsonObject
+                    val en = ep["number"]?.jsonPrimitive?.intOrNull ?: return@forEach
+                    val r = ep["rating"]?.jsonPrimitive?.doubleOrNull ?: return@forEach
+                    if (r > 0.0) out[sn to en] = r
+                }
+            }
+            out
+        } catch (cancelled: CancellationException) {
+            throw cancelled
+        } catch (_: Exception) {
+            emptyMap()
+        }
+    }
+}
