@@ -0,0 +1,29 @@
+package com.nuvio.app.features.home
+
+import com.nuvio.app.core.storage.AppFileCache
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+/** Shows the CS3 provider dot and the CloudStream catalogues on Home. Per device, on by default. */
+object CloudStreamHomeSetting {
+    private const val PATH = "settings/cloudstream_home"
+
+    private val _enabled = MutableStateFlow(true)
+    val enabled: StateFlow<Boolean> = _enabled.asStateFlow()
+
+    private var loaded = false
+
+    fun ensureLoaded() {
+        if (loaded) return
+        loaded = true
+        AppFileCache.read(PATH)?.trim()?.let { _enabled.value = it == "1" }
+    }
+
+    fun set(value: Boolean) {
+        ensureLoaded()
+        if (_enabled.value == value) return
+        _enabled.value = value
+        runCatching { AppFileCache.write(PATH, if (value) "1" else "0") }
+    }
+}
