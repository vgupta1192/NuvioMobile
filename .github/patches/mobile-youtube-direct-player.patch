+/** Feed pages kept across the full player, so a return does not reload the list or lose the scroll spot. */
+internal object FeedCache {
+    class Snap(val items: List<YtItem>, val token: String?, val index: Int, val offset: Int, val savedAt: Long)
+
+    /** Bumped by a tab re-tap or a pull down; feed keys carry it, so a bump means a fresh load. */
+    val tick = androidx.compose.runtime.mutableIntStateOf(0)
+    private val map = object : LinkedHashMap<Any, Snap>() {
+        override fun removeEldestEntry(eldest: MutableMap.MutableEntry<Any, Snap>?) = size > 12
+    }
+
+    fun get(key: Any): Snap? = synchronized(map) {
+        map[key]?.takeIf { nowMs() - it.savedAt < 30 * 60_000L }
+    }
+
+    fun put(key: Any, items: List<YtItem>, token: String?, index: Int, offset: Int) = synchronized(map) {
+        map[key] = Snap(items, token, index, offset, nowMs())
+    }
+
+    private fun nowMs(): Long = kotlin.time.Clock.System.now().toEpochMilliseconds()
+}
