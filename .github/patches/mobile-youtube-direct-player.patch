@@ -0,0 +1,82 @@
+package com.nuvio.app.features.trailer
+
+import androidx.media3.common.util.UnstableApi
+import androidx.media3.datasource.DataSpec
+import androidx.media3.datasource.DefaultHttpDataSource
+import java.io.ByteArrayOutputStream
+import java.util.concurrent.Executors
+
+/**
+ * The first bytes of a YouTube video and audio stream, downloaded before the viewer taps the card.
+ * [YoutubeChunkedDataSourceFactory] serves a request that starts at byte 0 from here, so the player
+ * has data for its first frame without waiting for the network round trip.
+ */
+@UnstableApi
+internal object YoutubeFirstChunkCache {
+    class Entry(val bytes: ByteArray, val requested: Int)
+
+    private const val MAX_ENTRIES = 8
+    const val VIDEO_BYTES = 3 * 1024 * 1024
+    const val AUDIO_BYTES = 512 * 1024
+
+    private val entries = object : LinkedHashMap<String, Entry>(16, 0.75f, true) {
+        override fun removeEldestEntry(eldest: MutableMap.MutableEntry<String, Entry>?): Boolean = size > MAX_ENTRIES
+    }
+    private val inFlight = HashSet<String>()
+    private val executor = Executors.newFixedThreadPool(2) { runnable ->
+        Thread(runnable, "yt-first-chunk").apply { isDaemon = true }
+    }
+
+    fun get(url: String): Entry? = synchronized(entries) { entries[url] }
+
+    fun prefetch(source: TrailerPlaybackSource) {
+        prefetch(source.videoUrl, VIDEO_BYTES)
+        source.audioUrl?.let { prefetch(it, AUDIO_BYTES) }
+    }
+
+    private fun prefetch(rawUrl: String, bytes: Int) {
+        if (!rawUrl.contains("googlevideo.com")) return
+        // Same normalisation as the data source, which looks the entry up by Uri.toString().
+        val url = android.net.Uri.parse(rawUrl).toString()
+        synchronized(entries) {
+            if (entries.containsKey(url) || !inFlight.add(url)) return
+        }
+        executor.execute {
+            try {
+                val data = download(url, bytes)
+                if (data != null) synchronized(entries) { entries[url] = Entry(data, bytes) }
+                android.util.Log.i("YouTubeStart", "first-bytes prefetch ${data?.size ?: 0} of $bytes")
+            } finally {
+                synchronized(entries) { inFlight.remove(url) }
+            }
+        }
+    }
+
+    private fun download(url: String, bytes: Int): ByteArray? {
+        val upstream = DefaultHttpDataSource.Factory()
+            .setConnectTimeoutMs(8_000)
+            .setReadTimeoutMs(8_000)
+            .setAllowCrossProtocolRedirects(true)
+            .setDefaultRequestProperties(TrailerExtractionPlatform.defaultHeaders)
+            .createDataSource()
+        return try {
+            val rangedUri = android.net.Uri.parse(url).buildUpon()
+                .appendQueryParameter("range", "0-${bytes - 1}")
+                .build()
+            upstream.open(DataSpec(rangedUri))
+            val out = ByteArrayOutputStream(bytes)
+            val buffer = ByteArray(64 * 1024)
+            while (out.size() < bytes) {
+                val read = upstream.read(buffer, 0, minOf(buffer.size, bytes - out.size()))
+                if (read < 0) break
+                out.write(buffer, 0, read)
+            }
+            out.toByteArray().takeIf { it.isNotEmpty() }
+        } catch (e: Exception) {
+            android.util.Log.w("YouTubeStart", "first-bytes prefetch failed: ${e.message}")
+            null
+        } finally {
+            runCatching { upstream.close() }
+        }
+    }
+}
