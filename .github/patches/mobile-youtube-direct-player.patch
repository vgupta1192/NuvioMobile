+package com.nuvio.app.features.youtube
+
+import co.touchlab.kermit.Logger
+import kotlin.time.TimeMark
+import kotlin.time.TimeSource
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+
+/**
+ * Timeline of one YouTube video start: tap, extraction stages, navigation, first playing frame.
+ * Shown in the video info sheet and written to the log (tag "YouTubeStart") to find slow steps.
+ */
+object YouTubeStartTrace {
+    private var started: TimeMark? = null
+    private var videoId: String = ""
+    private val _lines = MutableStateFlow<List<String>>(emptyList())
+    val lines: StateFlow<List<String>> = _lines
+    private val log = Logger.withTag("YouTubeStart")
+
+    fun begin(id: String) {
+        videoId = id
+        started = TimeSource.Monotonic.markNow()
+        _lines.value = emptyList()
+        log.i { "tap $id" }
+    }
+
+    fun mark(label: String) {
+        val mark = started ?: return
+        if (_lines.value.any { it.startsWith("$label ") }) return
+        val ms = mark.elapsedNow().inWholeMilliseconds
+        _lines.value = _lines.value + "$label  ${ms} ms"
+        log.i { "$label at ${ms} ms ($videoId)" }
+    }
+}
