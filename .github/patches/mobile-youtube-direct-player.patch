+    /** Keeps the best height, but narrows that height to the preferred codec when it is offered there. */
+    private fun preferCodec(pool: List<StreamCandidate>, codec: String): List<StreamCandidate> {
+        if (codec.isBlank() || codec == "auto") return pool
+        val top = pool.maxOfOrNull { it.height } ?: return pool
+        val atTop = pool.filter { it.height == top }
+        val match = atTop.filter { it.codec == codec }
+        return if (match.isEmpty()) pool else match
+    }
