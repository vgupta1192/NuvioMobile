@@ -0,0 +1,76 @@
+package com.nuvio.app.features.youtube
+
+import com.nuvio.app.features.streams.YouTubeStreamResolver
+import com.nuvio.app.features.trailer.TrailerPlaybackResolver
+import com.nuvio.app.features.trailer.TrailerPlaybackSource
+import kotlin.time.Duration.Companion.minutes
+import kotlin.time.TimeMark
+import kotlin.time.TimeSource
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Deferred
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.async
+import kotlinx.coroutines.sync.Semaphore
+import kotlinx.coroutines.sync.withPermit
+
+/**
+ * Resolves the stream of a video before the viewer taps it, so the tap goes straight to the player.
+ * An entry is only handed out while the quality cap and codec it was resolved with still match the
+ * settings, and only for a few minutes, so the stream URL cannot go stale.
+ */
+object YouTubePrewarm {
+    private class Entry(val key: String, val source: Deferred<TrailerPlaybackSource?>, val mark: TimeMark)
+
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.Default)
+    private val gate = Semaphore(2)
+    private val entries = LinkedHashMap<String, Entry>()
+    private val lock = Any()
+
+    private fun settingsKey(): String =
+        YouTubeSettings.startQuality.current() + "|" + YouTubeSettings.codecPreference.current()
+
+    private fun fresh(entry: Entry, key: String): Boolean =
+        entry.key == key && entry.mark.elapsedNow() < MAX_AGE
+
+    /** Starts resolving [item] in the background unless a fresh result is already on its way. */
+    fun warm(item: YtItem) {
+        if (item.kind != YtKind.VIDEO || item.isShort || item.isLive || item.id.isBlank()) return
+        val key = settingsKey()
+        synchronized(lock) {
+            entries[item.id]?.let { if (fresh(it, key)) return }
+            while (entries.size >= MAX_ENTRIES) entries.remove(entries.keys.first())
+            YouTubeStreamQuality.setCap(item.id, YouTubeSettings.startQuality.current().toIntOrNull())
+            YouTubeStreamQuality.setCodec(item.id, YouTubeSettings.codecPreference.current())
+            val watchUrl = YouTubeStreamResolver.watchUrl(item.id)
+            val deferred = scope.async {
+                gate.withPermit {
+                    runCatching { TrailerPlaybackResolver.resolveFromYouTubeUrl(watchUrl) }.getOrNull()
+                }
+            }
+            entries[item.id] = Entry(key, deferred, TimeSource.Monotonic.markNow())
+        }
+    }
+
+    /** Warms the first few playable videos of a list the viewer is looking at. */
+    fun warmFirst(items: List<YtItem>, count: Int = 2) {
+        items.asSequence()
+            .filter { it.kind == YtKind.VIDEO && !it.isShort && !it.isLive }
+            .take(count)
+            .forEach { warm(it) }
+    }
+
+    /** The prewarmed stream for [videoId], or null when none is usable. A failed warm-up is dropped. */
+    suspend fun take(videoId: String): TrailerPlaybackSource? {
+        val key = settingsKey()
+        val entry = synchronized(lock) {
+            entries[videoId]?.takeIf { fresh(it, key) }
+        } ?: return null
+        val source = runCatching { entry.source.await() }.getOrNull()
+        if (source == null) synchronized(lock) { if (entries[videoId] === entry) entries.remove(videoId) }
+        return source
+    }
+
+    private val MAX_AGE = 20.minutes
+    private const val MAX_ENTRIES = 8
+}
