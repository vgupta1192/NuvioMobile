+package com.nuvio.app.features.youtube
+
+import com.nuvio.app.features.streams.YouTubeStreamResolver
+import com.nuvio.app.features.trailer.TrailerPlaybackResolver
+import com.nuvio.app.features.trailer.TrailerPlaybackSource
+import kotlin.time.Duration.Companion.minutes
+import kotlin.time.TimeMark
+import kotlin.time.TimeSource
+import kotlin.concurrent.Volatile
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Deferred
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.async
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.Semaphore
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.sync.withPermit
+
+/**
+ * Resolves the stream of a video before the viewer taps it, so the tap goes straight to the player.
+ * An entry is only handed out while the quality cap and codec it was resolved with still match the
+ * settings, and only for a few minutes, so the stream URL cannot go stale.
+ */
+object YouTubePrewarm {
+    private class Entry(val key: String, val source: Deferred<TrailerPlaybackSource?>, val mark: TimeMark)
+
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.Default)
+    private val gate = Semaphore(3)
+    private val entries = LinkedHashMap<String, Entry>()
+    private val lock = Any()
+
+    private fun settingsKey(): String =
+        YouTubeSettings.startQuality.current() + "|" + YouTubeSettings.codecPreference.current()
+
+    private fun fresh(entry: Entry, key: String): Boolean =
+        entry.key == key && entry.mark.elapsedNow() < MAX_AGE
+
+    /** Fetches the page key and visitor id in the background; cheap when they are still fresh. */
+    fun warmConfig() {
+        scope.launch { runCatching { TrailerPlaybackResolver.warmUp() } }
+    }
+
+    /** Starts resolving [item] in the background unless a fresh result is already on its way. */
+    fun warm(item: YtItem) {
+        if (item.kind != YtKind.VIDEO || item.isShort || item.isLive || item.id.isBlank()) return
+        warmConfig()
+        val key = settingsKey()
+        synchronized(lock) {
+            entries[item.id]?.let { if (fresh(it, key)) return }
+            while (entries.size >= MAX_ENTRIES) entries.remove(entries.keys.first())
+            YouTubeStreamQuality.setCap(item.id, YouTubeSettings.startQuality.current().toIntOrNull())
+            YouTubeStreamQuality.setCodec(item.id, YouTubeSettings.codecPreference.current())
+            val watchUrl = YouTubeStreamResolver.watchUrl(item.id)
+            val deferred = scope.async {
+                gate.withPermit {
+                    runCatching { TrailerPlaybackResolver.resolveFromYouTubeUrl(watchUrl) }.getOrNull()
+                }?.also { source -> runCatching { YouTubeWarmupHooks.prefetchFirstBytes?.invoke(source) } }
+            }
+            entries[item.id] = Entry(key, deferred, TimeSource.Monotonic.markNow())
+        }
+    }
+
+    /** Warms the first few playable videos of a list the viewer is looking at. */
+    fun warmFirst(items: List<YtItem>, count: Int = 4) {
+        items.asSequence()
+            .filter { it.kind == YtKind.VIDEO && !it.isShort && !it.isLive }
+            .take(count)
+            .forEach { warm(it) }
+    }
+
+    /** The prewarmed stream for [videoId], or null when none is usable. A failed warm-up is dropped. */
+    suspend fun take(videoId: String): TrailerPlaybackSource? {
+        val key = settingsKey()
+        val entry = synchronized(lock) {
+            entries[videoId]?.takeIf { fresh(it, key) }
+        } ?: return null
+        val source = runCatching { entry.source.await() }.getOrNull()
+        if (source == null) synchronized(lock) { if (entries[videoId] === entry) entries.remove(videoId) }
+        return source
+    }
+
+    /** Why the last preview resolve gave nothing; shown on the card while previews are being debugged. */
+    @Volatile
+    var lastError: String? = null
+
+    private val previews = LinkedHashMap<String, Entry>()
+    private val capLock = Mutex()
+
+    /**
+     * A small stream (480p, H.264) for the muted feed preview. The quality cap and codec of a video are
+     * kept per video id, so they are switched only while this resolve runs and put back right after.
+     * The full player never uses this entry.
+     */
+    suspend fun previewSource(item: YtItem): TrailerPlaybackSource? {
+        if (item.kind != YtKind.VIDEO || item.isShort || item.id.isBlank()) return null
+        lastError = null
+        // A live stream has no 480p file to pick: it plays the same stream the full player would.
+        if (item.isLive) {
+            return runCatching { YouTubeRepository.resolve(item.id) }
+                .onFailure { lastError = "live ${it::class.simpleName}: ${it.message?.take(120)}" }
+                .getOrNull()
+                .also { if (it == null && lastError == null) lastError = "live: no stream ${YouTubeWarmupHooks.lastExtractFailure.orEmpty()}" }
+        }
+        val deferred = synchronized(lock) {
+            previews[item.id]?.takeIf { it.mark.elapsedNow() < MAX_AGE }?.source
+                ?: scope.async {
+                    gate.withPermit {
+                        capLock.withLock {
+                            YouTubeStreamQuality.setCap(item.id, PREVIEW_HEIGHT)
+                            YouTubeStreamQuality.setCodec(item.id, "avc")
+                            try {
+                                runCatching { TrailerPlaybackResolver.resolveFromYouTubeUrl(YouTubeStreamResolver.watchUrl(item.id)) }
+                                    .onFailure { lastError = "${it::class.simpleName}: ${it.message?.take(120)}" }
+                                    .onSuccess { if (it == null) lastError = "resolver returned null" }
+                                    .getOrNull()
+                            } finally {
+                                YouTubeStreamQuality.setCap(item.id, YouTubeSettings.startQuality.current().toIntOrNull())
+                                YouTubeStreamQuality.setCodec(item.id, YouTubeSettings.codecPreference.current())
+                            }
+                        }
+                    }
+                }.also {
+                    while (previews.size >= MAX_ENTRIES) previews.remove(previews.keys.first())
+                    previews[item.id] = Entry("", it, TimeSource.Monotonic.markNow())
+                }
+        }
+        var source = runCatching { deferred.await() }.onFailure { lastError = "await: ${it::class.simpleName}: ${it.message?.take(120)}" }.getOrNull()
+        if (source == null) {
+            synchronized(lock) { previews.remove(item.id) }
+            // The capped resolve found nothing: fall back to the stream the full player would use.
+            source = take(item.id)
+                ?: runCatching { YouTubeRepository.resolve(item.id) }
+                    .onFailure { lastError = "$lastError; fallback ${it::class.simpleName}: ${it.message?.take(80)}" }
+                    .getOrNull()
+            lastError = "$lastError; fallback ${if (source == null) "null: ${YouTubeWarmupHooks.lastExtractFailure}" else "ok"}"
+        }
+        return source
+    }
+
+    private const val PREVIEW_HEIGHT = 480
+    private val MAX_AGE = 20.minutes
+    private const val MAX_ENTRIES = 8
+}
