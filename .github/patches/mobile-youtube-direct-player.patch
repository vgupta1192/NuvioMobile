+package com.nuvio.app.features.youtube
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.collectAsState
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.produceState
+import com.nuvio.app.features.addons.httpGetTextWithHeaders
+import kotlinx.coroutines.sync.Semaphore
+import kotlinx.coroutines.sync.withPermit
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonArray
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.booleanOrNull
+import kotlinx.serialization.json.contentOrNull
+import kotlinx.serialization.json.doubleOrNull
+import kotlinx.serialization.json.intOrNull
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+
+/** Community-written titles and thumbnails picked from the video itself (DeArrow, sponsor.ajay.app). */
+data class YtBranding(val title: String?, val thumb: String?)
+
+object YouTubeDeArrow {
+    private val cache = HashMap<String, YtBranding>()
+    private val gate = Semaphore(4)
+
+    fun cached(videoId: String): YtBranding? = cache[videoId]
+
+    suspend fun get(videoId: String): YtBranding {
+        cache[videoId]?.let { return it }
+        val result = gate.withPermit {
+            cache[videoId] ?: runCatching { fetch(videoId) }.getOrDefault(YtBranding(null, null))
+        }
+        cache[videoId] = result
+        return result
+    }
+
+    private suspend fun fetch(videoId: String): YtBranding {
+        val text = httpGetTextWithHeaders(
+            url = "https://sponsor.ajay.app/api/branding?videoID=$videoId",
+            headers = mapOf("accept" to "application/json"),
+        )
+        val root = Json.parseToJsonElement(text).jsonObject
+        val title = (root["titles"] as? JsonArray)?.firstNotNullOfOrNull { entry ->
+            val obj = entry as? JsonObject ?: return@firstNotNullOfOrNull null
+            val original = obj["original"]?.jsonPrimitive?.booleanOrNull == true
+            val votes = obj["votes"]?.jsonPrimitive?.intOrNull ?: 0
+            val locked = obj["locked"]?.jsonPrimitive?.booleanOrNull == true
+            val name = obj["title"]?.jsonPrimitive?.contentOrNull
+            name?.takeIf { !original && it.isNotBlank() && (votes >= 0 || locked) }
+        }?.replace(Regex("(^|\\s)>(?=\\S)"), "$1")
+        val thumb = (root["thumbnails"] as? JsonArray)?.firstNotNullOfOrNull { entry ->
+            val obj = entry as? JsonObject ?: return@firstNotNullOfOrNull null
+            val original = obj["original"]?.jsonPrimitive?.booleanOrNull == true
+            val votes = obj["votes"]?.jsonPrimitive?.intOrNull ?: 0
+            val locked = obj["locked"]?.jsonPrimitive?.booleanOrNull == true
+            val time = obj["timestamp"]?.jsonPrimitive?.doubleOrNull
+            time?.takeIf { !original && (votes >= 0 || locked) }
+        }?.let { "https://dearrow-thumb.ajay.app/api/v1/getThumbnail?videoID=$videoId&time=$it" }
+        return YtBranding(title, thumb)
+    }
+}
+
+/** Title and thumbnail to draw for [item]: DeArrow's when those settings are on and it has them, else the originals. */
+@Composable
+fun rememberBrandedItem(item: YtItem, thumbnails: Boolean = true): Pair<String, String> {
+    YouTubeSettings.ensureLoaded()
+    val titlesOn by YouTubeSettings.deArrowTitles.value.collectAsState()
+    val thumbsOn by YouTubeSettings.deArrowThumbnails.value.collectAsState()
+    val wantThumb = thumbsOn && thumbnails
+    if (item.kind != YtKind.VIDEO || item.id.length != 11 || (!titlesOn && !wantThumb)) return item.title to item.thumb
+    val branding by produceState(YouTubeDeArrow.cached(item.id), item.id) {
+        value = YouTubeDeArrow.get(item.id)
+    }
+    return (if (titlesOn) branding?.title else null).orEmpty().ifBlank { item.title } to
+        (if (wantThumb) branding?.thumb else null).orEmpty().ifBlank { item.thumb }
+}
