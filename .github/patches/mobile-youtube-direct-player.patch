+
+/** The one feed card that plays a muted preview while it is in view. Mute and caption choices stick across cards. */
+internal object InlinePreview {
+    val activeKey = mutableStateOf<String?>(null)
+    val muted = mutableStateOf(true)
+    val captions = mutableStateOf(false)
+    /** Live position of the playing preview, for the card's time badge. */
+    val elapsedKey = mutableStateOf<String?>(null)
+    val elapsedMs = mutableStateOf(0L)
+    /** Where each preview last was, so the full player can open at that point. */
+    val positions = HashMap<String, Long>()
+
+    fun format(ms: Long): String {
+        val total = (ms / 1000).coerceAtLeast(0)
+        val h = total / 3600
+        val m = (total % 3600) / 60
+        val sec = total % 60
+        return if (h > 0) "$h:${m.toString().padStart(2, '0')}:${sec.toString().padStart(2, '0')}" else "$m:${sec.toString().padStart(2, '0')}"
+    }
+}
+
+private fun previewable(item: YtItem) =
+    item.kind == YtKind.VIDEO && !item.isShort && item.id.isNotBlank()
+
+/**
+ * Picks the previewable card nearest the middle of the list once scrolling has settled and at least
+ * 70 % of it is in view. Cards must be laid out as lazy items keyed by [YtItem.key].
+ */
+@Composable
+internal fun TrackInlinePreview(listState: LazyListState, items: List<YtItem>) {
+    val enabled by YouTubeSettings.inlinePreview.value.collectAsState()
+    remember { YouTubeSettings.inlinePreview.ensureLoaded(); 0 }
+    val byKey = remember(items) { items.filter(::previewable).associateBy { it.key } }
+    DisposableEffect(Unit) { onDispose { InlinePreview.activeKey.value = null } }
+    LaunchedEffect(enabled, byKey) {
+        if (!enabled) {
+            InlinePreview.activeKey.value = null
+            return@LaunchedEffect
+        }
+        snapshotFlow {
+            if (listState.isScrollInProgress) {
+                null
+            } else {
+                val info = listState.layoutInfo
+                val top = info.viewportStartOffset
+                val bottom = info.viewportEndOffset
+                val middle = (top + bottom) / 2
+                val candidates = info.visibleItemsInfo
+                    .filter { (it.key as? String) in byKey && it.size > 0 }
+                    .filter { (minOf(it.offset + it.size, bottom) - maxOf(it.offset, top)).toFloat() / it.size >= 0.7f }
+                // A list at its top (a tab just opened) previews its first video, not the one nearest the middle.
+                if (!listState.canScrollBackward) candidates.minByOrNull { it.offset }?.key as? String
+                else candidates.minByOrNull { kotlin.math.abs(it.offset + it.size / 2 - middle) }?.key as? String
+            }
+        }
+            .distinctUntilChanged()
+            .collect { key ->
+                if (key == null) return@collect
+                delay(350)
+                InlinePreview.activeKey.value = key
+            }
+    }
+}
+
+@Composable
+internal fun InlinePreviewOverlay(item: YtItem, modifier: Modifier = Modifier, onOpen: (positionMs: Long) -> Unit) {
+    val session by YouTubePlayerSession.state.collectAsState()
+    if (session.active) return
+    var source by remember(item.id) { mutableStateOf<TrailerPlaybackSource?>(null) }
+    var controller by remember(item.id) { mutableStateOf<PlayerEngineController?>(null) }
+    var snapshot by remember(item.id) { mutableStateOf(PlayerPlaybackSnapshot()) }
+    var cues by remember(item.id) { mutableStateOf<List<SubtitleSyncCue>>(emptyList()) }
+    var failed by remember(item.id) { mutableStateOf(false) }
+    var note by remember(item.id) { mutableStateOf<String?>(null) }
+    var scrub by remember(item.id) { mutableStateOf<Float?>(null) }
+    val muted by InlinePreview.muted
+    val captions by InlinePreview.captions
+
+    LaunchedEffect(item.id) {
+        source = YouTubePrewarm.previewSource(item)
+        if (source == null) { note = "preview: no stream (${YouTubePrewarm.lastError})"; failed = true }
+    }
+    // A preview that has not started after this long gives way to the plain thumbnail.
+    LaunchedEffect(source) {
+        if (source == null) return@LaunchedEffect
+        delay(15_000)
+        if (snapshot.durationMs <= 0L && snapshot.positionMs <= 0L && !snapshot.isPlaying) {
+            note = "preview: timeout loading=${snapshot.isLoading} playing=${snapshot.isPlaying} audio=${source?.audioUrl != null} ${source?.videoUrl?.take(60)}"
+            failed = true
+        }
+    }
+    LaunchedEffect(item.id, captions) {
+        if (captions && cues.isEmpty()) {
+            cues = runCatching { YouTubeCaptions.cues(item.id) }.getOrDefault(emptyList())
+        }
+    }
+    LaunchedEffect(controller, muted) { controller?.setMuted(muted) }
+    // Starts where the preview or the full player last left this video.
+    var resumed by remember(item.id) { mutableStateOf(false) }
+    LaunchedEffect(controller, snapshot.durationMs) {
+        val c = controller ?: return@LaunchedEffect
+        if (resumed || snapshot.durationMs <= 0L || item.isLive) return@LaunchedEffect
+        resumed = true
+        val at = InlinePreview.positions[item.id] ?: YouTubeRepository.savedPositionMs(item.id)
+        if (at > 2_000L && at < snapshot.durationMs - 10_000L) c.seekTo(at)
+    }
+    LaunchedEffect(snapshot.positionMs) {
+        if (snapshot.positionMs > 0L) {
+            InlinePreview.positions[item.id] = snapshot.positionMs
+            InlinePreview.elapsedKey.value = item.key
+            InlinePreview.elapsedMs.value = snapshot.positionMs
+        }
+    }
+    DisposableEffect(item.id) { onDispose { if (InlinePreview.elapsedKey.value == item.key) InlinePreview.elapsedKey.value = null } }
+    var captionNote by remember(item.id) { mutableStateOf(false) }
+    LaunchedEffect(captions, cues) {
+        captionNote = false
+        if (captions && cues.isEmpty()) {
+            delay(4_000)
+            if (cues.isEmpty()) captionNote = true
+        }
+    }
+    LaunchedEffect(snapshot.isEnded) {
+        if (snapshot.isEnded) {
+            controller?.seekTo(0L)
+            controller?.play()
+        }
+    }
+
+    Box(modifier = modifier.fillMaxSize()) {
+        val src = source
+        if (failed && note != null) {
+            Text(
+                text = note.orEmpty(),
+                color = Color.White,
+                fontSize = 9.sp,
+                maxLines = 8,
+                modifier = Modifier.align(Alignment.BottomStart).background(Color.Black.copy(alpha = 0.6f)).padding(4.dp),
+            )
+        }
+        if (src != null && !failed) {
+            PlatformPlayerSurface(
+                sourceUrl = src.videoUrl,
+                sourceAudioUrl = src.audioUrl,
+                useYoutubeChunkedPlayback = true,
+                modifier = Modifier.fillMaxSize(),
+                playWhenReady = true,
+                resizeMode = PlayerResizeMode.Fit,
+                useNativeController = false,
+                onControllerReady = {
+                    controller = it
+                    it.setMuted(InlinePreview.muted.value)
+                },
+                onSnapshot = { snapshot = it },
+                // The player reports a null error while it switches engines; the 15 s check below catches a preview that never starts.
+                onError = { if (it != null) { note = "preview error: ${it.take(160)}"; failed = true } },
+            )
+            // Taps on the picture open the full player; the controls below sit on top and take their own taps.
+            Box(
+                Modifier
+                    .fillMaxSize()
+                    .clickable(interactionSource = remember { MutableInteractionSource() }, indication = null) { onOpen(snapshot.positionMs.takeIf { it > 0L } ?: InlinePreview.positions[item.id] ?: 0L) },
+            )
+            val cue = if (captions) cues.firstOrNull { snapshot.positionMs >= it.startTimeMs && snapshot.positionMs < it.endTimeMs } else null
+            if (cue != null) {
+                Text(
+                    text = cue.text.replace(Regex("<[^>]*>"), "").trim(),
+                    color = Color.White,
+                    fontSize = 13.sp,
+                    textAlign = TextAlign.Center,
+                    maxLines = 3,
+                    modifier = Modifier
+                        .align(Alignment.BottomCenter)
+                        .padding(start = 24.dp, end = 24.dp, bottom = 16.dp)
+                        .clip(RoundedCornerShape(4.dp))
+                        .background(Color.Black.copy(alpha = 0.7f))
+                        .padding(horizontal = 6.dp, vertical = 2.dp),
+                )
+            }
+            if (captionNote) {
+                Text(
+                    text = "No captions for this video",
+                    color = Color.White,
+                    fontSize = 11.sp,
+                    modifier = Modifier
+                        .align(Alignment.BottomCenter)
+                        .padding(bottom = 22.dp)
+                        .clip(RoundedCornerShape(4.dp))
+                        .background(Color.Black.copy(alpha = 0.7f))
+                        .padding(horizontal = 6.dp, vertical = 2.dp),
+                )
+            }
+            Row(
+                modifier = Modifier.align(Alignment.TopEnd).padding(8.dp),
+                horizontalArrangement = Arrangement.spacedBy(8.dp),
+            ) {
+                RoundIcon(if (captions) Icons.Rounded.ClosedCaption else Icons.Rounded.ClosedCaptionDisabled, "Captions") {
+                    InlinePreview.captions.value = !captions
+                }
+                RoundIcon(
+                    if (muted) Icons.AutoMirrored.Rounded.VolumeOff else Icons.AutoMirrored.Rounded.VolumeUp,
+                    if (muted) "Unmute" else "Mute",
+                ) { InlinePreview.muted.value = !muted }
+            }
+            val duration = snapshot.durationMs
+            if (duration > 0L) {
+                val fraction = scrub ?: (snapshot.positionMs.toFloat() / duration).coerceIn(0f, 1f)
+                Box(
+                    modifier = Modifier
+                        .align(Alignment.BottomCenter)
+                        .fillMaxWidth()
+                        .height(16.dp)
+                        .pointerInput(duration) {
+                            detectTapGestures { offset -> controller?.seekTo((offset.x / size.width * duration).toLong()) }
+                        }
+                        .pointerInput(duration) {
+                            detectHorizontalDragGestures(
+                                onDragStart = { scrub = (it.x / size.width).coerceIn(0f, 1f) },
+                                onDragEnd = {
+                                    scrub?.let { controller?.seekTo((it * duration).toLong()) }
+                                    scrub = null
+                                },
+                                onDragCancel = { scrub = null },
+                            ) { change, _ -> scrub = (change.position.x / size.width).coerceIn(0f, 1f) }
+                        },
+                ) {
+                    Box(Modifier.align(Alignment.BottomStart).fillMaxWidth().height(3.dp).background(Color.White.copy(alpha = 0.3f)))
+                    Box(Modifier.align(Alignment.BottomStart).fillMaxWidth(fraction).height(3.dp).background(Color(0xFFFF0033)))
+                    Box(
+                        Modifier
+                            .align(Alignment.BottomStart)
+                            .fillMaxWidth(fraction)
+                            .height(12.dp),
+                    ) {
+                        Box(
+                            Modifier
+                                .align(Alignment.BottomEnd)
+                                .size(10.dp)
+                                .clip(CircleShape)
+                                .background(Color(0xFFFF0033)),
+                        )
+                    }
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun RoundIcon(icon: androidx.compose.ui.graphics.vector.ImageVector, description: String, onClick: () -> Unit) {
+    Box(
+        modifier = Modifier
+            .size(30.dp)
+            .clip(CircleShape)
+            .background(Color.Black.copy(alpha = 0.55f))
+            .clickable(onClick = onClick),
+        contentAlignment = Alignment.Center,
+    ) {
+        Icon(icon, contentDescription = description, tint = Color.White, modifier = Modifier.size(18.dp))
+    }
+}
