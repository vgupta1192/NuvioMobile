+internal fun PlayerScreenRuntime.onSpeedButton() {
+    if (com.nuvio.app.features.settings.ForkPrefs.speedPopup.current()) {
+        ForkSpeedPopup.open.value = true
+        controlsVisible = true
+    } else {
+        cyclePlaybackSpeed()
+    }
+}
+
+internal fun PlayerScreenRuntime.chooseSpeed(next: Float) {
+    if (partyBlocksControl()) return
+    partyRateNudge = null
+    playerController?.setPlaybackSpeed(next)
+    DxRemember.noteSpeed(next)
+    publishPartyPlayback(rate = next)
+    showGestureMessage(formatPlaybackSpeedLabel(next))
+    controlsVisible = true
+}
+
