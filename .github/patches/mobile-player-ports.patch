+
+/** Fork feature: speed button opens one popup with the speeds and the sleep timer choices. */
+internal object ForkSpeedPopup {
+    val open = MutableStateFlow(false)
+    val speeds: List<Float> = listOf(0.5f, 0.75f, 1f, 1.25f, 1.5f, 1.75f, 2f, 2.5f, 3f)
+}
+
+@Composable
+internal fun ForkSpeedPopupHost(currentSpeed: Float, onSpeedSelected: (Float) -> Unit) {
+    val visible by ForkSpeedPopup.open.collectAsStateWithLifecycle()
+    if (!visible) return
+    val minutes by SleepTimer.minutes.collectAsStateWithLifecycle()
+    val accent = MaterialTheme.colorScheme.primary
+    val shape = RoundedCornerShape(18.dp)
+    Popup(
+        alignment = Alignment.BottomCenter,
+        offset = IntOffset(0, -260),
+        onDismissRequest = { ForkSpeedPopup.open.value = false },
+        properties = PopupProperties(focusable = true),
+    ) {
+        Column(
+            modifier = Modifier
+                .widthIn(max = 340.dp)
+                .heightIn(max = 320.dp)
+                .clip(shape)
+                .ambientLiquidGlass(
+                    shape = shape,
+                    tint = Color.Black.copy(alpha = 0.45f),
+                    fallback = Color.Black.copy(alpha = 0.78f),
+                    blurRadius = 16.dp,
+                    refractionHeight = 10.dp,
+                )
+                .verticalScroll(rememberScrollState())
+                .padding(14.dp),
+            verticalArrangement = Arrangement.spacedBy(8.dp),
+        ) {
+            Text("Speed", color = Color.White.copy(alpha = 0.6f), fontSize = 12.sp)
+            ChoiceRow(
+                labels = ForkSpeedPopup.speeds.map { formatPlaybackSpeedLabel(it) },
+                selected = ForkSpeedPopup.speeds.indexOfFirst { abs(currentSpeed - it) < 0.01f },
+                accent = accent,
+                onPick = { index ->
+                    onSpeedSelected(ForkSpeedPopup.speeds[index])
+                    ForkSpeedPopup.open.value = false
+                },
+            )
+            Text("Sleep timer", color = Color.White.copy(alpha = 0.6f), fontSize = 12.sp)
+            ChoiceRow(
+                labels = SleepTimer.choices.map { SleepTimer.label(it) },
+                selected = SleepTimer.choices.indexOf(minutes),
+                accent = accent,
+                onPick = { index -> SleepTimer.set(SleepTimer.choices[index]) },
+            )
+        }
+    }
+}
+
+@Composable
+private fun ChoiceRow(labels: List<String>, selected: Int, accent: Color, onPick: (Int) -> Unit) {
+    labels.chunked(5).forEachIndexed { rowIndex, rowLabels ->
+        Row(modifier = Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.spacedBy(6.dp)) {
+            rowLabels.forEachIndexed { i, label ->
+                val index = rowIndex * 5 + i
+                val isSelected = index == selected
+                Text(
+                    text = label,
+                    color = if (isSelected) accent else Color.White,
+                    fontSize = 13.sp,
+                    fontWeight = if (isSelected) FontWeight.Bold else FontWeight.Medium,
+                    modifier = Modifier
+                        .clip(RoundedCornerShape(10.dp))
+                        .background(if (isSelected) Color.White.copy(alpha = 0.16f) else Color.White.copy(alpha = 0.06f))
+                        .clickable { onPick(index) }
+                        .padding(horizontal = 10.dp, vertical = 7.dp),
+                )
+            }
+        }
+    }
+}
