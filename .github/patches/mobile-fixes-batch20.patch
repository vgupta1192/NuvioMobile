+        Column(modifier = Modifier.padding(horizontal = 14.dp, vertical = 12.dp)) {
+            SkeletonLine(MaterialTheme.typography.titleSmall, 0.62f)
+            SkeletonLine(MaterialTheme.typography.bodySmall, 0.78f)
