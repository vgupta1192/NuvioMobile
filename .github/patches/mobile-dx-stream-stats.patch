+/** dx.bi port: the stream stats overlay. The button switch lives in Settings, the overlay itself opens from the player. */
+internal object DxStreamStats {
+    private const val PATH = "settings/dx_stats"
+    private val _buttonEnabled = MutableStateFlow(true)
+    val buttonEnabled: StateFlow<Boolean> = _buttonEnabled.asStateFlow()
+    private val _visible = MutableStateFlow(false)
+    val visible: StateFlow<Boolean> = _visible.asStateFlow()
+    private var loaded = false
+
+    fun ensureLoaded() {
+        if (loaded) return
+        loaded = true
+        _buttonEnabled.value = AppFileCache.read(PATH)?.trim() != "0"
+    }
+
+    fun setButtonEnabled(enabled: Boolean) {
+        ensureLoaded()
+        _buttonEnabled.value = enabled
+        if (!enabled) _visible.value = false
+        runCatching { AppFileCache.write(PATH, if (enabled) "1" else "0") }
+    }
+
+    fun toggle() {
+        _visible.value = !_visible.value
+    }
+}
+
+@Composable
+internal fun DxStatsHeaderButton(metrics: PlayerLayoutMetrics) {
+    LaunchedEffect(Unit) { DxStreamStats.ensureLoaded() }
+    val enabled by DxStreamStats.buttonEnabled.collectAsStateWithLifecycle()
+    val visible by DxStreamStats.visible.collectAsStateWithLifecycle()
+    if (!enabled) return
+    PlayerHeaderIconButton(
+        icon = Icons.Rounded.BarChart,
+        contentDescription = "Stream stats",
+        buttonSize = metrics.headerIconSize + 16.dp,
+        iconSize = metrics.headerIconSize,
+        onClick = DxStreamStats::toggle,
+        tint = if (visible) MaterialTheme.colorScheme.primary else Color.White,
+    )
+}
+
+@Composable
+internal fun DxStatsToolbarAction() {
+    LaunchedEffect(Unit) { DxStreamStats.ensureLoaded() }
+    val enabled by DxStreamStats.buttonEnabled.collectAsStateWithLifecycle()
+    val visible by DxStreamStats.visible.collectAsStateWithLifecycle()
+    if (!enabled) return
+    IconButton(onClick = DxStreamStats::toggle, modifier = Modifier.size(48.dp)) {
+        Icon(
+            imageVector = Icons.Rounded.BarChart,
+            contentDescription = "Stream stats",
+            tint = if (visible) MaterialTheme.colorScheme.primary else Color.White,
+            modifier = Modifier.size(24.dp),
+        )
+    }
+}
+
+/** Refreshes once a second while it is open; nothing runs while it is closed. */
+@Composable
+internal fun PlayerScreenRuntime.DxStatsOverlay() {
+    val enabled by DxStreamStats.buttonEnabled.collectAsStateWithLifecycle()
+    val visible by DxStreamStats.visible.collectAsStateWithLifecycle()
+    var rows by remember { mutableStateOf<List<Pair<String, String>>>(emptyList()) }
+    val controller = playerController
+    LaunchedEffect(visible, enabled, controller) {
+        if (!visible || !enabled || controller == null) return@LaunchedEffect
+        while (true) {
+            rows = runCatching { controller.dxStreamStats() }.getOrDefault(emptyList())
+            delay(1_000)
+        }
+    }
+    if (!visible || !enabled) return
+    Box(modifier = Modifier.fillMaxSize().padding(start = 16.dp, top = 72.dp), contentAlignment = Alignment.TopStart) {
+        Column(
+            modifier = Modifier
+                .background(Color.Black.copy(alpha = 0.72f), RoundedCornerShape(10.dp))
+                .padding(horizontal = 12.dp, vertical = 8.dp),
+        ) {
+            Text("Stream stats", color = Color.White, fontSize = 12.sp, modifier = Modifier.padding(bottom = 4.dp))
+            if (rows.isEmpty()) {
+                Text("No stats from this player", color = Color.White.copy(alpha = 0.7f), fontSize = 11.sp)
+            }
+            rows.forEach { (label, value) ->
+                Row {
+                    Text("$label  ", color = Color.White.copy(alpha = 0.6f), fontSize = 11.sp, fontFamily = FontFamily.Monospace)
+                    Text(value, color = Color.White, fontSize = 11.sp, fontFamily = FontFamily.Monospace)
+                }
+            }
+        }
+    }
+}
