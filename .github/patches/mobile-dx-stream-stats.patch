+package com.nuvio.app.features.settings
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.getValue
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import com.nuvio.app.features.player.DxStreamStats
+
+/** dx.bi port: stream stats overlay button in the player. */
+@Composable
+internal fun DxStatsSettingsSection(isTablet: Boolean) {
+    LaunchedEffect(Unit) { DxStreamStats.ensureLoaded() }
+    val enabled by DxStreamStats.buttonEnabled.collectAsStateWithLifecycle()
+    SettingsSection(title = "Stream stats", isTablet = isTablet) {
+        SettingsGroup(isTablet = isTablet) {
+            SettingsSwitchRow(
+                title = "Stream stats button",
+                description = "Adds a button to the player that shows resolution, codecs, HDR, bitrate, buffer, dropped frames and download speed, refreshed every second.",
+                checked = enabled,
+                isTablet = isTablet,
+                onCheckedChange = DxStreamStats::setButtonEnabled,
+            )
+        }
+    }
+}
