+package com.nuvio.app.features.player
+
+import android.content.Context
+import android.os.SystemClock
+import androidx.annotation.OptIn
+import androidx.media3.common.C
+import androidx.media3.common.util.UnstableApi
+import androidx.media3.exoplayer.ExoPlayer
+import androidx.media3.exoplayer.upstream.DefaultBandwidthMeter
+import java.util.Locale
+import java.util.concurrent.atomic.AtomicLong
+
+internal fun dxFormatRate(bytesPerSecond: Double): String = when {
+    bytesPerSecond >= 1_048_576.0 -> String.format(Locale.US, "%.1f MB/s", bytesPerSecond / 1_048_576.0)
+    bytesPerSecond >= 1024.0 -> String.format(Locale.US, "%.0f KB/s", bytesPerSecond / 1024.0)
+    else -> String.format(Locale.US, "%.0f B/s", bytesPerSecond)
+}
+
+internal fun dxFormatBitrate(bitsPerSecond: Long): String = when {
+    bitsPerSecond >= 1_000_000L -> String.format(Locale.US, "%.1f Mbps", bitsPerSecond / 1_000_000.0)
+    bitsPerSecond > 0L -> String.format(Locale.US, "%d kbps", bitsPerSecond / 1000L)
+    else -> "unknown"
+}
+
+/**
+ * dx.bi stream stats for the ExoPlayer engine: the video and audio Format, the video DecoderCounters, the buffered
+ * position, the bytes the player's own network counter saw in the last second and the shared BandwidthMeter estimate.
+ */
+@OptIn(UnstableApi::class)
+internal class DxExoStats(
+    private val context: Context,
+    private val player: ExoPlayer,
+    private val networkBytes: AtomicLong,
+) {
+    private var lastBytes = networkBytes.get()
+    private var lastAt = SystemClock.elapsedRealtime()
+    private var lastSpeed = 0.0
+
+    fun snapshot(): List<Pair<String, String>> {
+        val now = SystemClock.elapsedRealtime()
+        val bytes = networkBytes.get()
+        val elapsed = now - lastAt
+        if (elapsed >= 700L) {
+            lastSpeed = ((bytes - lastBytes).coerceAtLeast(0L)) * 1000.0 / elapsed
+            lastBytes = bytes
+            lastAt = now
+        }
+        val rows = ArrayList<Pair<String, String>>()
+        val video = player.videoFormat
+        if (video != null) {
+            val fps = video.frameRate.takeIf { it > 0f }?.let { String.format(Locale.US, " @ %.2f fps", it) }.orEmpty()
+            rows += "Resolution" to "${video.width}x${video.height}$fps"
+            val codec = CustomDefaultTrackNameProvider.formatNameFromMime(video.sampleMimeType) ?: "video"
+            rows += "Video codec" to listOfNotNull(codec, video.codecs?.takeIf { it.isNotBlank() }).joinToString(" ")
+            val hdr = video.hdrFormats()
+            rows += "HDR" to if (hdr.isEmpty()) "SDR" else hdr.joinToString(" + ")
+            val bitrate = video.averageBitrate.takeIf { it > 0 } ?: video.bitrate
+            rows += "Video bitrate" to dxFormatBitrate(bitrate.toLong().coerceAtLeast(0L))
+        } else {
+            rows += "Resolution" to "waiting for video"
+        }
+        val audio = player.audioFormat
+        if (audio != null) {
+            val codec = CustomDefaultTrackNameProvider.formatNameFromMime(audio.sampleMimeType) ?: "audio"
+            val channels = audio.channelCount.takeIf { it > 0 }?.let { " ${it}ch" }.orEmpty()
+            val rate = audio.sampleRate.takeIf { it > 0 }?.let { " ${it / 1000} kHz" }.orEmpty()
+            rows += "Audio" to codec + channels + rate
+        }
+        val bufferedMs = (player.bufferedPosition - player.currentPosition).coerceAtLeast(0L)
+        rows += "Buffer" to String.format(Locale.US, "%.1f s", bufferedMs / 1000.0)
+        val counters = player.videoDecoderCounters
+        if (counters != null) {
+            counters.ensureUpdated()
+            val dropped = counters.droppedBufferCount + counters.skippedOutputBufferCount
+            rows += "Dropped frames" to "$dropped of ${counters.renderedOutputBufferCount + dropped}"
+        }
+        val estimate = runCatching { DefaultBandwidthMeter.getSingletonInstance(context).bitrateEstimate }.getOrDefault(C.LENGTH_UNSET.toLong())
+        val estimateText = if (estimate > 0L) " (est. ${dxFormatBitrate(estimate)})" else ""
+        rows += "Download" to dxFormatRate(lastSpeed) + estimateText
+        return rows
+    }
+}
+
+/** The same table from libmpv properties; each property may be missing on some builds. */
+internal fun dxMpvStats(property: (String) -> String?): List<Pair<String, String>> {
+    val rows = ArrayList<Pair<String, String>>()
+    val width = property("video-params/w")?.toIntOrNull()
+    val height = property("video-params/h")?.toIntOrNull()
+    val fps = property("estimated-vf-fps")?.toDoubleOrNull() ?: property("container-fps")?.toDoubleOrNull()
+    if (width != null && height != null) {
+        rows += "Resolution" to "${width}x$height" + (fps?.let { String.format(Locale.US, " @ %.2f fps", it) } ?: "")
+    } else {
+        rows += "Resolution" to "waiting for video"
+    }
+    property("current-tracks/video/codec")?.let { codec ->
+        val decoder = property("hwdec-current")?.takeIf { it.isNotBlank() && it != "no" }
+        rows += "Video codec" to codec.uppercase() + (decoder?.let { " ($it)" } ?: " (software)")
+    }
+    val hdr = buildList {
+        if (!property("current-tracks/video/dolby-vision-profile").isNullOrBlank()) add("DV")
+        when (property("video-params/gamma")) {
+            "pq" -> add("HDR10")
+            "hlg" -> add("HLG")
+        }
+    }
+    rows += "HDR" to if (hdr.isEmpty()) "SDR" else hdr.joinToString(" + ")
+    property("video-bitrate")?.toDoubleOrNull()?.let { rows += "Video bitrate" to dxFormatBitrate(it.toLong()) }
+    property("current-tracks/audio/codec")?.let { codec ->
+        val channels = property("audio-params/channel-count")?.toIntOrNull()?.let { " ${it}ch" }.orEmpty()
+        rows += "Audio" to codec.uppercase() + channels
+    }
+    property("demuxer-cache-duration")?.toDoubleOrNull()?.let {
+        rows += "Buffer" to String.format(Locale.US, "%.1f s", it)
+    }
+    val dropped = (property("frame-drop-count")?.toLongOrNull() ?: 0L) + (property("decoder-frame-drop-count")?.toLongOrNull() ?: 0L)
+    rows += "Dropped frames" to dropped.toString()
+    property("cache-speed")?.toDoubleOrNull()?.let { rows += "Download" to dxFormatRate(it) }
+    return rows
+}
