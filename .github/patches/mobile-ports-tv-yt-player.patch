+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonArray
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+import kotlinx.serialization.json.contentOrNull
+import kotlinx.serialization.json.doubleOrNull
+
+/**
+ * Options that only make sense for a YouTube video in the app's own player: SponsorBlock, loop,
+ * autoplay next, Up next, subscribe, like and Watch later. The player shows them only when the
+ * video was opened from the YouTube tab, so normal videos never see them.
+ */
+object YouTubePlayerPrefs {
+    val sponsorSkip = ForkBoolPref("settings/youtube_player_sponsorblock", true)
+    val loop = ForkBoolPref("settings/youtube_player_loop", false)
+    val autoplayNext = ForkBoolPref("settings/youtube_player_autoplay_next", true)
+}
+
+/** Set by the app shell: opens another YouTube video in the player. */
+object YouTubePlayerHooks {
+    var playVideo: ((YtItem) -> Unit)? = null
+}
+
+private data class SponsorSegment(val startMs: Long, val endMs: Long, val category: String)
+
+private object YouTubeSponsorBlock {
+    private val json = Json { ignoreUnknownKeys = true; isLenient = true }
+    private val cache = mutableMapOf<String, List<SponsorSegment>>()
+
+    suspend fun segments(videoId: String): List<SponsorSegment> {
+        cache[videoId]?.let { return it }
+        val categories = "%5B%22sponsor%22%2C%22selfpromo%22%2C%22interaction%22%2C%22intro%22%2C%22outro%22%5D"
+        val result = runCatching {
+            val response = httpRequestRaw(
+                method = "GET",
+                url = "https://sponsor.ajay.app/api/skipSegments?videoID=$videoId&categories=$categories",
+                headers = mapOf("Accept" to "application/json"),
+                body = "",
+                maxResponseBodyBytes = 1_000_000,
+            )
+            if (response.status !in 200..299) return@runCatching emptyList<SponsorSegment>()
+            (json.parseToJsonElement(response.body) as? JsonArray).orEmpty().mapNotNull { element ->
+                val obj = element as? JsonObject ?: return@mapNotNull null
+                val pair = obj["segment"] as? JsonArray ?: return@mapNotNull null
+                val start = (pair.getOrNull(0) as? JsonPrimitive)?.doubleOrNull ?: return@mapNotNull null
+                val end = (pair.getOrNull(1) as? JsonPrimitive)?.doubleOrNull ?: return@mapNotNull null
+                SponsorSegment(
+                    startMs = (start * 1000).toLong(),
+                    endMs = (end * 1000).toLong(),
+                    category = (obj["category"] as? JsonPrimitive)?.contentOrNull.orEmpty(),
+                )
+            }.filter { it.endMs > it.startMs }
+        }.getOrDefault(emptyList())
+        cache[videoId] = result
+        return result
+    }
+}
+
+@Composable
+fun YouTubePlayerOptions(
+    videoId: String,
+    title: String,
+    channel: String,
+    thumb: String,
+    positionMs: Long,
+    isEnded: Boolean,
+    controlsVisible: Boolean,
+    controller: PlayerEngineController?,
+    modifier: Modifier = Modifier,
+) {
+    val sponsorSkip by YouTubePlayerPrefs.sponsorSkip.value.collectAsState()
+    val loop by YouTubePlayerPrefs.loop.value.collectAsState()
+    val autoplayNext by YouTubePlayerPrefs.autoplayNext.value.collectAsState()
+    val saved by YouTubeRepository.saved.collectAsState()
+    var showSheet by remember { mutableStateOf(false) }
+    var segments by remember(videoId) { mutableStateOf<List<SponsorSegment>>(emptyList()) }
+    var owner by remember(videoId) { mutableStateOf<Pair<String, String>?>(null) }
+    var related by remember(videoId) { mutableStateOf<List<YtItem>>(emptyList()) }
+    var liked by remember(videoId) { mutableStateOf(false) }
+    var skipped by remember(videoId) { mutableStateOf(emptySet<Long>()) }
+    var handledEnd by remember(videoId) { mutableStateOf(false) }
+    val scope = remember { kotlinx.coroutines.CoroutineScope(kotlinx.coroutines.SupervisorJob() + kotlinx.coroutines.Dispatchers.Default) }
+
+    LaunchedEffect(videoId) {
+        YouTubePlayerPrefs.sponsorSkip.ensureLoaded()
+        YouTubePlayerPrefs.loop.ensureLoaded()
+        YouTubePlayerPrefs.autoplayNext.ensureLoaded()
+        YouTubeRepository.ensureLoaded()
+        segments = YouTubeSponsorBlock.segments(videoId)
+        owner = YouTubeRepository.ownerOf(videoId)
+        related = runCatching { YtInnertube.related(videoId) }.getOrDefault(emptyList())
+    }
+
+    // SponsorBlock: jump over a marked segment once when playback reaches its start.
+    LaunchedEffect(positionMs, sponsorSkip, segments) {
+        if (!sponsorSkip || controller == null) return@LaunchedEffect
+        val hit = segments.firstOrNull { positionMs >= it.startMs && positionMs < it.endMs - 500 && it.startMs !in skipped }
+            ?: return@LaunchedEffect
+        skipped = skipped + hit.startMs
+        controller.seekTo(hit.endMs)
+    }
+
+    // End of video: loop it, or move on to the first suggested video.
+    LaunchedEffect(isEnded) {
+        if (!isEnded) {
+            handledEnd = false
+            return@LaunchedEffect
+        }
+        if (handledEnd) return@LaunchedEffect
+        handledEnd = true
+        if (loop && controller != null) {
+            skipped = emptySet()
+            controller.seekTo(0L)
+            controller.play()
+        } else if (autoplayNext) {
+            val hideShorts = YouTubePrefs.hideShorts.current()
+            related.firstOrNull { it.kind == YtKind.VIDEO && (!hideShorts || !it.isShort) }
+                ?.let { YouTubePlayerHooks.playVideo?.invoke(it) }
+        }
+    }
+
+    Box(modifier = modifier) {
+        if (controlsVisible) {
+            Text(
+                text = "YouTube",
+                color = Color.White,
+                style = MaterialTheme.typography.labelLarge,
+                modifier = Modifier
+                    .background(Color(0x99000000), RoundedCornerShape(50))
+                    .clickable { showSheet = true }
+                    .padding(horizontal = 14.dp, vertical = 8.dp),
+            )
+        }
+    }
+
+    if (showSheet) {
+        val channelId = owner?.first.orEmpty()
+        val channelName = owner?.second?.ifBlank { channel } ?: channel
+        val subscribed = channelId.isNotBlank() && saved.subscriptions.any { it.id == channelId }
+        val watchLater = saved.watchLater.any { it.id == videoId }
+        val item = remember(videoId, title, channelName, thumb) {
+            YtItem(id = videoId, title = title, channel = channelName, channelId = channelId, thumb = thumb)
+        }
+        Dialog(onDismissRequest = { showSheet = false }) {
+            Column(
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .heightIn(max = 480.dp)
+                    .background(Color(0xFF1B1B1F), RoundedCornerShape(16.dp))
+                    .padding(16.dp)
+                    .verticalScroll(rememberScrollState()),
+                verticalArrangement = Arrangement.spacedBy(4.dp),
+            ) {
+                Text(title, color = Color.White, style = MaterialTheme.typography.titleMedium, maxLines = 2, overflow = TextOverflow.Ellipsis)
+                if (channelName.isNotBlank()) {
+                    Text(channelName, color = Color(0xFFB0B0B0), style = MaterialTheme.typography.bodySmall)
+                }
+                Row(horizontalArrangement = Arrangement.spacedBy(8.dp), modifier = Modifier.padding(top = 8.dp)) {
+                    if (channelId.isNotBlank()) {
+                        TextButton(onClick = { YouTubeRepository.toggleSubscription(channelId, channelName) }) {
+                            Text(if (subscribed) "Subscribed" else "Subscribe")
+                        }
+                    }
+                    TextButton(onClick = {
+                        val target = !liked
+                        liked = target
+                        scope.launch {
+                            if (!runCatching { YtInnertube.like(videoId, target) }.getOrDefault(false)) liked = !target
+                        }
+                    }) { Text(if (liked) "Liked" else "Like") }
+                    TextButton(onClick = { YouTubeRepository.toggleWatchLater(item) }) {
+                        Text(if (watchLater) "Saved" else "Watch later")
+                    }
+                }
+                OptionSwitch("Skip sponsors", "SponsorBlock segments", sponsorSkip) { YouTubePlayerPrefs.sponsorSkip.set(it) }
+                OptionSwitch("Loop video", null, loop) { YouTubePlayerPrefs.loop.set(it) }
+                OptionSwitch("Autoplay next", "Plays the first Up next video", autoplayNext) { YouTubePlayerPrefs.autoplayNext.set(it) }
+                if (related.isNotEmpty()) {
+                    Text("Up next", color = Color.White, style = MaterialTheme.typography.titleSmall, modifier = Modifier.padding(top = 12.dp))
+                    related.take(12).forEach { next ->
+                        Column(
+                            modifier = Modifier
+                                .fillMaxWidth()
+                                .clickable {
+                                    showSheet = false
+                                    YouTubePlayerHooks.playVideo?.invoke(next)
+                                }
+                                .padding(vertical = 8.dp),
+                        ) {
+                            Text(next.title, color = Color.White, maxLines = 2, overflow = TextOverflow.Ellipsis, style = MaterialTheme.typography.bodyMedium)
+                            val meta = listOf(next.channel, next.duration).filter { it.isNotBlank() }.joinToString(" · ")
+                            if (meta.isNotEmpty()) Text(meta, color = Color(0xFFB0B0B0), style = MaterialTheme.typography.bodySmall)
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun OptionSwitch(label: String, detail: String?, checked: Boolean, onChange: (Boolean) -> Unit) {
+    Row(
+        modifier = Modifier.fillMaxWidth().padding(vertical = 4.dp),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        Column(modifier = Modifier.weight(1f)) {
+            Text(label, color = Color.White, style = MaterialTheme.typography.bodyLarge)
+            if (detail != null) Text(detail, color = Color(0xFFB0B0B0), style = MaterialTheme.typography.bodySmall)
+        }
+        Switch(checked = checked, onCheckedChange = onChange)
+    }
+}
