+package com.nuvio.app.core.sound
+
+import android.media.AudioAttributes
+import android.media.AudioFormat
+import android.media.AudioTrack
+import kotlin.math.PI
+import kotlin.math.exp
+import kotlin.math.min
+import kotlin.math.sin
+
+/** Synthesized PCM played through AudioTrack: no audio assets. Volume follows the system media volume. */
+internal actual object DxSoundPlatform {
+    private const val SAMPLE_RATE = 22050
+    private val lock = Any()
+    private var introTrack: AudioTrack? = null
+
+    private val introPcm: ShortArray by lazy { synthIntro() }
+    private val clickPcm: ShortArray by lazy { synthClick() }
+
+    actual fun playIntro() {
+        Thread {
+            runCatching {
+                val track = buildTrack(introPcm, AudioAttributes.USAGE_MEDIA)
+                synchronized(lock) {
+                    introTrack?.let { runCatching { it.stop(); it.release() } }
+                    introTrack = track
+                }
+                track.play()
+                Thread.sleep(introPcm.size * 1000L / SAMPLE_RATE + 200L)
+                synchronized(lock) {
+                    if (introTrack === track) introTrack = null
+                }
+                runCatching { track.stop() }
+                track.release()
+            }
+        }.start()
+    }
+
+    actual fun stopIntro() {
+        synchronized(lock) {
+            introTrack?.let { runCatching { it.stop(); it.release() } }
+            introTrack = null
+        }
+    }
+
+    actual fun playClick() {
+        Thread {
+            runCatching {
+                val track = buildTrack(clickPcm, AudioAttributes.USAGE_ASSISTANCE_SONIFICATION)
+                track.play()
+                Thread.sleep(clickPcm.size * 1000L / SAMPLE_RATE + 120L)
+                runCatching { track.stop() }
+                track.release()
+            }
+        }.start()
+    }
+
+    private fun buildTrack(pcm: ShortArray, usage: Int): AudioTrack {
+        val attributes = AudioAttributes.Builder()
+            .setUsage(usage)
+            .setContentType(AudioAttributes.CONTENT_TYPE_SONIFICATION)
+            .build()
+        val format = AudioFormat.Builder()
+            .setEncoding(AudioFormat.ENCODING_PCM_16BIT)
+            .setSampleRate(SAMPLE_RATE)
+            .setChannelMask(AudioFormat.CHANNEL_OUT_MONO)
+            .build()
+        val track = AudioTrack.Builder()
+            .setAudioAttributes(attributes)
+            .setAudioFormat(format)
+            .setBufferSizeInBytes(pcm.size * 2)
+            .setTransferMode(AudioTrack.MODE_STATIC)
+            .build()
+        track.write(pcm, 0, pcm.size)
+        return track
+    }
+
+    private fun synthClick(): ShortArray {
+        val n = SAMPLE_RATE * 45 / 1000
+        return ShortArray(n) { i ->
+            val t = i.toDouble() / SAMPLE_RATE
+            val envelope = exp(-t * 90.0) * min(1.0, t * 800.0)
+            val tone = sin(2 * PI * 1900.0 * t) * 0.7 + sin(2 * PI * 3800.0 * t) * 0.15
+            (tone * envelope * 0.22 * Short.MAX_VALUE).toInt().toShort()
+        }
+    }
+
+    /** About 2.4 s: low thump, then a rising soft chord swell that fades out. */
+    private fun synthIntro(): ShortArray {
+        val seconds = 2.4
+        val n = (SAMPLE_RATE * seconds).toInt()
+        val chord = doubleArrayOf(174.61, 220.0, 261.63, 349.23)
+        return ShortArray(n) { i ->
+            val t = i.toDouble() / SAMPLE_RATE
+            val thump = sin(2 * PI * (62.0 - 20.0 * t) * t) * exp(-t * 4.0) * 0.8
+            val swellIn = (t / 1.4).coerceIn(0.0, 1.0)
+            val fadeOut = ((seconds - t) / 0.9).coerceIn(0.0, 1.0)
+            val swell = swellIn * swellIn * fadeOut
+            var pad = 0.0
+            for (f in chord) {
+                val glide = f * (0.94 + 0.06 * swellIn)
+                pad += sin(2 * PI * glide * t) + 0.25 * sin(2 * PI * glide * 2.0 * t)
+            }
+            pad = pad / chord.size * swell * 0.55
+            val sparkleT = t - 1.35
+            val sparkle = if (sparkleT > 0.0) sin(2 * PI * 1396.9 * t) * exp(-sparkleT * 5.0) * 0.18 else 0.0
+            val start = min(1.0, t * 200.0)
+            ((thump + pad + sparkle) * start * 0.6 * Short.MAX_VALUE).toInt()
+                .coerceIn(-32768, 32767).toShort()
+        }
+    }
+}
