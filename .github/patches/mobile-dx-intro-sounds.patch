+package com.nuvio.app.features.settings
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.getValue
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import com.nuvio.app.core.sound.DxSounds
+
+/** dx.bi port: startup intro and soft interface sounds. Both off by default. */
+@Composable
+internal fun DxSoundsSettingsSection(isTablet: Boolean) {
+    LaunchedEffect(Unit) { DxSounds.ensureLoaded() }
+    val intro by DxSounds.introEnabled.collectAsStateWithLifecycle()
+    val sounds by DxSounds.uiSoundsEnabled.collectAsStateWithLifecycle()
+    SettingsSection(title = "Intro and sounds", isTablet = isTablet) {
+        SettingsGroup(isTablet = isTablet) {
+            SettingsSwitchRow(
+                title = "Startup intro",
+                description = "Plays a short cinematic intro with a sound when the app opens, once per launch. Tap to skip. It covers the first 2.6 seconds, so the app opens a little later. Sound follows the media volume.",
+                checked = intro,
+                isTablet = isTablet,
+                onCheckedChange = { enabled ->
+                    DxSounds.setIntroEnabled(enabled)
+                    if (enabled) DxSounds.previewIntroSound()
+                },
+            )
+            SettingsGroupDivider(isTablet = isTablet)
+            SettingsSwitchRow(
+                title = "Interface sounds",
+                description = "A soft tick when you tap a tab in the bottom bar. Follows the media volume.",
+                checked = sounds,
+                isTablet = isTablet,
+                onCheckedChange = DxSounds::setUiSoundsEnabled,
+            )
+        }
+    }
+}
