+/// persistentSystemOverlays is iOS 16+. On iOS 15 the player's own
+/// prefersHomeIndicatorAutoHidden / prefersStatusBarHidden still keep system
+/// chrome out of the way, so the modifier degrades to a no-op there.
+private struct NuvioPersistentOverlaysModifier: ViewModifier {
+    let isHidden: Bool
+
+    func body(content: Content) -> some View {
+        if #available(iOS 16.0, *) {
+            content.persistentSystemOverlays(isHidden ? .hidden : .automatic)
+        } else {
+            content
+        }
+    }
+}
