 }
+
+extension MetalLayer {
+    /// HDR-capable layer on iOS 16+, plain layer below.
+    static func forCurrentOS() -> MetalLayer {
+        if #available(iOS 16.0, *) {
+            return MetalLayerHDR()
+        }
+        return MetalLayer()
+    }
+}
