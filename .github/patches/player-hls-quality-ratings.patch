+package com.nuvio.app.core.logging
+
+import co.touchlab.kermit.Logger
+
+/** Fork shim for the Enhanced in-app logger: forwards to Kermit. */
+internal object InAppLogger {
+    fun debug(tag: String, message: String) = Logger.withTag(tag).d { message }
+    fun info(tag: String, message: String) = Logger.withTag(tag).i { message }
+    fun warn(tag: String, message: String) = Logger.withTag(tag).w { message }
+    fun redactUrl(url: String?): String = url?.substringBefore('?').orEmpty()
+    fun headerKeys(headers: Map<String, String>): String = headers.keys.sorted().joinToString(",")
+    fun throwableSummary(error: Throwable): String = "${error::class.simpleName}: ${error.message}"
+}
