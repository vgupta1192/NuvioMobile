+/** Compact root header: back, small title, Settings and the active profile's avatar. */
+@Composable
+private fun YouTubeRootHeader(title: String, onBack: () -> Unit, onSettings: () -> Unit, onAccount: () -> Unit) {
+    val tokens = MaterialTheme.nuvio
+    val account by YouTubeAccount.state.collectAsState()
+    LaunchedEffect(account.signedIn, account.profiles.isEmpty()) {
+        if (account.signedIn && account.profiles.isEmpty()) runCatching { YouTubeAccount.refreshProfiles() }
+    }
+    val active = account.profiles.firstOrNull { it.selected } ?: account.profiles.firstOrNull()
+    val avatar = active?.avatar.orEmpty()
+    Row(
+        modifier = Modifier
+            .fillMaxWidth()
+            .statusBarsPadding()
+            .padding(horizontal = tokens.spacing.screenHorizontal, vertical = 4.dp),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        IconButton(onClick = onBack) {
+            Icon(Icons.AutoMirrored.Rounded.ArrowBack, contentDescription = "Back", tint = tokens.colors.textPrimary)
+        }
+        Text(
+            text = title,
+            style = MaterialTheme.typography.titleLarge,
+            fontWeight = FontWeight.SemiBold,
+            maxLines = 1,
+            modifier = Modifier.weight(1f),
+        )
+        TextButton(onClick = onSettings) { Text("Settings", maxLines = 1) }
+        if (account.signedIn) {
+            Box(
+                modifier = Modifier
+                    .padding(start = 4.dp)
+                    .size(34.dp)
+                    .clip(CircleShape)
+                    .background(MaterialTheme.colorScheme.primary)
+                    .clickable(onClick = onAccount),
+                contentAlignment = Alignment.Center,
+            ) {
+                if (avatar.isNotBlank()) {
+                    AsyncImage(
+                        model = if (avatar.startsWith("//")) "https:$avatar" else avatar,
+                        contentDescription = "Switch profile",
+                        contentScale = ContentScale.Crop,
+                        modifier = Modifier.fillMaxSize(),
+                    )
+                } else {
+                    Text(
+                        text = (active?.name ?: account.label).ifBlank { "?" }.take(1).uppercase(),
+                        color = MaterialTheme.colorScheme.onPrimary,
+                        style = MaterialTheme.typography.titleSmall,
+                    )
+                }
+            }
+        }
+    }
+}
