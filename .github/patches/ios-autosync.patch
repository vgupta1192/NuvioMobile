@@ -0,0 +1,361 @@
+package com.nuvio.app.features.autosync
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.DisposableEffect
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.rememberUpdatedState
+import co.touchlab.kermit.Logger
+import com.nuvio.app.features.player.GeneratedSubtitles
+import com.nuvio.app.features.player.PlayerEngineController
+import com.nuvio.app.features.player.PlayerSubtitleCueParser
+import com.nuvio.app.features.player.PlayerSystemControlSource
+import com.nuvio.app.features.player.SyncedSubtitles
+import com.nuvio.app.features.player.YouTubeCaptions
+import com.nuvio.app.features.streams.StreamSubtitle
+import kotlinx.cinterop.BetaInteropApi
+import kotlinx.cinterop.ExperimentalForeignApi
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import platform.Foundation.NSDate
+import platform.Foundation.NSFileManager
+import platform.Foundation.NSString
+import platform.Foundation.NSTemporaryDirectory
+import platform.Foundation.NSUTF8StringEncoding
+import platform.Foundation.create
+import platform.Foundation.timeIntervalSince1970
+import platform.Foundation.writeToFile
+
+private const val TAG = "AutoSyncLibmpv"
+
+/** File name prefix of the retimed subtitle copies that the libmpv path loads. */
+internal const val LIBMPV_AUTOSYNC_FILE_PREFIX = "autosync_"
+
+@Composable
+internal fun rememberLibmpvAutoSyncCoordinator(
+    scope: CoroutineScope,
+    sourceUrl: String,
+    sourceHeaders: Map<String, String>,
+    externalSubtitles: List<StreamSubtitle>,
+    preferredSubtitleLanguage: String?,
+): LibmpvAutoSyncCoordinator {
+    val latestExternalSubtitles = rememberUpdatedState(externalSubtitles)
+    val latestPreferredLanguage = rememberUpdatedState(preferredSubtitleLanguage)
+    val coordinator = remember(sourceUrl, sourceHeaders, scope) {
+        LibmpvAutoSyncCoordinator(
+            scope = scope,
+            sourceUrl = sourceUrl,
+            sourceHeaders = sourceHeaders,
+            getSubtitleHeaders = { subtitleUrl ->
+                latestExternalSubtitles.value.firstOrNull { it.url == subtitleUrl }?.headers.orEmpty()
+            },
+            getPreferredLanguage = { latestPreferredLanguage.value },
+        )
+    }
+    DisposableEffect(coordinator) {
+        onDispose { coordinator.dispose() }
+    }
+    return coordinator
+}
+
+/**
+ * AutoSync for one libmpv source on iOS. The original subtitle shows right away; a confident
+ * result replaces it with a copy whose timestamps are rewritten. References come from addon
+ * subtitles only, because the container's subtitle index needs Media3 extractors.
+ */
+internal class LibmpvAutoSyncCoordinator(
+    private val scope: CoroutineScope,
+    private val sourceUrl: String,
+    private val sourceHeaders: Map<String, String>,
+    private val getSubtitleHeaders: (String) -> Map<String, String>,
+    private val getPreferredLanguage: () -> String?,
+) {
+    private var job: Job? = null
+    private var operationToken = 0L
+    private var candidates: List<AutoSyncSubtitleCandidate> = emptyList()
+    private var appliedListener: ((subtitleUrl: String, delayMs: Int) -> Unit)? = null
+
+    fun <T> wrap(
+        controller: T,
+        replaceExternalSubtitle: (replacedUrl: String, path: String) -> Unit,
+    ): PlayerEngineController where T : PlayerEngineController, T : PlayerSystemControlSource =
+        AutoSyncLibmpvEngineController(controller, this, replaceExternalSubtitle)
+
+    fun setCandidates(value: List<AutoSyncSubtitleCandidate>) {
+        candidates = value.distinctBy { it.url }
+    }
+
+    fun setAppliedListener(listener: ((subtitleUrl: String, delayMs: Int) -> Unit)?) {
+        appliedListener = listener
+    }
+
+    fun cancel() {
+        operationToken++
+        job?.cancel()
+        job = null
+    }
+
+    fun dispose() {
+        cancel()
+        appliedListener = null
+    }
+
+    /** A subtitle synced before for this title + stream keeps its saved timing. */
+    fun restoreSynced(
+        url: String,
+        base: PlayerEngineController,
+        replaceExternalSubtitle: (replacedUrl: String, path: String) -> Unit,
+    ): Boolean {
+        val saved = SyncedSubtitles.savedFor(url) ?: return false
+        cancel()
+        base.setSubtitleUri(url)
+        val path = writeSubtitleFile(
+            prefix = "$LIBMPV_AUTOSYNC_FILE_PREFIX${url.hashCode().toUInt().toString(16)}_",
+            text = saved.srt,
+            extension = "srt",
+        ) ?: return true
+        replaceExternalSubtitle(url, path)
+        base.setSubtitleDelayMs(0)
+        appliedListener?.invoke(url, 0)
+        AutoSyncSyncedSubtitle.mark(url)
+        return true
+    }
+
+    fun start(
+        url: String,
+        candidateScope: AutoSyncCandidateScope,
+        base: PlayerEngineController,
+        replaceExternalSubtitle: (replacedUrl: String, path: String) -> Unit,
+    ) {
+        cancel()
+        val token = operationToken
+        base.setSubtitleUri(url)
+        AutoSyncPreferencesRepository.ensureLoaded()
+        if (decideAutoSyncStart(AutoSyncPreferencesRepository.preferredSubtitleAutoSyncOnStart.value) ==
+            AutoSyncStartAction.ATTACH_ORIGINAL ||
+            !(sourceUrl.startsWith("https://", true) || sourceUrl.startsWith("http://", true))
+        ) {
+            return
+        }
+
+        val subtitleHeaders = getSubtitleHeaders(url)
+        val subtitleLanguage = candidates.firstOrNull { it.url == url }?.language
+            ?.takeIf { it.isNotBlank() } ?: getPreferredLanguage()
+
+        job = scope.launch {
+            try {
+                var outcome: AutoSyncAnalysisOutcome? = null
+                val resolved = AutomaticSubtitleSync.findTimelineRetime(
+                    sourceKey = sourceUrl,
+                    sourceHeaders = sourceHeaders,
+                    selectedSubtitleUrl = url,
+                    selectedSubtitleHeaders = subtitleHeaders,
+                    preferredLanguage = subtitleLanguage,
+                    alternativeSubtitles = candidateScope.alternativeCandidates(candidates),
+                    alternativeSubtitlesProvider = if (candidateScope.usesAlternativeProvider) {
+                        { candidates }
+                    } else null,
+                    onAnalysisOutcome = { outcome = it },
+                    allowLiveReference = false,
+                )
+                currentCoroutineContext().ensureActive()
+                if (token != operationToken) return@launch
+                if (resolved == null) {
+                    Logger.i(TAG) { "AutoSync found no timing for $url (outcome=$outcome)" }
+                    return@launch
+                }
+
+                val chosenUrl = resolved.subtitleUrl
+                val tolerance = AutoSyncPreferencesRepository.syncToleranceMs.value
+                val withinTolerance = tolerance > 0 && chosenUrl == url &&
+                    resolved.timeline.maxAlignmentShiftMs() <= tolerance
+                if (!withinTolerance) {
+                    val retimed = retimeSubtitle(chosenUrl, resolved, subtitleLanguage)
+                    currentCoroutineContext().ensureActive()
+                    if (token != operationToken) return@launch
+                    val path = retimed?.let { writeRetimedSubtitle(chosenUrl, it) }
+                    if (retimed == null || path == null) {
+                        Logger.w(TAG) { "AutoSync could not write a retimed subtitle for $chosenUrl" }
+                        return@launch
+                    }
+                    replaceExternalSubtitle(url, path)
+                    saveSynced(chosenUrl, retimed)
+                }
+                base.setSubtitleDelayMs(0)
+                appliedListener?.invoke(chosenUrl, 0)
+                AutoSyncSyncedSubtitle.mark(chosenUrl)
+            } catch (cancel: CancellationException) {
+                throw cancel
+            } catch (error: Exception) {
+                if (token != operationToken) return@launch
+                Logger.w(TAG, error) { "AutoSync failed for $url" }
+            }
+        }
+    }
+
+    private suspend fun retimeSubtitle(
+        subtitleUrl: String,
+        resolved: AutoSyncResolvedTimeline,
+        languageHint: String?,
+    ): String? {
+        val body = resolved.subtitleBody ?: AutomaticSubtitleSync.downloadSubtitleBody(
+            url = subtitleUrl,
+            headers = resolved.subtitleHeaders.ifEmpty { getSubtitleHeaders(subtitleUrl) },
+            languageHint = languageHint,
+        )
+        return withContext(autoSyncCpuDispatcher) {
+            AutoSyncSubtitleTextRetimer.retime(body, resolved.timeline)
+        }
+    }
+
+    private suspend fun writeRetimedSubtitle(subtitleUrl: String, retimed: String): String? {
+        val extension = when {
+            retimed.trimStart().startsWith("WEBVTT") -> "vtt"
+            retimed.contains("[Events]", ignoreCase = true) -> "ass"
+            else -> "srt"
+        }
+        return withContext(Dispatchers.Default) {
+            writeSubtitleFile(
+                prefix = "$LIBMPV_AUTOSYNC_FILE_PREFIX${subtitleUrl.hashCode().toUInt().toString(16)}_",
+                text = retimed,
+                extension = extension,
+            )
+        }
+    }
+
+    private fun saveSynced(subtitleUrl: String, retimed: String) {
+        runCatching {
+            val cues = PlayerSubtitleCueParser.parse(retimed, subtitleUrl)
+            if (cues.isEmpty()) return
+            val srt = buildString {
+                cues.forEachIndexed { index, cue ->
+                    append(index + 1).append('\n')
+                    append(srtTimestamp(cue.startTimeMs)).append(" --> ").append(srtTimestamp(cue.endTimeMs)).append('\n')
+                    append(cue.text.trim()).append("\n\n")
+                }
+            }
+            SyncedSubtitles.save(
+                url = subtitleUrl,
+                srt = srt,
+                method = "autosync",
+                nowMs = (NSDate().timeIntervalSince1970 * 1000.0).toLong(),
+            )
+        }.onFailure { Logger.w(TAG, it) { "Could not save synced subtitle" } }
+    }
+}
+
+private fun srtTimestamp(ms: Long): String {
+    val safe = ms.coerceAtLeast(0L)
+    val h = safe / 3_600_000L
+    val m = (safe % 3_600_000L) / 60_000L
+    val s = (safe % 60_000L) / 1_000L
+    val milli = safe % 1_000L
+    return "${h.toString().padStart(2, '0')}:${m.toString().padStart(2, '0')}:" +
+        "${s.toString().padStart(2, '0')},${milli.toString().padStart(3, '0')}"
+}
+
+/** Writes [text] as UTF-8 in the temp subtitles dir; older files with [prefix] are removed. */
+@OptIn(ExperimentalForeignApi::class, BetaInteropApi::class)
+private fun writeSubtitleFile(prefix: String, text: String, extension: String): String? {
+    val manager = NSFileManager.defaultManager
+    val dir = NSTemporaryDirectory().trimEnd('/') + "/subtitles"
+    manager.createDirectoryAtPath(dir, withIntermediateDirectories = true, attributes = null, error = null)
+    val name = "$prefix${text.hashCode().toUInt().toString(16)}.$extension"
+    val path = "$dir/$name"
+    (manager.contentsOfDirectoryAtPath(dir, error = null) as? List<*>)?.forEach { entry ->
+        val existing = entry as? String ?: return@forEach
+        if (existing.startsWith(prefix) && existing != name) {
+            manager.removeItemAtPath("$dir/$existing", error = null)
+        }
+    }
+    val ok = NSString.create(string = text).writeToFile(
+        path,
+        atomically = true,
+        encoding = NSUTF8StringEncoding,
+        error = null,
+    )
+    return if (ok) path else null
+}
+
+private class AutoSyncLibmpvEngineController<T>(
+    private val base: T,
+    private val coordinator: LibmpvAutoSyncCoordinator,
+    private val replaceExternalSubtitle: (replacedUrl: String, path: String) -> Unit,
+) : PlayerEngineController by base, PlayerSystemControlSource by base, AutoSyncPlayerController
+    where T : PlayerEngineController, T : PlayerSystemControlSource {
+
+    override val autoSyncRetryState: StateFlow<AutoSyncRetryUiState> =
+        MutableStateFlow(AutoSyncRetryUiState()).asStateFlow()
+
+    init {
+        SyncedSubtitles.restoreSavedHook = { url ->
+            coordinator.restoreSynced(url, base, replaceExternalSubtitle)
+            Unit
+        }
+    }
+
+    override fun retryWithAnotherReference() = Unit
+
+    override fun setAutoSyncSubtitleCandidates(candidates: List<AutoSyncSubtitleCandidate>) =
+        coordinator.setCandidates(candidates)
+
+    override fun setAutoSyncAppliedListener(
+        listener: ((subtitleUrl: String, delayMs: Int) -> Unit)?,
+    ) = coordinator.setAppliedListener(listener)
+
+    private fun passthrough(url: String): Boolean {
+        if (GeneratedSubtitles.isGenerated(url) || YouTubeCaptions.isCaptionUrl(url)) {
+            coordinator.cancel()
+            base.setSubtitleUri(url)
+            return true
+        }
+        return false
+    }
+
+    override fun setSubtitleUri(url: String) {
+        if (passthrough(url)) return
+        if (coordinator.restoreSynced(url, base, replaceExternalSubtitle)) return
+        coordinator.cancel()
+        base.setSubtitleUri(url)
+    }
+
+    override fun setSubtitleUriWithAutoSync(url: String) {
+        if (passthrough(url)) return
+        if (coordinator.restoreSynced(url, base, replaceExternalSubtitle)) return
+        coordinator.start(url, AutoSyncCandidateScope.STARTUP_SEARCH, base, replaceExternalSubtitle)
+    }
+
+    override fun setSubtitleUriWithSelectedAutoSync(url: String) {
+        if (passthrough(url)) return
+        if (coordinator.restoreSynced(url, base, replaceExternalSubtitle)) return
+        coordinator.start(url, AutoSyncCandidateScope.SELECTED_ONLY, base, replaceExternalSubtitle)
+    }
+
+    override fun selectSubtitleTrack(index: Int) {
+        coordinator.cancel()
+        base.selectSubtitleTrack(index)
+    }
+
+    override fun clearExternalSubtitle() {
+        coordinator.cancel()
+        base.clearExternalSubtitle()
+    }
+
+    override fun clearExternalSubtitleAndSelect(trackIndex: Int) {
+        coordinator.cancel()
+        base.clearExternalSubtitleAndSelect(trackIndex)
+    }
+
+    fun cancelForManualSubtitleDelay() {
+        coordinator.cancel()
+        AutoSyncSyncedSubtitle.clear()
+    }
+}
