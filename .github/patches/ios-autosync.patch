+    /// Loads the retimed file at `path` in place of the external track loaded from `replacedUrl`,
+    /// keeping that track's title and language, then drops the replaced and earlier autosync tracks.
+    func replaceExternalSubtitle(_ replacedUrl: String, _ path: String) {
+        guard mpv != nil else { return }
+        let count = getInt("track-list/count")
+        var replacedIds: [Int] = []
+        var title: String?
+        var lang: String?
+        var wasSelected = false
+        var staleIds: [Int] = []
+        for i in 0..<count {
+            guard (getString("track-list/\(i)/type") ?? "") == "sub", getFlag("track-list/\(i)/external") else { continue }
+            let id = getInt("track-list/\(i)/id")
+            let filename = getString("track-list/\(i)/external-filename") ?? ""
+            if filename == path { continue }
+            if filename == replacedUrl {
+                replacedIds.append(id)
+                title = title ?? getString("track-list/\(i)/title")
+                lang = lang ?? getString("track-list/\(i)/lang")
+                if getFlag("track-list/\(i)/selected") { wasSelected = true }
+            } else if filename.contains("/autosync_") {
+                staleIds.append(id)
+                if getFlag("track-list/\(i)/selected") { wasSelected = true }
+            }
+        }
+        var args: [String?] = [path, wasSelected || replacedIds.isEmpty ? "select" : "cached"]
+        if let title = ifNotBlank(title ?? "") {
+            args.append(title)
+            if let lang = ifNotBlank(lang ?? "") { args.append(lang) }
+        }
+        command("sub-add", args: args, checkForErrors: false)
+        for id in (replacedIds + staleIds) {
+            command("sub-remove", args: ["\(id)"], checkForErrors: false)
+        }
+    }
