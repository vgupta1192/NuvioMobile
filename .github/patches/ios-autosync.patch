+package com.nuvio.app.features.autosync
+
+import com.nuvio.app.features.addons.RawHttpResponse
+import com.nuvio.app.features.addons.httpRequestRaw
+import kotlinx.cinterop.BetaInteropApi
+import kotlinx.cinterop.ExperimentalForeignApi
+import kotlinx.cinterop.addressOf
+import kotlinx.cinterop.usePinned
+import kotlinx.coroutines.CoroutineScope
+import platform.Foundation.NSData
+import platform.Foundation.NSISOLatin1StringEncoding
+import platform.Foundation.NSProcessInfo
+import platform.Foundation.NSString
+import platform.Foundation.NSUTF16BigEndianStringEncoding
+import platform.Foundation.NSUTF16LittleEndianStringEncoding
+import platform.Foundation.NSWindowsCP1250StringEncoding
+import platform.Foundation.NSWindowsCP1251StringEncoding
+import platform.Foundation.NSWindowsCP1252StringEncoding
+import platform.Foundation.NSWindowsCP1253StringEncoding
+import platform.Foundation.NSWindowsCP1254StringEncoding
+import platform.Foundation.create
+import kotlin.math.abs
+import kotlin.math.pow
+import kotlin.math.roundToLong
+
+internal fun autoSyncElapsedMs(): Long =
+    (NSProcessInfo.processInfo.systemUptime * 1000.0).toLong()
+
+internal fun autoSyncFormat(value: Double, decimals: Int): String {
+    if (value.isNaN()) return "NaN"
+    if (value.isInfinite()) return if (value > 0) "Infinity" else "-Infinity"
+    val scale = 10.0.pow(decimals)
+    val scaled = (abs(value) * scale).roundToLong()
+    val whole = scaled / scale.toLong()
+    val fraction = (scaled % scale.toLong()).toString().padStart(decimals, '0')
+    val sign = if (value < 0 && scaled != 0L) "-" else ""
+    return if (decimals == 0) "$sign$whole" else "$sign$whole.$fraction"
+}
+
+/** Media3 track flag values that the shared reference ranking tests. */
+internal object AutoSyncTrackFlags {
+    const val SELECTION_FORCED = 2
+    const val ROLE_COMMENTARY = 8
+    const val ROLE_SUBTITLE = 128
+    const val ROLE_TRANSCRIBES_DIALOG = 4096
+    const val ROLE_DESCRIBES_VIDEO = 512
+    const val ROLE_DESCRIBES_MUSIC_AND_SOUND = 1024
+}
+
+/** AutoSync debug reports are Android-only; iOS keeps the same call sites without output. */
+internal object AutoSyncDebugLog {
+    val ENABLED: Boolean get() = false
+    val VERBOSE: Boolean get() = false
+
+    fun start(sourceKey: String, subtitleUrl: String) = Unit
+    fun section(title: () -> String) = Unit
+    fun info(message: () -> String) = Unit
+    fun warn(message: () -> String) = Unit
+    fun error(throwable: Throwable? = null, message: () -> String) = Unit
+    fun verbose(message: () -> String) = Unit
+    fun cue(prefix: String, index: Int, startMs: Long, endMs: Long, text: String) = Unit
+    fun timing(
+        label: String,
+        cues: List<com.nuvio.app.features.player.SubtitleSyncCue>,
+        estimatedEndStartsMs: Set<Long> = emptySet(),
+        sdh: Boolean = false,
+    ) = Unit
+
+    fun formatTimestamp(ms: Long): String {
+        val safe = ms.coerceAtLeast(0L)
+        val hours = safe / 3_600_000L
+        val minutes = (safe % 3_600_000L) / 60_000L
+        val seconds = (safe % 60_000L) / 1_000L
+        val millis = safe % 1_000L
+        return "${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}:" +
+            "${seconds.toString().padStart(2, '0')}.${millis.toString().padStart(3, '0')}"
+    }
+}
+
+/**
+ * The container's own subtitle index is read through Media3 extractors on Android and has no iOS
+ * equivalent, so iOS AutoSync references come from addon subtitles only.
+ */
+internal object EmbeddedSubtitleTimelineLoader {
+    fun prefetch(
+        scope: CoroutineScope,
+        sourceUrl: String,
+        sourceHeaders: Map<String, String> = emptyMap(),
+    ) = Unit
+
+    suspend fun load(
+        sourceUrl: String,
+        sourceHeaders: Map<String, String> = emptyMap(),
+    ): IndexedEmbeddedTimeline? = null
+}
+
+internal data class IndexedEmbeddedTimeline(
+    val tracks: List<ReferenceTrack>,
+    val source: String,
+    val bytesDownloaded: Long,
+    val rangeRequests: Int,
+    val loadMs: Long,
+    val skipLiveFallbackWait: Boolean = false,
+    val noSubtitleTracks: Boolean = false,
+)
+
+internal object AutoSyncSubtitleHttp {
+    private const val TRUNCATION_SUFFIX = "\n...[truncated]"
+
+    suspend fun get(
+        url: String,
+        headers: Map<String, String>,
+        maxResponseBodyBytes: Int,
+        languageHint: String? = null,
+    ): RawHttpResponse {
+        val sent = headers.filterKeys { !it.equals("Accept-Encoding", ignoreCase = true) }
+        val response = httpRequestRaw(
+            method = "GET",
+            url = url,
+            headers = sent,
+            body = "",
+            followRedirects = true,
+            maxResponseBodyBytes = maxResponseBodyBytes,
+        )
+        val truncated = response.body.endsWith(TRUNCATION_SUFFIX)
+        val decoded = SubtitleCharsetDetector.decode(response.bodyBytes, languageHint)
+        return response.copy(body = if (truncated) "$decoded$TRUNCATION_SUFFIX" else decoded)
+    }
+}
+
+/** Addon files often use legacy encodings without declaring a charset: pick one from the bytes. */
+internal object SubtitleCharsetDetector {
+    fun decode(bytes: ByteArray, languageHint: String? = null): String {
+        if (bytes.isEmpty()) return ""
+        if (bytes.size >= 3 && bytes[0] == 0xEF.toByte() && bytes[1] == 0xBB.toByte() && bytes[2] == 0xBF.toByte()) {
+            return bytes.decodeToString(startIndex = 3, throwOnInvalidSequence = false)
+        }
+        if (bytes.size >= 2 && bytes[0] == 0xFF.toByte() && bytes[1] == 0xFE.toByte()) {
+            decodeWith(bytes, NSUTF16LittleEndianStringEncoding)?.let { return it.removePrefix("﻿") }
+        }
+        if (bytes.size >= 2 && bytes[0] == 0xFE.toByte() && bytes[1] == 0xFF.toByte()) {
+            decodeWith(bytes, NSUTF16BigEndianStringEncoding)?.let { return it.removePrefix("﻿") }
+        }
+        runCatching { bytes.decodeToString(throwOnInvalidSequence = true) }.getOrNull()?.let { return it }
+        val base = languageHint?.trim()?.lowercase()?.substringBefore('-')?.substringBefore('_').orEmpty()
+        if (base == "he" || base == "iw") return decodeHebrew(bytes)
+        val encoding = when (base) {
+            "ru", "uk", "bg", "sr", "mk", "be", "kk" -> NSWindowsCP1251StringEncoding
+            "el" -> NSWindowsCP1253StringEncoding
+            "tr", "az" -> NSWindowsCP1254StringEncoding
+            "pl", "cs", "sk", "hu", "ro", "hr", "sl", "bs" -> NSWindowsCP1250StringEncoding
+            else -> NSWindowsCP1252StringEncoding
+        }
+        return decodeWith(bytes, encoding)
+            ?: decodeWith(bytes, NSISOLatin1StringEncoding)
+            ?: bytes.decodeToString(throwOnInvalidSequence = false)
+    }
+
+    private fun decodeHebrew(bytes: ByteArray): String = buildString(bytes.size) {
+        for (b in bytes) {
+            val v = b.toInt() and 0xFF
+            append(
+                when {
+                    v in 0xE0..0xFA -> (0x05D0 + (v - 0xE0)).toChar()
+                    else -> v.toChar()
+                },
+            )
+        }
+    }
+
+    @OptIn(ExperimentalForeignApi::class, BetaInteropApi::class)
+    private fun decodeWith(bytes: ByteArray, encoding: ULong): String? {
+        val data = bytes.usePinned { pinned ->
+            NSData.create(bytes = pinned.addressOf(0), length = bytes.size.toULong())
+        }
+        return NSString.create(data = data, encoding = encoding)?.toString()
+    }
+}
