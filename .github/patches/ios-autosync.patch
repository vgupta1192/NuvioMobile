+
+private fun syncedSubtitleFileName(name: String): String = buildString {
+    name.encodeToByteArray().forEach { byte ->
+        val v = byte.toInt() and 0xFF
+        val c = v.toChar()
+        if (c in 'a'..'z' || c in 'A'..'Z' || c in '0'..'9' || c == '.' || c == '-') {
+            append(c)
+        } else {
+            append('_').append(v.toString(16).padStart(2, '0'))
+        }
+    }
+}.take(200)
+
+@OptIn(ExperimentalForeignApi::class, BetaInteropApi::class)
