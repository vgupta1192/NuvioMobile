+
+/** Toolbar ids of the YouTube-only buttons. They exist only while a YouTube video plays. */
+internal val YouTubeToolbarButtons = listOf(
+    ForkToolbarButton("yt_subscribe", "YouTube: Subscribe"),
+    ForkToolbarButton("yt_like", "YouTube: Like"),
+    ForkToolbarButton("yt_watch_later", "YouTube: Watch later"),
+    ForkToolbarButton("yt_loop", "YouTube: Loop video"),
+    ForkToolbarButton("yt_sponsor", "YouTube: Skip sponsors"),
+    ForkToolbarButton("yt_autoplay", "YouTube: Autoplay next"),
+    ForkToolbarButton("yt_upnext", "YouTube: Up next"),
+)
+
+/** YouTube-only player buttons; empty for every normal video. */
+@Composable
+internal fun youTubeControlActions(): List<PlayerControlAction> {
+    val session by YouTubePlayerSession.state.collectAsState()
+    val saved by YouTubeRepository.saved.collectAsState()
+    val loop by YouTubePlayerPrefs.loop.value.collectAsState()
+    val sponsor by YouTubePlayerPrefs.sponsorSkip.value.collectAsState()
+    val autoplay by YouTubePrefs.autoplay.value.collectAsState()
+    if (!session.active) return emptyList()
+    val on = MaterialTheme.colorScheme.primary
+    val subscribed = session.channelId.isNotBlank() && saved.subscriptions.any { it.id == session.channelId }
+    val watchLater = saved.watchLater.any { it.id == session.videoId }
+    return listOfNotNull(
+        if (session.channelId.isNotBlank()) {
+            PlayerControlAction(
+                if (subscribed) "Subscribed" else "Subscribe", { YouTubePlayerSession.toggleSubscribe() },
+                icon = if (subscribed) Icons.Rounded.HowToReg else Icons.Rounded.PersonAdd,
+                id = "yt_subscribe",
+                tint = if (subscribed) on else Color.White,
+            )
+        } else null,
+        PlayerControlAction(
+            if (session.liked) "Liked" else "Like", { YouTubePlayerSession.toggleLike() },
+            icon = Icons.Rounded.ThumbUp, id = "yt_like", tint = if (session.liked) on else Color.White,
+        ),
+        PlayerControlAction(
+            if (watchLater) "Saved to Watch later" else "Watch later", { YouTubePlayerSession.toggleWatchLater() },
+            icon = Icons.Rounded.WatchLater, id = "yt_watch_later", tint = if (watchLater) on else Color.White,
+        ),
+        PlayerControlAction(
+            if (loop) "Loop on" else "Loop video", { YouTubePlayerPrefs.loop.set(!loop) },
+            icon = if (loop) Icons.Rounded.RepeatOne else Icons.Rounded.Repeat, id = "yt_loop",
+            tint = if (loop) on else Color.White,
+        ),
+        PlayerControlAction(
+            if (sponsor) "Skip sponsors on" else "Skip sponsors", { YouTubePlayerPrefs.sponsorSkip.set(!sponsor) },
+            icon = Icons.Rounded.FastForward, id = "yt_sponsor", tint = if (sponsor) on else Color.White,
+        ),
+        PlayerControlAction(
+            if (autoplay) "Autoplay next on" else "Autoplay next", { YouTubePrefs.autoplay.set(!autoplay) },
+            icon = Icons.Rounded.PlayCircle, id = "yt_autoplay", tint = if (autoplay) on else Color.White,
+        ),
+        PlayerControlAction(
+            "Up next", { YouTubePlayerSession.update { it.copy(showUpNext = true) } },
+            icon = Icons.AutoMirrored.Rounded.PlaylistPlay, id = "yt_upnext",
+        ),
+    )
+}
