+package com.nuvio.app.features.youtube
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.collectAsState
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.remember
+import com.nuvio.app.core.storage.AppFileCache
+import com.nuvio.app.features.settings.ForkBoolPref
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+/** Text setting kept in the app file cache, same idea as [ForkBoolPref]. */
+class ForkStringPref(val path: String, private val default: String) {
+    private val _value = MutableStateFlow(default)
+    val value: StateFlow<String> = _value.asStateFlow()
+    private var loaded = false
+
+    fun ensureLoaded() {
+        if (loaded) return
+        loaded = true
+        val stored = runCatching { AppFileCache.read(path) }.getOrNull()
+        if (stored != null) _value.value = stored
+    }
+
+    fun current(): String {
+        ensureLoaded()
+        return _value.value
+    }
+
+    fun set(text: String) {
+        ensureLoaded()
+        _value.value = text
+        runCatching { AppFileCache.write(path, text) }
+    }
+}
+
+data class YtSponsorCategory(val id: String, val label: String)
+
+/** YouTube settings of the fork: SponsorBlock, feeds, tabs and hidden words (same groups as the 1T reference app). */
+object YouTubeSettings {
+    val sponsorNotice = ForkBoolPref("settings/youtube_sb_notice", true)
+    val sponsorAsk = ForkBoolPref("settings/youtube_sb_ask", false)
+    val sponsorCategories = ForkStringPref("settings/youtube_sb_categories", "sponsor,selfpromo,interaction")
+    val hideWatched = ForkBoolPref("settings/youtube_hide_watched", false)
+    val hideUpcoming = ForkBoolPref("settings/youtube_hide_upcoming", true)
+    val rememberLastTab = ForkBoolPref("settings/youtube_remember_tab", true)
+    val lastTab = ForkStringPref("settings/youtube_last_tab", "home")
+    val tabOrder = ForkStringPref("settings/youtube_tab_order", "home,subs,shorts,saved")
+    val hiddenTabs = ForkStringPref("settings/youtube_hidden_tabs", "")
+    val hiddenWords = ForkStringPref("settings/youtube_hidden_words", "")
+    val hiddenChannels = ForkStringPref("settings/youtube_hidden_channels", "")
+
+    val categories = listOf(
+        YtSponsorCategory("sponsor", "Sponsor"),
+        YtSponsorCategory("selfpromo", "Self-promotion"),
+        YtSponsorCategory("interaction", "Like and subscribe reminders"),
+        YtSponsorCategory("intro", "Intros"),
+        YtSponsorCategory("outro", "Outros and end cards"),
+        YtSponsorCategory("preview", "Previews and recaps"),
+        YtSponsorCategory("music_offtopic", "Non-music parts"),
+        YtSponsorCategory("filler", "Filler"),
+    )
+
+    val tabs = listOf("home" to "Home", "subs" to "Subscriptions", "shorts" to "Shorts", "saved" to "Saved")
+
+    private fun ids(text: String) = text.split(',').map { it.trim() }.filter { it.isNotEmpty() }
+    fun categoryIds(text: String): Set<String> = ids(text).toSet()
+    fun toggleCategory(id: String) {
+        val now = categoryIds(sponsorCategories.current())
+        sponsorCategories.set((if (id in now) now - id else now + id).joinToString(","))
+    }
+
+    /** Tab ids in the saved order; ids added later are appended, unknown ids dropped. */
+    fun orderedTabs(order: String): List<String> {
+        val known = tabs.map { it.first }
+        val saved = ids(order).filter { it in known }.distinct()
+        return saved + known.filter { it !in saved }
+    }
+
+    fun moveTab(id: String, delta: Int) {
+        val list = orderedTabs(tabOrder.current()).toMutableList()
+        val from = list.indexOf(id)
+        val to = from + delta
+        if (from < 0 || to !in list.indices) return
+        list.add(to, list.removeAt(from))
+        tabOrder.set(list.joinToString(","))
+    }
+
+    fun setTabVisible(id: String, visible: Boolean) {
+        val hidden = ids(hiddenTabs.current()).toMutableSet()
+        // At least one tab must stay on.
+        if (!visible && tabs.size - hidden.size <= 1) return
+        if (visible) hidden.remove(id) else hidden.add(id)
+        hiddenTabs.set(hidden.joinToString(","))
+    }
+
+    fun visibleTabs(order: String, hidden: String): List<String> {
+        val off = ids(hidden).toSet()
+        return orderedTabs(order).filter { it !in off }
+    }
+
+    fun lines(text: String): List<String> = text.split('\n').map { it.trim() }.filter { it.isNotEmpty() }
+
+    fun addLine(pref: ForkStringPref, value: String) {
+        val clean = value.trim().replace('\n', ' ')
+        if (clean.isEmpty()) return
+        val now = lines(pref.current())
+        if (now.any { it.equals(clean, ignoreCase = true) }) return
+        pref.set((now + clean).joinToString("\n"))
+    }
+
+    fun removeLine(pref: ForkStringPref, value: String) {
+        pref.set(lines(pref.current()).filterNot { it == value }.joinToString("\n"))
+    }
+
+    fun ensureLoaded() {
+        listOf(sponsorNotice, sponsorAsk, hideWatched, hideUpcoming, rememberLastTab).forEach { it.ensureLoaded() }
+        listOf(sponsorCategories, lastTab, tabOrder, hiddenTabs, hiddenWords, hiddenChannels).forEach { it.ensureLoaded() }
+        YouTubePrefs.tabEnabled.ensureLoaded()
+        YouTubePrefs.autoplay.ensureLoaded()
+        YouTubePrefs.hideShorts.ensureLoaded()
+        YouTubePlayerPrefs.sponsorSkip.ensureLoaded()
+    }
+}
+
+/** Decides which feed items stay visible: Shorts, watched, upcoming, hidden words and hidden channels. */
+@Composable
+internal fun rememberYtFilter(): (YtItem) -> Boolean {
+    ensureSettingsLoaded()
+    val hideShorts by YouTubePrefs.hideShorts.value.collectAsState()
+    val hideWatched by YouTubeSettings.hideWatched.value.collectAsState()
+    val hideUpcoming by YouTubeSettings.hideUpcoming.value.collectAsState()
+    val words by YouTubeSettings.hiddenWords.value.collectAsState()
+    val channels by YouTubeSettings.hiddenChannels.value.collectAsState()
+    val saved by YouTubeRepository.saved.collectAsState()
+    return remember(hideShorts, hideWatched, hideUpcoming, words, channels, saved.continueWatching) {
+        buildYtFilter(hideShorts, hideWatched, hideUpcoming, words, channels, saved.continueWatching)
+    }
+}
+
+/** Same filter as [rememberYtFilter], read once from the current settings (for code outside composition). */
+internal fun currentYtFilter(): (YtItem) -> Boolean {
+    YouTubeSettings.ensureLoaded()
+    return buildYtFilter(
+        YouTubePrefs.hideShorts.current(),
+        YouTubeSettings.hideWatched.current(),
+        YouTubeSettings.hideUpcoming.current(),
+        YouTubeSettings.hiddenWords.current(),
+        YouTubeSettings.hiddenChannels.current(),
+        YouTubeRepository.saved.value.continueWatching,
+    )
+}
+
+private fun buildYtFilter(
+    hideShorts: Boolean,
+    hideWatched: Boolean,
+    hideUpcoming: Boolean,
+    words: String,
+    channels: String,
+    progress: List<YtProgress>,
+): (YtItem) -> Boolean {
+    val wordList = YouTubeSettings.lines(words).map { it.lowercase() }
+    val channelList = YouTubeSettings.lines(channels).map { it.lowercase() }
+    val watched = progress
+        .filter { it.durationMs > 0 && it.positionMs * 10 >= it.durationMs * 9 }
+        .map { it.item.id }
+        .toSet()
+    return { item ->
+        val title = item.title.lowercase()
+        val channel = item.channel.lowercase()
+        (!hideShorts || !item.isShort) &&
+            (!hideWatched || item.id !in watched) &&
+            (!hideUpcoming || !isUpcoming(item)) &&
+            wordList.none { it in title } &&
+            channelList.none { it == channel }
+    }
+}
+
+@Composable
+private fun ensureSettingsLoaded() {
+    remember { YouTubeSettings.ensureLoaded(); 0 }
+}
+
+private fun isUpcoming(item: YtItem): Boolean {
+    if (item.kind != YtKind.VIDEO || item.isLive) return false
+    val meta = item.meta.lowercase()
+    return meta.startsWith("scheduled") || meta.startsWith("premieres") || meta.contains("waiting")
+}
