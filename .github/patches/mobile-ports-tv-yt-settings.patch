+@Composable
+private fun YouTubeListSection(title: String, hint: String, pref: ForkStringPref, isTablet: Boolean) {
+    val stored by pref.value.collectAsState()
+    var input by remember { mutableStateOf("") }
+    val lines = YouTubeSettings.lines(stored)
+    SettingsSection(title = title, isTablet = isTablet) {
+        SettingsGroup(isTablet = isTablet) {
+            Row(
+                modifier = Modifier.fillMaxWidth().padding(horizontal = 16.dp, vertical = 8.dp),
+                verticalAlignment = Alignment.CenterVertically,
+                horizontalArrangement = Arrangement.spacedBy(8.dp),
+            ) {
+                OutlinedTextField(
+                    value = input,
+                    onValueChange = { input = it },
+                    label = { Text(hint) },
+                    singleLine = true,
+                    modifier = Modifier.weight(1f),
+                )
+                TextButton(onClick = {
+                    YouTubeSettings.addLine(pref, input)
+                    input = ""
+                }) { Text("Add") }
+            }
+            lines.forEach { line ->
+                Row(
+                    modifier = Modifier.fillMaxWidth().padding(horizontal = 16.dp, vertical = 2.dp),
+                    verticalAlignment = Alignment.CenterVertically,
