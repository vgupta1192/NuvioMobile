+@Composable
+private fun YouTubeTabsSection(isTablet: Boolean) {
+    val order by YouTubeSettings.tabOrder.value.collectAsState()
+    val hidden by YouTubeSettings.hiddenTabs.value.collectAsState()
+    val ordered = YouTubeSettings.orderedTabs(order)
+    val off = hidden.split(',').map { it.trim() }.toSet()
+    SettingsSection(title = "Tabs", isTablet = isTablet) {
+        SettingsGroup(isTablet = isTablet) {
+            ordered.forEachIndexed { index, id ->
+                if (index > 0) SettingsGroupDivider(isTablet = isTablet)
+                Row(
+                    modifier = Modifier.fillMaxWidth().padding(horizontal = 16.dp, vertical = 4.dp),
+                    verticalAlignment = Alignment.CenterVertically,
+                ) {
+                    Text(
+                        text = YouTubeSettings.tabs.first { it.first == id }.second,
+                        color = MaterialTheme.colorScheme.onSurface,
+                        style = MaterialTheme.typography.bodyLarge,
+                        modifier = Modifier.weight(1f),
+                    )
+                    IconButton(onClick = { YouTubeSettings.moveTab(id, -1) }, enabled = index > 0) {
+                        Icon(Icons.Rounded.KeyboardArrowUp, contentDescription = "Move up")
+                    }
+                    IconButton(onClick = { YouTubeSettings.moveTab(id, 1) }, enabled = index < ordered.lastIndex) {
+                        Icon(Icons.Rounded.KeyboardArrowDown, contentDescription = "Move down")
+                    }
+                    Switch(checked = id !in off, onCheckedChange = { YouTubeSettings.setTabVisible(id, it) })
+                }
+            }
+        }
+    }
+}
