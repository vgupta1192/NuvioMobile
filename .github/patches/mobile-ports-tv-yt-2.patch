+package com.nuvio.app.features.youtube
+
+import com.nuvio.app.core.storage.AppFileCache
+import com.nuvio.app.features.addons.httpRequestRaw
+import com.nuvio.app.features.watchprogress.WatchProgressClock
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.update
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.contentOrNull
+import kotlinx.serialization.json.put
+import kotlin.random.Random
+
+/** What the sign-in UI shows: signed in (with a label), a pending device code, or an error. */
+data class YtAccountState(
+    val signedIn: Boolean = false,
+    val label: String = "",
+    val busy: Boolean = false,
+    val userCode: String = "",
+    val verificationUrl: String = "",
+    val error: String? = null,
+)
+
+@Serializable
+private data class StoredAccount(
+    val refreshToken: String = "",
+    val accessToken: String = "",
+    val expiresAtMs: Long = 0L,
+    val label: String = "",
+    val deviceId: String = "",
+)
+
+/**
+ * Google sign-in for the YouTube tab: the OAuth2 device-code flow of the YouTube-on-TV client.
+ * The user types a short code at youtube.com/activate; this object polls until Google hands out tokens,
+ * keeps them in the app file cache (this device only, never synced) and refreshes the access token on demand.
+ */
+object YouTubeAccount {
+    private const val CLIENT_ID = "861556708454-d6dlm3lh05idd8npek18k6be8ba3oc68.apps.googleusercontent.com"
+    private const val CLIENT_SECRET = "SboVhoG9s0rNafixCSGGKXAT"
+    private const val SCOPE = "https://www.googleapis.com/auth/youtube-paid-content"
+    private const val DEVICE_CODE_URL = "https://www.youtube.com/o/oauth2/device/code"
+    private const val TOKEN_URL = "https://www.youtube.com/o/oauth2/token"
+    private const val REVOKE_URL = "https://oauth2.googleapis.com/revoke"
+    private const val DEFAULT_ACTIVATE_URL = "https://www.youtube.com/activate"
+    private const val STORE_PATH = "youtube/account.json"
+
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.Default)
+    private val json = Json { ignoreUnknownKeys = true; encodeDefaults = true; isLenient = true }
+    private val refreshMutex = Mutex()
+
+    private val _state = MutableStateFlow(YtAccountState())
+    val state: StateFlow<YtAccountState> = _state.asStateFlow()
+    private var stored = StoredAccount()
+    private var loaded = false
+    private var signInJob: Job? = null
+
+    fun ensureLoaded() {
+        if (loaded) return
+        loaded = true
+        val raw = runCatching { AppFileCache.read(STORE_PATH) }.getOrNull() ?: return
+        val account = runCatching { json.decodeFromString(StoredAccount.serializer(), raw) }.getOrNull() ?: return
+        stored = account
+        if (account.refreshToken.isNotBlank()) {
+            _state.update { it.copy(signedIn = true, label = account.label) }
+        }
+    }
+
+    val isSignedIn: Boolean
+        get() {
+            ensureLoaded()
+            return _state.value.signedIn
+        }
+
+    private fun persist() {
+        runCatching { AppFileCache.write(STORE_PATH, json.encodeToString(StoredAccount.serializer(), stored)) }
+    }
+
+    fun reportError(message: String) {
+        _state.update { it.copy(error = message) }
+    }
+
+    fun clearError() {
+        _state.update { it.copy(error = null) }
+    }
+
+    // --- sign in ---
+
+    fun startSignIn() {
+        ensureLoaded()
+        if (signInJob?.isActive == true || _state.value.signedIn) return
+        _state.update { it.copy(busy = true, error = null, userCode = "", verificationUrl = "") }
+        signInJob = scope.launch {
+            try {
+                runSignIn()
+            } catch (cancelled: CancellationException) {
+                throw cancelled
+            } catch (_: Exception) {
+                fail("Sign-in failed. Check the connection and try again.")
+            }
+        }
+    }
+
+    fun cancelSignIn() {
+        signInJob?.cancel()
+        signInJob = null
+        _state.update { it.copy(busy = false, userCode = "", verificationUrl = "") }
+    }
+
+    private fun fail(message: String) {
+        _state.update { it.copy(busy = false, userCode = "", verificationUrl = "", error = message) }
+    }
+
+    private suspend fun runSignIn() {
+        if (stored.deviceId.isBlank()) stored = stored.copy(deviceId = newDeviceId())
+        val (codeStatus, codeBody) = oauthPost(
+            DEVICE_CODE_URL,
+            mapOf(
+                "client_id" to CLIENT_ID,
+                "scope" to SCOPE,
+                "device_id" to stored.deviceId,
+                "model_name" to "Nuvio Mobile",
+            ),
+        )
+        val deviceCode = codeBody?.str("device_code")
+        val userCode = codeBody?.str("user_code")
+        if (codeBody == null || deviceCode == null || userCode == null) {
+            fail(
+                if (codeStatus == 0) "Could not reach Google. Check the connection and try again."
+                else "Google did not give a sign-in code (HTTP $codeStatus). Try again later.",
+            )
+            return
+        }
+        var intervalSeconds = (codeBody.str("interval")?.toIntOrNull() ?: 5).coerceIn(2, 30)
+        val lifetimeSeconds = codeBody.str("expires_in")?.toLongOrNull() ?: 1800L
+        val expiresAtMs = WatchProgressClock.nowEpochMs() + lifetimeSeconds * 1000L
+        _state.update {
+            it.copy(
+                busy = true,
+                userCode = userCode,
+                verificationUrl = codeBody.str("verification_url") ?: DEFAULT_ACTIVATE_URL,
+            )
+        }
+        var networkFailures = 0
+        while (true) {
+            delay(intervalSeconds * 1000L)
+            if (WatchProgressClock.nowEpochMs() > expiresAtMs) {
+                fail("The code expired. Start the sign-in again.")
+                return
+            }
+            val (status, body) = oauthPost(
+                TOKEN_URL,
+                mapOf(
+                    "client_id" to CLIENT_ID,
+                    "client_secret" to CLIENT_SECRET,
+                    "code" to deviceCode,
+                    "grant_type" to "http://oauth.net/grant_type/device/1.0",
+                ),
+            )
+            val accessToken = body?.str("access_token")
+            val refreshToken = body?.str("refresh_token")
+            if (body != null && accessToken != null && refreshToken != null) {
+                val lifetime = body.str("expires_in")?.toLongOrNull() ?: 3600L
+                stored = stored.copy(
+                    refreshToken = refreshToken,
+                    accessToken = accessToken,
+                    expiresAtMs = WatchProgressClock.nowEpochMs() + lifetime * 1000L,
+                )
+                persist()
+                _state.update {
+                    it.copy(signedIn = true, label = stored.label, busy = false, userCode = "", verificationUrl = "", error = null)
+                }
+                YouTubeRepository.onAccountChanged()
+                scope.launch { refreshLabel() }
+                return
+            }
+            when (body?.str("error")) {
+                "authorization_pending" -> networkFailures = 0
+                "slow_down" -> intervalSeconds = (intervalSeconds + 5).coerceAtMost(30)
+                "access_denied" -> {
+                    fail("Sign-in was denied.")
+                    return
+                }
+                "expired_token" -> {
+                    fail("The code expired. Start the sign-in again.")
+                    return
+                }
+                null -> {
+                    networkFailures++
+                    if (networkFailures >= 6) {
+                        fail(
+                            if (status == 0) "Lost the connection while waiting for sign-in. Try again."
+                            else "Google returned an unexpected answer (HTTP $status). Try again later.",
+                        )
+                        return
+                    }
+                }
+                else -> {
+                    fail("Sign-in failed: ${body?.str("error")}.")
+                    return
+                }
+            }
+        }
+    }
+
+    private suspend fun refreshLabel() {
+        val name = runCatching { YtInnertube.accountName() }.getOrNull()
+        stored = stored.copy(label = name?.takeIf { it.isNotBlank() } ?: stored.label.ifBlank { "YouTube account" })
+        persist()
+        _state.update { it.copy(label = stored.label) }
+    }
+
+    fun signOut() {
+        ensureLoaded()
+        cancelSignIn()
+        val token = stored.refreshToken
+        if (token.isNotBlank()) {
+            scope.launch {
+                runCatching {
+                    httpRequestRaw(
+                        method = "POST",
+                        url = REVOKE_URL,
+                        headers = mapOf("Content-Type" to "application/x-www-form-urlencoded"),
+                        body = "token=${urlEncode(token)}",
+                    )
+                }
+            }
+        }
+        stored = StoredAccount(deviceId = stored.deviceId)
+        persist()
+        _state.value = YtAccountState()
+        YouTubeRepository.onAccountChanged()
+    }
+
+    // --- tokens ---
+
+    /** A valid access token, refreshed first when it expires within a minute; null when signed out or offline. */
+    suspend fun accessToken(): String? {
+        ensureLoaded()
+        if (!_state.value.signedIn) return null
+        fun valid() = stored.accessToken.isNotBlank() && stored.expiresAtMs - WatchProgressClock.nowEpochMs() > 60_000L
+        if (valid()) return stored.accessToken
+        return refreshMutex.withLock {
+            if (valid()) return@withLock stored.accessToken
+            refreshAccessToken()
+        }
+    }
+
+    /** Forces the next [accessToken] call to refresh (used after YouTube answered 401). */
+    fun invalidateAccess() {
+        stored = stored.copy(expiresAtMs = 0L)
+    }
+
+    private suspend fun refreshAccessToken(): String? {
+        val (status, body) = oauthPost(
+            TOKEN_URL,
+            mapOf(
+                "client_id" to CLIENT_ID,
+                "client_secret" to CLIENT_SECRET,
+                "refresh_token" to stored.refreshToken,
+                "grant_type" to "refresh_token",
+            ),
+        )
+        val accessToken = body?.str("access_token")
+        if (body != null && accessToken != null) {
+            val lifetime = body.str("expires_in")?.toLongOrNull() ?: 3600L
+            stored = stored.copy(
+                accessToken = accessToken,
+                expiresAtMs = WatchProgressClock.nowEpochMs() + lifetime * 1000L,
+                refreshToken = body.str("refresh_token") ?: stored.refreshToken,
+            )
+            persist()
+            return accessToken
+        }
+        val error = body?.str("error")
+        if (error == "invalid_grant" || error == "unauthorized_client") {
+            // The user revoked access or the token aged out: drop the session instead of retrying forever.
+            stored = StoredAccount(deviceId = stored.deviceId)
+            persist()
+            _state.value = YtAccountState(error = "Your YouTube session expired. Sign in again.")
+            YouTubeRepository.onAccountChanged()
+        } else if (status == 0) {
+            reportError("Could not reach Google to refresh the YouTube sign-in.")
+        }
+        return null
+    }
+
+    // --- http ---
+
+    /** Posts [fields] as JSON first and as a form when Google rejects that; status 0 means no answer. */
+    private suspend fun oauthPost(url: String, fields: Map<String, String>): Pair<Int, JsonObject?> {
+        val jsonBody = buildJsonObject { fields.forEach { (k, v) -> put(k, v) } }.toString()
+        val first = runCatching {
+            httpRequestRaw(
+                method = "POST",
+                url = url,
+                headers = mapOf("Content-Type" to "application/json", "User-Agent" to "Mozilla/5.0 (ChromiumStylePlatform) Cobalt/Version"),
+                body = jsonBody,
+            )
+        }.getOrNull() ?: return 0 to null
+        val firstBody = parseObject(first.body)
+        if (firstBody != null && (first.status in 200..299 || firstBody.str("error") != null)) return first.status to firstBody
+        val form = fields.entries.joinToString("&") { "${urlEncode(it.key)}=${urlEncode(it.value)}" }
+        val second = runCatching {
+            httpRequestRaw(
+                method = "POST",
+                url = url,
+                headers = mapOf("Content-Type" to "application/x-www-form-urlencoded", "User-Agent" to "Mozilla/5.0 (ChromiumStylePlatform) Cobalt/Version"),
+                body = form,
+            )
+        }.getOrNull() ?: return first.status to firstBody
+        return second.status to parseObject(second.body)
+    }
+
+    private fun parseObject(text: String): JsonObject? =
+        runCatching { json.parseToJsonElement(text) as? JsonObject }.getOrNull()
+
+    private fun JsonObject.str(key: String): String? = (this[key] as? JsonPrimitive)?.contentOrNull
+
+    private fun newDeviceId(): String {
+        val chars = "0123456789abcdef"
+        return buildString { repeat(16) { append(chars[Random.nextInt(chars.length)]) } }
+    }
+
+    private fun urlEncode(value: String): String {
+        val unreserved = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_.~"
+        val out = StringBuilder()
+        for (byte in value.encodeToByteArray()) {
+            val c = (byte.toInt() and 0xFF).toChar()
+            if (unreserved.indexOf(c) >= 0) {
+                out.append(c)
+            } else {
+                out.append('%')
+                out.append("0123456789ABCDEF"[(byte.toInt() shr 4) and 0xF])
+                out.append("0123456789ABCDEF"[byte.toInt() and 0xF])
+            }
+        }
+        return out.toString()
+    }
+}
