+                    deferred.invokeOnCompletion {
+                        synchronized(mainPageRequestMutex) {
+                            if (mainPageRequests[requestKey] === deferred) {
+                                mainPageRequests.remove(requestKey)
+                            }
+                        }
+                    }
+                }
+        }
