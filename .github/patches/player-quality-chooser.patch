+private fun ExoPlayer.extractVideoQualities(): List<VideoQualityOption> {
+    val pinnedHeight = trackSelectionParameters.overrides.values
+        .firstOrNull { it.mediaTrackGroup.type == C.TRACK_TYPE_VIDEO }
+        ?.let { pin -> pin.mediaTrackGroup.getFormat(pin.trackIndices.first()).height }
+    val byHeight = LinkedHashMap<Int, VideoQualityOption>()
+    for (group in currentTracks.groups) {
+        if (group.type != C.TRACK_TYPE_VIDEO) continue
+        for (i in 0 until group.length) {
+            if (!group.isTrackSupported(i)) continue
+            val format = group.getTrackFormat(i)
+            if (format.height <= 0) continue
+            val existing = byHeight[format.height]
+            if (existing == null || (format.bitrate > (existing.bitrate ?: 0))) {
+                byHeight[format.height] = VideoQualityOption(
+                    heightPx = format.height,
+                    label = "${format.height}p",
+                    bitrate = format.bitrate.takeIf { it > 0 },
+                    isSelected = pinnedHeight == format.height,
+                )
+            }
+        }
+    }
+    return byHeight.values.sortedByDescending { it.heightPx }
+}
+
+private fun ExoPlayer.applyVideoQuality(heightPx: Int?) {
+    val builder = trackSelectionParameters.buildUpon().clearOverridesOfType(C.TRACK_TYPE_VIDEO)
+    if (heightPx != null) {
+        var best: Pair<Tracks.Group, Int>? = null
+        for (group in currentTracks.groups) {
+            if (group.type != C.TRACK_TYPE_VIDEO) continue
+            for (i in 0 until group.length) {
+                val format = group.getTrackFormat(i)
+                if (format.height != heightPx || !group.isTrackSupported(i)) continue
+                val currentBest = best?.let { it.first.getTrackFormat(it.second).bitrate } ?: -1
+                if (format.bitrate > currentBest) best = group to i
+            }
+        }
+        best?.let { (group, index) ->
+            builder.setOverrideForType(TrackSelectionOverride(group.mediaTrackGroup, listOf(index)))
+        }
+    }
+    trackSelectionParameters = builder.build()
+}
