+    fun export(): String = kotlinx.serialization.json.buildJsonObject {
+        ForkPrefs.all.forEach { put(it.path, kotlinx.serialization.json.JsonPrimitive(it.current())) }
+        layouts.forEach { (key, layout) ->
+            put("layout/$key", kotlinx.serialization.json.JsonPrimitive(layout.exportRaw()))
+        }
+    }.toString()
+
+    fun replace(payload: String) {
+        val root = runCatching {
+            kotlinx.serialization.json.Json.parseToJsonElement(payload) as? kotlinx.serialization.json.JsonObject
+        }.getOrNull() ?: return
+        ForkPrefs.all.forEach { pref ->
+            (root[pref.path] as? kotlinx.serialization.json.JsonPrimitive)?.content?.toBooleanStrictOrNull()
+                ?.let(pref::set)
+        }
+        layouts.forEach { (key, layout) ->
+            (root["layout/$key"] as? kotlinx.serialization.json.JsonPrimitive)?.content
+                ?.takeIf { it.isNotBlank() }
+                ?.let(layout::importRaw)
+        }
+    }
 }
