+/** Fork settings (toggles and player button layouts) as one string, so backups and profile sync carry them. */
+object ForkSettingsBackup {
+    private val layouts: List<Pair<String, com.nuvio.app.features.player.ForkButtonLayout>> = listOf(
+        "toolbar" to com.nuvio.app.features.player.ForkPlayerToolbar,
+        "legacy_top" to com.nuvio.app.features.player.ForkLegacyTopButtons,
+        "legacy_bottom" to com.nuvio.app.features.player.ForkLegacyBottomButtons,
+    )
