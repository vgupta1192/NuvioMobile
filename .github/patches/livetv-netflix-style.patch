+/**
+ * Fork feature: Netflix style for the Live TV screen (landscape channel cards with the current
+ * programme and a progress bar). Off by default; the original list is untouched when off.
+ *
+ * Persisted as "<0|1>|<snapshot>". The snapshot is the value this preference had when the global
+ * Netflix style was turned on ("-" when no snapshot is held); turning the global switch off puts it back.
+ */
+object LiveTvNetflixStyle {
+    private const val PATH = "settings/livetv_netflix_style"
+
+    private val _enabled = MutableStateFlow(false)
+    val enabled: StateFlow<Boolean> = _enabled.asStateFlow()
+    private var loaded = false
+
+    private fun readParts(): List<String> =
+        runCatching { AppFileCache.read(PATH)?.trim()?.split('|').orEmpty() }.getOrDefault(emptyList())
+
+    private fun save(on: Boolean, snapshot: String) {
+        runCatching { AppFileCache.write(PATH, "${if (on) 1 else 0}|$snapshot") }
+    }
+
+    fun ensureLoaded() {
+        if (loaded) return
+        loaded = true
+        _enabled.value = readParts().firstOrNull() == "1"
+    }
+
+    /** The user's own toggle (Settings or the Live TV header). Keeps any held snapshot. */
+    fun setEnabled(on: Boolean) {
+        ensureLoaded()
+        if (on == _enabled.value) return
+        save(on, readParts().getOrNull(1) ?: "-")
+        _enabled.value = on
+    }
+
+    /** Called by the global Netflix style switch: ON snapshots and enables, OFF restores the snapshot. */
+    fun onGlobalChanged(globalOn: Boolean) {
+        ensureLoaded()
+        if (globalOn) {
+            save(true, if (_enabled.value) "1" else "0")
+            _enabled.value = true
+        } else {
+            val snapshot = readParts().getOrNull(1)
+            if (snapshot == "0" || snapshot == "1") {
+                val restored = snapshot == "1"
+                save(restored, "-")
+                _enabled.value = restored
+            }
+        }
+    }
+}
+
+@Composable
+internal fun LiveTvNetflixGrid(
+    state: LiveTvUiState,
+    epgRevision: Int,
+    nowMs: Long,
+    onPlay: (LiveTvChannel, LiveTvStreamOption) -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    LazyVerticalGrid(
+        columns = GridCells.Adaptive(minSize = 190.dp),
+        modifier = modifier.fillMaxSize(),
+        horizontalArrangement = Arrangement.spacedBy(12.dp),
+        verticalArrangement = Arrangement.spacedBy(14.dp),
+    ) {
+        items(state.filteredChannels, key = { it.stableKey() }) { channel ->
+            val epg = remember(channel, epgRevision, nowMs) { LiveTvEpgRepository.epgFor(channel, nowMs) }
+            LiveTvNetflixCard(
+                channel = channel,
+                epg = epg,
+                nowMs = nowMs,
+                selected = state.selectedChannel?.stableKey() == channel.stableKey(),
+                favorite = state.isFavorite(channel),
+                onClick = {
+                    if (state.selectedChannel?.stableKey() == channel.stableKey()) {
+                        state.streams.firstOrNull()?.let { onPlay(channel, it) }
+                    } else {
+                        LiveTvRepository.selectChannel(channel)
+                    }
+                },
+            )
+        }
+    }
+}
+
+@Composable
+private fun LiveTvNetflixCard(
+    channel: LiveTvChannel,
+    epg: ChannelEpgInfo?,
+    nowMs: Long,
+    selected: Boolean,
+    favorite: Boolean,
+    onClick: () -> Unit,
+) {
+    val tokens = MaterialTheme.nuvio
+    val shape = RoundedCornerShape(12.dp)
+    Column(modifier = Modifier.fillMaxWidth().clickable(onClick = onClick)) {
+        Box(
+            modifier = Modifier
+                .fillMaxWidth()
+                .aspectRatio(16f / 9f)
+                .clip(shape)
+                .background(tokens.colors.surfaceElevated)
+                .then(if (selected) Modifier.border(2.dp, tokens.colors.accent, shape) else Modifier),
+            contentAlignment = Alignment.Center,
+        ) {
+            val logo = channel.displayLogo
+            if (logo != null) {
+                AsyncImage(
+                    model = logo,
+                    contentDescription = channel.name,
+                    contentScale = ContentScale.Fit,
+                    modifier = Modifier.fillMaxSize().padding(16.dp),
+                )
+            } else {
+                Text(
+                    text = channel.name.take(2).uppercase(),
+                    style = MaterialTheme.typography.headlineSmall,
+                    color = tokens.colors.textMuted,
+                )
+            }
+            IconButton(
+                onClick = { LiveTvRepository.toggleFavorite(channel) },
+                modifier = Modifier.align(Alignment.TopEnd).size(36.dp),
+            ) {
+                Icon(
+                    imageVector = if (favorite) Icons.Rounded.Star else Icons.Rounded.StarBorder,
+                    contentDescription = stringResource(Res.string.livetv_netflix_style_favorite),
+                    tint = if (favorite) tokens.colors.warning else tokens.colors.textMuted,
+                )
+            }
+            val now = epg?.nowProgram
+            if (now != null) {
+                LinearProgressIndicator(
+                    progress = now.progress(nowMs),
+                    modifier = Modifier.align(Alignment.BottomCenter).fillMaxWidth().height(3.dp),
+                )
+            }
+        }
+        Text(
+            text = channel.name,
+            style = MaterialTheme.typography.titleSmall,
+            fontWeight = FontWeight.SemiBold,
+            color = tokens.colors.textPrimary,
+            maxLines = 1,
+            overflow = TextOverflow.Ellipsis,
+            modifier = Modifier.padding(top = 6.dp),
+        )
+        val now = epg?.nowProgram
+        Text(
+            text = now?.title
+                ?: listOfNotNull(channel.primaryGenre ?: channel.catalogName, channel.addonName).distinct().joinToString(" · "),
+            style = MaterialTheme.typography.bodySmall,
+            color = if (now != null) tokens.colors.textSecondary else tokens.colors.textMuted,
+            maxLines = 1,
+            overflow = TextOverflow.Ellipsis,
+        )
+    }
+}
