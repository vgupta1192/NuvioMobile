+@file:OptIn(androidx.media3.common.util.UnstableApi::class)
+
+package com.nuvio.app.features.autosync
+
+import android.content.Context
+import android.graphics.Typeface
+import android.text.Spanned
+import android.text.style.StyleSpan
+import android.util.Log
+import androidx.media3.common.C
+import androidx.media3.common.text.Cue
+import androidx.media3.extractor.text.CuesWithTiming
+import com.nuvio.app.features.player.SidecarSubtitleController
+import com.nuvio.app.features.player.SyncedSubtitles
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.collectLatest
+import kotlinx.coroutines.launch
+import java.io.File
+
+/**
+ * Saves the subtitle AutoSync (or the audio sync) synced in this playback, as SRT, through
+ * [SyncedSubtitles], and shows a saved one again without syncing. The save waits until the
+ * timing has settled for a few seconds, since the audio sync keeps refining its result.
+ */
+internal class SyncedSubtitleKeeper(
+    private val scope: CoroutineScope,
+    private val sidecar: SidecarSubtitleController,
+) {
+    private val saver: Job = scope.launch {
+        AutoSyncSyncedSubtitle.revision.collectLatest {
+            val url = AutoSyncSyncedSubtitle.url.value ?: return@collectLatest
+            delay(SETTLE_MS)
+            if (AutoSyncSyncedSubtitle.url.value != url || sidecar.activeSidecarSubtitleKey != url) return@collectLatest
+            val cues = sidecar.sidecarTimedCues
+            if (cues.isEmpty()) return@collectLatest
+            val srt = toSrt(cues)
+            SyncedSubtitles.save(url, srt, method = "autosync", nowMs = System.currentTimeMillis())
+            Log.i(TAG, "saved synced subtitle ($url, ${cues.size} lines)")
+        }
+    }
+
+    /** Marks [url] as synced once the sidecar shows the saved timing. */
+    fun markWhenShown(url: String) {
+        scope.launch {
+            var waitedMs = 0L
+            while (sidecar.activeSidecarSubtitleKey == url && sidecar.sidecarTimedCues.isEmpty() && waitedMs < SHOW_WAIT_MS) {
+                delay(POLL_MS)
+                waitedMs += POLL_MS
+            }
+            if (sidecar.activeSidecarSubtitleKey == url && sidecar.sidecarTimedCues.isNotEmpty()) {
+                AutoSyncSyncedSubtitle.mark(url)
+                Log.i(TAG, "showing saved synced subtitle ($url)")
+            }
+        }
+    }
+
+    fun release() {
+        saver.cancel()
+    }
+
+    companion object {
+        private const val TAG = "NuvioSyncedSubtitles"
+        private const val SETTLE_MS = 4_000L
+        private const val SHOW_WAIT_MS = 10_000L
+        private const val POLL_MS = 100L
+
+        private const val MAX_FILES = 400
+
+        /** Device storage for [SyncedSubtitles] (filesDir/synced-subtitles). Call once at app start. */
+        fun initialize(context: Context) {
+            val dir = File(context.filesDir, "synced-subtitles")
+            SyncedSubtitles.installStore(
+                load = { name -> runCatching { File(dir, name).takeIf { it.isFile }?.readText() }.getOrNull() },
+                save = { name, value ->
+                    runCatching {
+                        dir.mkdirs()
+                        File(dir, name).writeText(value)
+                        val files = dir.listFiles().orEmpty()
+                        if (files.size > MAX_FILES) {
+                            files.sortedBy { it.lastModified() }.take(files.size - MAX_FILES).forEach { it.delete() }
+                        }
+                    }
+                },
+            )
+        }
+
+        /** [cues] as SRT; italic/bold kept as tags, lines placed at the top kept with {\an8}. */
+        internal fun toSrt(cues: List<CuesWithTiming>): String {
+            val out = StringBuilder()
+            var index = 1
+            for (entry in cues) {
+                if (entry.startTimeUs == C.TIME_UNSET) continue
+                val endUs = when {
+                    entry.endTimeUs != C.TIME_UNSET -> entry.endTimeUs
+                    entry.durationUs != C.TIME_UNSET -> entry.startTimeUs + entry.durationUs
+                    else -> entry.startTimeUs + 2_000_000L
+                }
+                val text = entry.cues.mapNotNull { cue -> cueText(cue) }.joinToString("\n").trim()
+                if (text.isEmpty()) continue
+                val top = entry.cues.any { cue ->
+                    cue.lineType == Cue.LINE_TYPE_FRACTION && cue.line != Cue.DIMEN_UNSET && cue.line < 0.4f
+                }
+                out.append(index++).append('\n')
+                out.append(time(entry.startTimeUs)).append(" --> ").append(time(endUs)).append('\n')
+                if (top) out.append("{\\an8}")
+                out.append(text).append("\n\n")
+            }
+            return out.toString()
+        }
+
+        private fun cueText(cue: Cue): String? {
+            val text = cue.text ?: return null
+            if (text !is Spanned) return text.toString()
+            val opens = HashMap<Int, String>()
+            val closes = HashMap<Int, String>()
+            for (span in text.getSpans(0, text.length, StyleSpan::class.java)) {
+                val start = text.getSpanStart(span)
+                val end = text.getSpanEnd(span)
+                if (start < 0 || end <= start) continue
+                opens[start] = opens[start].orEmpty() + openTag(span.style)
+                closes[end] = closeTag(span.style) + closes[end].orEmpty()
+            }
+            val builder = StringBuilder()
+            for (i in 0..text.length) {
+                closes[i]?.let(builder::append)
+                opens[i]?.let(builder::append)
+                if (i < text.length) builder.append(text[i])
+            }
+            return builder.toString()
+        }
+
+        private fun openTag(style: Int) = when (style) {
+            Typeface.ITALIC -> "<i>"
+            Typeface.BOLD -> "<b>"
+            Typeface.BOLD_ITALIC -> "<b><i>"
+            else -> ""
+        }
+
+        private fun closeTag(style: Int) = when (style) {
+            Typeface.ITALIC -> "</i>"
+            Typeface.BOLD -> "</b>"
+            Typeface.BOLD_ITALIC -> "</i></b>"
+            else -> ""
+        }
+
+        private fun time(us: Long): String {
+            val totalMs = (us / 1_000L).coerceAtLeast(0L)
+            val h = totalMs / 3_600_000L
+            val m = totalMs / 60_000L % 60
+            val s = totalMs / 1_000L % 60
+            val ms = totalMs % 1_000L
+            return "%02d:%02d:%02d,%03d".format(h, m, s, ms)
+        }
+    }
+}
