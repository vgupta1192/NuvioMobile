+    /** First page of comments of [videoId]; the token in the result loads the next page. */
+    suspend fun comments(videoId: String): YtCommentPage? {
+        val root = post("next") { put("videoId", videoId) } ?: return null
+        val sections = mutableListOf<JsonObject>()
+        collectObjects(root, "itemSectionRenderer", sections)
+        val section = sections.firstOrNull { it.str("sectionIdentifier") == "comment-item-section" }
+        val token = section?.let { findString(it, "token") } ?: return YtCommentPage(emptyList(), null)
+        return moreComments(token)
+    }
+
+    suspend fun moreComments(token: String): YtCommentPage? {
+        val root = post("next") { put("continuation", token) } ?: return null
+        val out = mutableListOf<YtComment>()
+        // Newer layout: the text lives in entity updates beside the thread list.
+        val payloads = mutableListOf<JsonObject>()
+        collectObjects(root, "commentEntityPayload", payloads)
+        for (payload in payloads) {
+            val props = payload["properties"].asObj()
+            val body = text(props?.get("content")).ifBlank { continue }
+            out.add(
+                YtComment(
+                    author = text(payload["author"].asObj()?.get("displayName")).removePrefix("@"),
+                    body = body,
+                    likes = text(payload["toolbar"].asObj()?.get("likeCountNotliked")).takeIf { it != "0" }.orEmpty(),
+                    published = text(props?.get("publishedTime")),
+                ),
+            )
+        }
+        if (out.isEmpty()) {
+            val old = mutableListOf<JsonObject>()
+            collectObjects(root, "commentRenderer", old)
+            for (c in old) {
+                val body = text(c["contentText"]).ifBlank { continue }
+                out.add(
+                    YtComment(
+                        author = text(c["authorText"]).removePrefix("@"),
+                        body = body,
+                        likes = text(c["voteCount"]),
+                        published = text(c["publishedTimeText"]),
+                    ),
+                )
+            }
+        }
+        var next: String? = null
+        val arrays = mutableListOf<JsonArray>()
+        fun walk(e: JsonElement?) {
+            when (e) {
+                is JsonObject -> { (e["continuationItems"] as? JsonArray)?.let { arrays.add(it) }; e.values.forEach { walk(it) } }
+                is JsonArray -> e.forEach { walk(it) }
+                else -> Unit
+            }
+        }
+        walk(root)
+        for (items in arrays) {
+            val last = items.lastOrNull().asObj()?.get("continuationItemRenderer") ?: continue
+            findString(last, "token")?.let { next = it }
+        }
+        return YtCommentPage(out, next)
+    }
