+package com.nuvio.app.features.downloads
+
+/**
+ * Fork feature: choose where new downloads are stored. Android can use the app folder on removable
+ * storage (SD card) when one is mounted; existing downloads stay where they are.
+ */
+internal expect object DownloadsStorageLocation {
+    fun isExternalAvailable(): Boolean
+    fun isExternal(): Boolean
+    fun setExternal(enabled: Boolean)
+}
