@@ -0,0 +1,37 @@
+package com.nuvio.app.features.downloads
+
+import android.content.Context
+import android.os.Environment
+import java.io.File
+
+internal actual object DownloadsStorageLocation {
+    private const val PREFERENCES_NAME = "nuvio_downloads_location"
+    private const val EXTERNAL_KEY = "external"
+
+    private fun preferences() =
+        DownloadsPlatformDownloader.applicationContextOrNull()
+            ?.getSharedPreferences(PREFERENCES_NAME, Context.MODE_PRIVATE)
+
+    /** Mounted removable-storage app folder, or null when only the internal volume exists. */
+    private fun externalRoot(context: Context): File? =
+        context.getExternalFilesDirs(null)
+            .filterNotNull()
+            .firstOrNull { Environment.getExternalStorageState(it) == Environment.MEDIA_MOUNTED && Environment.isExternalStorageRemovable(it) }
+
+    actual fun isExternalAvailable(): Boolean {
+        val context = DownloadsPlatformDownloader.applicationContextOrNull() ?: return false
+        return externalRoot(context) != null
+    }
+
+    actual fun isExternal(): Boolean = preferences()?.getBoolean(EXTERNAL_KEY, false) ?: false
+
+    actual fun setExternal(enabled: Boolean) {
+        preferences()?.edit()?.putBoolean(EXTERNAL_KEY, enabled)?.apply()
+    }
+
+    /** Folder for new downloads; falls back to the internal folder when the card is gone. */
+    fun directory(context: Context): File {
+        val external = if (isExternal()) externalRoot(context) else null
+        return if (external != null) File(external, "downloads") else File(context.filesDir, "downloads")
+    }
+}
