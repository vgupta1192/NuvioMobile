@@ -0,0 +1,25 @@
+package com.nuvio.app.features.details
+
+import com.nuvio.app.features.library.LibraryClock
+
+/**
+ * Remembers that a host could not be reached, so it is not asked again on every page. When another host answered
+ * at the same time the network is fine and the host is taken as gone for [GONE_MS]; otherwise the device may just be
+ * offline for a moment, and the host is tried again after [OFFLINE_MS].
+ */
+internal class HostOutage(
+    private val now: () -> Long = { LibraryClock.nowEpochMs() },
+) {
+    private var downUntilMs = 0L
+
+    fun isDown(): Boolean = now() < downUntilMs
+
+    fun markDown(networkUp: Boolean) {
+        downUntilMs = now() + if (networkUp) GONE_MS else OFFLINE_MS
+    }
+
+    private companion object {
+        const val GONE_MS = 24L * 60L * 60L * 1000L
+        const val OFFLINE_MS = 10L * 60L * 1000L
+    }
+}
