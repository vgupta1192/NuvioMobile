+package com.nuvio.app.features.settings
+
+import android.app.ActivityManager
+import android.content.Context
+import com.nuvio.app.core.storage.AppContextHolder
+import java.io.File
+
+internal actual object ForkHealthPlatform {
+    private fun dirSize(file: File): Long =
+        if (file.isFile) file.length() else file.listFiles()?.sumOf { dirSize(it) } ?: 0L
+
+    private fun mb(bytes: Long): String = "%.1f MB".format(bytes / (1024.0 * 1024.0))
+
+    actual fun systemLines(): List<String> {
+        val context = AppContextHolder.get() ?: return listOf("Device facts are not ready yet.")
+        val runtime = Runtime.getRuntime()
+        val manager = context.getSystemService(Context.ACTIVITY_SERVICE) as? ActivityManager
+        val info = ActivityManager.MemoryInfo().also { manager?.getMemoryInfo(it) }
+        return buildList {
+            add("App memory: ${mb(runtime.totalMemory() - runtime.freeMemory())} used of ${mb(runtime.maxMemory())}")
+            if (manager != null) {
+                add("Device memory: ${mb(info.availMem)} free of ${mb(info.totalMem)}" + if (info.lowMemory) " (low)" else "")
+            }
+            add("Free storage: ${mb(context.filesDir.usableSpace)}")
+            add("Cache folder: ${mb(dirSize(context.cacheDir))}")
+            add("Saved data: ${mb(dirSize(context.filesDir))}")
+        }
+    }
+}
