+            added = newKeys.count { it !in oldKeys }
+            // Links that were already there keep their badges and cache status.
+            val merged = presented.copy(
+                streams = presented.streams.map { oldByKey[it.refreshKey()] ?: it },
+                isLoading = false,
+                error = null,
+            )
+            val groups = if (old == null) {
+                current.groups + merged
+            } else {
+                current.groups.map { if (it.addonId == fresh.addonId) merged else it }
+            }
+            current.copy(
+                groups = StreamAutoPlaySelector.orderAddonStreams(
+                    groups = groups,
+                    installedOrder = context.installedOrder,
+                    preferredGroupIds = context.preferredGroupIds,
+                ),
+                activeAddonIds = current.activeAddonIds + merged.addonId,
+            )
         }
+        return added
     }
 
