+import kotlin.time.Clock
+
+private data class AddonHealth(val name: String, val ok: Boolean, val detail: String)
+
+private suspend fun checkAddon(name: String, manifestUrl: String): AddonHealth {
+    val start = Clock.System.now().toEpochMilliseconds()
+    return try {
+        val answer = withTimeoutOrNull(5_000L) { fetchAddonResponseText(url = manifestUrl, forceRefresh = true) }
+        val elapsed = Clock.System.now().toEpochMilliseconds() - start
+        if (answer == null) AddonHealth(name, false, "timed out") else AddonHealth(name, true, "$elapsed ms")
+    } catch (error: CancellationException) {
+        throw error
+    } catch (error: Throwable) {
+        AddonHealth(name, false, error.message?.take(40) ?: "no answer")
+    }
+}
+
+/** Nuvio fork: Settings health dialog with memory, storage, cache sizes and addon reachability. */
+@Composable
+internal fun ForkHealthSettingsSection(isTablet: Boolean) {
+    var show by remember { mutableStateOf(false) }
+    SettingsSection(title = "App health", isTablet = isTablet) {
+        SettingsGroup(isTablet = isTablet) {
+            SettingsNavigationRow(
+                title = "App health",
+                description = "Memory, storage, cache sizes and whether every addon answers.",
+                isTablet = isTablet,
+                onClick = { show = true },
+            )
+        }
+    }
+    if (show) ForkHealthDialog(onDismiss = { show = false })
+}
+
+@Composable
+private fun ForkHealthDialog(onDismiss: () -> Unit) {
+    val addonsState by AddonRepository.uiState.collectAsStateWithLifecycle()
+    var lines by remember { mutableStateOf<List<String>>(emptyList()) }
+    var addons by remember { mutableStateOf<List<AddonHealth>?>(null) }
+    var nonce by remember { mutableStateOf(0) }
+
+    LaunchedEffect(nonce) {
+        lines = withContext(Dispatchers.Default) { ForkHealthPlatform.systemLines() }
+        addons = null
+        val targets = addonsState.addons.enabledAddons().map { addon ->
+            (addon.manifest?.name ?: addon.manifestUrl) to addon.manifestUrl
+        }
+        addons = coroutineScope {
+            targets.map { (name, url) -> async { checkAddon(name, url) } }.awaitAll()
+        }
+    }
+
+    AlertDialog(
+        onDismissRequest = onDismiss,
+        title = { Text("App health") },
+        text = {
+            Column(modifier = Modifier.verticalScroll(rememberScrollState())) {
+                lines.forEach { Text(it, style = MaterialTheme.typography.bodyMedium) }
+                val checked = addons
+                Text(
+                    text = if (checked == null) {
+                        "Addons: checking..."
+                    } else {
+                        val bad = checked.count { !it.ok }
+                        "Addons: ${checked.size - bad} answer, $bad do not"
+                    },
+                    style = MaterialTheme.typography.titleSmall,
+                    modifier = Modifier.padding(top = 10.dp),
+                )
+                checked.orEmpty().forEach { health ->
+                    Text(
+                        text = (if (health.ok) "OK  " else "FAIL  ") + health.name + "  (" + health.detail + ")",
+                        style = MaterialTheme.typography.bodySmall,
+                        maxLines = 1,
+                        overflow = TextOverflow.Ellipsis,
+                    )
+                }
+            }
+        },
+        confirmButton = {
+            Row {
+                TextButton(onClick = { nonce++ }) { Text("Check again") }
+                TextButton(onClick = onDismiss) { Text("Close") }
+            }
+        },
+    )
+}
