+package com.nuvio.app.features.downloads
+
+import android.content.Context
+import android.net.Uri
+import android.provider.DocumentsContract
+import android.util.Log
+import android.webkit.MimeTypeMap
+import java.io.File
+import java.io.IOException
+import java.security.MessageDigest
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.withContext
+
+/**
+ * Fork port of the Enhanced custom download folder. Downloads are staged in app storage and copied
+ * into the folder the user picked (Storage Access Framework tree) when they finish.
+ */
+internal object AndroidDownloadExport {
+    private const val TAG = "NuvioDownloadExport"
+
+    private val context: Context?
+        get() = DownloadsPlatformDownloader.applicationContextOrNull()
+
+    fun isContentUri(uri: String): Boolean = uri.startsWith("content:", ignoreCase = true)
+
+    /** Document URI of the picked folder when the permission is still granted and the folder exists. */
+    fun writableFolder(treeUri: String): Uri? = runCatching {
+        val context = context ?: return@runCatching null
+        val tree = Uri.parse(treeUri)
+        val granted = context.contentResolver.persistedUriPermissions.any { it.uri == tree && it.isWritePermission }
+        if (!granted) return@runCatching null
+        val folder = treeDocumentUri(treeUri) ?: return@runCatching null
+        val mime = context.contentResolver.query(
+            folder, arrayOf(DocumentsContract.Document.COLUMN_MIME_TYPE), null, null, null,
+        )?.use { if (it.moveToFirst()) it.getString(0) else null }
+        folder.takeIf { mime == DocumentsContract.Document.MIME_TYPE_DIR }
+    }.onFailure { Log.w(TAG, "Download location is not accessible", it) }.getOrNull()
+
+    fun treeDocumentUri(treeUri: String): Uri? = runCatching {
+        val uri = Uri.parse(treeUri)
+        DocumentsContract.buildDocumentUriUsingTree(uri, DocumentsContract.getTreeDocumentId(uri))
+    }.getOrNull()
+
+    suspend fun copyInto(folder: Uri, source: File): Uri = withContext(Dispatchers.IO) {
+        val resolver = checkNotNull(context) { "Download export is not initialized" }.contentResolver
+        val mimeType = MimeTypeMap.getSingleton().getMimeTypeFromExtension(source.extension.lowercase())
+            ?: "application/octet-stream"
+        val target = DocumentsContract.createDocument(resolver, folder, mimeType, source.name)
+            ?: throw IOException("Could not create the file in the selected download location")
+        try {
+            val output = resolver.openOutputStream(target, "w")
+                ?: throw IOException("Could not open the selected download location")
+            output.use { out ->
+                source.inputStream().use { input ->
+                    val buffer = ByteArray(256 * 1024)
+                    while (true) {
+                        currentCoroutineContext().ensureActive()
+                        val size = input.read(buffer)
+                        if (size == -1) break
+                        out.write(buffer, 0, size)
+                    }
+                    out.flush()
+                }
+            }
+            val written = resolver.openFileDescriptor(target, "r")?.use { it.statSize } ?: -1L
+            if (written >= 0L && written != source.length()) {
+                throw IOException("Copy to the selected download location was incomplete")
+            }
+            target
+        } catch (error: Throwable) {
+            runCatching { DocumentsContract.deleteDocument(resolver, target) }
+            throw error
+        }
+    }
+
+    fun exists(uri: String): Boolean = runCatching {
+        val resolver = context?.contentResolver ?: return@runCatching false
+        resolver.query(
+            Uri.parse(uri), arrayOf(DocumentsContract.Document.COLUMN_DOCUMENT_ID), null, null, null,
+        )?.use { it.moveToFirst() } == true
+    }.getOrDefault(false)
+
+    fun delete(uri: String): Boolean = runCatching {
+        val resolver = context?.contentResolver ?: return@runCatching false
+        DocumentsContract.deleteDocument(resolver, Uri.parse(uri))
+    }.getOrDefault(false)
+
+    fun subtitleDirectory(contentUri: String): File {
+        val key = MessageDigest.getInstance("SHA-256").digest(contentUri.toByteArray())
+            .joinToString("") { "%02x".format(it) }
+        return File(File(checkNotNull(context).filesDir, "download-subtitles"), "$key.subtitles")
+    }
+
+    fun moveSubtitles(privateVideo: File, contentUri: String) {
+        val from = File(privateVideo.path + ".subtitles")
+        if (!from.isDirectory) return
+        val to = subtitleDirectory(contentUri)
+        to.deleteRecursively()
+        to.parentFile?.mkdirs()
+        if (!from.renameTo(to)) {
+            from.copyRecursively(to, overwrite = true)
+            from.deleteRecursively()
+        }
+    }
+}
