+package com.nuvio.app.features.downloads
+
+import android.content.Context
+
+internal actual object DownloadsLocationStorage {
+    private const val PREFERENCES_NAME = "nuvio_downloads_settings"
+    private const val LOCATION_KEY = "download_location_uri"
+    private const val SHOW_BUTTON_KEY = "show_download_button"
+
+    private fun preferences() =
+        DownloadsPlatformDownloader.applicationContextOrNull()
+            ?.getSharedPreferences(PREFERENCES_NAME, Context.MODE_PRIVATE)
+
+    actual fun loadLocationUri(): String? = preferences()?.getString(LOCATION_KEY, null)?.takeIf { it.isNotBlank() }
+
+    actual fun saveLocationUri(uri: String?) {
+        preferences()?.edit()?.run {
+            if (uri == null) remove(LOCATION_KEY) else putString(LOCATION_KEY, uri)
+        }?.apply()
+    }
+
+    actual fun loadShowDownloadButton(): Boolean = preferences()?.getBoolean(SHOW_BUTTON_KEY, true) ?: true
+
+    actual fun saveShowDownloadButton(enabled: Boolean) {
+        preferences()?.edit()?.putBoolean(SHOW_BUTTON_KEY, enabled)?.apply()
+    }
+}
