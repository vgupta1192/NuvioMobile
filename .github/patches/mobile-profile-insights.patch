+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+private fun ProfileInsightsDialog(
+    profile: NuvioProfile?,
+    avatarUrl: String?,
+    onSwitchProfile: (() -> Unit)?,
+    onDismiss: () -> Unit,
+) {
+    LaunchedEffect(Unit) {
+        DxWatchStats.ensureLoaded()
+        WatchedRepository.ensureLoaded()
+        LibraryRepository.ensureLoaded()
+        WatchProgressRepository.ensureLoaded()
+    }
+    val progress by WatchProgressRepository.uiState.collectAsStateWithLifecycle()
+    val watched by WatchedRepository.uiState.collectAsStateWithLifecycle()
+    val fullySeries by WatchedRepository.fullyWatchedSeriesKeys.collectAsStateWithLifecycle()
+    val library by LibraryRepository.uiState.collectAsStateWithLifecycle()
+    val statsEnabled by DxWatchStats.enabled.collectAsStateWithLifecycle()
+
+    var editing by remember { mutableStateOf(false) }
+    var sheetKind by remember { mutableStateOf<InsightsKind?>(null) }
+    var factsVersion by remember { mutableStateOf(0) }
+    var loaded by remember { mutableStateOf(0) }
+    var total by remember { mutableStateOf(0) }
+    var refreshTick by remember { mutableStateOf(0) }
+
+    val activeProgress = remember(progress.entries) {
+        progress.entries
+            .filter { !it.isEffectivelyCompleted }
+            .sortedByDescending { it.lastUpdatedEpochMs }
+            .distinctBy { it.parentMetaId }
+    }
+    val watchedTitles = remember(watched.items) {
+        watched.items.sortedByDescending { it.markedAtEpochMs }.distinctBy { it.id }
+    }
+    val summary = remember(progress.entries, refreshTick, statsEnabled) { DxWatchStats.summary(progress.entries) }
+
+    // title ids whose details we want: library + watching + watched, newest first, capped
+    val wanted = remember(library.items, activeProgress, watchedTitles) {
+        buildList {
+            library.items.forEach { add(it.type to it.id) }
+            activeProgress.forEach { add(it.parentMetaType to it.parentMetaId) }
+            watchedTitles.forEach { add(it.type to it.id) }
+        }.distinct().take(90)
+    }
+    LaunchedEffect(wanted, refreshTick) {
+        total = wanted.size
+        loaded = wanted.count { insightsFactsCache.containsKey("${it.first}:${it.second}") }
+        for ((type, id) in wanted) {
+            val key = "$type:$id"
+            if (insightsFactsCache.containsKey(key)) continue
+            val facts = withContext(Dispatchers.Default) {
+                runCatching { MetaDetailsRepository.fetch(type, id) }.getOrNull()?.let { meta ->
+                    val today = CurrentDateProvider.todayIsoDate()
+                    InsightsTitleFacts(
+                        genres = meta.genres,
+                        runtimeMinutes = parseRuntimeMinutes(meta.runtime),
+                        upcoming = meta.videos.mapNotNull { v ->
+                            val date = v.released?.take(10)?.takeIf { it.length == 10 && it >= today } ?: return@mapNotNull null
+                            val ep = if (v.season != null && v.episode != null) "S${v.season}E${v.episode}" else null
+                            InsightsUpcoming(date = date, label = ep, image = v.thumbnail)
+                        }.sortedBy { it.date }.take(3),
+                    )
+                }
+            }
+            if (facts != null) insightsFactsCache[key] = facts
+            loaded += 1
+            factsVersion += 1
+        }
+        insightsFactsUpdatedAt = WatchProgressClock.nowEpochMs()
+        factsVersion += 1
+    }
+
+    val genreCounts = remember(factsVersion, watchedTitles, library.items) {
+        val counts = HashMap<String, Int>()
+        (watchedTitles.map { it.type to it.id } + library.items.map { it.type to it.id }).distinct().forEach { (t, i) ->
+            insightsFactsCache["$t:$i"]?.genres?.forEach { g -> counts[g] = (counts[g] ?: 0) + 1 }
+        }
+        counts.entries.sortedByDescending { it.value }.map { it.key to it.value }
+    }
+    val upcoming = remember(factsVersion, library.items, activeProgress) {
+        val seen = HashSet<String>()
+        val out = ArrayList<InsightsPoster>()
+        val sources = library.items.map { Triple(it.type, it.id, it) } .map { (t, i, x) -> Triple(t, i, x.name to x.poster) } +
+            activeProgress.map { Triple(it.parentMetaType, it.parentMetaId, it.title to it.poster) }
+        sources.forEach { (t, i, np) ->
+            if (!seen.add("$t:$i")) return@forEach
+            insightsFactsCache["$t:$i"]?.upcoming?.firstOrNull()?.let { up ->
+                out.add(InsightsPoster("$t:$i", np.first, listOfNotNull(up.date, up.label).joinToString(" • "), np.second))
+            }
+        }
+        out.sortedBy { it.subtitle }
+    }
+    val watchedMinutes = remember(factsVersion, watchedTitles) {
+        watchedTitles.sumOf { insightsFactsCache["${it.type}:${it.id}"]?.runtimeMinutes ?: 0 }
+    }
+    val movies = remember(watchedTitles) { watchedTitles.count { !isSeriesType(it.type) } }
+    val seriesCount = remember(watchedTitles) { watchedTitles.count { isSeriesType(it.type) } }
+    val episodes = remember(watched.items) { watched.items.count { it.season != null } }
+    val ongoing = remember(activeProgress) { activeProgress.count { isSeriesType(it.parentMetaType) } }
+    val completed = remember(watchedTitles, fullySeries) { watchedTitles.count { !isSeriesType(it.type) } + fullySeries.size }
+
+    fun postersFor(kind: InsightsKind): List<InsightsPoster> = when (kind) {
+        InsightsKind.Watching -> activeProgress.map {
+            InsightsPoster(it.parentMetaId, it.title, if (it.seasonNumber != null && it.episodeNumber != null) "S${it.seasonNumber}E${it.episodeNumber}" else null, it.poster)
+        }
+        InsightsKind.Ongoing -> activeProgress.filter { isSeriesType(it.parentMetaType) }.map {
+            InsightsPoster(it.parentMetaId, it.title, if (it.seasonNumber != null && it.episodeNumber != null) "S${it.seasonNumber}E${it.episodeNumber}" else null, it.poster)
+        }
+        InsightsKind.Saved -> library.items.map { InsightsPoster(it.id, it.name, it.releaseInfo, it.poster) }
+        InsightsKind.Upcoming -> upcoming
+        InsightsKind.Completed -> watchedTitles.filter { !isSeriesType(it.type) }.map { InsightsPoster(it.id, it.name, it.releaseInfo, it.poster) }
+        InsightsKind.Episodes -> watched.items.filter { it.season != null }.sortedByDescending { it.markedAtEpochMs }.take(60).map {
+            InsightsPoster(it.videoId ?: it.id, it.name, "S${it.season}E${it.episode}", it.poster)
+        }
+        InsightsKind.Watched -> watchedTitles.map { InsightsPoster(it.id, it.name, it.releaseInfo, it.poster) }
+    }
+
+    val counts = mapOf(
+        InsightsKind.Watching to activeProgress.size,
+        InsightsKind.Saved to library.items.size,
+        InsightsKind.Upcoming to upcoming.size,
+        InsightsKind.Completed to completed,
+        InsightsKind.Ongoing to ongoing,
+        InsightsKind.Episodes to episodes,
+        InsightsKind.Watched to watchedTitles.size,
+    )
+
+    Dialog(
+        onDismissRequest = onDismiss,
+        properties = DialogProperties(usePlatformDefaultWidth = false, decorFitsSystemWindows = false),
+    ) {
+        Box(modifier = Modifier.fillMaxSize().background(MaterialTheme.colorScheme.background)) {
+            Column(
+                modifier = Modifier
+                    .fillMaxSize()
+                    .verticalScroll(rememberScrollState())
+                    .statusBarsPadding()
+                    .navigationBarsPadding()
+                    .padding(bottom = 32.dp),
+                horizontalAlignment = Alignment.CenterHorizontally,
+            ) {
+                Row(
+                    modifier = Modifier.fillMaxWidth().padding(horizontal = 12.dp, vertical = 8.dp),
+                    verticalAlignment = Alignment.CenterVertically,
+                ) {
+                    InsightsRoundButton(Icons.AutoMirrored.Rounded.ArrowBack, "Back", onDismiss)
+                    Text(
+                        text = "Profile",
+                        modifier = Modifier.weight(1f),
+                        textAlign = TextAlign.Center,
+                        style = MaterialTheme.typography.titleMedium,
+                        fontWeight = FontWeight.SemiBold,
+                    )
+                    Spacer(Modifier.size(44.dp))
+                }
+                Row(
+                    modifier = Modifier.fillMaxWidth().padding(horizontal = 24.dp, vertical = 8.dp),
+                    verticalAlignment = Alignment.CenterVertically,
+                    horizontalArrangement = Arrangement.SpaceBetween,
+                ) {
+                    if (onSwitchProfile != null) {
+                        InsightsRoundButton(Icons.Rounded.People, "Switch profile", onSwitchProfile)
+                    } else {
+                        Spacer(Modifier.size(44.dp))
+                    }
+                    InsightsAvatar(profile = profile, imageUrl = avatarUrl, size = 112)
+                    InsightsRoundButton(Icons.Rounded.Edit, "Edit profile") { editing = true }
+                }
+                Text(
+                    text = profile?.name?.takeIf { it.isNotBlank() } ?: "Profile",
+                    style = MaterialTheme.typography.headlineSmall,
+                    fontWeight = FontWeight.Bold,
+                    modifier = Modifier.padding(top = 4.dp, bottom = 16.dp),
+                )
+
+                Row(
+                    modifier = Modifier.fillMaxWidth().horizontalScroll(rememberScrollState()).padding(horizontal = 20.dp),
+                    horizontalArrangement = Arrangement.spacedBy(10.dp),
+                ) {
+                    InsightsKind.entries.forEach { kind ->
+                        val n = counts[kind] ?: 0
+                        val tileEnabled = kind != InsightsKind.Ongoing || n > 0
+                        Surface(
+                            onClick = { if (tileEnabled) sheetKind = kind },
+                            shape = RoundedCornerShape(18.dp),
+                            color = MaterialTheme.colorScheme.surfaceVariant.copy(alpha = 0.6f),
+                            border = BorderStroke(1.dp, MaterialTheme.colorScheme.outline.copy(alpha = 0.15f)),
+                        ) {
+                            Column(
+                                modifier = Modifier.width(92.dp).padding(vertical = 12.dp),
+                                horizontalAlignment = Alignment.CenterHorizontally,
+                            ) {
+                                Text(n.toString(), style = MaterialTheme.typography.titleLarge, fontWeight = FontWeight.Bold)
+                                Text(kind.label, style = MaterialTheme.typography.labelMedium, color = MaterialTheme.colorScheme.onSurfaceVariant)
+                            }
+                        }
+                    }
+                }
+
+                Row(
+                    modifier = Modifier.padding(top = 14.dp, start = 20.dp, end = 20.dp).fillMaxWidth(),
+                    verticalAlignment = Alignment.CenterVertically,
+                    horizontalArrangement = Arrangement.Center,
+                ) {
+                    Text(
+                        text = agoText(insightsFactsUpdatedAt),
+                        style = MaterialTheme.typography.bodySmall,
+                        color = MaterialTheme.colorScheme.onSurfaceVariant,
+                    )
+                    Icon(
+                        imageVector = Icons.Rounded.Refresh,
+                        contentDescription = "Refresh",
+                        modifier = Modifier
+                            .padding(start = 8.dp)
+                            .size(22.dp)
+                            .clip(CircleShape)
+                            .clickable {
+                                insightsFactsCache.clear()
+                                refreshTick += 1
+                                factsVersion += 1
+                            },
+                        tint = MaterialTheme.colorScheme.onSurfaceVariant,
+                    )
+                }
+                if (total > 0 && loaded < total) {
+                    Row(
+                        modifier = Modifier.padding(top = 6.dp),
+                        verticalAlignment = Alignment.CenterVertically,
+                    ) {
+                        CircularProgressIndicator(modifier = Modifier.size(12.dp), strokeWidth = 2.dp)
+                        Text(
+                            text = "  Loading title details · $loaded of $total",
+                            style = MaterialTheme.typography.labelSmall,
+                            color = MaterialTheme.colorScheme.onSurfaceVariant,
+                        )
+                    }
+                }
+
+                // Watch time card
+                Surface(
+                    modifier = Modifier.fillMaxWidth().padding(horizontal = 20.dp, vertical = 18.dp),
+                    shape = RoundedCornerShape(24.dp),
+                    color = MaterialTheme.colorScheme.primary.copy(alpha = 0.14f),
+                    border = BorderStroke(1.dp, MaterialTheme.colorScheme.primary.copy(alpha = 0.3f)),
+                ) {
+                    Column(modifier = Modifier.padding(20.dp)) {
+                        Text("WATCH TIME", style = MaterialTheme.typography.labelMedium, color = MaterialTheme.colorScheme.onSurfaceVariant)
+                        val seconds = if (summary.total > 0.0) summary.total else watchedMinutes * 60.0
+                        Text(
+                            text = if (seconds > 0.0) formatWatchTime(seconds) else "No watch time yet",
+                            style = MaterialTheme.typography.displaySmall,
+                            fontWeight = FontWeight.Bold,
+                            modifier = Modifier.padding(top = 4.dp),
+                        )
+                        Text(
+                            text = if (summary.total > 0.0) {
+                                "${formatWatchTime(summary.week)} this week • ${summary.currentStreak} day streak"
+                            } else {
+                                "Estimated from runtime of everything you marked as watched"
+                            },
+                            style = MaterialTheme.typography.bodySmall,
+                            color = MaterialTheme.colorScheme.onSurfaceVariant,
+                            modifier = Modifier.padding(top = 4.dp),
+                        )
+                    }
+                }
+
+                // Taste
+                Text(
+                    text = "Taste",
+                    style = MaterialTheme.typography.titleLarge,
+                    fontWeight = FontWeight.Bold,
+                    modifier = Modifier.fillMaxWidth().padding(horizontal = 24.dp),
+                )
+                Surface(
+                    modifier = Modifier.fillMaxWidth().padding(horizontal = 20.dp, vertical = 10.dp),
+                    shape = RoundedCornerShape(24.dp),
+                    color = MaterialTheme.colorScheme.surfaceVariant.copy(alpha = 0.5f),
+                    border = BorderStroke(1.dp, MaterialTheme.colorScheme.outline.copy(alpha = 0.15f)),
+                ) {
+                    Column(modifier = Modifier.padding(20.dp)) {
+                        Text("Taste DNA", style = MaterialTheme.typography.titleMedium, fontWeight = FontWeight.SemiBold)
+                        if (genreCounts.isEmpty()) {
+                            Text(
+                                text = if (total > 0 && loaded < total) "Reading your titles, one moment..." else "Watch or save a few titles and your taste shows up here.",
+                                style = MaterialTheme.typography.bodySmall,
+                                color = MaterialTheme.colorScheme.onSurfaceVariant,
+                                modifier = Modifier.padding(vertical = 18.dp),
+                            )
+                        } else {
+                            InsightsGenreDonut(genreCounts)
+                            if (movies + seriesCount > 0) {
+                                InsightsBalanceBar(movies = movies, series = seriesCount)
+                            }
+                            InsightsChips(genreCounts.take(6).map { it.first })
+                        }
+                    }
+                }
+
+                if (statsEnabled || summary.total > 0.0) {
+                    TextRowAction(
+                        text = if (statsEnabled) "Counting watch time is on" else "Counting watch time is off",
+                        onClick = { DxWatchStats.setEnabled(!statsEnabled) },
+                    )
+                    TextRowAction(
+                        text = "Reset counted watch time",
+                        onClick = { DxWatchStats.reset(); refreshTick += 1 },
+                    )
+                }
+            }
+        }
+
+        sheetKind?.let { kind ->
+            val sheetState = rememberModalBottomSheetState(skipPartiallyExpanded = true)
+            val sheetItems = postersFor(kind)
+            NuvioModalBottomSheet(
+                onDismissRequest = { sheetKind = null },
+                sheetState = sheetState,
+                fullHeight = true,
+            ) {
+                Text(
+                    text = kind.label,
+                    style = MaterialTheme.typography.titleLarge,
+                    fontWeight = FontWeight.Bold,
+                    modifier = Modifier.padding(horizontal = 20.dp),
+                )
+                Text(
+                    text = "${sheetItems.size} titles",
+                    style = MaterialTheme.typography.bodySmall,
+                    color = MaterialTheme.colorScheme.onSurfaceVariant,
+                    modifier = Modifier.padding(horizontal = 20.dp, vertical = 4.dp),
+                )
+                if (sheetItems.isEmpty()) {
+                    Text(
+                        text = "Nothing here yet",
+                        modifier = Modifier.fillMaxWidth().padding(40.dp),
+                        textAlign = TextAlign.Center,
+                        color = MaterialTheme.colorScheme.onSurfaceVariant,
+                    )
+                } else {
+                    LazyVerticalGrid(
+                        columns = GridCells.Fixed(2),
+                        contentPadding = PaddingValues(start = 20.dp, end = 20.dp, top = 12.dp, bottom = 32.dp),
+                        horizontalArrangement = Arrangement.spacedBy(12.dp),
+                        verticalArrangement = Arrangement.spacedBy(14.dp),
+                        modifier = Modifier.fillMaxSize(),
+                    ) {
+                        items(sheetItems, key = { it.key + it.subtitle }) { poster ->
+                            Column {
+                                Box(
+                                    modifier = Modifier
+                                        .fillMaxWidth()
+                                        .aspectRatio(2f / 3f)
+                                        .clip(RoundedCornerShape(14.dp))
+                                        .background(MaterialTheme.colorScheme.surfaceVariant),
+                                ) {
+                                    if (poster.poster != null) {
+                                        AsyncImage(
+                                            model = poster.poster,
+                                            contentDescription = poster.title,
+                                            contentScale = ContentScale.Crop,
+                                            modifier = Modifier.fillMaxSize(),
+                                        )
+                                    }
+                                }
+                                Text(
+                                    text = poster.title,
+                                    style = MaterialTheme.typography.bodyMedium,
+                                    fontWeight = FontWeight.SemiBold,
+                                    maxLines = 1,
+                                    overflow = TextOverflow.Ellipsis,
+                                    modifier = Modifier.padding(top = 6.dp),
+                                )
+                                poster.subtitle?.let {
+                                    Text(
+                                        text = it,
+                                        style = MaterialTheme.typography.labelSmall,
+                                        color = MaterialTheme.colorScheme.onSurfaceVariant,
+                                        maxLines = 1,
+                                        overflow = TextOverflow.Ellipsis,
+                                    )
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    if (editing && profile != null) {
+        Dialog(
+            onDismissRequest = { editing = false },
+            properties = DialogProperties(usePlatformDefaultWidth = false, decorFitsSystemWindows = false),
+        ) {
+            Box(modifier = Modifier.fillMaxSize().background(MaterialTheme.colorScheme.background)) {
+                ProfileEditScreen(
+                    profile = profile,
+                    onBack = { editing = false },
+                    onSaved = { editing = false },
+                )
+            }
+        }
+    }
+}
+
+@Composable
+private fun TextRowAction(text: String, onClick: () -> Unit) {
+    Text(
+        text = text,
+        style = MaterialTheme.typography.bodyMedium,
+        color = MaterialTheme.colorScheme.primary,
+        modifier = Modifier
+            .padding(top = 8.dp)
+            .clip(RoundedCornerShape(12.dp))
+            .clickable(onClick = onClick)
+            .padding(horizontal = 16.dp, vertical = 8.dp),
+    )
+}
+
+@Composable
+private fun InsightsGenreDonut(genres: List<Pair<String, Int>>) {
+    val top = genres.take(7)
+    val others = genres.drop(7).sumOf { it.second }
+    val slices = top.mapIndexed { i, g -> Triple(g.first, g.second, DonutPalette[i % DonutPalette.size]) } +
+        (if (others > 0) listOf(Triple("Others", others, DonutOthers)) else emptyList())
+    val sum = slices.sumOf { it.second }.coerceAtLeast(1)
+    Row(
+        modifier = Modifier.fillMaxWidth().padding(top = 16.dp),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        Canvas(modifier = Modifier.size(132.dp)) {
+            val stroke = 26.dp.toPx()
+            val inset = stroke / 2f
+            var start = -90f
+            slices.forEach { (_, count, color) ->
+                val sweep = 360f * count / sum
+                drawArc(
+                    color = color,
+                    startAngle = start,
+                    sweepAngle = (sweep - 2f).coerceAtLeast(0.5f),
+                    useCenter = false,
+                    topLeft = Offset(inset, inset),
+                    size = Size(size.width - stroke, size.height - stroke),
+                    style = Stroke(width = stroke, cap = StrokeCap.Butt),
+                )
+                start += sweep
+            }
+        }
+        Column(modifier = Modifier.padding(start = 18.dp), verticalArrangement = Arrangement.spacedBy(6.dp)) {
+            slices.forEach { (name, count, color) ->
+                Row(verticalAlignment = Alignment.CenterVertically) {
+                    Box(Modifier.size(10.dp).clip(CircleShape).background(color))
+                    Text(
+                        text = "  $name  ${(100f * count / sum).roundToInt()}%",
+                        style = MaterialTheme.typography.bodySmall,
+                        maxLines = 1,
+                        overflow = TextOverflow.Ellipsis,
+                    )
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun InsightsBalanceBar(movies: Int, series: Int) {
+    val total = (movies + series).coerceAtLeast(1)
+    val moviePct = (100f * movies / total).roundToInt()
+    Column(modifier = Modifier.fillMaxWidth().padding(top = 20.dp)) {
+        Row(modifier = Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween) {
+            Text("Movies $moviePct%", style = MaterialTheme.typography.labelMedium)
+            Text("Series ${100 - moviePct}%", style = MaterialTheme.typography.labelMedium)
+        }
+        Row(
+            modifier = Modifier.fillMaxWidth().padding(top = 6.dp).height(10.dp).clip(RoundedCornerShape(5.dp)),
+        ) {
+            if (movies > 0) Box(Modifier.weight(movies.toFloat()).height(10.dp).background(Color(0xFFFF6384)))
+            if (series > 0) Box(Modifier.weight(series.toFloat()).height(10.dp).background(Color(0xFF36A2EB)))
+        }
+    }
+}
+
+@OptIn(ExperimentalLayoutApi::class)
+@Composable
+private fun InsightsChips(labels: List<String>) {
+    FlowRow(
+        modifier = Modifier.fillMaxWidth().padding(top = 18.dp),
+        horizontalArrangement = Arrangement.spacedBy(8.dp),
+        verticalArrangement = Arrangement.spacedBy(8.dp),
+    ) {
+        labels.forEach { label ->
+            Text(
+                text = label,
+                style = MaterialTheme.typography.labelMedium,
+                modifier = Modifier
+                    .clip(RoundedCornerShape(50))
+                    .background(MaterialTheme.colorScheme.primary.copy(alpha = 0.16f))
+                    .padding(horizontal = 12.dp, vertical = 6.dp),
+            )
+        }
+    }
+}
