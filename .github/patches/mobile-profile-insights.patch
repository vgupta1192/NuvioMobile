+/**
+ * Enhanced-style profile card + insights page for the settings root. Replaces the old "Your stats" list.
+ * Data comes from the fork's own repositories (progress, watched, library) and is enriched with title
+ * details (genres, runtime, episode dates) fetched in the background and kept in memory.
+ */
+
+private data class InsightsPoster(
+    val key: String,
+    val title: String,
+    val subtitle: String?,
+    val poster: String?,
+)
+
+private enum class InsightsKind(val label: String) {
+    Watching("Watching"),
+    Saved("Saved"),
+    Upcoming("Upcoming"),
+    Completed("Completed"),
+    Ongoing("Ongoing"),
+    Episodes("Episodes"),
+    Watched("Watched"),
+}
+
+private data class InsightsTitleFacts(
+    val genres: List<String>,
+    val runtimeMinutes: Int,
+    val upcoming: List<InsightsUpcoming>,
+)
+
+private data class InsightsUpcoming(
+    val date: String,
+    val label: String?,
+    val image: String?,
+)
+
+private val insightsFactsCache = HashMap<String, InsightsTitleFacts>()
+private var insightsFactsUpdatedAt: Long = 0L
+
+private val DonutPalette = listOf(
+    Color(0xFFFF6384), Color(0xFFFF9F40), Color(0xFFFFCD56), Color(0xFF4BC0C0),
+    Color(0xFF36A2EB), Color(0xFF9966FF), Color(0xFFE879F9),
+)
+private val DonutOthers = Color(0xFF8A8A96)
+
+private fun parseRuntimeMinutes(raw: String?): Int {
+    if (raw.isNullOrBlank()) return 0
+    val hours = Regex("(\\d+)\\s*h").find(raw)?.groupValues?.get(1)?.toIntOrNull() ?: 0
+    val mins = Regex("(\\d+)\\s*m").find(raw)?.groupValues?.get(1)?.toIntOrNull()
+    if (hours > 0 || mins != null) return hours * 60 + (mins ?: 0)
+    return Regex("(\\d+)").find(raw)?.groupValues?.get(1)?.toIntOrNull() ?: 0
+}
+
+private fun isSeriesType(type: String): Boolean =
+    !type.equals("movie", ignoreCase = true)
+
+private fun formatWatchTime(seconds: Double): String {
+    val totalMinutes = (seconds / 60.0).roundToInt()
+    val days = totalMinutes / (60 * 24)
+    val hours = (totalMinutes % (60 * 24)) / 60
+    val minutes = totalMinutes % 60
+    return when {
+        days > 0 -> "~${days}d ${hours}h"
+        hours > 0 -> "~${hours}h ${minutes}m"
+        else -> "~${minutes}m"
+    }
+}
+
+private fun agoText(updatedAt: Long): String {
+    if (updatedAt <= 0L) return "Not updated yet"
+    val minutes = ((WatchProgressClock.nowEpochMs() - updatedAt) / 60_000L).coerceAtLeast(0)
+    return when {
+        minutes < 1 -> "Updated just now"
+        minutes < 60 -> "Updated $minutes min ago"
+        minutes < 60 * 24 -> "Updated ${minutes / 60} h ago"
+        else -> "Updated ${minutes / (60 * 24)} d ago"
+    }
+}
