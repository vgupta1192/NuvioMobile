+@Composable
+private fun InsightsAvatar(profile: NuvioProfile?, imageUrl: String?, size: Int) {
+    val base = profile?.let { runCatching { parseHexColor(it.avatarColorHex) }.getOrNull() }
+        ?: MaterialTheme.colorScheme.primary
+    Box(
+        modifier = Modifier.size(size.dp).clip(CircleShape).background(base),
+        contentAlignment = Alignment.Center,
+    ) {
+        if (imageUrl != null) {
+            AsyncImage(
+                model = imageUrl,
+                contentDescription = null,
+                contentScale = ContentScale.Crop,
+                modifier = Modifier.fillMaxSize(),
+            )
+        } else {
+            Text(
+                text = profile?.name?.firstOrNull()?.uppercase() ?: "?",
+                fontSize = (size / 2.4f).sp,
+                fontWeight = FontWeight.Bold,
+                color = Color.White,
+            )
+        }
+    }
+}
