--- /dev/null
+++ b/composeApp/src/commonMain/kotlin/com/nuvio/app/features/streams/CloudStreamGroupMerge.kt
@@ -0,0 +1,32 @@
+package com.nuvio.app.features.streams
+
+internal const val CLOUDSTREAM_MERGED_ID = "cloudstream-merged"
+internal const val CLOUDSTREAM_MERGED_NAME = "CS3"
+
+/**
+ * Nuvio fork: folds every CloudStream provider group into one "CS3" tab. Each stream keeps its
+ * provider name as sourceName, so the list shows one sub-header per provider inside the tab.
+ */
+internal fun List<AddonStreamGroup>.withMergedCloudStreamGroups(): List<AddonStreamGroup> {
+    val cloud = filter { it.addonId.startsWith("cloudstream:") }
+    if (cloud.size < 2) return this
+    val merged = AddonStreamGroup(
+        addonName = CLOUDSTREAM_MERGED_NAME,
+        addonId = CLOUDSTREAM_MERGED_ID,
+        streams = cloud.flatMap { group ->
+            group.streams.map { stream -> stream.copy(sourceName = group.addonName) }
+        },
+        isLoading = cloud.any { it.isLoading },
+        error = if (cloud.all { it.error != null }) cloud.first().error else null,
+    )
+    val firstIndex = indexOfFirst { it.addonId.startsWith("cloudstream:") }
+    val result = ArrayList<AddonStreamGroup>(size)
+    forEachIndexed { index, group ->
+        if (index == firstIndex) result += merged
+        if (!group.addonId.startsWith("cloudstream:")) result += group
+    }
+    return result
+}
+
+internal fun StreamsUiState.withMergedCloudStreamGroups(): StreamsUiState =
+    copy(groups = groups.withMergedCloudStreamGroups())
