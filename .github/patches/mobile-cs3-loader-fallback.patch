+    private fun loadPluginClass(context: Context, file: File, pluginClassName: String): Class<*> {
+        val nativeLibDir = context.applicationInfo.nativeLibraryDir
+        val pathFailure = try {
+            return PathClassLoader(file.absolutePath, nativeLibDir, context.classLoader).loadClass(pluginClassName)
+        } catch (error: ClassNotFoundException) {
+            error
+        }
+        val dexEntries = ZipFile(file).use { archive ->
+            archive.entries().asSequence()
+                .filter { entry -> !entry.isDirectory }
+                .map { entry -> entry.name to entry.size }
+                .toList()
+        }
+        val inMemoryFailure = try {
+            val buffers = ZipFile(file).use { archive ->
+                dexEntries
+                    .filter { (name, _) -> name.endsWith(".dex") }
+                    .map { (name, _) ->
+                        ByteBuffer.wrap(archive.getInputStream(archive.getEntry(name)).use { it.readBytes() })
+                    }
+            }
+            if (buffers.isEmpty() || Build.VERSION.SDK_INT < Build.VERSION_CODES.O) {
+                null
+            } else {
+                return InMemoryDexClassLoader(buffers.toTypedArray(), context.classLoader).loadClass(pluginClassName)
+            }
+        } catch (error: Throwable) {
+            error
+        }
+        val suppressed = pathFailure.suppressed.joinToString("; ") { it.toString().take(160) }
+        throw IllegalStateException(
+            "Class $pluginClassName not loadable (sdk ${Build.VERSION.SDK_INT}, size ${file.length()}, " +
+                "entries ${dexEntries.joinToString { "${it.first}:${it.second}" }}). " +
+                "Path loader: ${pathFailure.message?.take(60)}; suppressed: ${suppressed.ifBlank { "none" }}. " +
+                "In-memory loader: ${inMemoryFailure?.toString()?.take(200) ?: "no dex or sdk too old"}",
+        )
+    }
