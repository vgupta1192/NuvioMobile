+/**
+ * Messages are resolved asynchronously (string lookups), so a slow "Analyzing" could land after a
+ * fast result and leave a working bubble that never ends. A ticket taken when a message is
+ * issued lets a stale message be dropped once a newer one has been shown.
+ */
+internal object AutoSyncMessageOrder {
+    private var issued = 0L
+    private var shown = 0L
+
+    @Synchronized
+    fun ticket(): Long = ++issued
+
+    @Synchronized
+    fun shouldShow(ticket: Long): Boolean {
+        if (ticket < shown) return false
+        shown = ticket
+        return true
+    }
+}
