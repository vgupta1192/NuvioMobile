+package com.nuvio.app.features.settings
+
+import androidx.compose.material3.Text
+import androidx.compose.material3.TextButton
+import androidx.compose.runtime.Composable
+import com.nuvio.app.features.player.rememberSubtitleFontPicker
+
+/**
+ * Nuvio fork (ported from NuvioMobile-Reshaped): import a TTF/OTF font for subtitles, used by
+ * ExoPlayer and libmpv. Hidden where fonts can't be imported (iOS).
+ */
+@Composable
+internal fun SubtitleFontSettingsSection(isTablet: Boolean) {
+    val picker = rememberSubtitleFontPicker() ?: return
+    SettingsSection(
+        title = "Subtitle font",
+        isTablet = isTablet,
+    ) {
+        SettingsGroup(isTablet = isTablet) {
+            SettingsNavigationRow(
+                title = "Subtitle font",
+                description = when {
+                    picker.isImporting -> "Importing font…"
+                    picker.fontName != null -> picker.fontName
+                    else -> "Default. Tap to import a .ttf or .otf file"
+                },
+                enabled = !picker.isImporting,
+                isTablet = isTablet,
+                trailingContent = if (picker.fontName != null) {
+                    {
+                        TextButton(onClick = picker.reset) {
+                            Text("Reset")
+                        }
+                    }
+                } else {
+                    null
+                },
+                onClick = picker.pick,
+            )
+        }
+    }
+}
