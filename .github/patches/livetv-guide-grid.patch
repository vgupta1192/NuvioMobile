+private val GuideChannelColumnWidth = 116.dp
+private val GuideRowHeight = 58.dp
+private val GuideHeaderHeight = 28.dp
+private val GuideDpPerMinute = 4.dp
+private const val GUIDE_BACK_MINUTES = 30
+private const val GUIDE_SPAN_MINUTES = 8 * 60
+private const val GUIDE_SLOT_MINUTES = 30
+
+/**
+ * Programme guide as a timeline grid (fork feature): channels down the side, time across the top,
+ * programmes as blocks sized by their length with a line at "now". Tap a block to open the channel.
+ */
+@Composable
+internal fun LiveTvGuideGrid(
+    state: LiveTvUiState,
+    epgRevision: Int,
+    nowMs: Long,
+    modifier: Modifier = Modifier,
+) {
+    val tokens = MaterialTheme.nuvio
+    val density = LocalDensity.current
+    val timelineScroll = rememberScrollState()
+    val slotMs = GUIDE_SLOT_MINUTES * 60_000L
+    val windowStartMs = remember(nowMs / slotMs) { (nowMs / slotMs) * slotMs - GUIDE_BACK_MINUTES * 60_000L }
+    val windowEndMs = windowStartMs + GUIDE_SPAN_MINUTES * 60_000L
+    val timelineWidth = GuideDpPerMinute * GUIDE_SPAN_MINUTES
+    val nowOffset = GuideDpPerMinute * ((nowMs - windowStartMs) / 60_000f)
+
+    LaunchedEffect(windowStartMs) {
+        // Open scrolled so "now" sits near the left edge of the timeline.
+        val target = with(density) { (nowOffset - 40.dp).coerceAtLeast(0.dp).roundToPx() }
+        timelineScroll.scrollTo(target)
+    }
+
+    if (state.filteredChannels.isEmpty()) {
+        Box(modifier = modifier, contentAlignment = Alignment.Center) {
+            Text(text = "No channels", color = tokens.colors.textMuted)
+        }
+        return
+    }
+
+    Column(modifier = modifier) {
+        Row(modifier = Modifier.fillMaxWidth().height(GuideHeaderHeight)) {
+            Box(modifier = Modifier.width(GuideChannelColumnWidth))
+            Box(modifier = Modifier.weight(1f).fillMaxHeight().horizontalScroll(timelineScroll)) {
+                Box(modifier = Modifier.width(timelineWidth).fillMaxHeight()) {
+                    var slotMs2 = windowStartMs
+                    while (slotMs2 < windowEndMs) {
+                        val atMinutes = (slotMs2 - windowStartMs) / 60_000f
+                        Text(
+                            text = LiveTvPlatform.formatClock(slotMs2),
+                            style = MaterialTheme.typography.labelSmall,
+                            color = tokens.colors.textMuted,
+                            modifier = Modifier
+                                .offset(x = GuideDpPerMinute * atMinutes + 4.dp)
+                                .align(Alignment.CenterStart),
+                        )
+                        slotMs2 += slotMs
+                    }
+                }
+            }
+        }
+        LazyColumn(modifier = Modifier.fillMaxSize()) {
+            items(state.filteredChannels, key = { "guide:" + it.stableKey() }) { channel ->
+                val epg = remember(channel, epgRevision, nowMs / 60_000L) { LiveTvEpgRepository.epgFor(channel, nowMs) }
+                GuideRow(
+                    channel = channel,
+                    programs = epg?.programs.orEmpty(),
+                    selected = state.selectedChannel?.stableKey() == channel.stableKey(),
+                    windowStartMs = windowStartMs,
+                    windowEndMs = windowEndMs,
+                    nowMs = nowMs,
+                    timelineWidth = timelineWidth,
+                    nowOffset = nowOffset,
+                    scrollState = timelineScroll,
+                )
+            }
+        }
+    }
+}
+
+@Composable
+private fun GuideRow(
+    channel: LiveTvChannel,
+    programs: List<EpgProgram>,
+    selected: Boolean,
+    windowStartMs: Long,
+    windowEndMs: Long,
+    nowMs: Long,
+    timelineWidth: Dp,
+    nowOffset: Dp,
+    scrollState: androidx.compose.foundation.ScrollState,
+) {
+    val tokens = MaterialTheme.nuvio
+    val rowShape = RoundedCornerShape(10.dp)
+    Row(
+        modifier = Modifier
+            .fillMaxWidth()
+            .height(GuideRowHeight)
+            .padding(vertical = 2.dp),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        Row(
+            modifier = Modifier
+                .width(GuideChannelColumnWidth)
+                .fillMaxHeight()
+                .clip(rowShape)
+                .background(if (selected) tokens.colors.accent.copy(alpha = 0.18f) else tokens.colors.surfaceCard)
+                .clickable { LiveTvRepository.selectChannel(channel) }
+                .padding(horizontal = 6.dp),
+            verticalAlignment = Alignment.CenterVertically,
+            horizontalArrangement = Arrangement.spacedBy(6.dp),
+        ) {
+            val logo = channel.displayLogo
+            if (logo != null) {
+                AsyncImage(
+                    model = logo,
+                    contentDescription = null,
+                    modifier = Modifier.size(28.dp),
+                    contentScale = ContentScale.Fit,
+                )
+            }
+            Text(
+                text = channel.name,
+                style = MaterialTheme.typography.labelSmall,
+                color = tokens.colors.textPrimary,
+                maxLines = 2,
+                overflow = TextOverflow.Ellipsis,
+            )
+        }
+        Box(
+            modifier = Modifier
+                .weight(1f)
+                .fillMaxHeight()
+                .horizontalScroll(scrollState),
+        ) {
+            Box(
+                modifier = Modifier
+                    .width(timelineWidth)
+                    .fillMaxHeight()
+                    .drawBehind {
+                        val x = nowOffset.toPx()
+                        drawLine(
+                            color = Color(0xFFFF5252),
+                            start = Offset(x, 0f),
+                            end = Offset(x, size.height),
+                            strokeWidth = 2.dp.toPx(),
+                        )
+                    },
+            ) {
+                val visible = programs.filter { it.endEpochMs > windowStartMs && it.startEpochMs < windowEndMs }
+                if (visible.isEmpty()) {
+                    Text(
+                        text = "No guide data",
+                        style = MaterialTheme.typography.labelSmall,
+                        color = tokens.colors.textMuted,
+                        modifier = Modifier.align(Alignment.CenterStart).padding(start = 8.dp),
+                    )
+                }
+                visible.forEach { program ->
+                    val start = maxOf(program.startEpochMs, windowStartMs)
+                    val end = minOf(program.endEpochMs, windowEndMs)
+                    val startMinutes = (start - windowStartMs) / 60_000f
+                    val widthMinutes = ((end - start) / 60_000f).coerceAtLeast(1f)
+                    val live = program.isLive(nowMs)
+                    Column(
+                        modifier = Modifier
+                            .offset(x = GuideDpPerMinute * startMinutes)
+                            .width(GuideDpPerMinute * widthMinutes - 3.dp)
+                            .fillMaxHeight()
+                            .clip(rowShape)
+                            .background(
+                                if (live) tokens.colors.accent.copy(alpha = 0.28f) else tokens.colors.surfaceCard,
+                            )
+                            .clickable { LiveTvRepository.selectChannel(channel) }
+                            .padding(horizontal = 8.dp, vertical = 4.dp),
+                        verticalArrangement = Arrangement.Center,
+                    ) {
+                        Text(
+                            text = program.title,
+                            style = MaterialTheme.typography.labelMedium.copy(
+                                fontSize = 12.sp,
+                                fontWeight = if (live) FontWeight.Bold else FontWeight.Medium,
+                            ),
+                            color = tokens.colors.textPrimary,
+                            maxLines = 1,
+                            overflow = TextOverflow.Ellipsis,
+                        )
+                        Text(
+                            text = program.timeRange,
+                            style = MaterialTheme.typography.labelSmall.copy(fontSize = 10.sp),
+                            color = tokens.colors.textMuted,
+                            maxLines = 1,
+                            overflow = TextOverflow.Ellipsis,
+                        )
+                    }
+                }
+            }
+        }
+    }
+}
