+@file:OptIn(androidx.media3.common.util.UnstableApi::class)
+
+package com.nuvio.app.features.player.seekpreview.local
+
+import android.net.Uri
+import android.os.Process
+import android.util.Log
+import androidx.media3.common.Format
+import androidx.media3.datasource.DataSource
+import androidx.media3.extractor.SeekMap
+import com.nuvio.app.features.player.audiosync.HlsAudioSpotSampler
+import kotlin.math.abs
+
+/**
+ * Seek-preview thumbnails for HLS and DASH streams (Nuvio fork). ExoPlayer reads playlists with
+ * its own extractors, which the buffer tap does not see, and their segments are cheap to reach
+ * one by one. So this reads them on purpose: the lowest-bitrate video rendition, only the start
+ * of each segment (where its first keyframe is), only while the viewer scrubs or has paused.
+ *
+ * Order: slots around the scrub position first; while paused, also a coarse grid across the
+ * title, so a first scrub anywhere already lands near a frame.
+ */
+internal class StreamPreviewFiller(
+    private val uri: Uri,
+    private val dataSourceFactory: DataSource.Factory,
+    private val track: LocalPreviewTrack,
+    private val playbackActive: () -> Boolean,
+) {
+    @Volatile private var stopped = false
+
+    fun start() {
+        Thread({
+            Process.setThreadPriority(Process.THREAD_PRIORITY_BACKGROUND)
+            runCatching { run() }.onFailure { Log.w(TAG, "playlist previews stopped: ${it.message}") }
+        }, "NuvioPreviewFill").apply {
+            isDaemon = true
+            start()
+        }
+    }
+
+    fun stop() {
+        stopped = true
+    }
+
+    private fun done() = stopped || track.isClosed
+
+    private fun run() {
+        val kind = HlsAudioSpotSampler.manifestKind(uri, dataSourceFactory) ?: return
+        val sampler = HlsAudioSpotSampler(
+            uri = uri,
+            dataSourceFactory = dataSourceFactory,
+            maxBytes = Long.MAX_VALUE,
+            dash = kind == HlsAudioSpotSampler.KIND_DASH,
+            video = true,
+        )
+        val startsUs = sampler.segmentStartsUs()
+        if (startsUs.isEmpty()) return
+        val tried = BooleanArray(startsUs.size)
+        var failures = 0
+        Log.i(TAG, "playlist previews: $kind, ${startsUs.size} segments")
+        while (!done()) {
+            if (track.isBusy()) {
+                Thread.sleep(IDLE_MS)
+                continue
+            }
+            val index = nextSegment(startsUs, tried)
+            if (index == null) {
+                Thread.sleep(IDLE_MS)
+                continue
+            }
+            tried[index] = true
+            val got = runCatching { read(sampler, index, FIRST_READ_BYTES) || read(sampler, index, SECOND_READ_BYTES) }
+                .onFailure { Log.w(TAG, "segment $index not read: ${it.message}") }
+                .getOrDefault(false)
+            if (got) {
+                failures = 0
+            } else if (++failures >= MAX_FAILURES_IN_A_ROW) {
+                Log.w(TAG, "playlist previews: $failures segments in a row without a keyframe, giving up")
+                return
+            }
+        }
+    }
+
+    /** The untried segment whose first keyframe would fill the most useful missing thumbnail. */
+    private fun nextSegment(startsUs: LongArray, tried: BooleanArray): Int? {
+        val durationMs = track.totalDurationMs
+        val focusMs = track.recentScrubMs()
+        if (focusMs != null) {
+            for (distance in 0..FOCUS_RADIUS_SLOTS) {
+                for (sign in intArrayOf(1, -1)) {
+                    if (distance == 0 && sign < 0) continue
+                    val targetMs = focusMs + sign * distance * LocalPreviewTrack.SLOT_MS
+                    if (targetMs < 0 || targetMs > durationMs) continue
+                    candidate(startsUs, tried, targetMs)?.let { return it }
+                }
+            }
+        }
+        if (playbackActive()) return null
+        var targetMs = 0L
+        while (targetMs <= durationMs) {
+            candidate(startsUs, tried, targetMs)?.let { return it }
+            targetMs += GRID_MS
+        }
+        return null
+    }
+
+    private fun candidate(startsUs: LongArray, tried: BooleanArray, targetMs: Long): Int? {
+        val index = nearestStart(startsUs, targetMs * 1_000L)
+        if (tried[index]) return null
+        val startMs = startsUs[index] / 1_000L
+        // Only when that segment's keyframe lands near the target and its slot still needs one.
+        if (abs(startMs - targetMs) > LocalPreviewTrack.SLOT_MS) return null
+        if (!track.wantsFrameAt(startMs)) {
+            tried[index] = true
+            return null
+        }
+        return index
+    }
+
+    private fun nearestStart(startsUs: LongArray, targetUs: Long): Int {
+        var low = 0
+        var high = startsUs.size - 1
+        while (low < high) {
+            val mid = (low + high) / 2
+            if (startsUs[mid] < targetUs) low = mid + 1 else high = mid
+        }
+        return if (low > 0 && abs(startsUs[low - 1] - targetUs) <= abs(startsUs[low] - targetUs)) low - 1 else low
+    }
+
+    /** Reads the start of segment [index]; true once its first keyframe went to the track. */
+    private fun read(sampler: HlsAudioSpotSampler, index: Int, limitBytes: Long): Boolean {
+        var got = false
+        val sink = object : KeyframeSink {
+            override fun wantsKeyframes(): Boolean = !got
+            override fun wantsKeyframe(timeUs: Long): Boolean = !got
+            override fun onKeyframe(format: Format, timeUs: Long, data: ByteArray, offset: Int, size: Int) {
+                got = true
+                track.offerKeyframe(format, timeUs, data, offset, size)
+            }
+            override fun onSeekMap(seekMap: SeekMap) = Unit
+        }
+        runCatching {
+            sampler.readSegmentStart(index, limitBytes, { factory -> VideoKeyframeExtractorsFactory(factory, sink) }) { got || done() }
+        }.onFailure { if (!got) throw it }
+        return got
+    }
+
+    companion object {
+        private const val TAG = "NuvioLocalPreviews"
+        private const val IDLE_MS = 250L
+        private const val FOCUS_RADIUS_SLOTS = 6
+        private const val GRID_MS = 60_000L
+        private const val FIRST_READ_BYTES = 1_500_000L
+        private const val SECOND_READ_BYTES = 6_000_000L
+        private const val MAX_FAILURES_IN_A_ROW = 8
+    }
+}
