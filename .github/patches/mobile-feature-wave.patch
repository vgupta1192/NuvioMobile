+import com.nuvio.app.features.home.MetaPreview
+import com.nuvio.app.features.home.stableKey
+
+/**
+ * Nuvio fork: the short "why" badge the Smart Highlights rail draws on each featured poster.
+ * Dark scrim with white label text so it stays legible over any artwork.
+ */
+@Composable
+internal fun SmartHighlightReasonChip(
+    text: String,
+    modifier: Modifier = Modifier,
+) {
+    Text(
+        text = text,
+        style = MaterialTheme.typography.labelMedium,
+        color = Color.White,
+        maxLines = 1,
+        overflow = TextOverflow.Ellipsis,
+        modifier = modifier
+            .clip(RoundedCornerShape(6.dp))
+            .background(Color.Black.copy(alpha = 0.72f))
+            .padding(horizontal = 8.dp, vertical = 3.dp),
+    )
+}
+
+/**
+ * Nuvio fork: the Smart Highlights rail — top picks from the profile's own library and progress,
+ * with a reason chip drawn onto each poster. Clicks navigate to the detail screen like any
+ * catalog card. Hidden entirely when [picks] is empty.
+ */
+@Composable
+internal fun SmartHighlightsRailSection(
+    title: String,
+    picks: List<SmartHighlightPick>,
+    sectionPadding: androidx.compose.ui.unit.Dp,
+    modifier: Modifier = Modifier,
+    onPosterClick: ((MetaPreview) -> Unit)? = null,
+    onPosterLongClick: ((MetaPreview) -> Unit)? = null,
+) {
+    if (picks.isEmpty()) return
+    NuvioShelfSection(
+        title = title,
+        entries = picks,
+        modifier = modifier,
+        headerHorizontalPadding = sectionPadding,
+        rowContentPadding = PaddingValues(horizontal = sectionPadding),
+        key = { pick -> "${pick.item.stableKey()}|highlight" },
+    ) { pick ->
+        SmartHighlightPosterCard(
+            pick = pick,
+            onClick = onPosterClick?.let { { it(pick.item) } },
+            onLongClick = onPosterLongClick?.let { { it(pick.item) } },
+        )
+    }
+}
+
+@Composable
+private fun SmartHighlightPosterCard(
+    pick: SmartHighlightPick,
+    onClick: (() -> Unit)?,
+    onLongClick: (() -> Unit)?,
+    modifier: Modifier = Modifier,
+) {
+    Box(modifier = modifier) {
+        HomePosterCard(
+            item = pick.item,
+            onClick = onClick,
+            onLongClick = onLongClick,
+        )
+        SmartHighlightReasonChip(
+            text = pick.reason,
+            modifier = Modifier
+                .align(Alignment.BottomStart)
+                .padding(8.dp),
+        )
+    }
+}
