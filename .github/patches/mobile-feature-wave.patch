diff --git a/composeApp/src/iosMain/kotlin/com/nuvio/app/features/tvdb/TvdbSettingsStorage.ios.kt b/composeApp/src/iosMain/kotlin/com/nuvio/app/features/tvdb/TvdbSettingsStorage.ios.kt
