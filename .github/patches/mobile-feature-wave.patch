+import kotlin.math.exp
+import kotlin.math.ln
+import kotlin.math.pow
+
+private const val INTRO_WATCHDOG_EXTRA_MS = 2_500L
+
+/** The wordmark resource's aspect (app_logo_wordmark.png is 1085 x 344). */
+private const val WORDMARK_ASPECT = 1085f / 344f
+
+// Phase boundaries as fractions of the intro's length (of the 5 s intro's shape).
+private const val PHASE_SETTLE_START = 0.07f
+private const val PHASE_SETTLE_END = 0.14f
+private const val PHASE_SPLIT_START = 0.14f
+private const val PHASE_SPLIT_END = 0.20f
+private const val PHASE_HOLD_END = 0.62f
+private const val PHASE_UNSPLIT_END = 0.71f
+private const val PHASE_ZOOM_START = 0.71f
+
+/**
+ * Draws the playback intro above the whole player while [PlaybackIntroState] is active. Nothing
+ * is composed or drawn when it isn't. The intro runs for the length the playback settings chose
+ * and ends early once the player's first video frame is ready; Back skips it.
+ *
+ * The animation is a Compose canvas re-interpretation of the fork's TV intro: the ring logo
+ * lands with an overshoot, the "nuvio" wordmark slides out of it and back, then the camera
+ * rushes through nested rings and the whole thing fades to black. The chime (where the platform
+ * has one) follows the same timeline.
+ */
+@Composable
+internal fun PlaybackIntroHost() {
+    val active by PlaybackIntroState.active.collectAsState()
+    if (!active) return
+    // The length chosen in playback settings, fixed for this intro.
+    val timeline = remember { IntroTimeline(PlaybackIntroState.lengthSeconds) }
+    // Never left up: if the intro can't draw or finish for any reason, it goes shortly after its
+    // own length and the player carries on (the loading screen follows, as usual).
+    LaunchedEffect(Unit) {
+        delay(timeline.totalMs + INTRO_WATCHDOG_EXTRA_MS)
+        PlaybackIntroState.finish()
+    }
+    PlatformBackHandler(enabled = true) {
+        PlaybackIntroState.finish()
+    }
+    Box(
+        modifier = Modifier
+            .fillMaxSize()
+            .background(Color.Black),
+    ) {
+        val wordmark = imageResource(Res.drawable.app_logo_wordmark)
+        val timeMs = remember(timeline) { mutableStateOf(0f) }
+        LaunchedEffect(timeline) {
+            var startNanos = -1L
+            while (true) {
+                withFrameNanos { now ->
+                    if (startNanos < 0L) startNanos = now
+                    timeMs.value = (now - startNanos) / 1_000_000f
+                }
+                if (timeMs.value >= timeline.totalMs) {
+                    PlaybackIntroState.finish()
+                    break
+                }
+            }
+        }
+        val t = timeMs.value
+        Canvas(Modifier.fillMaxSize()) {
+            drawIntroFrame(t, timeline, wordmark)
+        }
+        DisposableEffect(timeline.seconds) {
+            val player = platformIntroChimePlayer(timeline.seconds)
+            player?.start()
+            onDispose { player?.release() }
+        }
+    }
+}
+
+/**
+ * Milestones of an intro [seconds] long, in milliseconds. The 5 s intro is as tuned; the others
+ * scale every part by seconds / 5, so each keeps its share. The chime follows the same timeline.
+ */
+internal class IntroTimeline(val seconds: Int) {
+    private val scale = seconds / 5f
+
+    val pulse1 = 4100f * scale
+    val pulse2 = 4450f * scale
+    val fadeStart = 4650f * scale
+    val totalMs = 5000f * scale
+
+    /** The pulse and fade widths keep their share of the length. */
+    val pulseWidth1 = 120f * scale
+    val pulseWidth2 = 130f * scale
+    val appearWidthMs = 150f * scale
+}
+
+// ── One frame ────────────────────────────────────────────────────────────────────────────────
+
+private fun DrawScope.drawIntroFrame(t: Float, timeline: IntroTimeline, wordmark: ImageBitmap) {
+    if (t <= 0f) return
+    val fade = if (t < timeline.fadeStart) 1f else 1f - progress(t, timeline.fadeStart, timeline.totalMs)
+    if (fade <= 0f) return
+    val cx = size.width / 2f
+    val cy = size.height / 2f
+    val densityPx = 1.dp.toPx()
+    val logoPx = 200f * densityPx
+    val wordHeightPx = 62f * densityPx
+    val gapPx = 18f * densityPx
+    val shrunk = 0.72f
+
+    if (t < PHASE_ZOOM_START * timeline.totalMs) {
+        drawLogoAndWord(t, timeline, cx, cy, logoPx, wordHeightPx, gapPx, shrunk, wordmark, fade)
+    } else {
+        drawZoom(t, timeline, cx, cy, logoPx, densityPx, fade)
+    }
+}
+
+// ── Logo lands, word slides out and back ─────────────────────────────────────────────────────
+
+private fun DrawScope.drawLogoAndWord(
+    t: Float,
+    timeline: IntroTimeline,
+    cx: Float,
+    cy: Float,
+    logoPx: Float,
+    wordHeightPx: Float,
+    gapPx: Float,
+    shrunk: Float,
+    wordmark: ImageBitmap,
+    fade: Float,
+) {
+    val overshootEnd = PHASE_SETTLE_START * timeline.totalMs
+    val settleEnd = PHASE_SETTLE_END * timeline.totalMs
+    val landScale = when {
+        t < overshootEnd -> lerp(0.55f, 1.08f, easeOut(t / overshootEnd))
+        t < settleEnd -> lerp(1.08f, 1f, easeInOut((t - overshootEnd) / (settleEnd - overshootEnd)))
+        else -> 1f
+    }
+    val splitStartMs = PHASE_SPLIT_START * timeline.totalMs
+    val splitEndMs = PHASE_SPLIT_END * timeline.totalMs
+    val holdEndMs = PHASE_HOLD_END * timeline.totalMs
+    val unsplitEndMs = PHASE_UNSPLIT_END * timeline.totalMs
+    val split = when {
+        t < splitStartMs -> 0f
+        t < splitEndMs -> easeInOut((t - splitStartMs) / (splitEndMs - splitStartMs))
+        t < holdEndMs -> 1f
+        else -> 1f - easeInOut((t - holdEndMs) / (unsplitEndMs - holdEndMs))
+    }
+    // A slow drift while the word is out, so the hold doesn't look frozen.
+    val hold = progress(t, splitEndMs, holdEndMs)
+    val drift = 1f + 0.035f * easeInOut(hold) * split
+    val scale = landScale * lerp(1f, shrunk, split) * drift
+    val wordWidthPx = wordHeightPx * WORDMARK_ASPECT
+    val groupWidth = logoPx * shrunk + gapPx + wordWidthPx
+    val sideBySideX = cx - groupWidth / 2 + logoPx * shrunk / 2
+    val logoX = lerp(cx, sideBySideX, split)
+    val ringSize = logoPx * scale
+
+    // The ring logo: a white ring with its play symbol.
+    drawRing(logoX, cy, ringSize, alpha = fade)
+    val playAlpha = fade * easeOut((t / overshootEnd).coerceIn(0f, 1f))
+    if (playAlpha > 0.01f) drawPlay(logoX, cy, ringSize, alpha = playAlpha)
+
+    if (split > 0f) {
+        val wordLeftRest = logoX + logoPx * shrunk * drift / 2 + gapPx
+        val wordLeft = lerp(wordLeftRest - wordWidthPx - gapPx, wordLeftRest, split)
+        val wordAlpha = (fade * (split * 1.6f)).coerceAtMost(1f)
+        val logoRight = logoX + ringSize * 0.42f
+        clipRect(left = logoRight, top = 0f, right = size.width, bottom = size.height) {
+            drawImage(
+                image = wordmark,
+                srcOffset = IntOffset.Zero,
+                srcSize = IntSize(wordmark.width, wordmark.height),
+                dstOffset = IntOffset(wordLeft.toInt(), (cy - wordHeightPx / 2).toInt()),
+                dstSize = IntSize(wordWidthPx.toInt(), wordHeightPx.toInt()),
+                alpha = wordAlpha,
+                filterQuality = FilterQuality.Medium,
+            )
+        }
+    }
+}
+
+// ── Through the logos ────────────────────────────────────────────────────────────────────────
+
+/** Each logo is this fraction of the size of the one in front of it (the spacing). */
+private const val NEST_RATIO = 0.42f
+
+/** Logos passed in the 5 s intro (other lengths in proportion, at the same speed). */
+private const val ZOOM_LEVELS = 19.5f
+
+/** The zoom's speed slope: 1 = steady; higher starts slower and rushes at the end. */
+private const val ZOOM_CURVE = 2.7f
+
+/** Logos stay until they're this many screens wide: flown out past the corners. */
+private const val REACH = 10f
+
+/** How far down the tunnel you see before the logos fade to dark, in logos. */
+private const val FOG_DEPTH = 6.5f
+
+/** Logos drawn at most per frame. */
+private const val LAYERS_MAX = 21
+
+private fun DrawScope.drawZoom(
+    t: Float,
+    timeline: IntroTimeline,
+    cx: Float,
+    cy: Float,
+    logoPx: Float,
+    densityPx: Float,
+    fade: Float,
+) {
+    val zoomStartMs = PHASE_ZOOM_START * timeline.totalMs
+    val levels = ZOOM_LEVELS * progress(t, zoomStartMs, timeline.totalMs).pow(ZOOM_CURVE)
+    val camera = (1f / NEST_RATIO).pow(levels)
+    val appear = progress(t, zoomStartMs, zoomStartMs + timeline.appearWidthMs)
+    // Two pulses of a coloured streak, timed with the sound's swells.
+    val pulse = gaussian(t, timeline.pulse1, timeline.pulseWidth1) * 0.8f +
+        gaussian(t, timeline.pulse2, timeline.pulseWidth2)
+    val screen = minOf(size.width, size.height)
+    val minPx = 6f * densityPx
+    val lnNest = ln(1f / NEST_RATIO)
+
+    // Nearest (biggest) first, drawn from the far end, so nearer logos land in front.
+    val fromK = (levels.toInt() - 8).coerceAtLeast(-4)
+    val toK = levels.toInt() + 12
+    var count = 0
+    for (k in toK downTo fromK) {
+        val ringSize = logoPx * camera * NEST_RATIO.pow(k)
+        if (ringSize < minPx) continue
+        if (ringSize / screen >= REACH) continue // flown past
+        if (count >= LAYERS_MAX) break
+        count++
+        val pass = 1f - smoothstep(REACH * 0.75f, REACH, ringSize / screen)
+        // Only the copies inside the starting logo fade in.
+        val inner = if (k <= 0) 1f else appear
+        // How far behind the logo at the starting size it stands: the distance fades to dark.
+        val behind = ln(logoPx / ringSize) / lnNest
+        val fog = 1f - smoothstep(FOG_DEPTH * 0.4f, FOG_DEPTH, behind)
+        // New logos fade in from the vanishing point rather than popping in.
+        val tiny = smoothstep(minPx, minPx * 3f, ringSize)
+        val alpha = inner * pass * fade * fog * tiny
+        if (alpha <= 0.01f) continue
+        drawRing(cx, cy, ringSize, alpha)
+        // Every logo keeps its play symbol until it grows past the starting size.
+        val playAlpha = alpha * (1f - smoothstep(logoPx, logoPx * 2.4f, ringSize)) * 0.85f
+        if (playAlpha > 0.01f) drawPlay(cx, cy, ringSize, playAlpha)
+    }
+    if (pulse > 0.02f) drawStreak(cy, pulse * 0.6f * fade, densityPx)
+}
+
+private fun DrawScope.drawRing(cx: Float, cy: Float, ringSize: Float, alpha: Float) {
+    drawCircle(
+        color = Color.White.copy(alpha = alpha.coerceIn(0f, 1f)),
+        radius = ringSize / 2f,
+        center = Offset(cx, cy),
+        style = Stroke(width = ringSize * 0.085f),
+    )
+}
+
+private fun DrawScope.drawPlay(cx: Float, cy: Float, ringSize: Float, alpha: Float) {
+    val s = ringSize
+    val path = Path().apply {
+        moveTo(cx - 0.10f * s, cy - 0.18f * s)
+        lineTo(cx + 0.20f * s, cy)
+        lineTo(cx - 0.10f * s, cy + 0.18f * s)
+        close()
+    }
+    drawPath(path, Color.White.copy(alpha = alpha.coerceIn(0f, 1f)))
+}
+
+/** A soft coloured band across the middle: the chime's swell, seen. */
+private fun DrawScope.drawStreak(cy: Float, strength: Float, densityPx: Float) {
+    val height = 3f * densityPx * (1f + strength)
+    val colors = listOf(
+        Color(0xFF4FD8FF).copy(alpha = 0.3f * strength),
+        Color(0xFF8A6CFF).copy(alpha = 0.45f * strength),
+        Color(0xFFD45BFF).copy(alpha = 0.3f * strength),
+        Color.Transparent,
+    )
+    drawRect(
+        brush = Brush.horizontalGradient(colors, startX = 0f, endX = size.width),
+        topLeft = Offset(0f, cy - height / 2),
+        size = Size(size.width, height),
+        blendMode = BlendMode.Plus,
+    )
+}
+
+// ── Easing ───────────────────────────────────────────────────────────────────────────────────
+
+private fun lerp(a: Float, b: Float, fraction: Float) = a + (b - a) * fraction
+
+private fun progress(t: Float, start: Float, end: Float): Float =
+    ((t - start) / (end - start)).coerceIn(0f, 1f)
+
+private fun easeOut(x: Float) = 1f - (1f - x.coerceIn(0f, 1f)).pow(3)
+
+private fun easeInOut(x: Float): Float {
+    val clamped = x.coerceIn(0f, 1f)
+    return (0.5f - 0.5f * cos(PI * clamped)).toFloat()
+}
+
+private fun gaussian(t: Float, at: Float, width: Float) = exp(-((t - at) / width).pow(2))
+
+private fun smoothstep(a: Float, b: Float, x: Float): Float {
+    val fraction = ((x - a) / (b - a)).coerceIn(0f, 1f)
+    return fraction * fraction * (3 - 2 * fraction)
+}
