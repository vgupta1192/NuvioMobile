+package com.nuvio.app.features.player.skip
+
+/** A keyframe this wide reads like a seek thumbnail, which the detector's shares were tuned for. */
+internal const val SKIP_FRAME_WIDTH = 320
+internal const val SKIP_FRAME_HEIGHT = 180
+
+/**
+ * Decodes a small keyframe picture at an arbitrary time of the stream the credits are looked for in, without
+ * touching the player: its own decoder session, one per search, each picture scaled to about [SKIP_FRAME_WIDTH]
+ * wide ([LocalCreditsDetector]'s thresholds are thumbnail-scale, where lettering blurs into grey).
+ *
+ * The pictures come back as ARGB pixel arrays ([SkipFrameGrabber.grab]), so the detector stays platform-free. A
+ * stream whose container the platform decoder can't seek (HLS, for one) gives no pictures at all — the detector
+ * treats them as missing and finds nothing. Best-effort, as MatroskaChapterLoader is.
+ */
+internal expect class SkipFrameGrabber(url: String, headers: Map<String, String>) {
+
+    /**
+     * The keyframe at or just before [positionMs], scaled small, as ARGB ints, or null. Blocking; call off the
+     * main thread, one grab at a time.
+     */
+    fun grab(positionMs: Long): IntArray?
+
+    fun release()
+}
