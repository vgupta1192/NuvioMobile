+package com.nuvio.app.features.player.intro
+
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+/**
+ * Whether the playback intro is on screen. The intro is drawn above the whole player so it can
+ * cover the player's startup while the stream connects; it ends when its length is up (the
+ * length the playback settings chose) or as soon as the player's first video frame is ready,
+ * whichever comes first — and Back skips it at any point.
+ */
+object PlaybackIntroState {
+    private val _active = MutableStateFlow(false)
+    val active: StateFlow<Boolean> = _active.asStateFlow()
+
+    /** Length of the running (or next) intro, in seconds; always one of [LENGTHS]. */
+    @Volatile
+    var lengthSeconds: Int = DEFAULT_LENGTH_SECONDS
+        private set
+
+    /** Starts the intro [seconds] long unless one is already playing. */
+    fun start(seconds: Int) {
+        if (_active.value) return
+        lengthSeconds = seconds.takeIf { it in LENGTHS } ?: DEFAULT_LENGTH_SECONDS
+        _active.value = true
+    }
+
+    /** For the player opening: starts the intro (kept as its own step so callers read clearly). */
+    fun startOnPlayerOpen(seconds: Int) = start(seconds)
+
+    /** The player's first video frame is up: the intro can end early. */
+    fun onVideoFrameReady() {
+        if (!_active.value) return
+        _active.value = false
+    }
+
+    fun finish() {
+        _active.value = false
+    }
+
+    /** Intro lengths the settings offer, in seconds. */
+    val LENGTHS = listOf(3, 4, 5, 6)
+
+    const val DEFAULT_LENGTH_SECONDS = 5
+
+    /** Cycles the intro length 3 -> 4 -> 5 -> 6 -> 3 (an unknown value self-heals to 3s). */
+    fun nextLength(current: Int): Int {
+        val index = LENGTHS.indexOf(current)
+        return LENGTHS[(index.coerceAtLeast(0) + 1) % LENGTHS.size]
+    }
+}
