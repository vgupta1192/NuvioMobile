+package com.nuvio.app.features.player.intro
+
+/**
+ * The intro chime's player. [start] begins playback once the intro shows; [release] stops and
+ * frees it whenever the intro leaves the screen (skipped, finished, or the player closed).
+ * A platform that has no chime (iOS) never gets a player, and the intro runs silent.
+ */
+internal interface IntroChimePlayer {
+    fun start()
+    fun release()
+}
+
+/** Builds a chime player for the intro of [seconds], or null when the platform has none. */
+internal expect fun platformIntroChimePlayer(seconds: Int): IntroChimePlayer?
