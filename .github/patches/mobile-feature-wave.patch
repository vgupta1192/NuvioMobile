+package com.nuvio.app.features.player
+
+import com.nuvio.app.features.player.skip.LocalCreditsDetector
+import com.nuvio.app.features.player.skip.LocalMediaChapter
+import com.nuvio.app.features.player.skip.LocalSkipTimeFitter
+import com.nuvio.app.features.player.skip.SkipFrameGrabber
+import com.nuvio.app.features.player.skip.SkipInterval
+import com.nuvio.app.features.watching.domain.isShortPlaceholderDuration
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import kotlinx.coroutines.withTimeoutOrNull
+
+/** Local (no-API) skip detection's state: what the remote databases gave, and what the file's own pictures gave. */
+internal class LocalSkipTimesState {
+    /** The remote databases' result for the current stream; cleared when the stream changes. */
+    var remote: List<SkipInterval> = emptyList()
+
+    /** Whether the remote path has answered for this stream at all (its answer may be empty). */
+    var remoteArrived: Boolean = false
+
+    /** Credits found in the current stream's pictures, or null while none. */
+    var found: SkipInterval? = null
+
+    /** The stream the search ran (or was given up) for: it runs once per stream. */
+    var searchedFor: String? = null
+    var job: Job? = null
+
+    /** The last on/off combination the tick has seen, so a settings flip can be acted on once. */
+    var enabledSeen: Boolean? = null
+}
+
+/** Between two pictures, so the decoder and the network stay free for playback and scrubbing. */
+private const val LOCAL_SKIP_GRAB_PACE_MS = 250L
+
+/** One picture at most this long; a stream the decoder hangs on gives up that look, not the search. */
+private const val LOCAL_SKIP_GRAB_TIMEOUT_MS = 12_000L
+
+/** Credits are searched this long before the stretch they could start in, which leaves time to finish. */
+private const val LOCAL_SKIP_SEARCH_LEAD_MS = 5 * 60_000L
+
+/**
+ * The remote databases' answer applied; the local fallback (pictures, chapters) sees it through the next
+ * combine. Every path that assigns [PlayerScreenRuntime.skipIntervals] goes through here, so remote and local
+ * can never race: with the local toggle off the remote list is used verbatim (behaviour unchanged), with it on
+ * [LocalSkipTimeFitter.combine] merges what the file itself has said.
+ */
+internal fun PlayerScreenRuntime.applyRemoteSkipTimes(times: List<SkipInterval>) {
+    localSkipTimes.remote = times
+    localSkipTimes.remoteArrived = true
+    if (!playerSettingsUiState.skipIntroEnabled || !playerSettingsUiState.localCreditsDetectionEnabled) {
+        skipIntervals = times
+        return
+    }
+    refreshSkipIntervals()
+}
+
+/** [PlayerScreenRuntime.skipIntervals] again, from the remote times and what the file has said so far. */
+internal fun PlayerScreenRuntime.refreshSkipIntervals() {
+    if (!playerSettingsUiState.skipIntroEnabled || !playerSettingsUiState.localCreditsDetectionEnabled) return
+    val next = LocalSkipTimeFitter.combine(
+        remote = localSkipTimes.remote,
+        durationMs = playbackSnapshot.durationMs.coerceAtLeast(0L),
+        movie = (contentType ?: parentMetaType).equals("movie", ignoreCase = true),
+        chapters = currentMediaChapters(),
+        credits = localSkipTimes.found?.takeIf { localSkipTimes.searchedFor == activeSourceUrl },
+    )
+    if (next == skipIntervals) return
+    skipIntervals = next
+}
+
+/** The playing file's chapters, with each one's end set to the next chapter's start. */
+private fun PlayerScreenRuntime.currentMediaChapters(): List<LocalMediaChapter>? {
+    val list = chapters
+    if (list.isEmpty()) return null
+    return list.mapIndexed { i, chapter ->
+        LocalMediaChapter(chapter.startMs, list.getOrNull(i + 1)?.startMs, chapter.title.orEmpty())
+    }
+}
+
+/** Turning local detection off stops its search and drops what it found, keeping the remote times alone. */
+internal fun PlayerScreenRuntime.stopLocalSkipDetection() {
+    localSkipTimes.job?.cancel()
+    localSkipTimes.job = null
+    localSkipTimes.searchedFor = null
+    localSkipTimes.found = null
+    if (playerSettingsUiState.skipIntroEnabled) {
+        skipIntervals = localSkipTimes.remote
+    }
+}
+
+/** A new episode or source: its local state starts over (the remote fetch re-runs by itself). */
+internal fun PlayerScreenRuntime.resetLocalSkipDetection() {
+    localSkipTimes.job?.cancel()
+    localSkipTimes.job = null
+    localSkipTimes.remote = emptyList()
+    localSkipTimes.remoteArrived = false
+    localSkipTimes.searchedFor = null
+    localSkipTimes.found = null
+}
+
+/**
+ * On every position tick: starts the credits search of the file playing once the remote databases have answered
+ * and had nothing, the position is near the stretch the credits could start in, and the search hasn't run for
+ * this stream yet. The pictures come from the stream itself ([SkipFrameGrabber]), not the player's surface.
+ */
+internal fun PlayerScreenRuntime.ensureLocalSkipDetection() {
+    val state = localSkipTimes
+    val enabled = playerSettingsUiState.skipIntroEnabled && playerSettingsUiState.localCreditsDetectionEnabled
+    if (state.enabledSeen != null && state.enabledSeen != enabled) {
+        // The playback setting flipped: on allows a fresh search, off stops the search and drops what it found.
+        if (enabled) {
+            state.searchedFor = null
+        } else {
+            stopLocalSkipDetection()
+        }
+    }
+    state.enabledSeen = enabled
+    if (!enabled) return
+    // Keep the merge current: chapters and the file duration can arrive after the remote answer did.
+    refreshSkipIntervals()
+    if (state.job?.isActive == true) return
+    if (state.searchedFor != null && state.searchedFor != activeSourceUrl) {
+        // A new episode or source: what the old one said no longer holds.
+        state.job?.cancel()
+        state.job = null
+        state.searchedFor = null
+        state.found = null
+    }
+    if (state.searchedFor == activeSourceUrl) return
+    // Only a fallback: the remote path has to have run and come back empty first. Non-empty remote results
+    // landing mid-search win through the combine; the pictures may only sharpen an ending.
+    if (!state.remoteArrived || state.remote.isNotEmpty()) return
+    if (isLiveTvPlayback) return
+    val durationMs = playbackSnapshot.durationMs.takeIf { it > 0 && !isShortPlaceholderDuration(it) } ?: return
+    val url = localSkipStreamUrl() ?: return
+    val movie = (contentType ?: parentMetaType).equals("movie", ignoreCase = true)
+    val positionMs = playbackSnapshot.positionMs
+    if (positionMs < durationMs - LocalCreditsDetector.windowMs(movie) - LOCAL_SKIP_SEARCH_LEAD_MS) return
+    state.searchedFor = activeSourceUrl
+    state.job = scope.launch { findLocalSkipTimes(url, durationMs, movie) }
+}
+
+/** The stream the pictures are decoded from: the P2P relay's local URL for torrents, the surface's URL else. */
+private fun PlayerScreenRuntime.localSkipStreamUrl(): String? {
+    val url = if (activeTorrentInfoHash != null) p2pResolvedSourceUrl else activeSourceUrl
+    return url?.takeIf { it.isNotBlank() && it.startsWith("http", ignoreCase = true) }
+}
+
+private suspend fun PlayerScreenRuntime.findLocalSkipTimes(url: String, durationMs: Long, movie: Boolean) {
+    val headers = activeSourceHeaders
+    // Opening the decoder reads the stream header: off the main thread, like every grab.
+    val grabber = withContext(Dispatchers.IO) { SkipFrameGrabber(url, headers) }
+    try {
+        val found = LocalCreditsDetector.find(
+            durationMs = durationMs,
+            movie = movie,
+            grab = { positionMs ->
+                delay(LOCAL_SKIP_GRAB_PACE_MS)
+                withTimeoutOrNull(LOCAL_SKIP_GRAB_TIMEOUT_MS) {
+                    withContext(Dispatchers.IO) { grabber.grab(positionMs) }
+                }?.let { pixels ->
+                    withContext(Dispatchers.Default) { LocalCreditsDetector.stats(pixels) }
+                }
+            },
+        )
+        if (localSkipTimes.searchedFor != activeSourceUrl) return
+        localSkipTimes.found = found
+        refreshSkipIntervals()
+    } finally {
+        grabber.release()
+    }
+}
