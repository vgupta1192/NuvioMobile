+++ b/composeApp/src/commonMain/kotlin/com/nuvio/app/features/player/skip/LocalCreditsDetector.kt
@@ -0,0 +1,178 @@
+package com.nuvio.app.features.player.skip
+
+/**
+ * Finds end credits on black in keyframe pictures of a file's last minutes, the way Intro Skipper's black-frame
+ * pass does: a run of pictures that are almost all black and mostly lettered (a little colourless bright text),
+ * long enough to be credits. Credits over the picture, or on a colour card, aren't found.
+ *
+ * Pure picture math: the frames come from [com.nuvio.app.features.player.skip.SkipFrameGrabber] as ARGB pixel
+ * arrays, so this file stays out of any platform graphics API.
+ */
+internal object LocalCreditsDetector {
+
+    /** At or below this (0-255 luma) a pixel is black. */
+    private const val BLACK_LUMA = 24
+
+    /** At or above this a pixel is bright, as credit lettering is. */
+    private const val BRIGHT_LUMA = 150
+
+    /** Lettering's pixels are near grey: their channels differ by this at most. */
+    private const val COLOURLESS_SPREAD = 48
+
+    /**
+     * A picture this black (share of pixels) is a black one. Intro Skipper's default is 85% of a full frame; shrunk
+     * to a thumbnail, lettering blurs into grey, so a page dense with names reads a little less black.
+     */
+    private const val BLACK_SHARE = 0.80f
+
+    /** A lettered picture's bright share: text, not a lit scene (nor a speck of light in a dark one). */
+    private const val MIN_TEXT_SHARE = 0.003f
+    private const val MAX_TEXT_SHARE = 0.15f
+
+    /** Most of the bright pixels must be colourless for lettering. */
+    private const val COLOURLESS_SHARE = 0.6f
+
+    /** Where TV credits are looked for: the last 7.5 minutes (Intro Skipper's longest credits), every 15 s. */
+    private const val TV_WINDOW_MS = 450_000L
+    private const val TV_STEP_MS = 15_000L
+
+    /** A movie's: its last 15 minutes, every 30 s. */
+    private const val MOVIE_WINDOW_MS = 900_000L
+    private const val MOVIE_STEP_MS = 30_000L
+
+    /** The last picture looked at is this far from the end (the very last frames may not be keyframes). */
+    private const val END_GUARD_MS = 3_000L
+
+    /** Credits shorter than this are a title card or a gap between acts. */
+    private const val MIN_CREDITS_MS = 20_000L
+
+    /** Halvings that place each edge of a found run between two looks (15 s becomes about 4 s). */
+    private const val REFINE_STEPS = 2
+
+    /** What follows the credits for less than this (a studio logo) is part of them. */
+    private const val SHORT_TAIL_MS = 15_000L
+
+    /** How far before the end credits are looked for. */
+    fun windowMs(movie: Boolean): Long = if (movie) MOVIE_WINDOW_MS else TV_WINDOW_MS
+
+    class FrameStats(val black: Float, val bright: Float, val colourless: Float) {
+        val isBlack: Boolean get() = black >= BLACK_SHARE
+
+        val isLettered: Boolean
+            get() = isBlack && bright in MIN_TEXT_SHARE..MAX_TEXT_SHARE && colourless >= COLOURLESS_SHARE
+    }
+
+    /**
+     * A frame's stats from its pixels, ARGB ints (as [SkipFrameGrabber.grab] hands them out).
+     * Dimensions don't matter: every count is a share of the pixel total.
+     */
+    fun stats(pixels: IntArray): FrameStats {
+        if (pixels.isEmpty()) return FrameStats(0f, 0f, 0f)
+        var black = 0
+        var bright = 0
+        var colourless = 0
+        for (c in pixels) {
+            val r = (c shr 16) and 0xFF
+            val g = (c shr 8) and 0xFF
+            val b = c and 0xFF
+            val luma = (r * 299 + g * 587 + b * 114) / 1000
+            if (luma <= BLACK_LUMA) {
+                black++
+            } else if (luma >= BRIGHT_LUMA) {
+                bright++
+                if (maxOf(r, g, b) - minOf(r, g, b) <= COLOURLESS_SPREAD) colourless++
+            }
+        }
+        val n = pixels.size.toFloat()
+        return FrameStats(black / n, bright / n, if (bright == 0) 0f else colourless / bright.toFloat())
+    }
+
+    /**
+     * The credits of a file [durationMs] long, or null. [grab] gives the frame's stats at a time (ms), null when
+     * there's no picture; [log] hears each look, for tuning.
+     */
+    suspend fun find(
+        durationMs: Long,
+        movie: Boolean,
+        grab: suspend (Long) -> FrameStats?,
+        log: (String) -> Unit = {},
+    ): SkipInterval? {
+        if (durationMs <= 0) return null
+        val window = windowMs(movie)
+        val step = if (movie) MOVIE_STEP_MS else TV_STEP_MS
+        val from = maxOf(durationMs / 2, durationMs - window)
+        val last = durationMs - END_GUARD_MS
+        if (last <= from) return null
+        val times = ArrayList<Long>()
+        var t = from
+        while (t < last) {
+            times += t
+            t += step
+        }
+        times += last
+
+        val looks = times.map { at -> at to grab(at) }
+
+        // The first run of black pictures that's long enough and lettered on more than half of them (a black stretch
+        // lettered on half or less is a gap between acts); a missing picture doesn't break it.
+        var runStart = -1
+        var runEnd = -1
+        var i = 0
+        while (i < looks.size && runStart < 0) {
+            if (looks[i].second?.isBlack != true) {
+                i++
+                continue
+            }
+            var j = i
+            var blacks = 0
+            var lettered = 0
+            var lastBlack = i
+            while (j < looks.size) {
+                val frame = looks[j].second
+                if (frame != null) {
+                    if (!frame.isBlack) break
+                    blacks++
+                    if (frame.isLettered) lettered++
+                    lastBlack = j
+                }
+                j++
+            }
+            val spanMs = looks[lastBlack].first - looks[i].first + step
+            if (blacks >= 2 && lettered * 2 > blacks && spanMs >= MIN_CREDITS_MS) {
+                runStart = i
+                runEnd = lastBlack
+            }
+            i = j
+        }
+        if (runStart < 0) return null
+
+        suspend fun black(at: Long) = grab(at)?.isBlack == true
+
+        // The start lies between the last picture before the run and its first.
+        var before = looks.getOrNull(runStart - 1)?.first ?: (looks[runStart].first - step).coerceAtLeast(0L)
+        var start = looks[runStart].first
+        repeat(REFINE_STEPS) {
+            val mid = (before + start) / 2
+            if (black(mid)) start = mid else before = mid
+        }
+        // The end, between its last picture and the next; a run to the last look ends with the file.
+        var end = durationMs
+        if (runEnd < looks.lastIndex) {
+            var inside = looks[runEnd].first
+            var after = looks[runEnd + 1].first
+            repeat(REFINE_STEPS) {
+                val mid = (inside + after) / 2
+                if (black(mid)) inside = mid else after = mid
+            }
+            end = after
+        }
+        if (durationMs - end <= SHORT_TAIL_MS) end = durationMs
+        log("credits ${start / 1000}s to ${end / 1000}s")
+        return SkipInterval(
+            startTime = start / 1000.0,
+            endTime = end / 1000.0,
+            type = if (movie) "movie-credits" else "outro",
+            provider = "picture",
+        )
+    }
+}
diff --git a/composeApp/src/commonMain/kotlin/com/nuvio/app/features/player/skip/LocalSkipTimeFitter.kt b/composeApp/src/commonMain/kotlin/com/nuvio/app/features/player/skip/LocalSkipTimeFitter.kt
new file mode 100644
index 0000000..b0cdaf5
--- /dev/null
+++ b/composeApp/src/commonMain/kotlin/com/nuvio/app/features/player/skip/LocalSkipTimeFitter.kt
@@ -0,0 +1,196 @@
+package com.nuvio.app.features.player.skip
+
+import kotlin.math.abs
+
+/** A chapter of the file playing, as its container lists it. [endMs] is the next chapter's start when known. */
+data class LocalMediaChapter(val startMs: Long, val endMs: Long?, val title: String)
+
+/**
+ * Turns the databases' skip times into ones for the file that plays, from what that file says about itself: its
+ * chapter names (exact for this release), its chapter starts (where its cuts really are) and credits found in its
+ * pictures ([LocalCreditsDetector]). The chapter-name patterns follow Intro Skipper's (GPL-3.0, as this app is),
+ * with Western "Main Titles" added.
+ *
+ * The remote times arrive already merged best-of by SkipIntroRepository, so there is no judging between providers
+ * here: chapter names win over the databases, database edges snap onto chapter starts, and the pictures' credits
+ * fill a missing ending or sharpen the database's one.
+ */
+internal object LocalSkipTimeFitter {
+
+    private val PREVIEW = Regex(
+        """(^|\s)(Preview|PV|Sneak\s?Peek|Coming\s?(Up|Soon)|Next\s+(time|on|episode)|Extra|Teaser|Trailer)(?![\s:]+End)(\s|:|$)""",
+        RegexOption.IGNORE_CASE,
+    )
+
+    /** The title sequence by name; wins over a plain "Intro", which in anime releases is the cold open before the OP. */
+    private val OPENING = Regex(
+        """(^|\s)(OP|Opening|Main\s+Titles?|Title\s+Sequence)(?![\s:]+End)(\s|:|$)""",
+        RegexOption.IGNORE_CASE,
+    )
+    private val INTRO = Regex("""(^|\s)(Intro|Introduction)(?![\s:]+End)(\s|:|$)""", RegexOption.IGNORE_CASE)
+    private val RECAP = Regex(
+        """(^|\s)(Re?cap|Sum{1,2}ary|Prev(ious(ly)?)?|(Last|Earlier)(\s\w+)?|Catch[ -]up)(?![\s:]+End)(\s|:|$)""",
+        RegexOption.IGNORE_CASE,
+    )
+    private val CREDITS = Regex("""(^|\s)(Credits?|ED|Ending|Outro)(?![\s:]+End)(\s|:|$)""", RegexOption.IGNORE_CASE)
+
+    /** An edge moves onto a chapter start this close. */
+    private const val CHAPTER_SNAP_S = 5.0
+
+    /** Credits found in the pictures this close to a database's take their start from the pictures. */
+    private const val CREDITS_AGREE_S = 60.0
+
+    private const val KIND_OPENING = "opening"
+    private const val KIND_RECAP = "recap"
+    private const val KIND_ENDING = "ending"
+    private const val KIND_MOVIE_CREDITS = "movie-credits"
+    private val KINDS = listOf(KIND_OPENING, KIND_RECAP, KIND_ENDING, KIND_MOVIE_CREDITS)
+
+    /**
+     * The skip times for a file [durationMs] long: the databases' [remote] with what the file has said so far —
+     * named chapters ([chapters], when the file lists any) and [credits] found in its pictures.
+     */
+    fun combine(
+        remote: List<SkipInterval>,
+        durationMs: Long,
+        movie: Boolean,
+        chapters: List<LocalMediaChapter>?,
+        credits: SkipInterval?,
+    ): List<SkipInterval> {
+        val named = fromChapters(chapters.orEmpty(), durationMs, movie)
+        val marks = chapters?.let(::chapterMarks) ?: DoubleArray(0)
+        val out = ArrayList<SkipInterval>()
+        for (kind in KINDS) {
+            val ofKind = { interval: SkipInterval -> category(interval.type) == kind }
+            var chosen = named.firstOrNull(ofKind)
+                ?: remote.firstOrNull(ofKind)?.let { snap(it, marks, durationMs) }
+            if (kind == KIND_ENDING || kind == KIND_MOVIE_CREDITS) {
+                chosen = withCredits(chosen, credits?.takeIf(ofKind), durationMs)
+            }
+            chosen?.let(out::add)
+        }
+        // What has no kind (a movie's post-credits scene) passes through.
+        val scenes = remote.filter { category(it.type) == null }
+        // Skipping credits must not also skip the post-credits scene behind them.
+        val scene = scenes.minByOrNull { it.startTime }
+        val clamped = if (scene != null && scene.startTime.isFinite()) {
+            out.map { interval ->
+                val clampedEnd = minOf(interval.endTime, scene.startTime)
+                if (clampedEnd < interval.endTime && clampedEnd > interval.startTime) {
+                    interval.copy(endTime = clampedEnd)
+                } else {
+                    interval
+                }
+            }
+        } else {
+            out
+        }
+        return (clamped + scenes).sortedBy { it.startTime }
+    }
+
+    /**
+     * Segments the file's chapter names give, the first of each kind (an opening by name before a plain "Intro"); a
+     * movie's chapters only give its credits.
+     */
+    fun fromChapters(chapters: List<LocalMediaChapter>, durationMs: Long, movie: Boolean): List<SkipInterval> {
+        if (chapters.isEmpty() || durationMs <= 0) return emptyList()
+        val found = LinkedHashMap<String, SkipInterval>()
+        val namedOpening =
+            !movie && chapters.any { OPENING.containsMatchIn(it.title) && !PREVIEW.containsMatchIn(it.title) }
+        chapters.forEachIndexed { i, chapter ->
+            val title = chapter.title
+            if (title.isBlank() || PREVIEW.containsMatchIn(title)) return@forEachIndexed
+            val type = when {
+                movie -> if (CREDITS.containsMatchIn(title)) "movie-credits" else null
+                OPENING.containsMatchIn(title) -> "intro"
+                INTRO.containsMatchIn(title) -> if (namedOpening) null else "intro"
+                RECAP.containsMatchIn(title) -> "recap"
+                CREDITS.containsMatchIn(title) -> "outro"
+                else -> null
+            } ?: return@forEachIndexed
+            val kind = category(type) ?: return@forEachIndexed
+            if (kind in found) return@forEachIndexed
+            val endMs = (chapter.endMs ?: chapters.getOrNull(i + 1)?.startMs ?: durationMs).coerceAtMost(durationMs)
+            val interval = SkipInterval(chapter.startMs / 1000.0, endMs / 1000.0, type, "chapters")
+            if (lengthFits(interval, kind) && plausible(interval, durationMs)) found[kind] = interval
+        }
+        return found.values.toList()
+    }
+
+    private fun lengthFits(interval: SkipInterval, kind: String): Boolean {
+        val length = interval.endTime - interval.startTime
+        return when (kind) {
+            KIND_OPENING -> length in 10.0..180.0
+            KIND_RECAP -> length in 5.0..240.0
+            KIND_ENDING -> length in 10.0..600.0
+            else -> length in 10.0..1200.0
+        }
+    }
+
+    /** A chapter segment within the file and not covering it whole; the same sanity the databases' are given. */
+    private fun plausible(interval: SkipInterval, durationMs: Long): Boolean {
+        if (!interval.startTime.isFinite() || !interval.endTime.isFinite()) return false
+        if (interval.startTime < 0.0 || interval.endTime <= interval.startTime) return false
+        return durationMs <= 0 || interval.endTime <= durationMs / 1000.0
+    }
+
+    /** Chapter starts (s), the file's start left out: every cut a chapter marks. */
+    private fun chapterMarks(chapters: List<LocalMediaChapter>): DoubleArray =
+        chapters.map { it.startMs / 1000.0 }.filter { it > 0.5 }.distinct().sorted().toDoubleArray()
+
+    /** Edges onto a chapter start close by. */
+    private fun snap(interval: SkipInterval, marks: DoubleArray, durationMs: Long): SkipInterval {
+        if (marks.isEmpty()) return interval
+        fun onChapter(edge: Double): Double? =
+            nearest(marks, edge)?.takeIf { abs(it - edge) <= CHAPTER_SNAP_S }
+        val length = if (durationMs > 0) durationMs / 1000.0 else Double.MAX_VALUE
+        val start = onChapter(interval.startTime) ?: interval.startTime
+        var end = interval.endTime
+        if (end.isFinite() && end < length) end = onChapter(end) ?: end
+        if (end <= start) return interval
+        return if (start == interval.startTime && end == interval.endTime) {
+            interval
+        } else {
+            interval.copy(startTime = start, endTime = end)
+        }
+    }
+
+    /**
+     * The database's ending, its start set by the credits found in the pictures when the two are close; the
+     * pictures' credits alone when no database has an ending.
+     */
+    private fun withCredits(db: SkipInterval?, found: SkipInterval?, durationMs: Long): SkipInterval? {
+        if (found == null || db?.provider == "chapters") return db
+        if (db == null) return found
+        if (abs(found.startTime - db.startTime) > CREDITS_AGREE_S) return db
+        val fileEnd = if (durationMs > 0) durationMs / 1000.0 else Double.MAX_VALUE
+        // The database knows how the credits end, unless it runs past this file or the pictures agree anyway.
+        val end = if (db.endTime > fileEnd || abs(found.endTime - db.endTime) <= CREDITS_AGREE_S) {
+            found.endTime
+        } else {
+            db.endTime
+        }
+        return db.copy(startTime = found.startTime, endTime = maxOf(end, found.startTime + 1.0))
+    }
+
+    private fun category(type: String): String? = when (type.trim().lowercase()) {
+        "intro", "op", "opening", "mixed-op" -> KIND_OPENING
+        "recap" -> KIND_RECAP
+        "outro", "ed", "ending", "mixed-ed", "credits" -> KIND_ENDING
+        "movie-credits" -> KIND_MOVIE_CREDITS
+        else -> null
+    }
+
+    private fun nearest(sorted: DoubleArray, value: Double): Double? {
+        if (sorted.isEmpty()) return null
+        var lo = 0
+        var hi = sorted.size - 1
+        while (lo < hi) {
+            val mid = (lo + hi) ushr 1
+            if (sorted[mid] < value) lo = mid + 1 else hi = mid
+        }
+        val after = sorted[lo]
+        val before = if (lo > 0) sorted[lo - 1] else after
+        return if (abs(before - value) <= abs(after - value)) before else after
+    }
+}
diff --git a/composeApp/src/commonMain/kotlin/com/nuvio/app/features/player/skip/SkipFrameGrabber.kt b/composeApp/src/commonMain/kotlin/com/nuvio/app/features/player/skip/SkipFrameGrabber.kt
