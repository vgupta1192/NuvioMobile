index 0000000..77b3453
--- /dev/null
+++ b/composeApp/src/androidMain/kotlin/com/nuvio/app/features/player/skip/SkipFrameGrabber.android.kt
@@ -0,0 +1,87 @@
+package com.nuvio.app.features.player.skip
+
+import android.graphics.Bitmap
+import android.media.MediaMetadataRetriever
+import android.os.Build
+import com.nuvio.app.core.storage.AppContextHolder
+import kotlin.math.roundToInt
+
+/**
+ * The Android frame source: its own [MediaMetadataRetriever] session, one per search, each picture scaled to
+ * [SKIP_FRAME_WIDTH] wide (aspect kept) and handed out as ARGB pixels. AppContextHolder supplies the
+ * application context, so the grabber needs no player or activity reference.
+ */
+internal actual class SkipFrameGrabber actual constructor(
+    url: String,
+    headers: Map<String, String>,
+) {
+    private val retriever = MediaMetadataRetriever()
+    private var opened = false
+    private var released = false
+
+    init {
+        val context = AppContextHolder.get()
+        if (context == null) {
+            runCatching { retriever.release() }
+            released = true
+        } else {
+            // setDataSource with a header map needs the framework http source; anything it refuses means no
+            // pictures.
+            runCatching {
+                // (String, Map) overload: headers ride along and the http source is chosen by the
+                // framework; not the removed (Context, Uri, Map) overload (gone from the API-36
+                // surface this project compiles against).
+                retriever.setDataSource(url, headers)
+                opened = true
+            }.onFailure {
+                runCatching { retriever.release() }
+                released = true
+            }
+        }
+    }
+
+    actual fun grab(positionMs: Long): IntArray? {
+        if (released || !opened) return null
+        return runCatching {
+            val frame = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O_MR1) {
+                retriever.getScaledFrameAtTime(
+                    positionMs * 1000,
+                    MediaMetadataRetriever.OPTION_CLOSEST_SYNC,
+                    SKIP_FRAME_WIDTH,
+                    SKIP_FRAME_HEIGHT,
+                ) ?: return null
+                val full = retriever.getFrameAtTime(
+                    positionMs * 1000,
+                    MediaMetadataRetriever.OPTION_CLOSEST_SYNC,
+                ) ?: return null
+                val scale = SKIP_FRAME_WIDTH.toFloat() / full.width.coerceAtLeast(1)
+                val scaled = Bitmap.createScaledBitmap(
+                    full,
+                    SKIP_FRAME_WIDTH,
+                    (full.height * scale).roundToInt().coerceAtLeast(1),
+                    true,
+                )
+                if (scaled !== full) full.recycle()
+                scaled
+            }
+            // getScaledFrameAtTime can hand back a frame larger than asked when it can't scale down.
+            val bitmap = if (frame.width > SKIP_FRAME_WIDTH * 2) {
+                val scaled = Bitmap.createScaledBitmap(frame, SKIP_FRAME_WIDTH, SKIP_FRAME_HEIGHT, true)
+                frame.recycle()
+                scaled
+            } else {
+                frame
+            }
+            val pixels = IntArray(bitmap.width * bitmap.height)
+            bitmap.getPixels(pixels, 0, bitmap.width, 0, 0, bitmap.width, bitmap.height)
+            bitmap.recycle()
+            pixels
+        }.getOrNull()
+    }
+
+    actual fun release() {
+        if (released) return
+        released = true
+        runCatching { retriever.release() }
+    }
+}
