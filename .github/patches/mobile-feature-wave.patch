+
+    private val CHIMES: Map<Int, List<String>> = mapOf(
+        3 to listOf(CHUNK_3S_A, CHUNK_3S_B, CHUNK_3S_C),
+        4 to listOf(CHUNK_4S_A, CHUNK_4S_B, CHUNK_4S_C),
+        5 to listOf(CHUNK_5S_A, CHUNK_5S_B, CHUNK_5S_C, CHUNK_5S_D),
+        6 to listOf(CHUNK_6S_A, CHUNK_6S_B, CHUNK_6S_C, CHUNK_6S_D),
+    )
+
+    /** The lengths a chime exists for. */
+    val chimeLengths: Set<Int> get() = CHIMES.keys
+
+
+    /** Decodes the [seconds] chime into the app cache dir (cached across runs); null when it can't. */
+    fun extract(seconds: Int): File? = runCatching {
+        val context = AppContextHolder.get() ?: return@runCatching null
+        val chunks = CHIMES[seconds] ?: return@runCatching null
+        val dir = File(context.cacheDir, "playback_intro").apply { mkdirs() }
+        val out = File(dir, "intro_${seconds}s.m4a")
+        if (out.isFile && out.length() > 0L) return@runCatching out
+        val bytes = Base64.decode(chunks.joinToString(""), Base64.DEFAULT)
+        if (bytes.isEmpty()) return@runCatching null
+        val part = File(dir, out.name + ".part")
+        part.writeBytes(bytes)
+        if (out.exists()) out.delete()
+        if (!part.renameTo(out)) {
+            part.delete()
+            return@runCatching null
+        }
+        out
+    }.getOrNull()
+}
