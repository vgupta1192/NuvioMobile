@@ -0,0 +1,69 @@
+package com.nuvio.app.features.player.intro
+
+import android.media.AudioAttributes
+import android.media.MediaPlayer
+
+/**
+ * The Android chime: the wanted length's m4a is decoded from the embedded base64 into the cache
+ * dir and prepared on a background thread (the intro is showing while it gets ready), then plays
+ * itself. Any failure (no context, bad data, no decoder) plays silently — the intro never waits
+ * on its sound, and [start] is a formality the common effect calls right away.
+ */
+internal actual fun platformIntroChimePlayer(seconds: Int): IntroChimePlayer? =
+    AndroidIntroChimePlayer.create(seconds)
+
+private class AndroidIntroChimePlayer private constructor(
+    seconds: Int,
+) : IntroChimePlayer {
+    private val lock = Any()
+    private var prepared: MediaPlayer? = null
+    private var released = false
+
+    init {
+        // Extract and prepare off the main thread; the intro covers the player's startup anyway.
+        Thread({
+            val player = runCatching {
+                val file = IntroChimeAssets.extract(seconds) ?: return@Thread
+                MediaPlayer().apply {
+                    setAudioAttributes(
+                        AudioAttributes.Builder()
+                            .setUsage(AudioAttributes.USAGE_MEDIA)
+                            .setContentType(AudioAttributes.CONTENT_TYPE_MUSIC)
+                            .build(),
+                    )
+                    setDataSource(file.absolutePath)
+                    prepare()
+                }
+            }.getOrNull() ?: return@Thread
+            synchronized(lock) {
+                if (released) {
+                    runCatching { player.release() }
+                    return@Thread
+                }
+                prepared = player
+                runCatching { player.start() }
+            }
+        }, "NuvioIntroChime").apply {
+            isDaemon = true
+            start()
+        }
+    }
+
+    override fun start() = Unit
+
+    override fun release() {
+        val player = synchronized(lock) {
+            released = true
+            prepared.also { prepared = null }
+        } ?: return
+        runCatching { if (player.isPlaying) player.stop() }
+        runCatching { player.release() }
+    }
+
+    companion object {
+        fun create(seconds: Int): IntroChimePlayer? {
+            if (IntroChimeAssets.chimeLengths.contains(seconds)) return AndroidIntroChimePlayer(seconds)
+            return null
+        }
+    }
+}
