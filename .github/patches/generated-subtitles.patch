+/**
+ * Generates English subtitles for the playing stream from its audio, ahead of the playhead:
+ * the stream's audio is read [LOOKAHEAD_MS] ahead over its own connection (single files and HLS
+ * playlists), cut into spoken lines by Silero VAD, recognised on the device (SenseVoice for
+ * Chinese/Cantonese/Japanese/Korean/English, Whisper small for Hindi, which translates by itself)
+ * and translated to English with ML Kit. Cues are pushed into the attached sidecar subtitle as
+ * they are ready; status lines ("Downloading speech model…") show in the subtitle itself.
+ */
+internal class GeneratedSubtitleSession(
+    context: Context,
+    private val scope: CoroutineScope,
+    private val player: ExoPlayer,
+    private val sidecar: SidecarSubtitleController,
+    sourceUrl: String,
+    sourceAudioUrl: String?,
+    private val dataSourceFactory: DataSource.Factory,
+) {
+    private val appContext = context.applicationContext
+    private val audioUrl = sourceAudioUrl?.takeIf { it.isNotBlank() } ?: sourceUrl
+    private val uri: Uri? = runCatching { Uri.parse(audioUrl) }.getOrNull()
+        ?.takeIf { it.scheme == "http" || it.scheme == "https" || it.scheme == "file" }
+    private val hls = uri?.path.orEmpty().lowercase().endsWith(".m3u8")
+
+    private class Run(val url: String) {
+        @Volatile
+        var stopped = false
+
+        @Volatile
+        var generation = 0L
+        var ticker: Job? = null
+        var worker: Thread? = null
+
+        // Written by the main-thread ticker, read by the worker.
+        @Volatile
+        var positionMs = 0L
+
+        @Volatile
+        var durationMs = 0L
+
+        @Volatile
+        var audioFormat: Format? = null
+
+        /** Shown at the playhead while no generated line covers it. */
+        @Volatile
+        var status: String? = "Generating subtitles from the audio…"
+
+        val cues = ArrayList<CuesWithTiming>()
+
+        @Volatile
+        var cuesVersion = 0
+    }
+
+    @Volatile
+    private var active: Run? = null
+
+    /** Attaches the generated subtitle [url] and starts generating; false if it can't be shown. */
+    fun start(url: String): Boolean {
+        stop()
+        if (uri == null) {
+            SyncLog.w("generated subtitles: stream address not supported")
+        }
+        val attached = sidecar.startSidecarAddonSubtitle(url = url, rawBodyLoader = { PLACEHOLDER_SRT })
+        if (!attached) return false
+        val current = Run(url)
+        current.generation = sidecar.currentGenerationFor(url) ?: return false
+        active = current
+        running = true
+        SyncLog.i("generated subtitles: started (${if (hls) "HLS playlist" else "single file"})")
+        current.ticker = scope.launch { tick(current) }
+        current.worker = Thread({ work(current) }, "NuvioGeneratedSubs").apply {
+            isDaemon = true
+            start()
+        }
+        return true
+    }
+
+    fun stop() {
+        val current = active ?: return
+        active = null
+        running = false
+        current.stopped = true
+        current.ticker?.cancel()
+        current.worker?.interrupt()
+        SyncLog.i("generated subtitles: stopped")
+    }
+
+    /** Main thread: follows the player, notices when the subtitle is replaced, pushes cues. */
+    private suspend fun tick(current: Run) {
+        // The placeholder is parsed asynchronously; committing before that would be overwritten.
+        while (scope.isActive && !current.stopped && sidecar.sidecarTimedCues.isEmpty()) {
+            if (sidecar.currentGenerationFor(current.url) != current.generation) break
+            delay(TICK_MS)
+        }
+        var committedVersion = -1
+        var committedStatus: String? = null
+        var statusAtMs = Long.MIN_VALUE
+        while (scope.isActive && !current.stopped) {
+            if (sidecar.currentGenerationFor(current.url) != current.generation) {
+                if (active === current) stop()
+                return
+            }
+            current.positionMs = player.currentPosition.coerceAtLeast(0L)
+            current.durationMs = player.duration.takeIf { it != C.TIME_UNSET && it > 0 } ?: 0L
+            current.audioFormat = player.currentTracks.selectedAudioFormat()
+            val status = current.status?.takeIf { !hasCueNear(current, current.positionMs) }
+            val statusMoved = status != null && kotlin.math.abs(current.positionMs - statusAtMs) > 1_000L
+            if (current.cuesVersion != committedVersion || status != committedStatus || statusMoved) {
+                val list = synchronized(current.cues) { ArrayList(current.cues) }
+                if (status != null) {
+                    statusAtMs = current.positionMs
+                    list += cue((statusAtMs - 200L).coerceAtLeast(0L), statusAtMs + STATUS_SHOW_MS, status)
+                    list.sortBy { it.startTimeUs }
+                }
+                if (list.isNotEmpty()) {
+                    sidecar.commitPreparedSidecarSubtitle(
+                        expectedCurrentUrl = current.url,
+                        newUrl = current.url,
+                        cues = list,
+                        expectedGeneration = current.generation,
+                    )
+                }
+                committedVersion = current.cuesVersion
+                committedStatus = status
+            }
+            delay(TICK_MS)
+        }
+    }
+
+    private fun hasCueNear(current: Run, positionMs: Long): Boolean = synchronized(current.cues) {
+        val fromUs = (positionMs - 1_500L) * 1_000L
+        val toUs = (positionMs + 4_000L) * 1_000L
+        current.cues.any { it.startTimeUs < toUs && it.startTimeUs + it.durationUs > fromUs }
+    }
+
+    // ---- worker thread ----
+
+    private fun work(current: Run) {
+        Process.setThreadPriority(Process.THREAD_PRIORITY_BACKGROUND)
+        var recognizer: GeneratedRecognizer? = null
+        val translator = GeneratedTranslator()
+        try {
+            val source = uri ?: run {
