+    val models by GeneratedSubtitles.models.collectAsStateWithLifecycle()
+    val fastAsianModel by GeneratedSubtitles.fastAsianModel.collectAsStateWithLifecycle()
+    var pickLanguage by remember { mutableStateOf(false) }
+    val highQuality by GeneratedSubtitles.highQuality.collectAsStateWithLifecycle()
+    val deeplKey by GeneratedSubtitles.deeplKey.collectAsStateWithLifecycle()
+    var editKey by remember { mutableStateOf(false) }
+    val groqKey by GeneratedSubtitles.groqKey.collectAsStateWithLifecycle()
+    var editGroqKey by remember { mutableStateOf(false) }
+
+    SettingsGroupDivider(isTablet = isTablet)
+    SettingsNavigationRow(
+        title = "Use generated subtitles automatically",
+        description = GeneratedSubtitles.modeLabel(mode) + ". \"English · Generated from the audio\" is " +
+            "always in the subtitle list (under English) to pick by hand. Tap to change.",
+        isTablet = isTablet,
+        onClick = GeneratedSubtitles::cycleMode,
+    )
+    SettingsGroupDivider(isTablet = isTablet)
+    SettingsNavigationRow(
+        title = "Spoken language for generated subtitles",
+        description = GeneratedSubtitles.spokenLanguageLabel(spokenLanguage) +
+            ". Whisper small (375 MB) recognises and translates every language to English, and detects " +
+            "the language when the audio track has no tag. English audio uses SenseVoice (237 MB).",
+        isTablet = isTablet,
+        onClick = { pickLanguage = true },
+    )
+    SettingsGroupDivider(isTablet = isTablet)
+    SettingsSwitchRow(
+        title = "Higher-quality speech model",
+        description = "Whisper medium (945 MB, once): noticeably more accurate than Whisper small " +
+            "(375 MB), about twice as slow. Off: Whisper small.",
+        checked = highQuality,
+        isTablet = isTablet,
+        onCheckedChange = GeneratedSubtitles::setHighQuality,
+    )
+    SettingsGroupDivider(isTablet = isTablet)
+    SettingsNavigationRow(
+        title = "Translate with DeepL",
+        description = if (deeplKey.isBlank()) {
+            "Off. Add your DeepL API key (free plan: 500,000 characters a month) for translations " +
+                "close to real subtitles. Only the recognised text is sent to DeepL, never audio."
+        } else {
+            "On (key …${deeplKey.takeLast(6)}). Whisper writes the spoken language down and DeepL " +
+                "translates whole lines with context. Tap to change or remove the key."
+        },
+        isTablet = isTablet,
+        onClick = { editKey = true },
+    )
+    SettingsGroupDivider(isTablet = isTablet)
+    SettingsNavigationRow(
+        title = "Generate online with Groq",
+        description = if (groqKey.isBlank()) {
+            "Off. With your Groq API key the subtitle list also offers \"English · Generated online\": " +
+                "Whisper large-v3 on Groq, the most accurate. The speech audio is sent to Groq."
+        } else {
+            "On (key …${groqKey.takeLast(6)}). Pick \"English · Generated online (Groq Whisper large-v3)\" " +
+                "in the subtitle list. Speech audio is sent to Groq; with DeepL, DeepL translates."
+        },
+        isTablet = isTablet,
+        onClick = { editGroqKey = true },
+    )
+    SettingsGroupDivider(isTablet = isTablet)
+    SettingsSwitchRow(
+        title = "Faster models (lower quality)",
+        description = "Off (recommended): Whisper for every language. On: Chinese, Cantonese, Japanese and " +
+            "Korean use SenseVoice, and Hindi, Urdu, Bengali, Tamil, Telugu, Gujarati, Marathi, Thai, " +
+            "Indonesian, Malay, Vietnamese, Tagalog, Arabic, Persian and Russian use Dolphin (250 MB), " +
+            "each followed by on-device translation (about 30 MB per language): faster, often worse.",
+        checked = fastAsianModel,
+        isTablet = isTablet,
+        onCheckedChange = GeneratedSubtitles::setFastAsianModel,
