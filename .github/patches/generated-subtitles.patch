+package com.nuvio.app.features.player.generated
+
+import android.content.Context
+import com.k2fsa.sherpa.onnx.FeatureConfig
+import com.k2fsa.sherpa.onnx.OfflineModelConfig
+import com.k2fsa.sherpa.onnx.OfflineRecognizer
+import com.k2fsa.sherpa.onnx.OfflineRecognizerConfig
+import com.k2fsa.sherpa.onnx.OfflineSenseVoiceModelConfig
+import com.k2fsa.sherpa.onnx.OfflineWhisperModelConfig
+import com.nuvio.app.features.player.GeneratedSubtitles
+
+/** On-device speech recognition for generated subtitles (sherpa-onnx, Apache-2.0). */
+internal class GeneratedRecognizer private constructor(
+    private val recognizer: OfflineRecognizer,
+    /** Whisper in translate mode already returns English. */
+    val translatesToEnglish: Boolean,
+    private val fixedLanguage: String,
+) : AutoCloseable {
+    /** [language] is the detected (or given) spoken language as a plain code, e.g. "zh". */
+    class Heard(val text: String, val language: String)
+
+    fun recognize(samples: FloatArray): Heard {
+        val stream = recognizer.createStream()
+        try {
+            stream.acceptWaveform(samples, SAMPLE_RATE)
+            recognizer.decode(stream)
+            val result = recognizer.getResult(stream)
+            val detected = result.lang.trim().removePrefix("<|").removeSuffix("|>").lowercase()
+            val language = when {
+                translatesToEnglish -> "en"
+                detected.isNotEmpty() && detected != "nospeech" -> detected
+                else -> fixedLanguage
+            }
+            return Heard(result.text, language)
+        } finally {
+            stream.release()
+        }
+    }
+
+    override fun close() = recognizer.release()
+
+    companion object {
+        private const val SAMPLE_RATE = 16_000
+
+        /** SenseVoice: Chinese, Cantonese, Japanese, Korean, English; [language] "auto" detects it. */
+        fun senseVoice(context: Context, language: String, threads: Int): GeneratedRecognizer {
+            val model = GeneratedSpeechModel.SENSE_VOICE
+            val code = language.takeIf { it in setOf("zh", "yue", "ja", "ko", "en") } ?: "auto"
+            val recognizer = OfflineRecognizer(
+                config = OfflineRecognizerConfig(
+                    featConfig = FeatureConfig(sampleRate = SAMPLE_RATE, featureDim = 80),
+                    modelConfig = OfflineModelConfig(
+                        senseVoice = OfflineSenseVoiceModelConfig(
+                            model = model.file(context, GeneratedSpeechModel.SENSE_VOICE_MODEL).absolutePath,
+                            language = code,
+                            useInverseTextNormalization = true,
+                        ),
+                        tokens = model.file(context, GeneratedSpeechModel.TOKENS).absolutePath,
+                        numThreads = threads,
+                    ),
+                ),
+            )
+            val fallback = if (code == "auto") GeneratedSubtitles.AUTO else code
+            return GeneratedRecognizer(recognizer, translatesToEnglish = false, fixedLanguage = fallback)
+        }
+
+        /** Whisper small, translating [language] speech (Hindi) straight into English. */
+        fun whisper(context: Context, language: String, threads: Int): GeneratedRecognizer {
+            val model = GeneratedSpeechModel.WHISPER_SMALL
+            val recognizer = OfflineRecognizer(
+                config = OfflineRecognizerConfig(
+                    featConfig = FeatureConfig(sampleRate = SAMPLE_RATE, featureDim = 80),
+                    modelConfig = OfflineModelConfig(
+                        whisper = OfflineWhisperModelConfig(
+                            encoder = model.file(context, GeneratedSpeechModel.WHISPER_ENCODER).absolutePath,
+                            decoder = model.file(context, GeneratedSpeechModel.WHISPER_DECODER).absolutePath,
+                            language = language,
+                            task = "translate",
+                        ),
+                        tokens = model.file(context, GeneratedSpeechModel.TOKENS).absolutePath,
+                        numThreads = threads,
+                    ),
+                ),
+            )
+            return GeneratedRecognizer(recognizer, translatesToEnglish = true, fixedLanguage = language)
+        }
+    }
+}
