@@ -0,0 +1,159 @@
+package com.nuvio.app.features.player.generated
+
+import android.content.Context
+import com.nuvio.app.features.player.GeneratedSubtitleModelActions
+import com.nuvio.app.features.player.GeneratedSubtitles
+import com.nuvio.app.features.player.audiosync.SyncLog
+import java.io.File
+import java.net.HttpURLConnection
+import java.net.URL
+
+/** A speech recognition model for generated subtitles, downloaded once into app storage. */
+internal enum class GeneratedSpeechModel(
+    val label: String,
+    private val dirName: String,
+    /** Local file name to (download address, size in bytes). */
+    private val files: List<Pair<String, Pair<String, Long>>>,
+) {
+    /** Chinese, Cantonese, Japanese, Korean and English; fast. Text is translated afterwards. */
+    SENSE_VOICE(
+        label = "SenseVoice",
+        dirName = "sense-voice-int8-2025-09-09",
+        files = listOf(
+            SENSE_VOICE_MODEL to ("$SENSE_VOICE_BASE/model.int8.onnx" to 237_115_547L),
+            TOKENS to ("$SENSE_VOICE_BASE/tokens.txt" to 315_894L),
+        ),
+    ),
+
+    /** Multilingual Whisper, used for Hindi; it translates straight into English. */
+    WHISPER_SMALL(
+        label = "Whisper small",
+        dirName = "whisper-small-int8",
+        files = listOf(
+            WHISPER_ENCODER to ("$WHISPER_BASE/small-encoder.int8.onnx" to 112_442_483L),
+            WHISPER_DECODER to ("$WHISPER_BASE/small-decoder.int8.onnx" to 262_226_114L),
+            TOKENS to ("$WHISPER_BASE/small-tokens.txt" to 816_730L),
+        ),
+    );
+
+    val totalBytes: Long get() = files.sumOf { it.second.second }
+    val sizeMb: Int get() = (totalBytes / 1_000_000L).toInt()
+
+    fun directory(context: Context): File = File(context.filesDir, "generated-subtitles/$dirName")
+
+    fun file(context: Context, name: String): File = File(directory(context), name)
+
+    fun isReady(context: Context): Boolean =
+        files.all { (name, source) -> file(context, name).length() == source.second }
+
+    /**
+     * Downloads the missing files, reporting overall progress (0..1). Blocking; returns null when
+     * the model is ready, else the reason it is not.
+     */
+    fun download(context: Context, isCancelled: () -> Boolean, onProgress: (Float) -> Unit): String? {
+        val dir = directory(context)
+        dir.mkdirs()
+        var done = files.filter { (name, source) -> file(context, name).length() == source.second }
+            .sumOf { it.second.second }
+        for ((name, source) in files) {
+            val (address, size) = source
+            val target = file(context, name)
+            if (target.length() == size) continue
+            val partial = File(dir, "$name.part")
+            val failure = fetch(address, partial, size, isCancelled) { bytes ->
+                onProgress((done + bytes).toFloat() / totalBytes)
+            }
+            if (failure != null) return failure
+            if (!partial.renameTo(target)) return "could not save $name"
+            done += size
+        }
+        return null
+    }
+
+    companion object {
+        const val SENSE_VOICE_MODEL = "model.int8.onnx"
+        const val WHISPER_ENCODER = "encoder.int8.onnx"
+        const val WHISPER_DECODER = "decoder.int8.onnx"
+        const val TOKENS = "tokens.txt"
+
+        /** Registers persistence and Settings actions. Call once at app start. */
+        fun initialize(context: Context) {
+            val appContext = context.applicationContext
+            val preferences = appContext.getSharedPreferences("nuvio_generated_subtitles", Context.MODE_PRIVATE)
+            GeneratedSubtitles.installPersistence(
+                load = { key -> preferences.getString(key, null) },
+                save = { key, value -> preferences.edit().putString(key, value).apply() },
+            )
+            GeneratedSubtitles.modelActions = object : GeneratedSubtitleModelActions {
+                override fun deleteModels() {
+                    if (GeneratedSubtitleSession.running) return
+                    File(appContext.filesDir, "generated-subtitles").deleteRecursively()
+                    publish(appContext)
+                }
+            }
+            GeneratedSubtitles.supported = true
+            publish(appContext)
+        }
+
+        fun publish(context: Context) {
+            val ready = entries.filter { it.isReady(context) }
+            GeneratedSubtitles.publishModels(
+                if (ready.isEmpty()) "" else ready.joinToString(" · ") { "${it.label} (${it.sizeMb} MB)" },
+            )
+        }
+
+        private fun fetch(
+            address: String,
+            target: File,
+            expectedSize: Long,
+            isCancelled: () -> Boolean,
+            onBytes: (Long) -> Unit,
+        ): String? = try {
+            var url = URL(address)
+            var connection: HttpURLConnection
+            var redirects = 0
+            while (true) {
+                connection = url.openConnection() as HttpURLConnection
+                connection.connectTimeout = 15_000
+                connection.readTimeout = 30_000
+                connection.instanceFollowRedirects = false
+                val code = connection.responseCode
+                // HttpURLConnection does not follow cross-host redirects (Hugging Face -> CDN).
+                if (code in 300..399 && redirects++ < 5) {
+                    val location = connection.getHeaderField("Location") ?: return "redirect without location"
+                    connection.disconnect()
+                    url = URL(url, location)
+                    continue
+                }
+                if (code != 200) {
+                    connection.disconnect()
+                    return "HTTP $code"
+                }
+                break
+            }
+            connection.inputStream.use { input ->
+                target.outputStream().use { output ->
+                    val buffer = ByteArray(64 * 1024)
+                    var total = 0L
+                    while (true) {
+                        if (isCancelled()) return "cancelled"
+                        val read = input.read(buffer)
+                        if (read < 0) break
+                        output.write(buffer, 0, read)
+                        total += read
+                        onBytes(total)
+                    }
+                }
+            }
+            connection.disconnect()
+            if (target.length() != expectedSize) "incomplete download (${target.length()} of $expectedSize bytes)" else null
+        } catch (error: Exception) {
+            SyncLog.w("generated subtitles: model download failed for $address: ${error.message}")
+            error.message ?: error.javaClass.simpleName
+        }
+    }
+}
+
+private const val SENSE_VOICE_BASE =
+    "https://huggingface.co/csukuangfj/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-int8-2025-09-09/resolve/main"
+private const val WHISPER_BASE = "https://huggingface.co/csukuangfj/sherpa-onnx-whisper-small/resolve/main"
