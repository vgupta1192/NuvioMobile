+package com.nuvio.app.features.player.generated
+
+import com.google.android.gms.tasks.Tasks
+import com.google.mlkit.nl.translate.TranslateLanguage
+import com.google.mlkit.nl.translate.Translation
+import com.google.mlkit.nl.translate.Translator
+import com.google.mlkit.nl.translate.TranslatorOptions
+import com.nuvio.app.features.player.audiosync.SyncLog
+import java.util.concurrent.TimeUnit
+
+/**
+ * Translates recognised lines into English with ML Kit's on-device translation (models of about
+ * 30 MB per language, downloaded once). Blocking; call from a background thread.
+ */
+internal class GeneratedTranslator : AutoCloseable {
+    private val translators = HashMap<String, Translator>()
+    private val ready = HashSet<String>()
+    private val failed = HashSet<String>()
+
+    /** English text of [text] spoken in [language], or null when it can't be translated. */
+    fun translate(text: String, language: String, onStatus: (String) -> Unit): String? {
+        val source = mlKitLanguage(language) ?: return null
+        if (source == TranslateLanguage.ENGLISH) return text
+        if (source in failed) return null
+        val translator = translators.getOrPut(source) {
+            Translation.getClient(
+                TranslatorOptions.Builder()
+                    .setSourceLanguage(source)
+                    .setTargetLanguage(TranslateLanguage.ENGLISH)
+                    .build(),
+            )
+        }
+        if (source !in ready) {
+            onStatus("Downloading translation model (about 30 MB, once)…")
+            try {
+                Tasks.await(translator.downloadModelIfNeeded(), 10, TimeUnit.MINUTES)
+                ready += source
+            } catch (error: Exception) {
+                SyncLog.w("generated subtitles: translation model for $source failed: ${error.message}")
+                failed += source
+                onStatus("Translation model download failed")
+                return null
+            }
+        }
+        return try {
+            Tasks.await(translator.translate(text), 30, TimeUnit.SECONDS)?.trim()?.takeIf { it.isNotEmpty() }
+        } catch (error: Exception) {
+            SyncLog.w("generated subtitles: translation failed: ${error.message}")
+            null
+        }
+    }
+
+    override fun close() {
+        translators.values.forEach { runCatching { it.close() } }
+        translators.clear()
+    }
+
+    private fun mlKitLanguage(code: String): String? = when (code.lowercase()) {
+        "zh", "yue", "cmn" -> TranslateLanguage.CHINESE
+        "ja" -> TranslateLanguage.JAPANESE
+        "ko" -> TranslateLanguage.KOREAN
+        "hi" -> TranslateLanguage.HINDI
+        "tl", "fil" -> TranslateLanguage.TAGALOG
+        "en" -> TranslateLanguage.ENGLISH
+        else -> TranslateLanguage.fromLanguageTag(code)
+    }
+}
