index 00000000..2947117b
--- /dev/null
+++ b/composeApp/src/commonMain/kotlin/com/nuvio/app/features/player/GeneratedSubtitles.kt
@@ -0,0 +1,98 @@
+package com.nuvio.app.features.player
+
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+/**
+ * English subtitles generated on the device from the audio (speech recognition + translation), for
+ * titles without usable subtitles. Offered as one extra entry in the subtitle list; the platform
+ * that can generate them sets [supported] and does the work when that entry is attached.
+ */
+object GeneratedSubtitles {
+    /** Pseudo address of the generated subtitle; the ".srt" ending lets it use the sidecar path. */
+    const val URL = "nuvio-generated://subtitles/english.srt"
+    private const val SCHEME = "nuvio-generated://"
+
+    /** Spoken languages the recogniser can be told to expect; [AUTO] follows the audio track's tag. */
+    const val AUTO = "auto"
+    val spokenLanguages: List<Pair<String, String>> = listOf(
+        AUTO to "Auto (from the audio track)",
+        "zh" to "Chinese",
+        "yue" to "Cantonese",
+        "ja" to "Japanese",
+        "ko" to "Korean",
+        "hi" to "Hindi",
+        "en" to "English",
+    )
+
+    /** Set by a platform that can generate subtitles (Android). */
+    var supported: Boolean = false
+
+    /** Model download/delete, registered by the platform. */
+    var modelActions: GeneratedSubtitleModelActions? = null
+
+    private val _autoGenerate = MutableStateFlow(false)
+    /** Pick the generated subtitle automatically when no subtitle in the preferred language exists. */
+    val autoGenerate: StateFlow<Boolean> = _autoGenerate.asStateFlow()
+
+    private val _spokenLanguage = MutableStateFlow(AUTO)
+    val spokenLanguage: StateFlow<String> = _spokenLanguage.asStateFlow()
+
+    private val _models = MutableStateFlow("")
+    /** One-line summary of the downloaded models, for Settings. */
+    val models: StateFlow<String> = _models.asStateFlow()
+
+    private var save: ((key: String, value: String) -> Unit)? = null
+
+    fun installPersistence(load: (key: String) -> String?, save: (key: String, value: String) -> Unit) {
+        this.save = save
+        _autoGenerate.value = load(KEY_AUTO) == "true"
+        _spokenLanguage.value = load(KEY_LANGUAGE)?.takeIf { code -> spokenLanguages.any { it.first == code } } ?: AUTO
+    }
+
+    fun setAutoGenerate(value: Boolean) {
+        _autoGenerate.value = value
+        save?.invoke(KEY_AUTO, value.toString())
+    }
+
+    fun setSpokenLanguage(code: String) {
+        _spokenLanguage.value = code
+        save?.invoke(KEY_LANGUAGE, code)
+    }
+
+    /** The next spoken language in [spokenLanguages], for a row that cycles through them. */
+    fun cycleSpokenLanguage() {
+        val index = spokenLanguages.indexOfFirst { it.first == _spokenLanguage.value }
+        setSpokenLanguage(spokenLanguages[(index + 1) % spokenLanguages.size].first)
+    }
+
+    fun spokenLanguageLabel(code: String = _spokenLanguage.value): String =
+        spokenLanguages.firstOrNull { it.first == code }?.second ?: code
+
+    fun publishModels(summary: String) {
+        _models.value = summary
+    }
+
+    fun isGenerated(url: String?): Boolean = url?.startsWith(SCHEME) == true
+
+    val entry: AddonSubtitle
+        get() = AddonSubtitle(
+            id = "nuvio-generated-english",
+            url = URL,
+            language = "en",
+            display = "English · Generated from the audio (on this device)",
+            addonName = "Nuvio",
+        )
+
+    /** [subtitles] plus the generated entry, last so a real subtitle always comes first. */
+    fun withEntry(subtitles: List<AddonSubtitle>): List<AddonSubtitle> =
+        if (!supported || subtitles.any { isGenerated(it.url) }) subtitles else subtitles + entry
+
+    private const val KEY_AUTO = "auto_generate"
+    private const val KEY_LANGUAGE = "spoken_language"
+}
+
+interface GeneratedSubtitleModelActions {
+    fun deleteModels()
+}
