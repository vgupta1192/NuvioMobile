+                return
+            }
+            val language = spokenLanguage(current)
+            val model = when {
+                language in SENSE_VOICE_LANGUAGES -> GeneratedSpeechModel.SENSE_VOICE
+                language in DOLPHIN_LANGUAGES && GeneratedSubtitles.fastAsianModel.value -> GeneratedSpeechModel.DOLPHIN
