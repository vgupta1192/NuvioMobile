+package com.nuvio.app.features.settings
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import com.nuvio.app.features.player.GeneratedSubtitles
+
+/** Settings for subtitles generated from the audio; shown only where they are supported. */
+@Composable
+internal fun GeneratedSubtitleSettingsRows(isTablet: Boolean) {
+    if (!GeneratedSubtitles.supported) return
+    val autoGenerate by GeneratedSubtitles.autoGenerate.collectAsStateWithLifecycle()
+    val spokenLanguage by GeneratedSubtitles.spokenLanguage.collectAsStateWithLifecycle()
+    val models by GeneratedSubtitles.models.collectAsStateWithLifecycle()
+
+    SettingsGroupDivider(isTablet = isTablet)
+    SettingsSwitchRow(
+        title = "Generate subtitles when none are found",
+        description = "Pick \"English · Generated from the audio\" by itself when no subtitle in your " +
+            "language exists. It is always in the subtitle list to pick by hand. Speech is recognised " +
+            "and translated on this device; models download once on Wi-Fi.",
+        checked = autoGenerate,
+        isTablet = isTablet,
+        onCheckedChange = GeneratedSubtitles::setAutoGenerate,
+    )
+    SettingsGroupDivider(isTablet = isTablet)
+    SettingsNavigationRow(
+        title = "Spoken language for generated subtitles",
+        description = GeneratedSubtitles.spokenLanguageLabel(spokenLanguage) +
+            " · Chinese, Cantonese, Japanese, Korean and English use SenseVoice (237 MB); " +
+            "Hindi uses Whisper small (375 MB). Tap to change.",
+        isTablet = isTablet,
+        onClick = GeneratedSubtitles::cycleSpokenLanguage,
+    )
+    if (models.isNotEmpty()) {
+        SettingsGroupDivider(isTablet = isTablet)
+        SettingsNavigationRow(
+            title = "Delete subtitle generation models",
+            description = models,
+            isTablet = isTablet,
+            onClick = { GeneratedSubtitles.modelActions?.deleteModels() },
+        )
+    }
+}
