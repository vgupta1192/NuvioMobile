+            val covered = ArrayList<LongArray>()
+            var failures = 0
+            while (!current.stopped) {
+                val positionMs = current.positionMs
+                val fromMs = nextUncovered(covered, positionMs)
+                val durationMs = current.durationMs
+                if (fromMs >= positionMs + LOOKAHEAD_MS || (durationMs > 0 && fromMs >= durationMs)) {
+                    Thread.sleep(500L)
+                    continue
+                }
+                // A short first window gets lines on screen quickly; later ones are longer.
+                val windowMs = if (fromMs - positionMs < FIRST_WINDOW_MS) FIRST_WINDOW_MS else WINDOW_MS
+                val toMs = if (durationMs > 0) minOf(fromMs + windowMs, durationMs) else fromMs + windowMs
+                if (!hasCueNear(current, positionMs) && fromMs <= positionMs + 2_000L) {
+                    current.status = "Generating subtitles from the audio…"
+                }
+                val startedAt = System.currentTimeMillis()
+                val segments = readWindow(current, source, hlsSampler, weights, fromMs, toMs)
+                if (current.stopped) return
+                if (segments == null) {
+                    failures++
+                    if (failures >= MAX_FAILURES) {
+                        current.status = "Couldn't read this stream's audio for generated subtitles"
+                        return
+                    }
+                    Thread.sleep(2_000L)
+                    continue
+                }
+                failures = 0
+                addCovered(covered, fromMs, toMs)
+                var lines = 0
+                for ((startMs, samples) in segments) {
+                    if (current.stopped) return
+                    // Whisper invents words for very short sounds; such bits rarely carry a line.
+                    if (recognizer.translatesToEnglish && samples.size < MIN_WHISPER_SAMPLES) continue
+                    val heard = recognizer.recognize(samples)
+                    val text = cleanText(heard.text) ?: continue
+                    if (recognizer.translatesToEnglish && isWhisperFiller(text)) continue
+                    val english = if (recognizer.translatesToEnglish || heard.language == "en") {
+                        text
+                    } else {
+                        translator.translate(text, heard.language.ifEmpty { language }) { message -> current.status = message }
+                            ?: continue
+                    }
+                    val endMs = startMs + samples.size * 1_000L / SileroVad.SAMPLE_RATE
+                    addLine(current, startMs, endMs, english)
+                    lines++
+                }
+                if (current.status?.startsWith("Downloading translation") == true || hasCueNear(current, current.positionMs)) {
+                    current.status = null
+                }
+                SyncLog.i(
+                    "generated subtitles: ${fromMs / 1_000}-${toMs / 1_000}s → $lines lines from ${segments.size} " +
+                        "speech segments in ${(System.currentTimeMillis() - startedAt) / 1_000}s",
+                )
+            }
+        } catch (_: InterruptedException) {
+        } catch (error: Throwable) {
+            SyncLog.w("generated subtitles failed: ${error.message}")
+            if (!current.stopped) current.status = "Generated subtitles stopped: ${error.message ?: error.javaClass.simpleName}"
+        } finally {
+            recognizer?.close()
+            translator.close()
+        }
+    }
+
+    /** The language to recognise: the user's choice, else the audio track's tag ([GeneratedSubtitles.AUTO] if none). */
+    private fun spokenLanguage(current: Run): String {
+        val chosen = GeneratedSubtitles.spokenLanguage.value
+        if (chosen != GeneratedSubtitles.AUTO) return chosen
+        // The ticker publishes the track shortly after start.
+        repeat(20) {
+            if (current.audioFormat != null || current.stopped) return@repeat
+            Thread.sleep(100L)
+        }
+        val tag = current.audioFormat?.language?.lowercase()?.substringBefore('-')?.substringBefore('_').orEmpty()
+        val code = THREE_LETTER_CODES[tag] ?: tag
+        return code.takeIf { known -> GeneratedSubtitles.spokenLanguages.any { it.first == known } }
+            ?: GeneratedSubtitles.AUTO
+    }
+
+    /**
+     * Reads [fromMs]..[toMs] of the stream's audio and returns its speech segments (start in ms,
+     * 16 kHz samples), or null when the audio couldn't be read.
+     */
+    private fun readWindow(
+        current: Run,
+        source: Uri,
+        hlsSampler: HlsAudioSpotSampler?,
+        weights: SileroVadWeights,
+        fromMs: Long,
+        toMs: Long,
+    ): List<Pair<Long, FloatArray>>? {
+        val analyzer = SpeechAnalyzer(SileroVad(weights), SpeechTimeline())
+        val segments = ArrayList<Pair<Long, FloatArray>>()
+        val segmenter = SpeechSegmenter { startFrame, samples ->
+            synchronized(segments) {
+                segments += startFrame.toLong() * SpeechTimeline.FRAME_DURATION_US / 1_000L to samples
+            }
+        }
+        analyzer.chunkListener = segmenter
+        val decoder = AudioSyncDecoder(analyzer, analyzer, allowVendorDecoders = false)
+        val sink = WindowSink(current, decoder, anyAudio = hlsSampler != null)
+        // Give up on the window when the user seeks far away from it.
+        val isCancelled = {
+            current.stopped || current.positionMs + SEEK_AWAY_MS < fromMs || current.positionMs > toMs + SEEK_AWAY_MS
+        }
+        try {
+            val result = if (hlsSampler != null) {
+                hlsSampler.run(listOf(fromMs), toMs - fromMs, listOf(sink), isCancelled) { _, _ -> }
+            } else {
+                AudioSpotSampler(source, dataSourceFactory, MAX_WINDOW_BYTES, MAX_WINDOW_BYTES, 0L, EARLY_SEEK_MS).run(
+                    spotsMs = listOf(fromMs),
+                    spotMs = toMs - fromMs,
+                    workers = listOf(AudioSyncExtractorsFactory(DefaultExtractorsFactory(), sink)),
+                    isCancelled = isCancelled,
+                ) { _, _ -> }
+            }
+            if (result.sampled == 0) {
+                SyncLog.w("generated subtitles: reading ${fromMs / 1_000}-${toMs / 1_000}s failed: ${result.failure}")
+                return null
+            }
+            decoder.awaitDrained(DRAIN_TIMEOUT_MS)
+            Thread.sleep(DECODE_SETTLE_MS)
+            segmenter.flush()
+        } finally {
+            decoder.release()
+        }
+        return synchronized(segments) { segments.sortedBy { it.first } }
+    }
+
+    /** Feeds the playing audio track (or, for HLS segments, the first audio track) to [decoder]. */
+    private class WindowSink(
+        private val current: Run,
+        private val decoder: AudioSyncDecoder,
+        private val anyAudio: Boolean,
+    ) : AudioSampleSink {
+        @Volatile
+        private var taken: String? = null
+
+        override fun wantsSamples(format: Format): Boolean {
+            if (current.stopped) return false
+            val playing = current.audioFormat
+            if (!anyAudio && playing != null) return sameTrack(format, playing)
+            val track = format.id ?: format.sampleMimeType ?: return false
+            return track == (taken ?: track.also { taken = it })
+        }
+
+        override fun onSample(format: Format, timeUs: Long, data: ByteArray, offset: Int, size: Int) {
+            while (!decoder.offer(format, timeUs, data, offset, size)) {
+                if (current.stopped || !decoder.accepts(format)) return
+                Thread.sleep(5L)
+            }
+        }
+
+        override fun onDiscontinuity() {
+            decoder.awaitDrained(DRAIN_TIMEOUT_MS)
+            decoder.discontinuity()
+        }
+    }
+
+    private fun addLine(current: Run, startMs: Long, endMs: Long, text: String) {
+        val pieces = splitForScreen(text)
+        val totalChars = pieces.sumOf { it.length }.coerceAtLeast(1)
+        val spanMs = (endMs - startMs).coerceAtLeast(MIN_CUE_MS)
+        var atMs = startMs
+        val added = pieces.map { piece ->
+            val pieceMs = (spanMs * piece.length / totalChars).coerceAtLeast(MIN_CUE_MS / pieces.size)
+            cue(atMs, atMs + pieceMs + if (piece === pieces.last()) LINGER_MS else 0L, piece).also { atMs += pieceMs }
+        }
+        synchronized(current.cues) {
+            current.cues.removeAll { existing -> added.any { it.startTimeUs == existing.startTimeUs } }
+            current.cues += added
+            current.cues.sortBy { it.startTimeUs }
+            // A line stays until the next one starts, never on top of it.
+            for (index in 0 until current.cues.size - 1) {
+                val entry = current.cues[index]
+                val nextStart = current.cues[index + 1].startTimeUs
+                if (entry.startTimeUs + entry.durationUs > nextStart && nextStart > entry.startTimeUs) {
+                    current.cues[index] = CuesWithTiming(entry.cues, entry.startTimeUs, nextStart - entry.startTimeUs)
+                }
+            }
+            current.cuesVersion++
+        }
+    }
+
+    companion object {
+        /** Whether a session is generating (models must not be deleted meanwhile). */
+        @Volatile
+        var running = false
+
+        private const val PLACEHOLDER_SRT = "1\n00:00:00,000 --> 00:00:00,100\n…\n"
+        private const val TICK_MS = 250L
+        private const val STATUS_SHOW_MS = 2_500L
+        private const val LOOKAHEAD_MS = 120_000L
+        private const val FIRST_WINDOW_MS = 20_000L
+        private const val WINDOW_MS = 60_000L
+        private const val SEEK_AWAY_MS = 60_000L
+        /** Files with a sparse index seek well before the target; reading from there is fine. */
+        private const val EARLY_SEEK_MS = 180_000L
+        private const val MAX_WINDOW_BYTES = 400L * 1_000_000L
+        private const val MAX_FAILURES = 4
+        private const val DRAIN_TIMEOUT_MS = 15_000L
+        private const val DECODE_SETTLE_MS = 300L
+        private const val MIN_CUE_MS = 1_200L
+        private const val LINGER_MS = 400L
+        private const val MAX_LINE_CHARS = 42
+        private const val THREADS = 2
+        private val WHISPER_THREADS = (Runtime.getRuntime().availableProcessors() / 2).coerceIn(2, 4)
+        private const val MIN_WHISPER_SAMPLES = SileroVad.SAMPLE_RATE * 6 / 10
+        private val SENSE_VOICE_LANGUAGES = setOf("zh", "yue", "ja", "ko", "en")
+
+        /** Dolphin languages ML Kit can also translate (Punjabi can't be, so Whisper keeps it). */
+        private val DOLPHIN_LANGUAGES = setOf(
+            "hi", "ur", "bn", "ta", "te", "gu", "mr", "th", "id", "ms", "vi", "tl", "ar", "fa", "ru",
+        )
+
+        /** ISO 639-2 audio tags (as in Matroska) to the codes in [GeneratedSubtitles.spokenLanguages]. */
+        private val THREE_LETTER_CODES = mapOf(
+            "zho" to "zh", "chi" to "zh", "cmn" to "zh", "jpn" to "ja", "kor" to "ko", "eng" to "en",
+            "hin" to "hi", "urd" to "ur", "ben" to "bn", "tam" to "ta", "tel" to "te", "mal" to "ml",
+            "kan" to "kn", "mar" to "mr", "guj" to "gu", "pan" to "pa", "tha" to "th", "ind" to "id",
+            "msa" to "ms", "may" to "ms", "tgl" to "tl", "fil" to "tl", "vie" to "vi", "tur" to "tr",
+            "ara" to "ar", "fas" to "fa", "per" to "fa", "rus" to "ru", "ukr" to "uk", "pol" to "pl",
+            "spa" to "es", "por" to "pt", "fra" to "fr", "fre" to "fr", "deu" to "de", "ger" to "de",
+            "ita" to "it", "nld" to "nl", "dut" to "nl", "swe" to "sv", "ell" to "el", "gre" to "el",
+            "heb" to "he", "iw" to "he", "in" to "id",
+        )
+
+        /** Lines Whisper is known to produce from music, noise or silence. */
+        private val WHISPER_FILLERS = setOf(
+            "thank you", "thanks", "thank you very much", "thanks for watching", "thank you for watching",
+            "you", "bye", "okay", "ok", "please subscribe", "subscribe", "music", "applause", "laughter",
+            "subtitles by the amara.org community", "so", "oh", "hmm", "uh", "um",
+        )
+
+        private fun isWhisperFiller(text: String): Boolean {
+            val plain = text.lowercase().replace(Regex("[^\\p{L}\\p{N} ]"), "").trim().replace(Regex("\\s+"), " ")
+            return plain.isEmpty() || plain in WHISPER_FILLERS ||
+                (text.trim().startsWith("[") && text.trim().endsWith("]")) ||
+                (text.trim().startsWith("(") && text.trim().endsWith(")")) ||
+                text.contains('♪')
+        }
+
+        private fun cue(startMs: Long, endMs: Long, text: String) = CuesWithTiming(
+            listOf(Cue.Builder().setText(text).build()),
+            startMs * 1_000L,
+            (endMs - startMs).coerceAtLeast(1L) * 1_000L,
+        )
+
+        /** Where the playhead's covered stretch ends, or (a little before) the playhead itself. */
+        private fun nextUncovered(covered: List<LongArray>, positionMs: Long): Long {
+            val probe = (positionMs - 2_000L).coerceAtLeast(0L)
+            var at = probe
+            var moved = true
+            while (moved) {
+                moved = false
+                for (range in covered) {
+                    if (at >= range[0] && at < range[1]) {
+                        at = range[1]
+                        moved = true
+                    }
+                }
+            }
+            return at
+        }
+
+        private fun addCovered(covered: MutableList<LongArray>, fromMs: Long, toMs: Long) {
+            covered += longArrayOf(fromMs, toMs)
+            covered.sortBy { it[0] }
+            val merged = ArrayList<LongArray>()
+            for (range in covered) {
+                val last = merged.lastOrNull()
+                if (last != null && range[0] <= last[1]) last[1] = maxOf(last[1], range[1]) else merged += range.copyOf()
+            }
+            covered.clear()
+            covered += merged
+        }
+
+        private fun sameTrack(a: Format, b: Format): Boolean {
+            if (a.sampleMimeType != b.sampleMimeType) return false
+            val periodPrefix = Regex("^(\\d+:)+")
+            val aId = a.id?.replace(periodPrefix, "")
+            val bId = b.id?.replace(periodPrefix, "")
+            if (!aId.isNullOrEmpty() && !bId.isNullOrEmpty()) return aId == bId
+            return a.language == b.language && a.channelCount == b.channelCount && a.sampleRate == b.sampleRate
+        }
+
+        /** Drops empty or punctuation-only results (music, sighs). */
+        private fun cleanText(text: String): String? {
+            // Model tags: SenseVoice "<|zh|>", Dolphin "<hi><IN>".
+            val trimmed = text.replace(Regex("<\\|[^|]*\\|>"), "").replace(Regex("<[A-Za-z_-]{1,12}>"), "").trim()
+            return trimmed.takeIf { value -> value.any { it.isLetterOrDigit() } }
+        }
+
+        /** Breaks a long line into on-screen pieces of at most two lines each. */
+        private fun splitForScreen(text: String): List<String> {
+            val words = text.split(Regex("\\s+")).filter { it.isNotEmpty() }
+            if (words.isEmpty()) return listOf(text)
+            val lines = ArrayList<String>()
+            val line = StringBuilder()
+            for (word in words) {
+                if (line.isNotEmpty() && line.length + 1 + word.length > MAX_LINE_CHARS) {
+                    lines += line.toString()
+                    line.setLength(0)
+                }
+                if (line.isNotEmpty()) line.append(' ')
+                line.append(word)
+            }
+            if (line.isNotEmpty()) lines += line.toString()
+            return lines.chunked(2) { it.joinToString("\n") }
+        }
+    }
+}
