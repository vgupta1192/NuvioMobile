+                        "${formatDownloadBytes(speed.toLong())}/s"
+                    }
+                    val speedText = when {
+                        perSecond == null -> null
+                        contributingSpeeds.size > 1 -> stringResource(Res.string.downloads_speed_total, perSecond)
