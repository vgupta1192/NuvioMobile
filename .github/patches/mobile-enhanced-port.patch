+        ?.takeIf { row.existing == null }
+        ?.let { stream -> listOfNotNull(stream.addonName.takeIf { it.isNotBlank() }, downloadQualityChipText(stream) ?: streamQualityLabel(stream)).joinToString(" · ") }
