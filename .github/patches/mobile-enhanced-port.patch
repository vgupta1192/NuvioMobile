+            Button(
+                onClick = {
+                    if (!canQueue) return@Button
+                    queuing = true
+                    scope.launch {
+                        try {
+                            val ready = rows.mapNotNull { row ->
+                                if (!row.selectedForTotal()) return@mapNotNull null
+                                val matched = row.match as? SeasonStreamMatch.Matched ?: return@mapNotNull null
