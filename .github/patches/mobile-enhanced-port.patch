+    private fun exportAddons(): JsonArray = buildJsonArray {
+        AddonRepository.uiState.value.addons.distinctBy { it.manifestUrl }.forEach { addon ->
+            add(
+                buildJsonObject {
+                    put("url", addon.manifestUrl)
+                    put("enabled", addon.enabled)
+                },
+            )
+        }
