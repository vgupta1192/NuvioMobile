+/** Fork feature: rate the title 1-10 on every connected tracker that supports ratings. */
+private fun MetaDetails.ratingTarget(): TrackingRatingTarget? {
+    val ids = parseTrackingExternalIds(id).let { parsed ->
+        if (parsed.imdb == null && imdbId != null) parsed.copy(imdb = imdbId) else parsed
+    }
+    val kind = trackingMediaKind(type, ids)
+    val isMovie = type.trim().lowercase() in setOf("movie", "film")
+    return TrackingRatingTarget(
+        scope = if (isMovie) TrackingRatingScope.MOVIE else TrackingRatingScope.SHOW,
+        kind = kind,
+        ids = ids,
+        title = name,
+        year = extractTrackingYear(releaseInfo),
+        catalog = TrackingCatalogReference(contentId = id, contentType = type),
+    ).takeIf { it.isValid }
+}
+
+/** Returns the "Rate" action (null when no connected tracker can rate this title) and hosts its dialog. */
+@Composable
+internal fun rememberRatingAction(meta: MetaDetails?): DetailSecondaryAction? {
+    if (meta == null) return null
+    val target = remember(meta.id) { meta.ratingTarget() } ?: return null
+    val providers = remember(meta.id) {
+        TrackingProviderRegistry.connectedRatingProviders().filter { it.canRate(target) }
+    }
+    if (providers.isEmpty()) return null
+
+    var showDialog by remember(meta.id) { mutableStateOf(false) }
+    var current by remember(meta.id) { mutableStateOf<Int?>(null) }
+    val scope = rememberCoroutineScope()
+    val profileId = ProfileRepository.activeProfileId
+
+    LaunchedEffect(showDialog) {
+        if (!showDialog) return@LaunchedEffect
+        current = runCatching {
+            val normalized = providers.first().normalize(target)
+            providers.first().fetchRatings(profileId, normalized.scope)
+                .firstOrNull { it.matches(normalized) }?.rating
+        }.getOrNull()
+    }
+
+    if (showDialog) {
+        RatingDialog(
+            title = meta.name,
+            current = current,
+            onRate = { value ->
+                showDialog = false
+                current = value
+                scope.launch {
+                    providers.forEach { provider ->
+                        try {
+                            provider.setRating(profileId, provider.normalize(target), value)
+                        } catch (e: CancellationException) {
+                            throw e
+                        } catch (_: Exception) {
+                        }
+                    }
+                }
+            },
+            onRemove = {
+                showDialog = false
+                current = null
+                scope.launch {
+                    providers.forEach { provider ->
+                        try {
+                            provider.removeRating(profileId, provider.normalize(target))
+                        } catch (e: CancellationException) {
+                            throw e
+                        } catch (_: Exception) {
+                        }
+                    }
+                }
+            },
+            onDismiss = { showDialog = false },
+        )
+    }
+
+    return DetailSecondaryAction(
+        label = current?.let { "Rated $it/10" } ?: "Rate",
+        icon = if (current != null) Icons.Default.Star else Icons.Outlined.StarBorder,
+        isActive = current != null,
+        onClick = { showDialog = true },
+    )
+}
+
+@OptIn(ExperimentalLayoutApi::class)
+@Composable
+private fun RatingDialog(
+    title: String,
+    current: Int?,
+    onRate: (Int) -> Unit,
+    onRemove: () -> Unit,
+    onDismiss: () -> Unit,
+) {
+    AlertDialog(
+        onDismissRequest = onDismiss,
+        title = { Text("Rate $title") },
+        text = {
+            Column(verticalArrangement = Arrangement.spacedBy(12.dp)) {
+                FlowRow(
+                    horizontalArrangement = Arrangement.spacedBy(8.dp),
+                    verticalArrangement = Arrangement.spacedBy(8.dp),
+                ) {
+                    for (value in TRACKING_RATING_MIN..TRACKING_RATING_MAX) {
+                        val selected = value == current
+                        Box(
+                            modifier = Modifier
+                                .size(44.dp)
+                                .clip(CircleShape)
+                                .background(
+                                    if (selected) MaterialTheme.colorScheme.primary
+                                    else MaterialTheme.colorScheme.surfaceVariant,
+                                )
+                                .clickable { onRate(value) },
+                            contentAlignment = Alignment.Center,
+                        ) {
+                            Text(
+                                text = value.toString(),
+                                color = if (selected) MaterialTheme.colorScheme.onPrimary
+                                else MaterialTheme.colorScheme.onSurface,
+                            )
+                        }
+                    }
+                }
+            }
+        },
+        confirmButton = {
+            if (current != null) TextButton(onClick = onRemove) { Text("Remove rating") }
+        },
+        dismissButton = { TextButton(onClick = onDismiss) { Text("Cancel") } },
+    )
+}
