+    /// Custom Stretch: mpv ignores video-zoom/scale/pan with keepaspect=no, so the bars are cropped.
+    func setVideoCrop(_ crop: String) {
+        guard mpv != nil else { return }
+        setStringProperty("video-crop", crop)
+    }
