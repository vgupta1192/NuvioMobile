+    /// Downscaled luma of the current decoded frame: UInt16 LE width, UInt16 LE height,
+    /// a flag byte (1 when the screenshot is only the video-crop region), then luma bytes.
+    func sampleVideoLuma(maxDimension: Int) -> Data? {
+        guard mpv != nil, maxDimension > 0 else { return nil }
+        var result = mpv_node()
+        var cargs = makeCArgs("screenshot-raw", ["video"]).map { $0.flatMap { UnsafePointer<CChar>(strdup($0)) } }
+        defer { for ptr in cargs where ptr != nil { free(UnsafeMutablePointer(mutating: ptr!)) } }
+        guard mpv_command_ret(mpv, &cargs, &result) >= 0 else { return nil }
+        defer { mpv_free_node_contents(&result) }
+        guard result.format == MPV_FORMAT_NODE_MAP, let list = result.u.list else { return nil }
+
+        var width = 0
+        var height = 0
+        var stride = 0
+        var format = "bgr0"
+        var pixels: UnsafeMutableRawPointer?
+        var pixelBytes = 0
+        for index in 0..<Int(list.pointee.num) {
+            guard let keyPointer = list.pointee.keys?[index] else { continue }
+            let value = list.pointee.values[index]
+            switch String(cString: keyPointer) {
+            case "w": width = Int(value.u.int64)
+            case "h": height = Int(value.u.int64)
+            case "stride": stride = Int(value.u.int64)
+            case "format":
+                if value.format == MPV_FORMAT_STRING, let string = value.u.string { format = String(cString: string) }
+            case "data":
+                if value.format == MPV_FORMAT_BYTE_ARRAY, let byteArray = value.u.ba {
+                    pixels = byteArray.pointee.data
+                    pixelBytes = Int(byteArray.pointee.size)
+                }
+            default: break
+            }
+        }
+        guard format == "bgr0", width > 0, height > 0, stride >= width * 4,
+              let pixels, pixelBytes >= stride * height else { return nil }
+        let sourceWidth = getInt("video-params/w")
+        let sourceHeight = getInt("video-params/h")
+        let cropped = sourceWidth > 0 && sourceHeight > 0 && (width != sourceWidth || height != sourceHeight)
+
+        let scale = min(1.0, Double(maxDimension) / Double(max(width, height)))
+        let outWidth = max(8, Int((Double(width) * scale).rounded()))
+        let outHeight = max(8, Int((Double(height) * scale).rounded()))
+        var output = Data(count: 5 + outWidth * outHeight)
+        output.withUnsafeMutableBytes { (buffer: UnsafeMutableRawBufferPointer) in
+            let out = buffer.bindMemory(to: UInt8.self)
+            out[0] = UInt8(outWidth & 0xFF)
+            out[1] = UInt8((outWidth >> 8) & 0xFF)
+            out[2] = UInt8(outHeight & 0xFF)
+            out[3] = UInt8((outHeight >> 8) & 0xFF)
+            out[4] = cropped ? 1 : 0
+            let source = pixels.assumingMemoryBound(to: UInt8.self)
+            for y in 0..<outHeight {
+                let sourceY = min(height - 1, (y * height + height / 2) / outHeight)
+                let row = source + sourceY * stride
+                for x in 0..<outWidth {
+                    let sourceX = min(width - 1, (x * width + width / 2) / outWidth)
+                    let pixel = row + sourceX * 4
+                    let luma = (Int(pixel[2]) * 77 + Int(pixel[1]) * 150 + Int(pixel[0]) * 29) >> 8
+                    out[5 + y * outWidth + x] = UInt8(luma)
+                }
+            }
+        }
+        return output
+    }
