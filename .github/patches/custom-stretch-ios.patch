+    // MARK: - Custom Stretch
+
+    private var customStretchActive = false
+    private var customStretchTransform: (scaleX: Double, scaleY: Double, panX: Double, panY: Double) = (1, 1, 0, 0)
+
+    func setVideoTransform(scaleX: Double, scaleY: Double, panX: Double, panY: Double) {
+        customStretchTransform = (scaleX, scaleY, panX, panY)
+        applyCustomStretchTransform()
+    }
+
+    private func applyCustomStretchTransform() {
+        guard mpv != nil else { return }
+        let transform = customStretchActive ? customStretchTransform : (scaleX: 1, scaleY: 1, panX: 0, panY: 0)
+        setStringProperty("keepaspect", customStretchActive ? "no" : "yes")
+        var scaleX = transform.scaleX
+        var scaleY = transform.scaleY
+        var panX = transform.panX
+        var panY = transform.panY
+        checkError(mpv_set_property(mpv, "video-scale-x", MPV_FORMAT_DOUBLE, &scaleX))
+        checkError(mpv_set_property(mpv, "video-scale-y", MPV_FORMAT_DOUBLE, &scaleY))
+        checkError(mpv_set_property(mpv, "video-pan-x", MPV_FORMAT_DOUBLE, &panX))
+        checkError(mpv_set_property(mpv, "video-pan-y", MPV_FORMAT_DOUBLE, &panY))
+    }
