+/**
+ * Smart Enhance (ported idea from MX Player): a player button that lifts contrast and colour for a more immersive
+ * picture, with a short banner when it is turned on. The player engine applies the actual video effect.
+ */
+object SmartEnhance {
+    private const val PATH = "settings/smart_enhance"
+    private val _enabled = MutableStateFlow(false)
+    val enabled: StateFlow<Boolean> = _enabled.asStateFlow()
+
+    /** True while the current engine can apply the effect; the toolbar button only shows then. */
+    internal val available = MutableStateFlow(false)
+
+    private val _bannerTick = MutableStateFlow(0)
+    internal val bannerTick: StateFlow<Int> = _bannerTick.asStateFlow()
+    private var loaded = false
+
+    fun ensureLoaded() {
+        if (loaded) return
+        loaded = true
+        AppFileCache.read(PATH)?.trim()?.let { _enabled.value = it == "1" }
+    }
+
+    fun toggle() {
+        ensureLoaded()
+        val next = !_enabled.value
+        _enabled.value = next
+        if (next) _bannerTick.value = _bannerTick.value + 1
+        runCatching { AppFileCache.write(PATH, if (next) "1" else "0") }
+    }
+}
+
+/** A video frame with a play triangle and a sparkle, drawn here so it needs no extra icon set. */
+internal val SmartEnhanceIcon: ImageVector by lazy {
+    ImageVector.Builder(
+        name = "SmartEnhance",
+        defaultWidth = 24.dp,
+        defaultHeight = 24.dp,
+        viewportWidth = 24f,
+        viewportHeight = 24f,
+    ).apply {
+        path(
+            stroke = SolidColor(Color.White),
+            strokeLineWidth = 1.8f,
+            strokeLineCap = StrokeCap.Round,
+            strokeLineJoin = StrokeJoin.Round,
+        ) {
+            moveTo(11f, 5f)
+            horizontalLineTo(6f)
+            arcTo(2.5f, 2.5f, 0f, false, false, 3.5f, 7.5f)
+            verticalLineTo(16.5f)
+            arcTo(2.5f, 2.5f, 0f, false, false, 6f, 19f)
+            horizontalLineTo(16f)
+            arcTo(2.5f, 2.5f, 0f, false, false, 18.5f, 16.5f)
+            verticalLineTo(12f)
+        }
+        path(fill = SolidColor(Color.White), pathFillType = PathFillType.NonZero) {
+            moveTo(8.5f, 9.2f)
+            lineTo(14f, 12f)
+            lineTo(8.5f, 14.8f)
+            close()
+        }
+        path(fill = SolidColor(Color.White), pathFillType = PathFillType.NonZero) {
+            moveTo(18.5f, 2.5f)
+            lineTo(19.6f, 5.4f)
+            lineTo(22.5f, 6.5f)
+            lineTo(19.6f, 7.6f)
+            lineTo(18.5f, 10.5f)
+            lineTo(17.4f, 7.6f)
+            lineTo(14.5f, 6.5f)
+            lineTo(17.4f, 5.4f)
+            close()
+        }
+    }.build()
+}
+
+/** Centre banner shown for a moment each time Smart Enhance is turned on. */
+@Composable
+internal fun SmartEnhanceBanner(modifier: Modifier = Modifier) {
+    val tick by SmartEnhance.bannerTick.collectAsStateWithLifecycle()
+    var visible by remember { mutableStateOf(false) }
+    LaunchedEffect(tick) {
+        if (tick == 0) return@LaunchedEffect
+        visible = true
+        delay(2_200)
+        visible = false
+    }
+    val alpha by animateFloatAsState(
+        targetValue = if (visible) 1f else 0f,
+        animationSpec = tween(durationMillis = if (visible) 280 else 520),
+        label = "smartEnhanceBanner",
+    )
+    if (alpha <= 0f) return
+    Box(modifier = modifier.fillMaxSize().alpha(alpha), contentAlignment = Alignment.Center) {
+        Column(
+            horizontalAlignment = Alignment.CenterHorizontally,
+            verticalArrangement = Arrangement.spacedBy(6.dp),
+        ) {
+            Icon(
+                imageVector = SmartEnhanceIcon,
+                contentDescription = null,
+                tint = Color.White,
+                modifier = Modifier.size(52.dp),
+            )
+            Text(
+                text = stringResource(Res.string.player_smart_enhance).uppercase(),
+                color = Color.White,
+                style = MaterialTheme.typography.headlineMedium,
+                fontWeight = FontWeight.Bold,
+                letterSpacing = 1.5.sp,
+                textAlign = TextAlign.Center,
+            )
+            Text(
+                text = stringResource(Res.string.player_smart_enhance_tagline),
+                color = Color.White,
+                style = MaterialTheme.typography.bodyLarge,
+                textAlign = TextAlign.Center,
+            )
+        }
+    }
+}
+
+/** Toolbar button for the header layout. */
+@Composable
+internal fun SmartEnhanceHeaderButton(metrics: PlayerLayoutMetrics) {
+    val available by SmartEnhance.available.collectAsStateWithLifecycle()
+    val enabled by SmartEnhance.enabled.collectAsStateWithLifecycle()
+    if (!available) return
+    PlayerHeaderIconButton(
+        icon = SmartEnhanceIcon,
+        contentDescription = stringResource(Res.string.player_smart_enhance),
+        buttonSize = metrics.headerIconSize + 16.dp,
+        iconSize = metrics.headerIconSize,
+        onClick = { SmartEnhance.toggle() },
+        tint = if (enabled) MaterialTheme.colorScheme.primary else Color.White,
+    )
+}
+
+/** Toolbar button for the legacy layout. */
+@Composable
+internal fun SmartEnhanceToolbarAction() {
+    val available by SmartEnhance.available.collectAsStateWithLifecycle()
+    val enabled by SmartEnhance.enabled.collectAsStateWithLifecycle()
+    if (!available) return
+    IconButton(onClick = { SmartEnhance.toggle() }, modifier = Modifier.size(48.dp)) {
+        Icon(
+            imageVector = SmartEnhanceIcon,
+            contentDescription = stringResource(Res.string.player_smart_enhance),
+            tint = if (enabled) MaterialTheme.colorScheme.primary else Color.White,
+            modifier = Modifier.size(24.dp),
+        )
+    }
+}
