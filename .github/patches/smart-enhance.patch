+/** Smart Enhance on ExoPlayer: a GL contrast and saturation lift on the decoded frames; an empty list restores the original picture. */
+private fun ExoPlayer.applySmartEnhance(enabled: Boolean) {
+    runCatching {
+        setVideoEffects(
+            if (enabled) {
+                listOf(
+                    Contrast(0.12f),
+                    HslAdjustment.Builder().adjustSaturation(16f).adjustLightness(2f).build(),
+                )
+            } else {
+                emptyList()
+            },
+        )
+    }.onFailure { Log.w(TAG, "Smart Enhance could not be applied", it) }
+}
