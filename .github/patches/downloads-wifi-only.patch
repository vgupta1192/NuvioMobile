@@ -0,0 +1,13 @@
+package com.nuvio.app.features.downloads
+
+import platform.Foundation.NSUserDefaults
+
+internal actual object DownloadsNetworkPolicy {
+    private const val WIFI_ONLY_KEY = "nuvio_downloads_wifi_only"
+
+    actual fun isWifiOnly(): Boolean = NSUserDefaults.standardUserDefaults.boolForKey(WIFI_ONLY_KEY)
+
+    actual fun setWifiOnly(enabled: Boolean) {
+        NSUserDefaults.standardUserDefaults.setBool(enabled, forKey = WIFI_ONLY_KEY)
+    }
+}
