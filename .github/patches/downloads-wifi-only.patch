+package com.nuvio.app.features.downloads
+
+/**
+ * Wi-Fi-only downloads (ported idea from NuvioMobile-Enhanced): when on, new downloads wait for an
+ * unmetered network instead of using mobile data. A per-device choice, not synced.
+ */
+internal expect object DownloadsNetworkPolicy {
+    fun isWifiOnly(): Boolean
+    fun setWifiOnly(enabled: Boolean)
+}
