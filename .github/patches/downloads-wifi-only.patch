@@ -0,0 +1,18 @@
+package com.nuvio.app.features.downloads
+
+import android.content.Context
+
+internal actual object DownloadsNetworkPolicy {
+    private const val PREFERENCES_NAME = "nuvio_downloads_network"
+    private const val WIFI_ONLY_KEY = "wifi_only"
+
+    private fun preferences() =
+        DownloadsPlatformDownloader.applicationContextOrNull()
+            ?.getSharedPreferences(PREFERENCES_NAME, Context.MODE_PRIVATE)
+
+    actual fun isWifiOnly(): Boolean = preferences()?.getBoolean(WIFI_ONLY_KEY, false) ?: false
+
+    actual fun setWifiOnly(enabled: Boolean) {
+        preferences()?.edit()?.putBoolean(WIFI_ONLY_KEY, enabled)?.apply()
+    }
+}
