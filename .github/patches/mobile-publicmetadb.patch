diff --git a/composeApp/src/commonMain/kotlin/com/nuvio/app/features/publicmetadb/PublicMetaDbApiClient.kt b/composeApp/src/commonMain/kotlin/com/nuvio/app/features/publicmetadb/PublicMetaDbApiClient.kt
