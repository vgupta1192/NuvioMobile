+    this is PublicMetaDbApiException && status == 429 -> PublicMetaDbSyncError.RATE_LIMIT
+    this is PublicMetaDbApiException && status == 403 -> PublicMetaDbSyncError.BLOCKED
+    else -> PublicMetaDbSyncError.UNAVAILABLE
