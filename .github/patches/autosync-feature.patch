+            DP_STEP_START -> Step.START
+            DP_STEP_GROUP -> Step.GROUP
+            DP_STEP_SKIP_REFERENCE -> Step.SKIP_REFERENCE
+            DP_STEP_SKIP_TARGET -> Step.SKIP_TARGET
+            else -> null
