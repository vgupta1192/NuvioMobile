diff --git a/composeApp/src/androidMain/kotlin/androidx/media3/decoder/ffmpeg/AudioSyncFfmpegDecoder.kt b/composeApp/src/androidMain/kotlin/androidx/media3/decoder/ffmpeg/AudioSyncFfmpegDecoder.kt
