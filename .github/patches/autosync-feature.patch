diff --git a/composeApp/src/androidMain/kotlin/com/nuvio/app/features/autosync/AutoSyncDebugLog.kt b/composeApp/src/androidMain/kotlin/com/nuvio/app/features/autosync/AutoSyncDebugLog.kt
