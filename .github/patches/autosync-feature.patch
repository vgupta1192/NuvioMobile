+        private const val MIN_SAMPLED_FILM_MS = 20 * 60_000L
+        private const val RESUME_THRESHOLD_MS = 10 * 60_000L
+        private const val SPOT_BACKOFF_MS = 5L
+        private const val DRAIN_TIMEOUT_MS = 10_000L
+
