+                    Icon(Icons.Rounded.SkipNext, contentDescription = "Next channel", tint = tokens.colors.textPrimary)
+                }
+                val favorite = state.isFavorite(channel)
+                IconButton(onClick = { LiveTvRepository.toggleFavorite(channel) }) {
