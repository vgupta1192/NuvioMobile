+            else -> items(state.streams, key = { "stream:${it.url}" }) { option ->
+                Row(
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .clip(RoundedCornerShape(10.dp))
+                        .background(tokens.colors.surfaceElevated)
+                        .clickable { onPlay(channel, option) }
+                        .padding(horizontal = 12.dp, vertical = 10.dp),
