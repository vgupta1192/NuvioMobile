+@file:androidx.annotation.OptIn(androidx.media3.common.util.UnstableApi::class)
+
+package com.nuvio.app.features.player
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.DisposableEffect
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.remember
+import androidx.media3.common.C
+import androidx.media3.datasource.DataSource
+import androidx.media3.datasource.DataSpec
+import androidx.media3.datasource.TransferListener
+import androidx.media3.exoplayer.ExoPlayer
+import com.nuvio.app.features.streams.PlaybackThroughputSampler
+import java.util.concurrent.atomic.AtomicLong
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.isActive
+
+/*
+ * Nuvio fork: connection-speed learning from playback (ported from NuvioMobile-Reshaped). The
+ * player counts bytes it receives over the network; the sampler turns sustained rates into the
+ * speed estimate that orders heavy streams last.
+ */
+
+private const val THROUGHPUT_TICK_MS = 250L
+
+/** Counts bytes received over the network (not from local files) by every data source the factory creates. */
+internal fun DataSource.Factory.forkCountingNetworkBytes(counter: AtomicLong): DataSource.Factory {
+    val listener = object : TransferListener {
+        override fun onTransferInitializing(source: DataSource, dataSpec: DataSpec, isNetwork: Boolean) = Unit
+
+        override fun onTransferStart(source: DataSource, dataSpec: DataSpec, isNetwork: Boolean) = Unit
+
+        override fun onBytesTransferred(source: DataSource, dataSpec: DataSpec, isNetwork: Boolean, bytesTransferred: Int) {
+            if (isNetwork) counter.addAndGet(bytesTransferred.toLong())
+        }
+
+        override fun onTransferEnd(source: DataSource, dataSpec: DataSpec, isNetwork: Boolean) = Unit
+    }
+    val upstream = this
+    return DataSource.Factory { upstream.createDataSource().apply { addTransferListener(listener) } }
+}
+
+/** ExoPlayer: feeds the bytes counted since the last tick while the player is loading. */
+@Composable
+internal fun ExoThroughputEffect(exoPlayer: ExoPlayer, sourceUrl: String, counter: AtomicLong) {
+    val sampler = remember(sourceUrl) { PlaybackThroughputSampler(sourceUrl) }
+    DisposableEffect(sampler) {
+        onDispose { sampler.finish() }
+    }
+    LaunchedEffect(exoPlayer, sampler) {
+        counter.set(0L)
+        while (isActive) {
+            sampler.onBytesTick(
+                bytes = counter.getAndSet(0L),
+                // A live stream only arrives at its own bitrate, so it says nothing about the network.
+                isFetching = !exoPlayer.isCurrentMediaItemLive && exoPlayer.duration != C.TIME_UNSET &&
+                    exoPlayer.isLoading,
+            )
+            delay(THROUGHPUT_TICK_MS)
+        }
+    }
+}
+
+/** libmpv: feeds mpv's own download rate (`cache-speed`) while its demuxer is reading. */
+@Composable
+internal fun MpvThroughputEffect(key: Any?, sourceUrl: String, read: suspend () -> Pair<Long, Boolean>?) {
+    val sampler = remember(sourceUrl) { PlaybackThroughputSampler(sourceUrl) }
+    DisposableEffect(sampler) {
+        onDispose { sampler.finish() }
+    }
+    LaunchedEffect(key, sampler) {
+        if (key == null) return@LaunchedEffect
+        while (isActive) {
+            read()?.let { (bytesPerSecond, isFetching) ->
+                sampler.onRateTick(bytesPerSecond = bytesPerSecond, isFetching = isFetching)
+            }
+            delay(THROUGHPUT_TICK_MS)
+        }
+    }
+}
