+package com.nuvio.app.features.details
+
+import com.nuvio.app.core.storage.AppFileCache
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+/**
+ * Hero trailer options (ported idea from NuvioMobile-Enhanced): start with sound and a start delay.
+ * Per device; kept in the app file cache.
+ */
+object HeroTrailerOptions {
+    private const val PATH = "settings/hero_trailer_options"
+    val delayChoicesSeconds = listOf(0, 2, 4, 6, 10)
+
+    data class State(val startUnmuted: Boolean = false, val startDelaySeconds: Int = 0)
+
+    private val _state = MutableStateFlow(State())
+    val state: StateFlow<State> = _state.asStateFlow()
+    private var loaded = false
+
+    fun ensureLoaded() {
+        if (loaded) return
+        loaded = true
+        val parts = AppFileCache.read(PATH)?.trim()?.split(',').orEmpty()
+        _state.value = State(
+            startUnmuted = parts.getOrNull(0) == "1",
+            startDelaySeconds = parts.getOrNull(1)?.toIntOrNull()?.takeIf { it in delayChoicesSeconds } ?: 0,
+        )
+    }
+
+    fun current(): State {
+        ensureLoaded()
+        return _state.value
+    }
+
+    private fun update(next: State) {
+        _state.value = next
+        runCatching { AppFileCache.write(PATH, "${if (next.startUnmuted) 1 else 0},${next.startDelaySeconds}") }
+    }
+
+    fun setStartUnmuted(enabled: Boolean) {
+        update(current().copy(startUnmuted = enabled))
+    }
+
+    fun cycleStartDelay() {
+        val now = current()
+        val next = delayChoicesSeconds[(delayChoicesSeconds.indexOf(now.startDelaySeconds) + 1) % delayChoicesSeconds.size]
+        update(now.copy(startDelaySeconds = next))
+    }
+}
