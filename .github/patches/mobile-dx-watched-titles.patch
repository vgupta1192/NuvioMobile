+package com.nuvio.app.features.settings
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.getValue
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import com.nuvio.app.core.ui.Chip
+import com.nuvio.app.features.home.DxWatchedMode
+import com.nuvio.app.features.home.DxWatchedTitles
+
+/** dx.bi port: watched titles show, dim or hide in Discover, Search and Home. */
+@Composable
+internal fun DxWatchedTitlesSettingsSection(isTablet: Boolean) {
+    LaunchedEffect(Unit) { DxWatchedTitles.ensureLoaded() }
+    val mode by DxWatchedTitles.mode.collectAsStateWithLifecycle()
+    SettingsSection(title = "Watched titles", isTablet = isTablet) {
+        SettingsGroup(isTablet = isTablet) {
+            SettingsChipRow(
+                title = "Watched titles in Discover, Search and Home",
+                description = "Show keeps them as they are, Dim fades them, Hide removes them from Discover, Search results and Home rows. Your Library is never changed.",
+                isTablet = isTablet,
+            ) {
+                DxWatchedMode.entries.forEach { option ->
+                    Chip(
+                        label = option.label,
+                        selected = mode == option,
+                        onClick = { DxWatchedTitles.setMode(option) },
+                    )
+                }
+            }
+        }
+    }
+}
