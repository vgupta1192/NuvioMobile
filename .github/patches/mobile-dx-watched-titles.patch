+package com.nuvio.app.features.home
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.getValue
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.draw.alpha
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import com.nuvio.app.core.storage.AppFileCache
+import com.nuvio.app.features.watching.application.WatchingState
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+enum class DxWatchedMode(val label: String) { Show("Show"), Dim("Dim"), Hide("Hide") }
+
+/**
+ * dx.bi port: watched titles in Discover, Search results, Home rows and "see all" catalogs can be shown
+ * (default), dimmed or hidden. Uses the same watched marks as the check badge on posters (local, Trakt,
+ * Simkl, Nuvio sync). Library and details screens are never affected.
+ */
+object DxWatchedTitles {
+    private const val PATH = "settings/dx_watched_titles"
+    private val _mode = MutableStateFlow(DxWatchedMode.Show)
+    val mode: StateFlow<DxWatchedMode> = _mode.asStateFlow()
+    private var loaded = false
+
+    fun ensureLoaded() {
+        if (loaded) return
+        loaded = true
+        val saved = runCatching { AppFileCache.read(PATH)?.trim() }.getOrNull()
+        _mode.value = DxWatchedMode.entries.firstOrNull { it.name == saved } ?: DxWatchedMode.Show
+    }
+
+    fun setMode(mode: DxWatchedMode) {
+        ensureLoaded()
+        _mode.value = mode
+        runCatching { AppFileCache.write(PATH, mode.name) }
+    }
+
+    /** Current mode for non-composable list building. */
+    fun currentMode(): DxWatchedMode {
+        ensureLoaded()
+        return _mode.value
+    }
+
+    fun filterHidden(
+        items: List<MetaPreview>,
+        mode: DxWatchedMode,
+        watchedKeys: Set<String>,
+        fullyWatchedSeriesKeys: Set<String>,
+    ): List<MetaPreview> =
+        if (mode != DxWatchedMode.Hide || watchedKeys.isEmpty() && fullyWatchedSeriesKeys.isEmpty()) {
+            items
+        } else {
+            items.filterNot { WatchingState.isPosterWatched(watchedKeys, it, fullyWatchedSeriesKeys) }
+        }
+}
+
+@Composable
+fun rememberDxWatchedMode(enabled: Boolean = true): DxWatchedMode {
+    if (!enabled) return DxWatchedMode.Show
+    LaunchedEffect(Unit) { DxWatchedTitles.ensureLoaded() }
+    val mode by DxWatchedTitles.mode.collectAsStateWithLifecycle()
+    return mode
+}
+
+fun Modifier.dxWatchedDim(isWatched: Boolean, mode: DxWatchedMode): Modifier =
+    if (isWatched && mode == DxWatchedMode.Dim) alpha(0.35f) else this
