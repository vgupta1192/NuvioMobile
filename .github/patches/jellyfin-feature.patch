+                Text(
+                    text = (if (showHiddenLibraries) "▾ " else "▸ ") + "Hidden (${hiddenLibraries.size})",
+                    style = MaterialTheme.typography.labelMedium,
+                    color = tokens.colors.textMuted,
+                )
+            }
+            if (showHiddenLibraries) {
+                hiddenLibraries.forEach { library ->
+                    JellyfinLibraryRow(
+                        name = library.name,
+                        isSelected = false,
+                        isDimmed = true,
