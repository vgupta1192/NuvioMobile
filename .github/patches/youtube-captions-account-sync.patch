+    /** The copy in the user's account first (another device may have fetched it), YouTube only when there is none. */
+    private suspend fun fetchSharedOrNetwork(youtubeId: String): List<AddonSubtitle> {
+        pullShared(youtubeId)?.let { return it }
+        if (isBlocked()) {
+            SyncedSubtitles.log("youtube captions: YouTube said HTTP 429 not long ago, not asking for $youtubeId yet")
+            return emptyList()
+        }
+        val now = nowMs()
+        val allowed = fetchLock.withLock {
+            while (recentFetches.isNotEmpty() && now - recentFetches.first() > HOUR_MS) recentFetches.removeFirst()
+            if (recentFetches.size >= MAX_VIDEOS_PER_HOUR) false else { recentFetches.addLast(now); true }
+        }
+        if (!allowed) {
+            SyncedSubtitles.log("youtube captions: $MAX_VIDEOS_PER_HOUR videos asked this hour, not asking for $youtubeId yet")
+            return emptyList()
+        }
+        val rows = networkLock.withLock { fetchWithRetry(youtubeId) }
+        if (rows.isNotEmpty()) pushShared(youtubeId)
+        return rows
+    }
+
+    private fun sharedKey(youtubeId: String) = "yt-captions|$youtubeId"
+
+    private suspend fun pullShared(youtubeId: String): List<AddonSubtitle>? {
+        val store = store ?: return null
+        val raw = GeneratedSubtitleSync.pull(sharedKey(youtubeId)) ?: return null
+        val root = runCatching { json.parseToJsonElement(raw).jsonObject }.getOrNull() ?: return null
+        val savedAt = root["savedAt"]?.jsonPrimitive?.longOrNull ?: return null
+        if (nowMs() - savedAt !in 0 until CAPTIONS_TTL_MS) return null
+        val tracks = root["tracks"]?.jsonArray ?: return null
+        val index = StringBuilder(savedAt.toString())
+        var count = 0
+        for (element in tracks) {
+            val track = element.jsonObject
+            val lang = track["lang"]?.jsonPrimitive?.contentOrNull ?: continue
+            val label = track["label"]?.jsonPrimitive?.contentOrNull ?: lang
+            val ext = if (track["ext"]?.jsonPrimitive?.contentOrNull == "vtt") "vtt" else "srt"
+            val text = track["text"]?.jsonPrimitive?.contentOrNull?.takeIf { it.isNotBlank() } ?: continue
+            val fileName = "$youtubeId.$count.$lang.$ext"
+            store.write(fileName, text)
+            index.append('\n').append(lang).append('\t').append(label.replace('\t', ' ').replace('\n', ' ')).append('\t').append(fileName)
+            count++
+        }
+        if (count == 0) return null
+        store.write("$youtubeId.idx", index.toString())
+        SyncedSubtitles.log("youtube captions: $count tracks from the account for $youtubeId, YouTube not asked")
+        return readDisk(youtubeId)
+    }
+
+    private suspend fun pushShared(youtubeId: String) {
+        val store = store ?: return
+        val lines = store.read("$youtubeId.idx")?.lines()?.filter { it.isNotBlank() } ?: return
+        val tracks = lines.drop(1).mapNotNull { line ->
+            val parts = line.split('\t')
+            if (parts.size < 3) return@mapNotNull null
+            val text = store.read(parts[2]) ?: return@mapNotNull null
+            buildJsonObject {
+                put("lang", parts[0])
+                put("label", parts[1])
+                put("ext", parts[2].substringAfterLast('.'))
+                put("text", text)
+            }
+        }
+        if (tracks.isEmpty()) return
+        val payload = buildJsonObject {
+            put("v", 1)
+            put("savedAt", lines.first().trim().toLongOrNull() ?: nowMs())
+            put("tracks", JsonArray(tracks))
+        }
+        val ok = GeneratedSubtitleSync.push(sharedKey(youtubeId), "youstream:$youtubeId", payload.toString())
+        SyncedSubtitles.log("youtube captions: saved to the account for $youtubeId: $ok")
+    }
+
