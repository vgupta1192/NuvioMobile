+package com.nuvio.app.core.ui
+
+import androidx.compose.animation.core.Animatable
+import androidx.compose.animation.core.tween
+import androidx.compose.foundation.layout.Box
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.collectAsState
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.draw.drawBehind
+import androidx.compose.ui.geometry.Offset
+import androidx.compose.ui.graphics.Brush
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.graphics.DrawScope
+
+/** How strongly the wash tints the hero, lighter than the TV fork's 0.51 because it sits over a visible image. */
+private const val WASH_STRENGTH = 0.34f
+
+private const val WASH_CROSSFADE_MS = 600
+
+/**
+ * Ambient poster tint wash, ported from the Echo fork: the hero artwork's palette sampled
+ * into three horizontal bands and drawn as a soft diagonal gradient, crossfading as the
+ * artwork changes. Emits nothing while Appearance → Ambient Poster Wash is off (the
+ * default), so the UI renders exactly as before the feature existed.
+ */
+@Composable
+fun AmbientPosterWash(url: String?, modifier: Modifier = Modifier) {
+    AmbientWashSetting.ensureLoaded()
+    val enabled by AmbientWashSetting.enabled.collectAsState()
+    if (!enabled) return
+    val palette = rememberAmbientWashPalette(url?.takeIf { it.isNotBlank() }) ?: return
+
+    var shown by remember { mutableStateOf(palette) }
+    var previous by remember { mutableStateOf<List<Color>?>(null) }
+    val fade = remember { Animatable(1f) }
+    LaunchedEffect(palette) {
+        if (palette == shown) return@LaunchedEffect
+        previous = shown
+        shown = palette
+        fade.snapTo(0f)
+        fade.animateTo(1f, tween(WASH_CROSSFADE_MS))
+        previous = null
+    }
+
+    Box(
+        modifier = modifier.drawBehind {
+            // Read only while drawing: the crossfade redraws the wash, it never recomposes it.
+            val alpha = fade.value
+            previous?.takeIf { alpha < 1f }?.let { drawWash(it, (1f - alpha) * WASH_STRENGTH) }
+            drawWash(shown, alpha * WASH_STRENGTH)
+        },
+    )
+}
+
+/** The soft gradient of one palette: the band colours across the box, brightest at the top-left. */
+private fun DrawScope.drawWash(palette: List<Color>, alpha: Float) {
+    if (alpha <= 0.01f) return
+    val colors = palette.take(3)
+    if (colors.isEmpty()) return
+    drawRect(
+        brush = Brush.linearGradient(
+            colors = colors,
+            start = Offset.Zero,
+            end = Offset(size.width, size.height * 0.55f),
+        ),
+        alpha = alpha,
+    )
+}
