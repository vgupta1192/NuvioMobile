+package com.nuvio.app.core.ui
+
+/**
+ * The app-wide typeface (Appearance → App Font). [SYSTEM] keeps the tree's bundled
+ * JetBrains Sans, so the default renders exactly as before the font setting existed.
+ * The other entries load variable TTFs (Inter, DM Sans, Open Sans) from compose resources.
+ */
+enum class AppFont(val displayName: String) {
+    SYSTEM("System"),
+    INTER("Inter"),
+    DM_SANS("DM Sans"),
+    OPEN_SANS("Open Sans"),
+    ;
+
+    companion object {
+        fun fromKey(name: String?): AppFont? =
+            name?.let { key -> entries.firstOrNull { it.name == key } }
+    }
+}
