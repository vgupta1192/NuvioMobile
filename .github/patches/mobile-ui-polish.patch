+/**
+ * How opaque liquid-glass surfaces draw (Appearance → Glass Intensity). [OFF] is the
+ * mobile default: glass surfaces draw nothing and the UI renders exactly as before.
+ */
+enum class GlassIntensity(val displayName: String) {
+    OFF("Off"),
+    LOW("Low"),
+    MID("Mid"),
+    HIGH("High"),
+    ;
+
+    companion object {
+        fun fromKey(name: String?): GlassIntensity? =
+            name?.let { key -> entries.firstOrNull { it.name == key } }
+    }
+}
