--- /dev/null
+++ b/composeApp/src/commonMain/kotlin/com/nuvio/app/features/player/PrivateViewing.kt
@@ -0,0 +1,44 @@
+package com.nuvio.app.features.player
+
+import com.nuvio.app.core.storage.AppFileCache
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+/**
+ * Private viewing (ported idea from NuvioMobile-Enhanced): while on, playback is not written to
+ * watch progress / Continue Watching and is not scrobbled to Trakt, Simkl, AniList, WeTrakr or MDBList.
+ * Per device; kept in the app file cache.
+ */
+object PrivateViewing {
+    private const val PATH = "settings/private_viewing"
+
+    private val _enabled = MutableStateFlow(false)
+    val enabled: StateFlow<Boolean> = _enabled.asStateFlow()
+
+    private var loaded = false
+
+    private fun ensureLoaded() {
+        if (loaded) return
+        loaded = true
+        _enabled.value = AppFileCache.read(PATH)?.trim() == "1"
+    }
+
+    fun isEnabled(): Boolean {
+        ensureLoaded()
+        return _enabled.value
+    }
+
+    fun set(enabled: Boolean) {
+        ensureLoaded()
+        if (_enabled.value == enabled) return
+        _enabled.value = enabled
+        runCatching { AppFileCache.write(PATH, if (enabled) "1" else "0") }
+    }
+
+    /** Collect from Compose so the settings switch reflects the stored value. */
+    fun state(): StateFlow<Boolean> {
+        ensureLoaded()
+        return enabled
+    }
+}
