+++ b/composeApp/src/commonMain/kotlin/com/nuvio/app/features/player/OpenSubtitlesHasher.kt
@@ -0,0 +1,61 @@
+package com.nuvio.app.features.player
+
+import com.nuvio.app.features.addons.httpGetRangeRaw
+
+/**
+ * Computes the OpenSubtitles hash (file size + sum of first/last 64KB as little-endian
+ * uint32s) of the playing stream over HTTP range requests. Subtitle addons receive it
+ * as the videoHash/videoSize extras and can answer with hash-verified, frame-synced
+ * subtitles. https://trac.opensubtitles.org/projects/opensubtitles/wiki/HashSourceCodes
+ */
+internal object OpenSubtitlesHasher {
+    private const val CHUNK = 65536L
+
+    data class Result(val hash: String, val fileSize: Long)
+
+    // single-slot memo: the active stream is the only URL hashed in practice; a stale
+    // read just causes a redundant recompute
+    private var memoUrl: String? = null
+    private var memoResult: Result? = null
+
+    suspend fun compute(url: String, headers: Map<String, String>): Result? {
+        if (url == memoUrl) return memoResult
+        val result = runCatching { computeUncached(url, headers) }.getOrNull()
+        if (result != null) {
+            memoUrl = url
+            memoResult = result
+        }
+        return result
+    }
+
+    private suspend fun computeUncached(url: String, headers: Map<String, String>): Result? {
+        val probe = httpGetRangeRaw(url, headers, 0, 0) ?: return null
+        if (probe.status != 206) return null
+        val total = probe.headers["content-range"]
+            ?.substringAfterLast('/')
+            ?.toLongOrNull()
+            ?: return null
+        if (total < CHUNK * 2) return null
+
+        val first = httpGetRangeRaw(url, headers, 0, CHUNK - 1) ?: return null
+        val last = httpGetRangeRaw(url, headers, total - CHUNK, total - 1) ?: return null
+        if (first.bytes.size < CHUNK || last.bytes.size < CHUNK) return null
+
+        // wraps naturally, like the reference C implementation (unsigned 64-bit)
+        val hash = total + chunkSum(first.bytes) + chunkSum(last.bytes)
+        return Result(hash = hash.toULong().toString(16).padStart(16, '0'), fileSize = total)
+    }
+
+    private fun chunkSum(bytes: ByteArray): Long {
+        var sum = 0L
+        var i = 0
+        while (i + 4 <= bytes.size) {
+            sum += (bytes[i].toLong() and 0xFF) or
+                ((bytes[i + 1].toLong() and 0xFF) shl 8) or
+                ((bytes[i + 2].toLong() and 0xFF) shl 16) or
+                ((bytes[i + 3].toLong() and 0xFF) shl 32)
+            i += 4
+        }
+        return sum
+    }
+}
