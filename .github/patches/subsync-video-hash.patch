+actual suspend fun httpGetRangeRaw(
+    url: String,
+    headers: Map<String, String>,
+    start: Long,
+    endInclusive: Long,
+): RawRangeResponse? =
+    withContext(Dispatchers.IO) {
+        runCatching {
+            val builder = Request.Builder()
+                .url(url)
+                .header("Range", "bytes=$start-$endInclusive")
+            headers.forEach { (key, value) ->
+                if (!key.equals("Range", ignoreCase = true)) builder.header(key, value)
+            }
+            AddonHttpClientProvider.get().newCall(builder.build()).execute().use { response ->
+                if (response.code != 206) return@use null
+                val bytes = response.body?.byteStream()?.use { input ->
+                    val out = ByteArrayOutputStream(262_144)
+                    val buffer = ByteArray(32_768)
+                    while (out.size() < 262_144) {
+                        val n = input.read(buffer)
+                        if (n == -1) break
+                        out.write(buffer, 0, n)
+                    }
+                    out.toByteArray()
+                } ?: return@use null
+                RawRangeResponse(
+                    status = response.code,
+                    bytes = bytes,
+                    headers = response.headers.toMultimap()
+                        .mapValues { (_, values) -> values.joinToString(",") }
+                        .mapKeys { (name, _) -> name.lowercase() },
+                )
+            }
+        }.getOrNull()
+    }
