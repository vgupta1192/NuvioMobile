@@ -0,0 +1,52 @@
+package com.nuvio.app.features.player.seekpreview
+
+import io.ktor.client.HttpClient
+import io.ktor.client.call.body
+import io.ktor.client.request.get
+import io.ktor.client.statement.bodyAsText
+import io.ktor.http.isSuccess
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+
+/** Shared thumbnail cache of the Nuvio fork: sprite sheets other viewers of the same release uploaded. */
+internal object CloudSeekPreviews {
+    private const val BASE = "https://thumbs.kissmissi.duckdns.org/v1"
+    private val idPattern = Regex("[A-Za-z0-9._-]{1,64}")
+    private val http: HttpClient by lazy { createSeekrHttpClient() }
+
+    suspend fun loadTrack(contentId: String?, season: Int?, episode: Int?, durationMs: Long): SeekrTrack? {
+        val id = contentId?.takeIf { idPattern.matches(it) } ?: return null
+        val seconds = durationMs / 1000L
+        if (seconds < 60) return null
+        val url = "$BASE/$id/${season ?: 0}/${episode ?: 0}/$seconds/index.vtt"
+        return withContext(Dispatchers.Default) {
+            try {
+                val response = http.get(url)
+                if (!response.status.isSuccess()) return@withContext null
+                val cues = SeekrVtt.parse(response.bodyAsText())
+                if (cues.isEmpty()) return@withContext null
+                SeekrTrack(
+                    cues = cues,
+                    sourceDurationMs = durationMs,
+                    sheets = SeekrSheetCache(::fetchBytes),
+                )
+            } catch (cancelled: CancellationException) {
+                throw cancelled
+            } catch (_: Exception) {
+                null
+            }
+        }
+    }
+
+    private suspend fun fetchBytes(url: String): ByteArray? = withContext(Dispatchers.Default) {
+        try {
+            val response = http.get(url)
+            if (response.status.isSuccess()) response.body<ByteArray>() else null
+        } catch (cancelled: CancellationException) {
+            throw cancelled
+        } catch (_: Exception) {
+            null
+        }
+    }
+}
