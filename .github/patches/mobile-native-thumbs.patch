@@ -0,0 +1,27 @@
+use std::fmt;
+
+#[derive(Debug)]
+pub enum Error {
+    Http(String),
+    /// A byte, request or time cap of the reader was reached.
+    Budget,
+    NoIndex,
+    Unsupported(String),
+    Malformed(&'static str),
+}
+
+pub type Result<T> = std::result::Result<T, Error>;
+
+impl fmt::Display for Error {
+    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
+        match self {
+            Error::Http(e) => write!(f, "http: {e}"),
+            Error::Budget => f.write_str("read budget spent"),
+            Error::NoIndex => f.write_str("no index"),
+            Error::Unsupported(what) => write!(f, "unsupported: {what}"),
+            Error::Malformed(what) => write!(f, "malformed {what}"),
+        }
+    }
+}
+
+impl std::error::Error for Error {}
diff --git a/native/container/src/http.rs b/native/container/src/http.rs
new file mode 100644
index 00000000..f33a5774
--- /dev/null
+++ b/native/container/src/http.rs
@@ -0,0 +1,182 @@
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+
+use crate::error::{Error, Result};
+
+#[derive(Clone)]
+pub struct Options {
+    pub headers: Vec<(String, String)>,
+    pub timeout: Duration,
+    pub connect_timeout: Duration,
+    pub max_bytes: Option<u64>,
+    pub max_requests: Option<u32>,
+    pub deadline: Option<Instant>,
+    /// Trusted roots as PEM, replacing the bundled ones.
+    pub ca_pem: Option<Vec<u8>>,
+}
+
+impl Default for Options {
+    fn default() -> Self {
+        Options {
+            headers: Vec::new(),
+            timeout: Duration::from_secs(30),
+            connect_timeout: Duration::from_secs(10),
+            max_bytes: None,
+            max_requests: None,
+            deadline: None,
+            ca_pem: None,
+        }
+    }
+}
+
+/// Range reads of one URL, or of a local path.
+pub struct RangeReader {
+    agent: ureq::Agent,
+    url: String,
+    /// The URL given, which `url` follows redirects from.
+    origin: String,
+    options: Options,
+    last: Option<(u64, Vec<u8>)>,
+    pub size: Option<u64>,
+    pub requests: u32,
+    pub bytes: u64,
+    pub waited: Duration,
+}
+
+impl RangeReader {
+    pub fn new(url: &str, options: Options) -> Result<RangeReader> {
+        let mut config = ureq::Agent::config_builder()
+            .timeout_global(Some(options.timeout))
+            .timeout_connect(Some(options.connect_timeout))
+            .http_status_as_error(false);
+        if let Some(pem) = &options.ca_pem {
+            let certs: Vec<_> = ureq::tls::parse_pem(pem)
+                .filter_map(|item| match item {
+                    Ok(ureq::tls::PemItem::Certificate(c)) => Some(c),
+                    _ => None,
+                })
+                .collect();
+            if certs.is_empty() {
+                return Err(Error::Malformed("CA bundle"));
+            }
+            let roots = ureq::tls::RootCerts::Specific(Arc::new(certs));
+            config = config.tls_config(ureq::tls::TlsConfig::builder().root_certs(roots).build());
+        }
+        Ok(RangeReader {
+            agent: config.build().into(),
+            url: url.to_string(),
+            origin: url.to_string(),
+            options,
+            last: None,
+            size: None,
+            requests: 0,
+            bytes: 0,
+            waited: Duration::ZERO,
+        })
+    }
+
+    /// Another reader of the same file, on this one's connections.
+    pub fn fork(&self) -> RangeReader {
+        RangeReader {
+            agent: self.agent.clone(),
+            url: self.url.clone(),
+            origin: self.origin.clone(),
+            options: self.options.clone(),
+            last: None,
+            size: self.size,
+            requests: 0,
+            bytes: 0,
+            waited: Duration::ZERO,
+        }
+    }
+
+    /// Up to `len` bytes from `start`; fewer only at the end of the file.
+    pub fn read(&mut self, start: u64, len: u64) -> Result<Vec<u8>> {
+        let mut len = len;
+        if let Some(size) = self.size {
+            if start >= size {
+                return Ok(Vec::new());
+            }
+            len = len.min(size - start);
+        }
+        if let Some((at, buf)) = &self.last
+            && start >= *at
+            && start + len <= at + buf.len() as u64
+        {
+            let from = (start - at) as usize;
+            return Ok(buf[from..from + len as usize].to_vec());
+        }
+        let o = &self.options;
+        if o.max_requests.is_some_and(|m| self.requests >= m)
+            || o.max_bytes.is_some_and(|m| self.bytes + len > m)
+            || o.deadline.is_some_and(|d| Instant::now() >= d)
+        {
+            return Err(Error::Budget);
+        }
+        let t = Instant::now();
+        let body = if self.url.starts_with("http://") || self.url.starts_with("https://") {
+            self.fetch(start, len)?
+        } else {
+            self.read_file(start, len)?
+        };
+        self.requests += 1;
+        self.bytes += body.len() as u64;
+        self.waited += t.elapsed();
+        self.last = Some((start, body.clone()));
+        Ok(body)
+    }
+
+    /// A redirect's target can expire, so a failed read of one starts again from the URL given.
+    fn fetch(&mut self, start: u64, len: u64) -> Result<Vec<u8>> {
+        match self.fetch_from(start, len) {
+            Err(_) if self.url != self.origin => {
+                self.url = self.origin.clone();
+                self.fetch_from(start, len)
+            }
+            read => read,
+        }
+    }
+
+    fn fetch_from(&mut self, start: u64, len: u64) -> Result<Vec<u8>> {
+        let mut request = self
+            .agent
+            .get(&self.url)
+            .header("Range", format!("bytes={start}-{}", start + len - 1));
+        for (k, v) in &self.options.headers {
+            request = request.header(k, v);
+        }
+        let response = request.call().map_err(|e| Error::Http(e.to_string()))?;
+        if response.status() != 206 {
+            return Err(Error::Http(format!("range answered {}", response.status())));
+        }
+        if self.size.is_none() {
+            self.size = response
+                .headers()
+                .get("content-range")
+                .and_then(|v| v.to_str().ok())
+                .and_then(|v| v.rsplit('/').next())
+                .and_then(|v| v.parse().ok());
+        }
+        let final_url = ureq::ResponseExt::get_uri(&response).to_string();
+        let body = response
+            .into_body()
+            .into_with_config()
+            // The reader fails on the read that finds the end, so a body of exactly `len` needs one more.
+            .limit(len + 1)
+            .read_to_vec()
+            .map_err(|e| Error::Http(e.to_string()))?;
+        self.url = final_url;
+        Ok(body)
+    }
+
+    fn read_file(&mut self, start: u64, len: u64) -> Result<Vec<u8>> {
+        use std::io::{Read, Seek, SeekFrom};
+        let io = |e: std::io::Error| Error::Http(e.to_string());
+        let mut f = std::fs::File::open(&self.url).map_err(io)?;
+        self.size = Some(f.metadata().map_err(io)?.len());
+        f.seek(SeekFrom::Start(start)).map_err(io)?;
+        let mut body = Vec::with_capacity(len as usize);
+        f.take(len).read_to_end(&mut body).map_err(io)?;
+        Ok(body)
+    }
+}
diff --git a/native/container/src/keyframes.rs b/native/container/src/keyframes.rs
new file mode 100644
index 00000000..9238877c
--- /dev/null
+++ b/native/container/src/keyframes.rs
@@ -0,0 +1,44 @@
+use crate::error::Result;
+use crate::http::RangeReader;
+use crate::track::Track;
+
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub enum Container {
+    Matroska,
+    Mp4,
+}
+
+/// A video keyframe: Matroska gives its cluster (and the block's place in it), MP4 its exact range.
+#[derive(Debug, Clone, Copy)]
+pub struct Keyframe {
+    pub time_ms: u64,
+    pub offset: u64,
+    pub relative: Option<u64>,
+    pub size: Option<u64>,
+}
+
+pub struct Keyframes {
+    pub container: Container,
+    pub track: Track,
+    pub duration_ms: u64,
+    pub(crate) scale_ns: u64,
+    pub entries: Vec<Keyframe>,
+}
+
+impl Keyframes {
+    /// The keyframe at or before `ms`.
+    pub fn at(&self, ms: u64) -> usize {
+        self.entries
+            .partition_point(|k| k.time_ms <= ms)
+            .saturating_sub(1)
+    }
+
+    /// The frame data of a keyframe, reading `guess` bytes when its size isn't known up front.
+    pub fn frame(&self, r: &mut RangeReader, index: usize, guess: u64) -> Result<Vec<u8>> {
+        let e = self.entries[index];
+        match e.size {
+            Some(size) => r.read(e.offset, size),
+            None => crate::mkv::keyframe(self, r, &e, guess),
+        }
+    }
+}
diff --git a/native/container/src/lib.rs b/native/container/src/lib.rs
new file mode 100644
index 00000000..58468514
--- /dev/null
+++ b/native/container/src/lib.rs
@@ -0,0 +1,24 @@
+pub mod ebml;
+mod error;
+pub mod http;
+mod keyframes;
+pub mod mkv;
+pub mod mp4;
+mod subtitles;
+mod track;
+
+pub use error::{Error, Result};
+pub use http::{Options, RangeReader};
+pub use keyframes::{Container, Keyframe, Keyframes};
+pub use subtitles::{SubtitleTimeline, index_options, subtitle_timelines};
+pub use track::{Track, TrackKind, Video};
+
+/// The video keyframes of a Matroska/WebM or MP4/MOV file.
+pub fn keyframes(r: &mut RangeReader) -> Result<Keyframes> {
+    let head = r.read(0, mkv::HEAD)?;
+    if head.starts_with(&ebml::id::EBML.to_be_bytes()) {
+        mkv::Segment::open(r)?.keyframes(r)
+    } else {
+        mp4::keyframes(r)
+    }
+}
diff --git a/native/container/src/mkv.rs b/native/container/src/mkv.rs
new file mode 100644
index 00000000..37769487
--- /dev/null
+++ b/native/container/src/mkv.rs
@@ -0,0 +1,377 @@
+use crate::ebml::{UNKNOWN, children, find, float, header, id, string, uint, vint};
+use crate::error::{Error, Result};
+use crate::http::RangeReader;
+use crate::keyframes::{Container, Keyframe, Keyframes};
+use crate::track::{Track, TrackKind, Video};
+
+/// The first read of a file, which usually covers everything before the first cluster.
+pub const HEAD: u64 = 256 * 1024;
+
+pub struct Segment {
+    /// File offset that SeekHead and Cues positions count from.
+    pub data_start: u64,
+    pub scale_ns: u64,
+    pub duration_ms: u64,
+    pub tracks: Vec<Track>,
+    seeks: Vec<(u32, u64)>,
+}
+
+#[derive(Debug, Clone, Copy)]
+pub struct CuePoint {
+    /// In segment ticks; see [`Segment::ms`].
+    pub time: u64,
+    pub track: u64,
+    /// File offset of the cluster.
+    pub cluster: u64,
+    /// Offset of the block inside the cluster's body.
+    pub relative: Option<u64>,
+    pub duration: Option<u64>,
+}
+
+fn read_element(r: &mut RangeReader, pos: u64) -> Result<(u32, Vec<u8>)> {
+    let head = r.read(pos, 64 * 1024)?;
+    let (id, h, size) = header(&head, 0).ok_or(Error::Malformed("element header"))?;
+    if size == UNKNOWN {
+        return Err(Error::Unsupported("unknown-size element".into()));
+    }
+    let total = h as u64 + size;
+    if total <= head.len() as u64 {
+        return Ok((id, head[h..total as usize].to_vec()));
+    }
+    let mut body = head[h..].to_vec();
+    body.extend(r.read(pos + head.len() as u64, total - head.len() as u64)?);
+    Ok((id, body))
+}
+
+fn seek_entries(body: &[u8], data_start: u64) -> impl Iterator<Item = (u32, u64)> + '_ {
+    children(body)
+        .filter(|(i, _)| *i == id::SEEK)
+        .filter_map(move |(_, s)| {
+            Some((
+                uint(find(s, id::SEEK_ID)?) as u32,
+                data_start + uint(find(s, id::SEEK_POSITION)?),
+            ))
+        })
+}
+
+fn flag(entry: &[u8], element: u32, default: bool) -> bool {
+    find(entry, element).map_or(default, |v| uint(v) != 0)
+}
+
+fn parse_track(entry: &[u8]) -> Option<Track> {
+    let kind = match find(entry, id::TRACK_TYPE).map(uint)? {
+        1 => TrackKind::Video,
+        2 => TrackKind::Audio,
+        17 => TrackKind::Subtitle,
+        _ => TrackKind::Other,
+    };
+    let mut t = Track::new(
+        find(entry, id::TRACK_NUMBER).map(uint)?,
+        kind,
+        string(find(entry, id::CODEC_ID)?),
+    );
+    t.private = find(entry, id::CODEC_PRIVATE)
+        .map(<[u8]>::to_vec)
+        .unwrap_or_default();
+    t.name = find(entry, id::NAME).map(string);
+    t.language = find(entry, id::LANGUAGE_IETF)
+        .or_else(|| find(entry, id::LANGUAGE))
+        .map(string);
+    t.enabled = flag(entry, id::FLAG_ENABLED, true);
+    t.default = flag(entry, id::FLAG_DEFAULT, true);
+    t.forced = flag(entry, id::FLAG_FORCED, false);
+    t.hearing_impaired = flag(entry, id::FLAG_HEARING_IMPAIRED, false);
+    t.commentary = flag(entry, id::FLAG_COMMENTARY, false);
+    if let Some(encodings) = find(entry, id::CONTENT_ENCODINGS) {
+        for (_, encoding) in children(encodings).filter(|(i, _)| *i == id::CONTENT_ENCODING) {
+            if let Some(comp) = find(encoding, id::CONTENT_COMPRESSION)
+                && find(comp, id::CONTENT_COMP_ALGO).map(uint) == Some(3)
+            {
+                t.header_strip = find(comp, id::CONTENT_COMP_SETTINGS)
+                    .map(<[u8]>::to_vec)
+                    .unwrap_or_default();
+            }
+        }
+    }
+    if let Some(video) = find(entry, id::VIDEO) {
+        let mut v = Video::new(
+            find(video, id::PIXEL_WIDTH).map_or(0, uint),
+            find(video, id::PIXEL_HEIGHT).map_or(0, uint),
+        );
+        v.display_width = find(video, id::DISPLAY_WIDTH).map_or(v.width, uint);
+        v.display_height = find(video, id::DISPLAY_HEIGHT).map_or(v.height, uint);
+        if let Some(c) = find(video, id::COLOUR) {
+            v.matrix = find(c, id::MATRIX_COEFFICIENTS).map_or(2, uint);
+            v.range = find(c, id::RANGE).map_or(0, uint);
+            v.transfer = find(c, id::TRANSFER_CHARACTERISTICS).map_or(2, uint);
+            v.primaries = find(c, id::PRIMARIES).map_or(2, uint);
+        }
+        for (_, map) in children(entry).filter(|(i, _)| *i == id::BLOCK_ADDITION_MAPPING) {
+            if matches!(
+                find(map, id::BLOCK_ADD_ID_TYPE).map(uint),
+                Some(0x64766343 | 0x64767643)
+            ) && let Some(record) = find(map, id::BLOCK_ADD_ID_EXTRA_DATA)
+            {
+                v.set_dovi(record);
+            }
+        }
+        t.video = Some(v);
+    }
+    Some(t)
+}
+
+impl Segment {
+    pub fn open(r: &mut RangeReader) -> Result<Segment> {
+        let head = r.read(0, HEAD)?;
+        let (ebml, h, size) = header(&head, 0).ok_or(Error::Malformed("EBML header"))?;
+        if ebml != id::EBML {
+            return Err(Error::Unsupported("not Matroska".into()));
+        }
+        let mut i = h + size as usize;
+        let (segment, h, _) = header(&head, i).ok_or(Error::Malformed("segment"))?;
+        if segment != id::SEGMENT {
+            return Err(Error::Malformed("segment"));
+        }
+        i += h;
+        let data_start = i as u64;
+        let (mut info, mut tracks, mut seeks) = (None, None, Vec::new());
+        while let Some((element, h, size)) = header(&head, i) {
+            if element == id::CLUSTER || size == UNKNOWN {
+                break;
+            }
+            let end = i + h + size as usize;
+            let body = if end <= head.len() {
+                head[i + h..end].to_vec()
+            } else if matches!(element, id::INFO | id::TRACKS | id::SEEK_HEAD) {
+                read_element(r, i as u64)?.1
+            } else {
+                break;
+            };
+            match element {
+                id::SEEK_HEAD => seeks.extend(seek_entries(&body, data_start)),
+                id::INFO => info = Some(body),
+                id::TRACKS => tracks = Some(body),
+                _ => {}
+            }
+            i = end;
+        }
+        // A SeekHead may point at a second one, often at the end of the file.
+        let more: Vec<u64> = seeks
+            .iter()
+            .filter(|(e, _)| *e == id::SEEK_HEAD)
+            .map(|&(_, p)| p)
+            .collect();
+        for pos in more {
+            if let Ok((id::SEEK_HEAD, body)) = read_element(r, pos) {
+                seeks.extend(seek_entries(&body, data_start));
+            }
+        }
+        let mut segment = Segment {
+            data_start,
+            scale_ns: 1_000_000,
+            duration_ms: 0,
+            tracks: Vec::new(),
+            seeks,
+        };
+        let info = match info {
+            Some(b) => b,
+            None => {
+                read_element(
+                    r,
+                    segment
+                        .position(id::INFO)
+                        .ok_or(Error::Malformed("segment info"))?,
+                )?
+                .1
+            }
+        };
+        let tracks = match tracks {
+            Some(b) => b,
+            None => {
+                read_element(
+                    r,
+                    segment
+                        .position(id::TRACKS)
+                        .ok_or(Error::Malformed("tracks"))?,
+                )?
+                .1
+            }
+        };
+        segment.scale_ns = find(&info, id::TIMESTAMP_SCALE).map_or(1_000_000, uint);
+        segment.duration_ms = find(&info, id::DURATION)
+            .map_or(0.0, |d| float(d) * segment.scale_ns as f64 / 1e6)
+            as u64;
+        segment.tracks = children(&tracks)
+            .filter(|(e, _)| *e == id::TRACK_ENTRY)
+            .filter_map(|(_, e)| parse_track(e))
+            .collect();
+        Ok(segment)
+    }
+
+    /// File offset of a top-level element the SeekHead lists.
+    pub fn position(&self, element: u32) -> Option<u64> {
+        self.seeks
+            .iter()
+            .find(|(e, _)| *e == element)
+            .map(|&(_, p)| p)
+    }
+
+    pub fn ms(&self, ticks: u64) -> u64 {
+        (ticks as u128 * self.scale_ns as u128 / 1_000_000) as u64
+    }
+
+    /// Every cue of every track, in file order.
+    pub fn cues(&self, r: &mut RangeReader) -> Result<Vec<CuePoint>> {
+        let (_, cues) = read_element(r, self.position(id::CUES).ok_or(Error::NoIndex)?)?;
+        let mut out = Vec::new();
+        for (_, point) in children(&cues).filter(|(e, _)| *e == id::CUE_POINT) {
+            let time = find(point, id::CUE_TIME).map_or(0, uint);
+            for (_, pos) in children(point).filter(|(e, _)| *e == id::CUE_TRACK_POSITIONS) {
+                let (Some(track), Some(cluster)) = (
+                    find(pos, id::CUE_TRACK),
+                    find(pos, id::CUE_CLUSTER_POSITION),
+                ) else {
+                    continue;
+                };
+                out.push(CuePoint {
+                    time,
+                    track: uint(track),
+                    cluster: self.data_start + uint(cluster),
+                    relative: find(pos, id::CUE_RELATIVE_POSITION).map(uint),
+                    duration: find(pos, id::CUE_DURATION).map(uint),
+                });
+            }
+        }
+        Ok(out)
+    }
+
+    pub fn keyframes(self, r: &mut RangeReader) -> Result<Keyframes> {
+        let video = self
+            .tracks
+            .iter()
+            .find(|t| t.kind == TrackKind::Video)
+            .cloned()
+            .ok_or(Error::Unsupported("no video track".into()))?;
+        let mut entries: Vec<Keyframe> = self
+            .cues(r)?
+            .into_iter()
+            .filter(|c| c.track == video.number)
+            .map(|c| Keyframe {
+                time_ms: self.ms(c.time),
+                offset: c.cluster,
+                relative: c.relative,
+                size: None,
+            })
+            .collect();
+        entries.sort_by_key(|k| k.time_ms);
+        entries.dedup_by_key(|k| k.time_ms);
+        if entries.is_empty() {
+            return Err(Error::NoIndex);
+        }
+        Ok(Keyframes {
+            container: Container::Matroska,
+            track: video,
+            duration_ms: self.duration_ms,
+            scale_ns: self.scale_ns,
+            entries,
+        })
+    }
+}
+
+/// The frame in the block at `at` of `buf`, read from `base`, completing a short read.
+fn block(
+    k: &Keyframes,
+    r: &mut RangeReader,
+    base: u64,
+    mut buf: Vec<u8>,
+    at: usize,
+) -> Result<Vec<u8>> {
+    let (element, h, size) = header(&buf, at).ok_or(Error::Malformed("block header"))?;
+    let end = at + h + size as usize;
+    if end > buf.len() {
+        let have = buf.len() as u64;
+        buf.extend(r.read(base + have, end as u64 - have)?);
+    }
+    let body = &buf[at + h..end];
+    let block = match element {
+        id::SIMPLE_BLOCK => body,
+        id::BLOCK_GROUP => find(body, id::BLOCK).ok_or(Error::Malformed("block group"))?,
+        _ => return Err(Error::Malformed("block")),
+    };
+    let (track, i) = vint(block, 0, false).ok_or(Error::Malformed("block"))?;
+    if track != k.track.number {
+        return Err(Error::Malformed("block of another track"));
+    }
+    if block.get(i + 2).ok_or(Error::Malformed("block"))? & 0x06 != 0 {
+        return Err(Error::Unsupported("laced video block".into()));
+    }
+    let mut frame = k.track.header_strip.clone();
+    frame.extend_from_slice(&block[i + 3..]);
+    Ok(frame)
+}
+
+pub(crate) fn keyframe(
+    k: &Keyframes,
+    r: &mut RangeReader,
+    e: &Keyframe,
+    guess: u64,
+) -> Result<Vec<u8>> {
+    let Some(rel) = e.relative else {
+        return scan_cluster(k, r, e);
+    };
+    // A cluster header is at most 12 bytes; read it with the block when they are close.
+    let near = rel < 256 * 1024;
+    let buf = r.read(e.offset, if near { 12 + rel + guess } else { 12 })?;
+    let (element, h, _) = header(&buf, 0).ok_or(Error::Malformed("cluster"))?;
+    if element != id::CLUSTER {
+        return Err(Error::Malformed("cluster"));
+    }
+    if near {
+        return block(k, r, e.offset, buf, h + rel as usize);
+    }
+    let base = e.offset + h as u64 + rel;
+    let buf = r.read(base, guess)?;
+    block(k, r, base, buf, 0)
+}
+
+fn scan_cluster(k: &Keyframes, r: &mut RangeReader, e: &Keyframe) -> Result<Vec<u8>> {
+    let buf = r.read(e.offset, 512 * 1024)?;
+    let (element, h, _) = header(&buf, 0).ok_or(Error::Malformed("cluster"))?;
+    if element != id::CLUSTER {
+        return Err(Error::Malformed("cluster"));
+    }
+    let (mut i, mut ts) = (h, 0u64);
+    while let Some((element, eh, size)) = header(&buf, i) {
+        let start = i + eh;
+        match element {
+            id::CLUSTER_TIMESTAMP if start + size as usize <= buf.len() => {
+                ts = uint(&buf[start..start + size as usize])
+            }
+            id::SIMPLE_BLOCK | id::BLOCK_GROUP => {
+                let first = if element == id::SIMPLE_BLOCK {
+                    start
+                } else {
+                    start + header(&buf, start).map_or(0, |x| x.1)
+                };
+                if let Some((track, j)) = vint(&buf, first, false)
+                    && track == k.track.number
+                    && j + 2 <= buf.len()
+                {
+                    let rel = i16::from_be_bytes([buf[j], buf[j + 1]]) as i64;
+                    let t = (ts as i64 + rel).max(0) as u64 * k.scale_ns / 1_000_000;
+                    if t + 1 >= e.time_ms {
+                        return block(k, r, e.offset, buf, i);
+                    }
+                }
+            }
+            _ => {}
+        }
+        i = start + size as usize;
+        if i >= buf.len() {
+            break;
+        }
+    }
+    Err(Error::Unsupported(
+        "keyframe not near its cluster start".into(),
+    ))
+}
diff --git a/native/container/src/mp4.rs b/native/container/src/mp4.rs
new file mode 100644
index 00000000..9e1fc80f
--- /dev/null
+++ b/native/container/src/mp4.rs
@@ -0,0 +1,255 @@
+use crate::error::{Error, Result};
+use crate::http::RangeReader;
+use crate::keyframes::{Container, Keyframe, Keyframes};
+use crate::track::{Track, TrackKind, Video};
+
+pub(crate) fn u16be(b: &[u8], i: usize) -> Option<u64> {
+    Some(u16::from_be_bytes(b.get(i..i + 2)?.try_into().ok()?) as u64)
+}
+
+pub(crate) fn u32be(b: &[u8], i: usize) -> Option<u64> {
+    Some(u32::from_be_bytes(b.get(i..i + 4)?.try_into().ok()?) as u64)
+}
+
+pub(crate) fn u64be(b: &[u8], i: usize) -> Option<u64> {
+    Some(u64::from_be_bytes(b.get(i..i + 8)?.try_into().ok()?))
+}
+
+/// (type, body) of each box in `b`.
+pub fn boxes(b: &[u8]) -> impl Iterator<Item = ([u8; 4], &[u8])> {
+    let mut i = 0;
+    std::iter::from_fn(move || {
+        let size = u32be(b, i)?;
+        let kind: [u8; 4] = b.get(i + 4..i + 8)?.try_into().ok()?;
+        let (head, size) = match size {
+            1 => (16, u64be(b, i + 8)?),
+            0 => (8, (b.len() - i) as u64),
+            n => (8, n),
+        };
+        let end = i.checked_add(usize::try_from(size).ok()?)?;
+        if size < head || end > b.len() {
+            return None;
+        }
+        let body = &b[i + head as usize..end];
+        i = end;
+        Some((kind, body))
+    })
+}
+
+pub fn child<'a>(b: &'a [u8], kind: &[u8; 4]) -> Option<&'a [u8]> {
+    boxes(b).find(|(k, _)| k == kind).map(|(_, v)| v)
+}
+
+pub(crate) fn path<'a>(b: &'a [u8], kinds: &[&[u8; 4]]) -> Option<&'a [u8]> {
+    kinds.iter().try_fold(b, |b, k| child(b, k))
+}
+
+/// The moov box's body, before or after the media data.
+pub fn moov(r: &mut RangeReader) -> Result<Vec<u8>> {
+    let mut pos = 0u64;
+    loop {
+        let head = r.read(pos, 16)?;
+        if head.len() < 8 {
+            return Err(Error::Malformed("MP4 without moov"));
+        }
+        let kind = &head[4..8];
+        let size = match u32be(&head, 0).unwrap() {
+            1 => u64be(&head, 8).ok_or(Error::Malformed("box header"))?,
+            0 => return Err(Error::Malformed("MP4 without moov")),
+            n => n,
+        };
+        if pos == 0 && kind != b"ftyp" {
+            return Err(Error::Unsupported("not MP4".into()));
+        }
+        if kind == b"moov" {
+            let mut body = r.read(pos, size)?;
+            body.drain(..if u32be(&body, 0) == Some(1) { 16 } else { 8 });
+            return Ok(body);
+        }
+        if kind == b"moof" {
+            return Err(Error::Unsupported("fragmented MP4".into()));
+        }
+        pos += size.max(8);
+    }
+}
+
+pub fn keyframes(r: &mut RangeReader) -> Result<Keyframes> {
+    let moov = moov(r)?;
+    if child(&moov, b"mvex").is_some() {
+        return Err(Error::Unsupported("fragmented MP4".into()));
+    }
+    for (kind, trak) in boxes(&moov) {
+        if &kind != b"trak" {
+            continue;
+        }
+        let Some(mdia) = child(trak, b"mdia") else {
+            continue;
+        };
+        if child(mdia, b"hdlr").and_then(|h| h.get(8..12)) == Some(b"vide") {
+            let number = child(trak, b"tkhd")
+                .and_then(|t| u32be(t, if t[0] == 1 { 20 } else { 12 }))
+                .unwrap_or(1);
+            return video_keyframes(number, mdia);
+        }
+    }
+    Err(Error::Unsupported("no video track".into()))
+}
+
+fn video_keyframes(number: u64, mdia: &[u8]) -> Result<Keyframes> {
+    let bad = || Error::Malformed("sample tables");
+    let mdhd = child(mdia, b"mdhd").ok_or_else(bad)?;
+    let (timescale, duration) = if mdhd[0] == 1 {
+        (u32be(mdhd, 20), u64be(mdhd, 24))
+    } else {
+        (u32be(mdhd, 12), u32be(mdhd, 16))
+    };
+    let timescale = timescale.filter(|&t| t > 0).ok_or_else(bad)?;
+    let stbl = path(mdia, &[b"minf", b"stbl"]).ok_or_else(bad)?;
+    let (entry_kind, entry) = boxes(
+        child(stbl, b"stsd")
+            .and_then(|s| s.get(8..))
+            .ok_or_else(bad)?,
+    )
+    .next()
+    .ok_or_else(bad)?;
+    let codec = match &entry_kind {
+        b"avc1" | b"avc3" => "V_MPEG4/ISO/AVC",
+        b"hvc1" | b"hev1" | b"dvh1" | b"dvhe" => "V_MPEGH/ISO/HEVC",
+        b"av01" => "V_AV1",
+        b"vp09" => "V_VP9",
+        other => {
+            return Err(Error::Unsupported(format!(
+                "video codec {}",
+                String::from_utf8_lossy(other)
+            )));
+        }
+    };
+    let mut track = Track::new(number, TrackKind::Video, codec.to_string());
+    let mut video = Video::new(u16be(entry, 24).unwrap_or(0), u16be(entry, 26).unwrap_or(0));
+    // A visual sample entry's own fields take 78 bytes.
+    for (kind, b) in boxes(entry.get(78..).unwrap_or(&[])) {
+        match &kind {
+            b"avcC" | b"hvcC" | b"av1C" => track.private = b.to_vec(),
+            b"colr" if b.get(..4) == Some(b"nclx") => {
+                video.primaries = u16be(b, 4).unwrap_or(2);
+                video.transfer = u16be(b, 6).unwrap_or(2);
+                video.matrix = u16be(b, 8).unwrap_or(2);
+                video.range = if b.get(10).is_some_and(|f| f & 0x80 != 0) {
+                    2
+                } else {
+                    1
+                };
+            }
+            b"pasp" => {
+                let (h, v) = (u32be(b, 0).unwrap_or(1), u32be(b, 4).unwrap_or(1));
+                if h > 0 && v > 0 {
+                    video.display_width = video.width * h / v;
+                }
+            }
+            b"dvcC" | b"dvvC" => video.set_dovi(b),
+            _ => {}
+        }
+    }
+    track.video = Some(video);
+
+    let stsz = child(stbl, b"stsz").ok_or_else(bad)?;
+    let fixed = u32be(stsz, 4).ok_or_else(bad)?;
+    let count = u32be(stsz, 8).ok_or_else(bad)? as usize;
+    let size = |s: usize| {
+        if fixed != 0 {
+            Some(fixed)
+        } else {
+            u32be(stsz, 12 + 4 * s)
+        }
+    };
+    let chunks: Vec<u64> = if let Some(stco) = child(stbl, b"stco") {
+        (0..u32be(stco, 4).ok_or_else(bad)? as usize)
+            .map(|i| u32be(stco, 8 + 4 * i))
+            .collect::<Option<_>>()
+            .ok_or_else(bad)?
+    } else {
+        let co64 = child(stbl, b"co64").ok_or_else(bad)?;
+        (0..u32be(co64, 4).ok_or_else(bad)? as usize)
+            .map(|i| u64be(co64, 8 + 8 * i))
+            .collect::<Option<_>>()
+            .ok_or_else(bad)?
+    };
+    let stsc = child(stbl, b"stsc").ok_or_else(bad)?;
+    let runs: Vec<(u64, u64)> = (0..u32be(stsc, 4).ok_or_else(bad)? as usize)
+        .map(|i| Some((u32be(stsc, 8 + 12 * i)?, u32be(stsc, 12 + 12 * i)?)))
+        .collect::<Option<_>>()
+        .ok_or_else(bad)?;
+    let stts = child(stbl, b"stts").ok_or_else(bad)?;
+    let ctts = child(stbl, b"ctts");
+    // Without stss every sample is a sync sample.
+    let sync: Option<Vec<u64>> = child(stbl, b"stss").map(|s| {
+        (0..u32be(s, 4).unwrap_or(0) as usize)
+            .filter_map(|i| u32be(s, 8 + 4 * i).map(|n| n - 1))
+            .collect()
+    });
+
+    let mut entries = Vec::new();
+    let (mut sample, mut run, mut dts) = (0usize, 0usize, 0u64);
+    let (mut stts_i, mut stts_left, mut stts_delta) = (0usize, 0u64, 0u64);
+    let (mut ctts_i, mut ctts_left, mut ctts_offset) = (0usize, 0u64, 0i64);
+    let mut next_sync = 0;
+    for (chunk, &offset) in chunks.iter().enumerate() {
+        while run + 1 < runs.len() && runs[run + 1].0 <= chunk as u64 + 1 {
+            run += 1;
+        }
+        let mut at = offset;
+        for _ in 0..runs.get(run).ok_or_else(bad)?.1 {
+            if sample >= count {
+                break;
+            }
+            while stts_left == 0 {
+                stts_left = u32be(stts, 8 + 8 * stts_i).ok_or_else(bad)?;
+                stts_delta = u32be(stts, 12 + 8 * stts_i).ok_or_else(bad)?;
+                stts_i += 1;
+            }
+            if let Some(ctts) = ctts {
+                while ctts_left == 0 {
+                    ctts_left = u32be(ctts, 8 + 8 * ctts_i).ok_or_else(bad)?;
+                    ctts_offset =
+                        u32be(ctts, 12 + 8 * ctts_i).ok_or_else(bad)? as u32 as i32 as i64;
+                    ctts_i += 1;
+                }
+                ctts_left -= 1;
+            }
+            let len = size(sample).ok_or_else(bad)?;
+            let is_sync = match &sync {
+                Some(list) => {
+                    let hit = list.get(next_sync) == Some(&(sample as u64));
+                    next_sync += hit as usize;
+                    hit
+                }
+                None => true,
+            };
+            if is_sync {
+                let pts = (dts as i64 + ctts_offset).max(0) as u64;
+                entries.push(Keyframe {
+                    time_ms: pts * 1000 / timescale,
+                    offset: at,
+                    relative: None,
+                    size: Some(len),
+                });
+            }
+            at += len;
+            dts += stts_delta;
+            stts_left -= 1;
+            sample += 1;
+        }
+    }
+    entries.sort_by_key(|k| k.time_ms);
+    entries.dedup_by_key(|k| k.time_ms);
+    if entries.is_empty() {
+        return Err(Error::NoIndex);
+    }
+    Ok(Keyframes {
+        container: Container::Mp4,
+        track,
+        duration_ms: duration.unwrap_or(dts) * 1000 / timescale,
+        scale_ns: 1_000_000,
+        entries,
+    })
+}
diff --git a/native/container/src/subtitles.rs b/native/container/src/subtitles.rs
new file mode 100644
index 00000000..8284b14d
--- /dev/null
+++ b/native/container/src/subtitles.rs
@@ -0,0 +1,279 @@
+use std::time::{Duration, Instant};
+
+use crate::mkv::Segment;
+use crate::mp4::{boxes, child, path, u16be, u32be, u64be};
+use crate::{Error, Options, RangeReader, Result, TrackKind, ebml, mkv, mp4};
+
+/// How long a line whose index entry has no duration shows, at most, before the next.
+const UNTIMED_MS: u64 = 4_000;
+/// A PGS entry this short clears the line before it.
+const PGS_CLEAR_MS: u64 = 100;
+/// Lines outside these are gaps or silences a PGS labelling took for lines.
+const PGS_SHORTEST_MS: u64 = 250;
+const PGS_LONGEST_MS: u64 = 12_000;
+/// What a labelling pays for an odd line, a line replaced without a clear, and a doubled clear.
+const PGS_ODD_LINE: u32 = 4;
+const PGS_REPLACED: u32 = 1;
+const PGS_CLEARED_TWICE: u32 = 3;
+
+/// A few requests for the head, the tracks and the index, or the players' own reading takes over.
+pub fn index_options() -> Options {
+    Options {
+        timeout: Duration::from_secs(4),
+        connect_timeout: Duration::from_secs(3),
+        max_bytes: Some(24 << 20),
+        max_requests: Some(16),
+        deadline: Some(Instant::now() + Duration::from_secs(7)),
+        ..Options::default()
+    }
+}
+
+/// One of the file's subtitle tracks and when its lines show, in milliseconds.
+#[derive(Debug, Clone)]
+pub struct SubtitleTimeline {
+    pub number: u64,
+    pub codec: String,
+    pub language: Option<String>,
+    pub lines: Vec<(u64, u64)>,
+}
+
+/// Every subtitle track of a Matroska or MP4 file in file order, with the lines its index lists.
+/// A track the index leaves out comes back empty.
+pub fn subtitle_timelines(r: &mut RangeReader) -> Result<Vec<SubtitleTimeline>> {
+    let head = r.read(0, mkv::HEAD)?;
+    if head.starts_with(&ebml::id::EBML.to_be_bytes()) {
+        matroska(r)
+    } else {
+        mp4_timelines(r)
+    }
+}
+
+/// Muxers index every subtitle frame, most with its duration.
+fn matroska(r: &mut RangeReader) -> Result<Vec<SubtitleTimeline>> {
+    let segment = Segment::open(r)?;
+    let mut tracks: Vec<SubtitleTimeline> = segment
+        .tracks
+        .iter()
+        .filter(|t| t.kind == TrackKind::Subtitle)
+        .map(|t| SubtitleTimeline {
+            number: t.number,
+            codec: t.codec.clone(),
+            language: t.language.clone(),
+            lines: Vec::new(),
+        })
+        .collect();
+    if tracks.is_empty() {
+        return Ok(tracks);
+    }
+    let cues = segment.cues(r)?;
+    for track in &mut tracks {
+        let mut points: Vec<(u64, Option<u64>)> = cues
+            .iter()
+            .filter(|c| c.track == track.number)
+            .map(|c| (segment.ms(c.time), c.duration.map(|d| segment.ms(d))))
+            .collect();
+        points.sort_by_key(|p| p.0);
+        points.dedup_by_key(|p| p.0);
+        track.lines = if track.codec == "S_HDMV/PGS" {
+            pgs_lines(&points)
+        } else {
+            timed_lines(&points)
+        };
+    }
+    Ok(tracks)
+}
+
+fn timed_lines(points: &[(u64, Option<u64>)]) -> Vec<(u64, u64)> {
+    points
+        .iter()
+        .enumerate()
+        .filter_map(|(i, &(start, duration))| {
+            let end = match duration {
+                Some(duration) => start + duration,
+                None => (start + UNTIMED_MS).min(points.get(i + 1).map_or(u64::MAX, |n| n.0)),
+            };
+            (end > start).then_some((start, end))
+        })
+        .collect()
+}
+
+/// PGS indexes the display set that shows each line and the one that clears it. Some muxers give
+/// the clearing ones a frame's duration; otherwise each entry is labelled one or the other, the
+/// labelling with the fewest odd lines and replaced or doubled clears winning.
+fn pgs_lines(points: &[(u64, Option<u64>)]) -> Vec<(u64, u64)> {
+    let clears = points
+        .iter()
+        .filter(|p| p.1.is_some_and(|d| d <= PGS_CLEAR_MS))
+        .count();
+    if clears * 10 >= points.len() * 3 {
+        return points
+            .iter()
+            .filter_map(|&(start, d)| d.filter(|&d| d > PGS_CLEAR_MS).map(|d| (start, start + d)))
+            .collect();
+    }
+    let t: Vec<u64> = points.iter().map(|p| p.0).collect();
+    let n = t.len();
+    if n < 2 {
+        return Vec::new();
+    }
+    let line = |i: usize| match t.get(i + 1) {
+        Some(next) if !(PGS_SHORTEST_MS..=PGS_LONGEST_MS).contains(&(next - t[i])) => PGS_ODD_LINE,
+        _ => 0,
+    };
+    // The cheapest labelling of entries up to i with entry i showing a line or clearing one, and
+    // whether the entry before it showed one.
+    let (mut show, mut clear) = (vec![0u32; n], vec![0u32; n]);
+    let (mut show_after_show, mut clear_after_show) = (vec![false; n], vec![false; n]);
+    show[0] = line(0);
+    clear[0] = PGS_CLEARED_TWICE;
+    for i in 1..n {
+        let replaced = show[i - 1] + PGS_REPLACED;
+        (show[i], show_after_show[i]) = if replaced < clear[i - 1] {
+            (replaced, true)
+        } else {
+            (clear[i - 1], false)
+        };
+        show[i] += line(i);
+        let cleared_twice = clear[i - 1] + PGS_CLEARED_TWICE;
+        (clear[i], clear_after_show[i]) = if show[i - 1] <= cleared_twice {
+            (show[i - 1], true)
+        } else {
+            (cleared_twice, false)
+        };
+    }
+    let mut shows = vec![false; n];
+    let mut is_show = show[n - 1] < clear[n - 1];
+    for i in (0..n).rev() {
+        shows[i] = is_show;
+        is_show = if is_show {
+            show_after_show[i]
+        } else {
+            clear_after_show[i]
+        };
+    }
+    (0..n - 1)
+        .filter(|&i| shows[i])
+        .map(|i| (t[i], t[i + 1]))
+        .collect()
+}
+
+/// The sample tables list every subtitle sample, and the gaps between lines as empty ones.
+fn mp4_timelines(r: &mut RangeReader) -> Result<Vec<SubtitleTimeline>> {
+    let moov = mp4::moov(r)?;
+    if child(&moov, b"mvex").is_some() {
+        return Err(Error::Unsupported("fragmented MP4".into()));
+    }
+    let movie_scale = child(&moov, b"mvhd")
+        .and_then(|h| u32be(h, if h.first() == Some(&1) { 20 } else { 12 }))
+        .filter(|&s| s > 0)
+        .unwrap_or(1000);
+    let traks: Vec<&[u8]> = boxes(&moov)
+        .filter(|(kind, _)| kind == b"trak")
+        .map(|(_, body)| body)
+        .collect();
+    // Players list chapter titles as chapters, not subtitles.
+    let chapters: Vec<u64> = traks
+        .iter()
+        .filter_map(|trak| child(trak, b"tref"))
+        .flat_map(|tref| boxes(tref).filter(|(kind, _)| kind == b"chap"))
+        .flat_map(|(_, ids)| (0..ids.len() / 4).filter_map(|i| u32be(ids, 4 * i)))
+        .collect();
+    let mut tracks = Vec::new();
+    for trak in traks {
+        let Some(mdia) = child(trak, b"mdia") else {
+            continue;
+        };
+        let handler = child(mdia, b"hdlr").and_then(|h| h.get(8..12));
+        if !matches!(handler, Some(b"sbtl" | b"text" | b"subt" | b"subp")) {
+            continue;
+        }
+        let number = child(trak, b"tkhd")
+            .and_then(|t| u32be(t, if t.first() == Some(&1) { 20 } else { 12 }))
+            .unwrap_or(0);
+        if chapters.contains(&number) {
+            continue;
+        }
+        let entry = path(mdia, &[b"minf", b"stbl", b"stsd"])
+            .and_then(|s| s.get(8..))
+            .and_then(|s| boxes(s).next())
+            .map(|(kind, _)| kind);
+        // An empty text sample is its two length bytes, an empty WebVTT one its 8-byte vtte box.
+        let empty = match entry.as_ref() {
+            Some(b"tx3g" | b"text") => Some(2),
+            Some(b"wvtt") => Some(8),
+            _ => None,
+        };
+        let mdhd = child(mdia, b"mdhd");
+        tracks.push(SubtitleTimeline {
+            number,
+            codec: entry.map_or_else(String::new, |k| String::from_utf8_lossy(&k).into_owned()),
+            language: mdhd.and_then(language),
+            lines: empty
+                .and_then(|empty| sample_lines(trak, mdia, movie_scale, empty))
+                .unwrap_or_default(),
+        });
+    }
+    Ok(tracks)
+}
+
+/// The packed ISO 639-2 code of an mdhd box.
+fn language(mdhd: &[u8]) -> Option<String> {
+    let packed = u16be(mdhd, if mdhd.first() == Some(&1) { 32 } else { 20 })?;
+    let code: String = [10, 5, 0]
+        .iter()
+        .map(|shift| char::from(((packed >> shift) & 0x1f) as u8 + 0x60))
+        .collect();
+    (code.chars().all(|c| c.is_ascii_lowercase()) && code != "und").then_some(code)
+}
+
+fn sample_lines(trak: &[u8], mdia: &[u8], movie_scale: u64, empty: u64) -> Option<Vec<(u64, u64)>> {
+    let mdhd = child(mdia, b"mdhd")?;
+    let scale = u32be(mdhd, if mdhd[0] == 1 { 20 } else { 12 }).filter(|&s| s > 0)?;
+    let stbl = path(mdia, &[b"minf", b"stbl"])?;
+    let stsz = child(stbl, b"stsz")?;
+    let (fixed, count) = (u32be(stsz, 4)?, u32be(stsz, 8)?);
+    let size = |s: u64| {
+        if fixed != 0 {
+            Some(fixed)
+        } else {
+            u32be(stsz, 12 + 4 * s as usize)
+        }
+    };
+    let stts = child(stbl, b"stts")?;
+    // An edit list delays the track by its empty edits and starts it at its first edit's media time.
+    let (mut delay_ms, mut first) = (0, 0);
+    if let Some(elst) = path(trak, &[b"edts", b"elst"]) {
+        let wide = elst.first() == Some(&1);
+        let entry = if wide { 20 } else { 12 };
+        for i in 0..u32be(elst, 4)? as usize {
+            let at = 8 + entry * i;
+            let (length, media) = if wide {
+                (u64be(elst, at)?, u64be(elst, at + 8)? as i64)
+            } else {
+                (u32be(elst, at)?, u32be(elst, at + 4)? as u32 as i32 as i64)
+            };
+            if media >= 0 {
+                first = media as u64;
+                break;
+            }
+            delay_ms += length * 1000 / movie_scale;
+        }
+    }
+    let ms = |t: u64| delay_ms + t.saturating_sub(first) * 1000 / scale;
+    let mut lines = Vec::new();
+    let (mut sample, mut dts) = (0u64, 0u64);
+    for i in 0..u32be(stts, 4)? as usize {
+        let (run, delta) = (u32be(stts, 8 + 8 * i)?, u32be(stts, 12 + 8 * i)?);
+        for _ in 0..run {
+            if sample >= count {
+                break;
+            }
+            if size(sample)? > empty && dts + delta > first {
+                lines.push((ms(dts), ms(dts + delta)));
+            }
+            dts += delta;
+            sample += 1;
+        }
+    }
+    Some(lines)
+}
