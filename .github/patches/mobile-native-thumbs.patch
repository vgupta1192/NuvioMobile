@@ -0,0 +1,80 @@
+use std::collections::HashMap;
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+use aiostreams_container::Options;
+use aiostreams_thumbs::{Session, Settings};
+
+/// A held seek key: a new position every `interval_ms`, thumbnails made by a [`Session`].
+pub fn run(pos: &[String], steps: usize, interval_ms: u64, workers: usize) -> Result<(), String> {
+    let url = pos.get(1).ok_or("url")?;
+    let asked: Arc<Mutex<HashMap<u64, Instant>>> = Arc::default();
+    let shown: Arc<Mutex<Vec<(u64, f64)>>> = Arc::default();
+    let t0 = Instant::now();
+    let session = {
+        let (asked, shown) = (asked.clone(), shown.clone());
+        Session::open(
+            url,
+            Options::default(),
+            Settings {
+                workers,
+                ..Settings::default()
+            },
+            move |t| {
+                if let Some(at) = asked.lock().unwrap().get(&t.time_ms) {
+                    shown
+                        .lock()
+                        .unwrap()
+                        .push((t.time_ms, at.elapsed().as_secs_f64() * 1e3));
+                }
+            },
+        )
+        .map_err(|e| e.to_string())?
+    };
+    let open_ms = t0.elapsed().as_secs_f64() * 1e3;
+    let k = session.keyframes();
+    let mut last = 0;
+    for i in 0..steps {
+        let ms = k.duration_ms / 10 + k.duration_ms / 2 * i as u64 / (steps.max(2) - 1) as u64;
+        last = k.entries[k.at(ms)].time_ms;
+        asked
+            .lock()
+            .unwrap()
+            .entry(last)
+            .or_insert_with(Instant::now);
+        session.want(ms, None);
+        std::thread::sleep(Duration::from_millis(interval_ms));
+    }
+    let deadline = Instant::now() + Duration::from_secs(20);
+    while Instant::now() < deadline && !shown.lock().unwrap().iter().any(|s| s.0 == last) {
+        std::thread::sleep(Duration::from_millis(5));
+    }
+    let settled = asked.lock().unwrap()[&last].elapsed().as_secs_f64() * 1e3;
+    let t = Instant::now();
+    let cached = (0..steps)
+        .filter(|&i| {
+            session
+                .want(
+                    k.duration_ms / 10 + k.duration_ms / 2 * i as u64 / (steps.max(2) - 1) as u64,
+                    None,
+                )
+                .is_some()
+        })
+        .count();
+    let cached_us = t.elapsed().as_secs_f64() * 1e6 / steps as f64;
+    let rss_busy = crate::metrics::rss_mb().0;
+    std::thread::sleep(Duration::from_secs(12));
+    let rss_idle = crate::metrics::rss_mb().0;
+    eprintln!(
+        "cached {cached}/{steps} at {cached_us:.1} us each; rss {rss_busy:.0} MB busy, {rss_idle:.0} MB after 12 s idle"
+    );
+    let shown = shown.lock().unwrap();
+    let mut latency: Vec<f64> = shown.iter().map(|s| s.1).collect();
+    latency.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    println!(
+        "{{\"open_ms\":{open_ms:.0},\"asked\":{steps},\"shown\":{},\"request_to_image_med\":{:.0},\"settled_ms\":{settled:.0}}}",
+        shown.len(),
+        latency.get(latency.len() / 2).copied().unwrap_or(0.0)
+    );
+    Ok(())
+}
diff --git a/native/thumbs/src/codec.rs b/native/thumbs/src/codec.rs
new file mode 100644
index 00000000..f4ed9819
--- /dev/null
+++ b/native/thumbs/src/codec.rs
@@ -0,0 +1,123 @@
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub enum Kind {
+    H264,
+    Hevc,
+    Av1,
+    Vp9,
+    Mpeg2,
+}
+
+impl Kind {
+    /// From a Matroska codec ID, which MP4 tracks use too.
+    pub fn from_codec_id(id: &str) -> Option<Kind> {
+        Some(match id {
+            "V_MPEG4/ISO/AVC" => Kind::H264,
+            "V_MPEGH/ISO/HEVC" => Kind::Hevc,
+            "V_AV1" => Kind::Av1,
+            "V_VP9" => Kind::Vp9,
+            "V_MPEG2" | "V_MPEG1" => Kind::Mpeg2,
+            _ => return None,
+        })
+    }
+
+    pub fn decoder(self) -> &'static str {
+        match self {
+            Kind::H264 => "h264",
+            Kind::Hevc => "hevc",
+            Kind::Av1 => "libdav1d",
+            Kind::Vp9 => "vp9",
+            Kind::Mpeg2 => "mpeg2video",
+        }
+    }
+}
+
+/// Turns container frames into packets that carry their parameter sets in band.
+#[derive(Clone)]
+pub struct Config {
+    nal_len: usize,
+    prefix: Vec<u8>,
+}
+
+const START: [u8; 4] = [0, 0, 0, 1];
+
+fn u16be(b: &[u8], i: usize) -> Option<usize> {
+    Some(u16::from_be_bytes([*b.get(i)?, *b.get(i + 1)?]) as usize)
+}
+
+impl Config {
+    pub fn new(kind: Kind, private: &[u8]) -> Result<Config, String> {
+        let mut prefix = Vec::new();
+        let mut nal_len = 0;
+        match kind {
+            Kind::H264 if private.len() > 6 && private[0] == 1 => {
+                nal_len = (private[4] & 3) as usize + 1;
+                let mut i = 5;
+                for group in 0..2 {
+                    let count = if group == 0 {
+                        private[i] & 0x1F
+                    } else {
+                        private[i]
+                    } as usize;
+                    i += 1;
+                    for _ in 0..count {
+                        let len = u16be(private, i).ok_or("short avcC")?;
+                        prefix.extend_from_slice(&START);
+                        prefix.extend_from_slice(
+                            private.get(i + 2..i + 2 + len).ok_or("short avcC")?,
+                        );
+                        i += 2 + len;
+                    }
+                    if i >= private.len() {
+                        break;
+                    }
+                }
+            }
+            // Without arrays when the parameter sets travel in band (hev1, dvhe).
+            Kind::Hevc if private.len() >= 23 => {
+                nal_len = (private[21] & 3) as usize + 1;
+                let arrays = private[22] as usize;
+                let mut i = 23;
+                for _ in 0..arrays {
+                    let count = u16be(private, i + 1).ok_or("short hvcC")?;
+                    i += 3;
+                    for _ in 0..count {
+                        let len = u16be(private, i).ok_or("short hvcC")?;
+                        prefix.extend_from_slice(&START);
+                        prefix.extend_from_slice(
+                            private.get(i + 2..i + 2 + len).ok_or("short hvcC")?,
+                        );
+                        i += 2 + len;
+                    }
+                }
+            }
+            // av1C is 4 bytes, then the sequence header OBU(s).
+            Kind::Av1 if private.len() > 4 => prefix.extend_from_slice(&private[4..]),
+            Kind::Mpeg2 => prefix.extend_from_slice(private),
+            _ => {}
+        }
+        Ok(Config { nal_len, prefix })
+    }
+
+    pub fn packet(&self, frame: &[u8]) -> Result<Vec<u8>, String> {
+        let mut out = Vec::with_capacity(self.prefix.len() + frame.len() + 64);
+        out.extend_from_slice(&self.prefix);
+        if self.nal_len == 0 {
+            out.extend_from_slice(frame);
+            return Ok(out);
+        }
+        let mut i = 0;
+        while i + self.nal_len <= frame.len() {
+            let len = frame[i..i + self.nal_len]
+                .iter()
+                .fold(0usize, |v, &b| (v << 8) | b as usize);
+            i += self.nal_len;
+            let nal = frame
+                .get(i..i + len)
+                .ok_or("NAL past the end of the frame")?;
+            out.extend_from_slice(&START);
+            out.extend_from_slice(nal);
+            i += len;
+        }
+        Ok(out)
+    }
+}
diff --git a/native/thumbs/src/decode.rs b/native/thumbs/src/decode.rs
new file mode 100644
index 00000000..d3046557
--- /dev/null
+++ b/native/thumbs/src/decode.rs
@@ -0,0 +1,376 @@
+//! libavcodec, loaded at runtime so builds need no FFmpeg. Of FFmpeg's structs only the start of
+//! AVFrame is read, which no release has changed.
+
+use std::ffi::{CStr, CString, c_char, c_int, c_uint, c_void};
+use std::path::{Path, PathBuf};
+use std::ptr;
+use std::sync::{Mutex, OnceLock};
+
+use libloading::Library;
+
+const PADDING: usize = 64;
+
+#[repr(C)]
+struct RawFrame {
+    data: [*const u8; 8],
+    linesize: [c_int; 8],
+    extended_data: *mut *mut u8,
+    width: c_int,
+    height: c_int,
+    nb_samples: c_int,
+    format: c_int,
+}
+
+struct Api {
+    find_decoder_by_name: unsafe extern "C" fn(*const c_char) -> *const c_void,
+    alloc_context3: unsafe extern "C" fn(*const c_void) -> *mut c_void,
+    open2: unsafe extern "C" fn(*mut c_void, *const c_void, *mut *mut c_void) -> c_int,
+    free_context: unsafe extern "C" fn(*mut *mut c_void),
+    send_packet: unsafe extern "C" fn(*mut c_void, *const c_void) -> c_int,
+    receive_frame: unsafe extern "C" fn(*mut c_void, *mut RawFrame) -> c_int,
+    flush_buffers: unsafe extern "C" fn(*mut c_void),
+    packet_alloc: unsafe extern "C" fn() -> *mut c_void,
+    packet_free: unsafe extern "C" fn(*mut *mut c_void),
+    packet_from_data: unsafe extern "C" fn(*mut c_void, *mut u8, c_int) -> c_int,
+    packet_unref: unsafe extern "C" fn(*mut c_void),
+    malloc: unsafe extern "C" fn(usize) -> *mut u8,
+    free: unsafe extern "C" fn(*mut c_void),
+    frame_alloc: unsafe extern "C" fn() -> *mut RawFrame,
+    frame_free: unsafe extern "C" fn(*mut *mut RawFrame),
+    frame_unref: unsafe extern "C" fn(*mut RawFrame),
+    dict_set: unsafe extern "C" fn(*mut *mut c_void, *const c_char, *const c_char, c_int) -> c_int,
+    dict_free: unsafe extern "C" fn(*mut *mut c_void),
+    strerror: unsafe extern "C" fn(c_int, *mut c_char, usize) -> c_int,
+    pix_fmt_name: unsafe extern "C" fn(c_int) -> *const c_char,
+    opt_get_int: unsafe extern "C" fn(*mut c_void, *const c_char, c_int, *mut i64) -> c_int,
+    version: c_uint,
+    _avcodec: Library,
+    _avutil: Library,
+}
+
+unsafe impl Send for Api {}
+unsafe impl Sync for Api {}
+
+static DIRS: Mutex<Vec<PathBuf>> = Mutex::new(Vec::new());
+static API: OnceLock<Result<Api, String>> = OnceLock::new();
+
+/// Folders searched for FFmpeg's libraries before the system's own search, set before the first
+/// decoder opens.
+pub fn library_dirs(dirs: Vec<PathBuf>) {
+    if let Ok(mut d) = DIRS.lock() {
+        *d = dirs;
+    }
+}
+
+/// Loads libavcodec on first use.
+pub fn ffmpeg_version() -> Result<String, String> {
+    let v = api()?.version;
+    Ok(format!("{}.{}.{}", v >> 16, (v >> 8) & 0xff, v & 0xff))
+}
+
+fn api() -> Result<&'static Api, String> {
+    API.get_or_init(Api::find).as_ref().map_err(Clone::clone)
+}
+
+/// libavutil's major has been libavcodec's minus two since FFmpeg 4.
+fn names(major: u32) -> (String, String) {
+    let util = major.saturating_sub(2);
+    if cfg!(target_os = "android") {
+        ("libavcodec.so".into(), "libavutil.so".into())
+    } else if cfg!(windows) {
+        (format!("avcodec-{major}.dll"), format!("avutil-{util}.dll"))
+    } else if cfg!(target_os = "macos") {
+        (
+            format!("libavcodec.{major}.dylib"),
+            format!("libavutil.{util}.dylib"),
+        )
+    } else {
+        (
+            format!("libavcodec.so.{major}"),
+            format!("libavutil.so.{util}"),
+        )
+    }
+}
+
+// SAFETY (both loaders): FFmpeg's libraries run no initialisers that depend on us.
+fn open(dir: Option<&Path>, name: &str) -> Result<Library, libloading::Error> {
+    match dir {
+        Some(dir) => open_in(&dir.join(name)),
+        None => unsafe { Library::new(name) },
+    }
+}
+
+/// The folder's own libraries satisfy each other's imports.
+#[cfg(windows)]
+fn open_in(path: &Path) -> Result<Library, libloading::Error> {
+    use libloading::os::windows;
+    unsafe { windows::Library::load_with_flags(path, windows::LOAD_WITH_ALTERED_SEARCH_PATH) }
+        .map(Into::into)
+}
+
+#[cfg(not(windows))]
+fn open_in(path: &Path) -> Result<Library, libloading::Error> {
+    unsafe { Library::new(path) }
+}
+
+impl Api {
+    fn find() -> Result<Api, String> {
+        let dirs = DIRS.lock().map(|d| d.clone()).unwrap_or_default();
+        let majors: Vec<u32> = if cfg!(target_os = "android") {
+            vec![0]
+        } else {
+            (59..=66).rev().collect()
+        };
+        let mut first = None;
+        for major in majors {
+            let (codec, util) = names(major);
+            for dir in dirs.iter().map(|d| Some(d.as_path())).chain([None]) {
+                // libavutil first, so libavcodec links to the same folder's copy.
+                let loaded = open(dir, &util).and_then(|u| Ok((open(dir, &codec)?, u)));
+                match loaded {
+                    Ok((avcodec, avutil)) => return Api::load(avcodec, avutil),
+                    Err(e) => {
+                        first.get_or_insert(e);
+                    }
+                }
+            }
+        }
+        Err(format!(
+            "no FFmpeg libraries: {}",
+            first.map(|e| e.to_string()).unwrap_or_default()
+        ))
+    }
+
+    fn load(avcodec: Library, avutil: Library) -> Result<Api, String> {
+        macro_rules! sym {
+            ($lib:ident, $name:literal) => {
+                // SAFETY: the signatures match FFmpeg's headers in every release we load.
+                *unsafe { $lib.get(concat!($name, "\0").as_bytes()) }
+                    .map_err(|e| format!("FFmpeg is missing {}: {e}", $name))?
+            };
+        }
+        let version: unsafe extern "C" fn() -> c_uint = sym!(avcodec, "avcodec_version");
+        Ok(Api {
+            find_decoder_by_name: sym!(avcodec, "avcodec_find_decoder_by_name"),
+            alloc_context3: sym!(avcodec, "avcodec_alloc_context3"),
+            open2: sym!(avcodec, "avcodec_open2"),
+            free_context: sym!(avcodec, "avcodec_free_context"),
+            send_packet: sym!(avcodec, "avcodec_send_packet"),
+            receive_frame: sym!(avcodec, "avcodec_receive_frame"),
+            flush_buffers: sym!(avcodec, "avcodec_flush_buffers"),
+            packet_alloc: sym!(avcodec, "av_packet_alloc"),
+            packet_free: sym!(avcodec, "av_packet_free"),
+            packet_from_data: sym!(avcodec, "av_packet_from_data"),
+            packet_unref: sym!(avcodec, "av_packet_unref"),
+            malloc: sym!(avutil, "av_malloc"),
+            free: sym!(avutil, "av_free"),
+            frame_alloc: sym!(avutil, "av_frame_alloc"),
+            frame_free: sym!(avutil, "av_frame_free"),
+            frame_unref: sym!(avutil, "av_frame_unref"),
+            dict_set: sym!(avutil, "av_dict_set"),
+            dict_free: sym!(avutil, "av_dict_free"),
+            strerror: sym!(avutil, "av_strerror"),
+            pix_fmt_name: sym!(avutil, "av_get_pix_fmt_name"),
+            opt_get_int: sym!(avutil, "av_opt_get_int"),
+            version: unsafe { version() },
+            _avcodec: avcodec,
+            _avutil: avutil,
+        })
+    }
+
+    fn error(&self, ret: c_int) -> String {
+        let mut buf = [0 as c_char; 256];
+        unsafe { (self.strerror)(ret, buf.as_mut_ptr(), buf.len()) };
+        unsafe { CStr::from_ptr(buf.as_ptr()) }
+            .to_string_lossy()
+            .into_owned()
+    }
+}
+
+pub struct Frame {
+    pub width: c_int,
+    pub height: c_int,
+    pub bits: c_int,
+    pub log2_chroma_w: c_int,
+    pub log2_chroma_h: c_int,
+    pub planar_yuv: c_int,
+    pub data: [*const u8; 3],
+    pub linesize: [c_int; 3],
+    pub color_range: c_int,
+    pub color_primaries: c_int,
+    pub color_trc: c_int,
+    pub colorspace: c_int,
+    pix_fmt: *const c_char,
+}
+
+impl Frame {
+    pub fn pix_fmt(&self) -> String {
+        if self.pix_fmt.is_null() {
+            return "?".into();
+        }
+        unsafe { CStr::from_ptr(self.pix_fmt) }
+            .to_string_lossy()
+            .into_owned()
+    }
+}
+
+/// Bits and chroma subsampling of a little-endian planar YUV format.
+fn planar_yuv(name: &str) -> Option<(c_int, c_int, c_int)> {
+    let rest = name
+        .strip_prefix("yuvj")
+        .or_else(|| name.strip_prefix("yuv"))?;
+    let (sub, depth) = rest.split_once('p')?;
+    let (w, h) = match sub {
+        "420" => (1, 1),
+        "422" => (1, 0),
+        "444" => (0, 0),
+        "440" => (0, 1),
+        "411" => (2, 0),
+        "410" => (2, 2),
+        _ => return None,
+    };
+    let bits = match depth {
+        "" => 8,
+        d => d.strip_suffix("le")?.parse().ok()?,
+    };
+    Some((bits, w, h))
+}
+
+pub struct Options {
+    pub threads: i32,
+    pub skip_loop_filter: bool,
+    pub fast: bool,
+}
+
+pub struct Decoder {
+    api: &'static Api,
+    ctx: *mut c_void,
+    packet: *mut c_void,
+    raw: *mut RawFrame,
+    frame: Frame,
+}
+
+unsafe impl Send for Decoder {}
+
+impl Decoder {
+    pub fn open(name: &str, o: &Options) -> Result<Decoder, String> {
+        let api = api()?;
+        let c_name = CString::new(name).map_err(|e| e.to_string())?;
+        let codec = unsafe { (api.find_decoder_by_name)(c_name.as_ptr()) };
+        if codec.is_null() {
+            return Err(format!("no decoder {name}"));
+        }
+        let d = Decoder {
+            api,
+            ctx: unsafe { (api.alloc_context3)(codec) },
+            packet: unsafe { (api.packet_alloc)() },
+            raw: unsafe { (api.frame_alloc)() },
+            frame: Frame {
+                width: 0,
+                height: 0,
+                bits: 8,
+                log2_chroma_w: 0,
+                log2_chroma_h: 0,
+                planar_yuv: 0,
+                data: [ptr::null(); 3],
+                linesize: [0; 3],
+                color_range: 0,
+                color_primaries: 2,
+                color_trc: 2,
+                colorspace: 2,
+                pix_fmt: ptr::null(),
+            },
+        };
+        if d.ctx.is_null() || d.packet.is_null() || d.raw.is_null() {
+            return Err("out of memory".into());
+        }
+        let threads = o.threads.to_string();
+        let mut options = vec![
+            ("threads", threads.as_str()),
+            ("thread_type", "slice"),
+            ("flags", "+low_delay"),
+            // libdav1d: keep film grain out of the picture.
+            ("export_side_data", "film_grain"),
+        ];
+        if o.skip_loop_filter {
+            options.push(("skip_loop_filter", "all"));
+        }
+        if o.fast {
+            options.push(("flags2", "+fast"));
+        }
+        let mut dict = ptr::null_mut();
+        for (key, value) in options {
+            let (key, value) = (CString::new(key).unwrap(), CString::new(value).unwrap());
+            unsafe { (api.dict_set)(&mut dict, key.as_ptr(), value.as_ptr(), 0) };
+        }
+        let ret = unsafe { (api.open2)(d.ctx, codec, &mut dict) };
+        unsafe { (api.dict_free)(&mut dict) };
+        if ret < 0 {
+            return Err(api.error(ret));
+        }
+        Ok(d)
+    }
+
+    /// Decodes one packet; the frame borrows the decoder until the next call.
+    pub fn decode(&mut self, packet: &[u8]) -> Result<&Frame, String> {
+        let api = self.api;
+        unsafe {
+            (api.frame_unref)(self.raw);
+            (api.flush_buffers)(self.ctx);
+            let buf = (api.malloc)(packet.len() + PADDING);
+            if buf.is_null() {
+                return Err("out of memory".into());
+            }
+            ptr::copy_nonoverlapping(packet.as_ptr(), buf, packet.len());
+            ptr::write_bytes(buf.add(packet.len()), 0, PADDING);
+            let ret = (api.packet_from_data)(self.packet, buf, packet.len() as c_int);
+            if ret < 0 {
+                (api.free)(buf.cast());
+                return Err(api.error(ret));
+            }
+            let ret = (api.send_packet)(self.ctx, self.packet);
+            (api.packet_unref)(self.packet);
+            if ret < 0 {
+                return Err(api.error(ret));
+            }
+            (api.send_packet)(self.ctx, ptr::null());
+            let ret = (api.receive_frame)(self.ctx, self.raw);
+            if ret < 0 {
+                return Err(api.error(ret));
+            }
+            let raw = &*self.raw;
+            let option = |name: &CStr| {
+                let mut v = 0i64;
+                (api.opt_get_int)(self.ctx, name.as_ptr(), 0, &mut v);
+                v as c_int
+            };
+            let f = &mut self.frame;
+            f.width = raw.width;
+            f.height = raw.height;
+            f.pix_fmt = (api.pix_fmt_name)(raw.format);
+            let layout = (!f.pix_fmt.is_null())
+                .then(|| CStr::from_ptr(f.pix_fmt).to_str().ok())
+                .flatten()
+                .and_then(planar_yuv);
+            f.planar_yuv = layout.is_some() as c_int;
+            (f.bits, f.log2_chroma_w, f.log2_chroma_h) = layout.unwrap_or((8, 0, 0));
+            f.data = [raw.data[0], raw.data[1], raw.data[2]];
+            f.linesize = [raw.linesize[0], raw.linesize[1], raw.linesize[2]];
+            f.color_range = option(c"color_range");
+            f.color_primaries = option(c"color_primaries");
+            f.color_trc = option(c"color_trc");
+            f.colorspace = option(c"colorspace");
+        }
+        Ok(&self.frame)
+    }
+}
+
+impl Drop for Decoder {
+    fn drop(&mut self) {
+        unsafe {
+            (self.api.free_context)(&mut self.ctx);
+            (self.api.packet_free)(&mut self.packet);
+            (self.api.frame_free)(&mut self.raw);
+        }
+    }
+}
diff --git a/native/thumbs/src/dovi.rs b/native/thumbs/src/dovi.rs
new file mode 100644
index 00000000..0fb5b241
--- /dev/null
+++ b/native/thumbs/src/dovi.rs
@@ -0,0 +1,251 @@
+//! Dolby Vision profile 5: reshaped IPTPQc2 with no HDR10 picture underneath, undone with the
+//! RPU each frame carries the way libplacebo does it.
+
+use dolby_vision::rpu::dovi_rpu::DoviRpu;
+use dolby_vision::rpu::rpu_data_header::RpuDataHeader;
+use dolby_vision::rpu::rpu_data_mapping::{DoviReshapingCurve, RpuDataMapping};
+use dolby_vision::rpu::vdr_dm_data::VdrDmData;
+
+use crate::scale::pq_eotf;
+
+/// BT.2020-referred Hunt-Pointer-Estevez LMS to BT.2020 RGB, libplacebo's constant.
+const LMS_TO_RGB: [[f32; 3]; 3] = [
+    [3.064_418_8, -2.165_976_8, 0.101_558_18],
+    [-0.656_121_1, 1.785_541_2, -0.129_437_49],
+    [0.017_363_21, -0.047_251_54, 1.030_042_5],
+];
+
+enum Piece {
+    /// Coefficients of 1, s and s².
+    Poly([f32; 3]),
+    /// Per order: the 3 samples' powers, then their 4 products' powers.
+    Mmr {
+        constant: f32,
+        orders: Vec<[f32; 7]>,
+    },
+}
+
+struct Curve {
+    /// Pivots between pieces, without the first and last.
+    inner: Vec<f32>,
+    lo: f32,
+    hi: f32,
+    pieces: Vec<Piece>,
+}
+
+/// One frame's reshaping, from coded samples to IPT.
+pub struct Reshape {
+    curves: [Curve; 3],
+    /// The highest MMR order of any piece.
+    orders: usize,
+}
+
+/// What turns reshaped samples into light: the same for most of a file.
+#[derive(Clone, Copy, PartialEq, Debug)]
+pub struct Matrices {
+    nonlinear: [[f32; 3]; 3],
+    offset: [f32; 3],
+    /// The RPU's RGB to LMS, then LMS to BT.2020.
+    linear: [[f32; 3]; 3],
+}
+
+pub struct Rpu {
+    pub reshape: std::sync::Arc<Reshape>,
+    pub matrices: Matrices,
+}
+
+fn mul(a: &[[f32; 3]; 3], b: &[[f32; 3]; 3]) -> [[f32; 3]; 3] {
+    std::array::from_fn(|i| std::array::from_fn(|j| (0..3).map(|k| a[i][k] * b[k][j]).sum()))
+}
+
+fn apply(m: &[[f32; 3]; 3], v: [f32; 3]) -> [f32; 3] {
+    std::array::from_fn(|i| m[i][0] * v[0] + m[i][1] * v[1] + m[i][2] * v[2])
+}
+
+fn coefficient(header: &RpuDataHeader, int: Option<i64>, fraction: u64) -> f32 {
+    if header.coefficient_data_type == 1 {
+        f32::from_bits(fraction as u32)
+    } else {
+        int.unwrap_or(0) as f32 + fraction as f32 / (1u64 << header.coefficient_log2_denom) as f32
+    }
+}
+
+impl Curve {
+    fn new(header: &RpuDataHeader, curve: &DoviReshapingCurve) -> Option<Curve> {
+        let max = ((1u32 << (header.bl_bit_depth_minus8 + 8)) - 1) as f32;
+        // Coded as differences from the previous pivot.
+        let pivots: Vec<f32> = curve
+            .pivots
+            .iter()
+            .scan(0u32, |sum, &d| {
+                *sum = (*sum + d as u32).min(u16::MAX as u32);
+                Some(*sum as f32 / max)
+            })
+            .collect();
+        let n = pivots.len().checked_sub(1).filter(|&n| n > 0)?;
+        let c = |int: Option<&i64>, fraction: &u64| coefficient(header, int.copied(), *fraction);
+        let pieces = if let Some(p) = &curve.polynomial {
+            (0..n)
+                .map(|i| {
+                    let (ints, fractions) = (p.poly_coef_int.get(i), p.poly_coef.get(i)?);
+                    let mut k = [0.0; 3];
+                    for (j, f) in fractions.iter().enumerate().take(3) {
+                        k[j] = c(ints.and_then(|v| v.get(j)), f);
+                    }
+                    Some(Piece::Poly(k))
+                })
+                .collect::<Option<Vec<_>>>()?
+        } else {
+            let m = curve.mmr.as_ref()?;
+            (0..n)
+                .map(|i| {
+                    let fractions = m.mmr_coef.get(i)?;
+                    let ints = m.mmr_coef_int.get(i);
+                    let orders = (0..fractions.len())
+                        .map(|j| {
+                            std::array::from_fn(|k| {
+                                c(ints.and_then(|v| v.get(j)?.get(k)), &fractions[j][k])
+                            })
+                        })
+                        .collect();
+                    let constant = c(m.mmr_constant_int.get(i), m.mmr_constant.get(i)?);
+                    Some(Piece::Mmr { constant, orders })
+                })
+                .collect::<Option<Vec<_>>>()?
+        };
+        Some(Curve {
+            inner: pivots[1..n].to_vec(),
+            lo: pivots[0],
+            hi: pivots[n],
+            pieces,
+        })
+    }
+}
+
+impl Reshape {
+    fn new(header: &RpuDataHeader, mapping: &RpuDataMapping) -> Option<Reshape> {
+        let [y, u, v] = &mapping.curves;
+        let curves = [
+            Curve::new(header, y)?,
+            Curve::new(header, u)?,
+            Curve::new(header, v)?,
+        ];
+        let orders = curves
+            .iter()
+            .flat_map(|c| &c.pieces)
+            .map(|p| match p {
+                Piece::Mmr { orders, .. } => orders.len(),
+                Piece::Poly(_) => 0,
+            })
+            .max()
+            .unwrap_or(0);
+        (orders <= 3).then_some(Reshape { curves, orders })
+    }
+
+    /// Coded samples, each 0..1 of its full range, to IPT.
+    pub fn apply(&self, coded: [f32; 3]) -> [f32; 3] {
+        let [y, u, v] = coded.map(|v| v.clamp(0.0, 1.0));
+        // The MMR terms of each order, shared by both chroma curves.
+        let mut terms = [[y, u, v, y * u, y * v, u * v, y * u * v]; 3];
+        for j in 1..self.orders {
+            terms[j] = std::array::from_fn(|k| terms[j - 1][k] * terms[0][k]);
+        }
+        std::array::from_fn(|c| {
+            let curve = &self.curves[c];
+            let s = terms[0][c];
+            let piece = curve.inner.iter().take_while(|&&p| s >= p).count();
+            let out = match &curve.pieces[piece] {
+                Piece::Poly(k) => (k[2] * s + k[1]) * s + k[0],
+                Piece::Mmr { constant, orders } => {
+                    orders
+                        .iter()
+                        .zip(&terms)
+                        .map(|(w, t)| w.iter().zip(t).map(|(w, t)| w * t).sum::<f32>())
+                        .sum::<f32>()
+                        + constant
+                }
+            };
+            out.clamp(curve.lo, curve.hi)
+        })
+    }
+}
+
+impl Matrices {
+    fn new(dm: &VdrDmData) -> Matrices {
+        let m = |c: [i16; 9], scale: f32| -> [[f32; 3]; 3] {
+            std::array::from_fn(|i| std::array::from_fn(|j| c[i * 3 + j] as f32 / scale))
+        };
+        let nonlinear = m(
+            [
+                dm.ycc_to_rgb_coef0,
+                dm.ycc_to_rgb_coef1,
+                dm.ycc_to_rgb_coef2,
+                dm.ycc_to_rgb_coef3,
+                dm.ycc_to_rgb_coef4,
+                dm.ycc_to_rgb_coef5,
+                dm.ycc_to_rgb_coef6,
+                dm.ycc_to_rgb_coef7,
+                dm.ycc_to_rgb_coef8,
+            ],
+            (1 << 13) as f32,
+        );
+        let lms = m(
+            [
+                dm.rgb_to_lms_coef0,
+                dm.rgb_to_lms_coef1,
+                dm.rgb_to_lms_coef2,
+                dm.rgb_to_lms_coef3,
+                dm.rgb_to_lms_coef4,
+                dm.rgb_to_lms_coef5,
+                dm.rgb_to_lms_coef6,
+                dm.rgb_to_lms_coef7,
+                dm.rgb_to_lms_coef8,
+            ],
+            (1 << 14) as f32,
+        );
+        let offset = [
+            dm.ycc_to_rgb_offset0,
+            dm.ycc_to_rgb_offset1,
+            dm.ycc_to_rgb_offset2,
+        ]
+        .map(|o| o as f32 / (1u32 << 28) as f32);
+        Matrices {
+            nonlinear,
+            offset,
+            linear: mul(&LMS_TO_RGB, &lms),
+        }
+    }
+
+    /// Linear BT.2020 light in nits from IPT.
+    pub fn light(&self, ipt: [f32; 3]) -> [f32; 3] {
+        let centred = std::array::from_fn(|i| ipt[i] - self.offset[i]);
+        let lms = apply(&self.nonlinear, centred).map(|e| pq_eotf(e.min(1.0)));
+        apply(&self.linear, lms)
+    }
+}
+
+impl Rpu {
+    /// The RPU in a packet's UNSPEC62 NAL unit; a frame that refers to an earlier one's
+    /// reshaping or matrices takes them from `previous`.
+    pub fn find(packet: &[u8], previous: Option<&Rpu>) -> Option<Rpu> {
+        let nal = crate::hevc::nal_units(packet)
+            .into_iter()
+            .find(|n| n.len() > 2 && n[0] >> 1 == 62)?;
+        // The parser panics on curves it doesn't implement, which no encoder is known to use.
+        let rpu = std::panic::catch_unwind(|| DoviRpu::parse_unspec62_nalu(nal))
+            .ok()?
+            .ok()?;
+        let reshape = rpu
+            .rpu_data_mapping
+            .as_ref()
+            .and_then(|m| Reshape::new(&rpu.header, m))
+            .map(std::sync::Arc::new)
+            .or_else(|| previous.map(|p| p.reshape.clone()))?;
+        let matrices = rpu
+            .vdr_dm_data
+            .as_ref()
+            .map(Matrices::new)
+            .or_else(|| previous.map(|p| p.matrices))?;
+        Some(Rpu { reshape, matrices })
+    }
+}
