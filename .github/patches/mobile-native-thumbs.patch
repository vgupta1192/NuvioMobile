+package com.nuvio.app.features.player.seekpreview.local
+
+import android.content.Context
+import android.net.ConnectivityManager
+import android.os.Process
+import android.util.Log
+import com.nuvio.app.features.player.aiostreams.Thumbnails
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit
+
+/**
+ * Seek-preview frames from the native decoder (Nuvio fork). It reads only the keyframes it needs
+ * with HTTP range requests, so a seek preview works for the part of a file playback has not
+ * reached. Order: slots around the scrub position first; then, while paused or after playback
+ * has settled on an unmetered network, a pass over the whole title so the cloud cache can be filled.
+ */
+internal class NativeThumbnailFiller(
+    private val context: Context,
+    private val url: String,
+    private val headers: Map<String, String>,
+    private val track: LocalPreviewTrack,
+    private val playbackActive: () -> Boolean,
+    private val onComplete: () -> Unit,
+) {
+    @Volatile private var stopped = false
+    private val startedAt = System.currentTimeMillis()
+
+    @Volatile private var latch = CountDownLatch(0)
+    @Volatile private var unavailable = false
+
+    private val listener = Thumbnails.Listener { positionMs, jpeg, error ->
+        when {
+            jpeg != null -> track.offerNativeFrame(positionMs, jpeg)
+            error != null -> unavailable = true
+        }
+        latch.countDown()
+    }
+
+    fun start() {
+        Thread({
+            Process.setThreadPriority(Process.THREAD_PRIORITY_BACKGROUND)
+            runCatching { run() }.onFailure { Log.w(TAG, "native previews stopped: ${it.message}") }
+        }, "NuvioNativeThumbs").apply {
+            isDaemon = true
+            start()
+        }
+    }
+
+    fun stop() {
+        stopped = true
+    }
+
+    private fun done() = stopped || track.isClosed
+
+    private fun run() {
+        val flat = headers.flatMap { listOf(it.key, it.value) }.toTypedArray()
+        val handle = Thumbnails.open(url, flat, Thumbnails.trustedRoots(context), listener)
+        if (handle == 0L) return
+        try {
+            val tried = BooleanArray(track.slots)
+            var misses = 0
+            var stride = COARSE_STRIDE
+            var cursor = 0
+            Thumbnails.prepare(handle)
+            while (!done() && !unavailable) {
+                val scrub = track.recentScrubMs()
+                val slot = if (scrub != null) {
+                    nearestOpen(track.slotAt(scrub), tried)
+                } else if (backgroundPassAllowed()) {
+                    val next = nextByStride(tried, stride, cursor)
+                    if (next == null && stride > 1) {
+                        stride = if (stride > FINE_STRIDE) FINE_STRIDE else 1
+                        cursor = 0
+                        continue
+                    }
+                    next?.also { cursor = it }
+                } else {
+                    null
+                }
+                if (slot == null) {
+                    if (stride == 1 && scrub == null && backgroundPassAllowed() && nextByStride(tried, 1, 0) == null) break
+                    Thread.sleep(IDLE_MS)
+                    continue
+                }
+                tried[slot] = true
+                latch = CountDownLatch(1)
+                Thumbnails.want(handle, slot * LocalPreviewTrack.SLOT_MS, -1L)
+                if (!latch.await(WAIT_MS, TimeUnit.MILLISECONDS)) {
+                    if (++misses >= MAX_MISSES) {
+                        Log.w(TAG, "native previews: $misses requests without an answer, giving up")
+                        return
+                    }
+                } else {
+                    misses = 0
+                }
+            }
+            if (!done() && !unavailable) onComplete()
+        } finally {
+            Thumbnails.close(handle)
+        }
+    }
+
+    private fun nearestOpen(center: Int, tried: BooleanArray): Int? {
+        for (distance in 0..FOCUS_RADIUS) {
+            for (candidate in intArrayOf(center + distance, center - distance)) {
+                if (candidate in tried.indices && !tried[candidate] && track.isSlotEmpty(candidate)) return candidate
+            }
+        }
+        return null
+    }
+
+    private fun nextByStride(tried: BooleanArray, stride: Int, from: Int): Int? {
+        var slot = from
+        while (slot < tried.size) {
+            if (!tried[slot] && track.isSlotEmpty(slot)) return slot
+            slot += stride
+        }
+        return null
+    }
+
+    private fun backgroundPassAllowed(): Boolean {
+        if (!playbackActive()) return true
+        if (System.currentTimeMillis() - startedAt < PLAYBACK_SETTLE_MS) return false
+        val manager = context.getSystemService(Context.CONNECTIVITY_SERVICE) as? ConnectivityManager
+        return manager != null && !manager.isActiveNetworkMetered
+    }
+
+    private companion object {
+        const val TAG = "NuvioNativeThumbs"
+        const val COARSE_STRIDE = 6
+        const val FINE_STRIDE = 3
+        const val FOCUS_RADIUS = 6
+        const val IDLE_MS = 700L
+        const val WAIT_MS = 6_000L
+        const val MAX_MISSES = 4
+        const val PLAYBACK_SETTLE_MS = 75_000L
+    }
+}
