+/**
+ * Shares a finished thumbnail set with the Nuvio thumbnail cache (Nuvio fork), so the next viewer
+ * of the same title and release gets seek previews at once. Frames become 800x450 sprite sheets of
+ * 5x5 tiles, uploaded first; the index is uploaded last, which is what makes the set visible.
+ */
+internal object CloudThumbUploader {
+    private const val TAG = "NuvioCloudThumbs"
+    const val BASE = "https://thumbs.kissmissi.duckdns.org/v1"
+    const val TILE_W = 160
+    const val TILE_H = 90
+    const val COLS = 5
+    const val PER_SHEET = 25
+    private const val MIN_FILLED_PERCENT = 85
+
+    @Volatile private var running = false
+
+    /** [key] is `id|season|episode|durationSec`; returns when the set is shared or given up on. */
+    fun upload(track: LocalPreviewTrack, key: String) {
+        if (CloudThumbToken.VALUE.isBlank() || running) return
+        val parts = key.split('|')
+        if (parts.size != 4) return
+        val (id, season, episode, durSec) = parts
+        if (!idPattern.matches(id) || durSec.toLongOrNull() == null) return
+        val frames = track.snapshotFrames()
+        if (frames.count { it != null } * 100 < frames.size * MIN_FILLED_PERCENT) return
+        running = true
+        try {
+            val base = "$BASE/$id/${season.ifBlank { "0" }}/${episode.ifBlank { "0" }}/$durSec"
+            if (exists("$base/index.vtt")) return
+            val cues = ((durSec.toLong() + 9) / 10).toInt()
+            val filled = fillGaps(frames.copyOf(cues))
+            val sheets = (cues + PER_SHEET - 1) / PER_SHEET
+            for (n in 0 until sheets) {
+                val jpeg = buildSheet(filled, n * PER_SHEET) ?: return
+                if (!put("$base/${n + 1}.jpg", jpeg)) return
+            }
+            put("$base/index.vtt", ByteArray(0))
+            Log.i(TAG, "shared $sheets sheets for $id")
+        } catch (error: Exception) {
+            Log.w(TAG, "upload stopped: ${error.message}")
+        } finally {
+            running = false
+        }
+    }
+
+    private val idPattern = Regex("[A-Za-z0-9._-]{1,64}")
+
+    private fun fillGaps(frames: Array<ByteArray?>): Array<ByteArray> {
+        val out = arrayOfNulls<ByteArray>(frames.size)
+        var last: ByteArray? = null
+        for (i in frames.indices) {
+            last = frames[i] ?: last
+            out[i] = last
+        }
+        var next: ByteArray? = null
+        for (i in frames.indices.reversed()) {
+            next = frames[i] ?: next
+            if (out[i] == null) out[i] = next
+        }
+        return Array(frames.size) { out[it] ?: ByteArray(0) }
+    }
+
+    private fun buildSheet(frames: Array<ByteArray>, first: Int): ByteArray? {
+        val sheet = Bitmap.createBitmap(COLS * TILE_W, COLS * TILE_H, Bitmap.Config.ARGB_8888)
+        val canvas = Canvas(sheet)
+        canvas.drawColor(Color.BLACK)
+        var drawn = 0
+        for (offset in 0 until PER_SHEET) {
+            val index = first + offset
+            if (index >= frames.size) break
+            val bytes = frames[index].takeIf { it.isNotEmpty() } ?: continue
+            val tile = BitmapFactory.decodeByteArray(bytes, 0, bytes.size) ?: continue
+            val scale = minOf(TILE_W.toFloat() / tile.width, TILE_H.toFloat() / tile.height)
+            val w = (tile.width * scale).toInt().coerceAtLeast(1)
+            val h = (tile.height * scale).toInt().coerceAtLeast(1)
+            val x = (offset % COLS) * TILE_W + (TILE_W - w) / 2
+            val y = (offset / COLS) * TILE_H + (TILE_H - h) / 2
+            canvas.drawBitmap(tile, null, Rect(x, y, x + w, y + h), null)
+            tile.recycle()
+            drawn++
+        }
+        if (drawn == 0) {
+            sheet.recycle()
+            return null
+        }
+        val out = ByteArrayOutputStream()
+        sheet.compress(Bitmap.CompressFormat.JPEG, 60, out)
+        sheet.recycle()
+        return out.toByteArray()
+    }
+
+    private fun exists(url: String): Boolean {
+        val connection = URL(url).openConnection() as HttpURLConnection
+        return try {
+            connection.requestMethod = "HEAD"
+            connection.connectTimeout = 8_000
+            connection.readTimeout = 8_000
+            connection.responseCode == 200
+        } finally {
+            connection.disconnect()
+        }
+    }
+
+    private fun put(url: String, body: ByteArray): Boolean {
+        val connection = URL(url).openConnection() as HttpURLConnection
+        return try {
+            connection.requestMethod = "PUT"
+            connection.doOutput = true
+            connection.connectTimeout = 10_000
+            connection.readTimeout = 20_000
+            connection.setRequestProperty("Authorization", "Bearer ${CloudThumbToken.VALUE}")
+            connection.setRequestProperty("Content-Type", "application/octet-stream")
+            connection.setFixedLengthStreamingMode(body.size)
+            connection.outputStream.use { it.write(body) }
+            val code = connection.responseCode
+            code == 201 || code == 200 || code == 409
+        } finally {
+            connection.disconnect()
+        }
+    }
+}
