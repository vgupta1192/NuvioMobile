+import androidx.compose.ui.unit.sp
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+/** Fork feature: pause playback after a chosen number of minutes. */
+internal object SleepTimer {
+    val choices: List<Int> = listOf(0, 15, 30, 45, 60, 90)
+
+    private val _minutes = MutableStateFlow(0)
+    val minutes: StateFlow<Int> = _minutes.asStateFlow()
+    private val _token = MutableStateFlow(0)
+    val token: StateFlow<Int> = _token.asStateFlow()
+
+    fun set(minutes: Int) {
+        _minutes.value = minutes
+        _token.value = _token.value + 1
+    }
+
+    fun label(minutes: Int): String = if (minutes <= 0) "Off" else "$minutes min"
+}
+
+@Composable
+internal fun SleepTimerEffect(controller: PlayerEngineController?) {
+    val minutes by SleepTimer.minutes.collectAsStateWithLifecycle()
+    val token by SleepTimer.token.collectAsStateWithLifecycle()
+    LaunchedEffect(controller, token) {
+        if (controller == null || minutes <= 0) return@LaunchedEffect
+        delay(minutes * 60_000L)
+        controller.pause()
+        SleepTimer.set(0)
+    }
+}
+
+@Composable
+internal fun SleepTimerRow() {
+    val minutes by SleepTimer.minutes.collectAsStateWithLifecycle()
+    Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+        Text("Sleep timer", color = Color.White, fontSize = 16.sp, fontWeight = FontWeight.SemiBold)
+        Row(
+            modifier = Modifier.fillMaxWidth().horizontalScroll(rememberScrollState()),
+            horizontalArrangement = Arrangement.spacedBy(8.dp),
+        ) {
+            SleepTimer.choices.forEach { option ->
+                com.nuvio.app.core.ui.Chip(
+                    label = SleepTimer.label(option),
+                    selected = minutes == option,
+                    onClick = { SleepTimer.set(option) },
+                )
+            }
+        }
+        Text(
+            text = if (minutes <= 0) "Playback keeps going." else "Playback pauses in $minutes minutes.",
+            color = Color.White.copy(alpha = 0.7f),
+            fontSize = 13.sp,
+        )
+    }
+}
