+internal data class DiscordPlaybackInfo(
+    val title: String,
+    val subtitle: String? = null,
+    val artworkUrl: String? = null,
+    val isPlaying: Boolean = false,
+    val isLoading: Boolean = false,
+    val positionMs: Long = 0L,
