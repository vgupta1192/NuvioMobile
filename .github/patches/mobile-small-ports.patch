+                        .map { video ->
+                            val score = video.ratingMapScore(episodeRatings)
+                            RatingMapCell(
+                                video = video,
+                                season = season,
+                                episode = video.episode ?: 0,
+                                rating = score?.first,
+                                source = score?.second,
