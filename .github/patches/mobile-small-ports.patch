+    if (!episodeRatingsVisibility.showRatings) return
+
+    val seasons: List<RatingMapSeason> = remember(meta.videos, episodeRatings, episodeRatingsVisibility, isEpisodeWatched) {
+        meta.groupedEpisodesForDisplay()
+            .filterKeys { it > SPECIALS_SEASON_NUMBER }
+            .toList()
+            .sortedBy { it.first }
+            .map { (season, episodes) ->
+                RatingMapSeason(
+                    number = season,
+                    cells = episodes
+                        .filter { it.episode != null }
