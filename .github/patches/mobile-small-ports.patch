+package com.nuvio.app.features.settings
+
+import androidx.compose.material3.AlertDialog
+import androidx.compose.material3.Text
+import androidx.compose.material3.TextButton
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.setValue
+import coil3.SingletonImageLoader
+import coil3.compose.LocalPlatformContext
+
+private val forkChanges = listOf(
+    "Native seek-bar thumbnails and a shared thumbnail cache",
+    "CloudStream plugins (.cs3) in the full build",
+    "Sleep timer, swipe to seek, subtitles start off, subtitle shadow",
+    "Home rows: Up next tonight, Airing this week, Finish a series",
+    "Episode rating map on series pages (needs episode ratings on)",
+    "Nuvio Read card for the series overview",
+    "TheIntroDB skip segments when no IntroDB address is set",
+    "Discord presence (Settings > Content discovery > Discord)",
+    "Calendar weeks start on Monday, DNS over HTTPS option",
+)
+
+@Composable
+internal fun ForkAboutSettingsSection(isTablet: Boolean) {
+    var showNews by remember { mutableStateOf(false) }
+    var cacheMessage by remember { mutableStateOf<String?>(null) }
+    val context = LocalPlatformContext.current
+    SettingsSection(title = "Performance and fork news", isTablet = isTablet) {
+        SettingsGroup(isTablet = isTablet) {
+            SettingsNavigationRow(
+                title = "Clear image cache",
+                description = cacheMessage ?: "Free space used by posters and backdrops. They load again when needed.",
+                isTablet = isTablet,
+                onClick = {
+                    val loader = SingletonImageLoader.get(context)
+                    runCatching { loader.memoryCache?.clear() }
+                    runCatching { loader.diskCache?.clear() }
+                    cacheMessage = "Image cache cleared"
+                },
+            )
+            SettingsGroupDivider(isTablet = isTablet)
+            SettingsNavigationRow(
+                title = "What's new in this build",
+                description = "Features added by this fork",
+                isTablet = isTablet,
+                onClick = { showNews = true },
+            )
+        }
+    }
+    if (showNews) {
+        AlertDialog(
+            onDismissRequest = { showNews = false },
+            confirmButton = { TextButton(onClick = { showNews = false }) { Text("Close") } },
+            title = { Text("What's new") },
+            text = { Text(forkChanges.joinToString("\n") { "- $it" }) },
+        )
+    }
+}
