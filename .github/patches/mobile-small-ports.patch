+package com.nuvio.app.features.player
+
+import com.nuvio.app.core.storage.AppFileCache
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+data class ForkToolbarButton(val id: String, val label: String)
+
+data class ForkToolbarEntry(val id: String, val visible: Boolean)
+
+object ForkPlayerToolbar {
+    val buttons: List<ForkToolbarButton> = listOf(
+        ForkToolbarButton("next_episode", "Next episode"),
+        ForkToolbarButton("subtitles", "Subtitles"),
+        ForkToolbarButton("audio", "Audio"),
+        ForkToolbarButton("chapters", "Chapters"),
+        ForkToolbarButton("sources", "Sources"),
+        ForkToolbarButton("episodes", "Episodes"),
+        ForkToolbarButton("quality", "Quality"),
+        ForkToolbarButton("rate", "Rate"),
+        ForkToolbarButton("speed", "Speed"),
+        ForkToolbarButton("resize", "Resize"),
+        ForkToolbarButton("external_player", "Open in external player"),
+        ForkToolbarButton("playback_info", "Stream info"),
+        ForkToolbarButton("video_settings", "Video settings"),
+        ForkToolbarButton("submit_intro", "Submit intro"),
+    )
+
+    private const val PATH = "settings/player_toolbar"
+    private val default = buttons.map { ForkToolbarEntry(it.id, true) }
+    private val _entries = MutableStateFlow(default)
+    val entries: StateFlow<List<ForkToolbarEntry>> = _entries.asStateFlow()
+    private var loaded = false
+
+    fun ensureLoaded() {
+        if (loaded) return
+        loaded = true
+        val stored = runCatching { AppFileCache.read(PATH)?.trim() }.getOrNull()
+        if (!stored.isNullOrBlank()) _entries.value = decode(stored)
+    }
+
+    private fun decode(value: String): List<ForkToolbarEntry> {
+        val known = buttons.map { it.id }.toSet()
+        val parsed = value.split(',').mapNotNull { token ->
+            val id = token.substringBefore(':').trim()
+            if (id !in known) return@mapNotNull null
+            ForkToolbarEntry(id, token.substringAfter(':', "v").trim() != "h")
+        }.distinctBy { it.id }
+        val missing = default.filter { d -> parsed.none { it.id == d.id } }
+        return parsed + missing
+    }
+
+    private fun save(list: List<ForkToolbarEntry>) {
+        _entries.value = list
+        runCatching {
+            AppFileCache.write(PATH, list.joinToString(",") { "${it.id}:${if (it.visible) "v" else "h"}" })
+        }
+    }
+
+    fun setVisible(id: String, visible: Boolean) {
+        ensureLoaded()
+        save(_entries.value.map { if (it.id == id) it.copy(visible = visible) else it })
+    }
+
+    fun move(id: String, delta: Int) {
+        ensureLoaded()
+        val list = _entries.value.toMutableList()
+        val from = list.indexOfFirst { it.id == id }
+        val to = from + delta
+        if (from < 0 || to !in list.indices) return
+        list.add(to, list.removeAt(from))
+        save(list)
+    }
+
+    fun reset() {
+        ensureLoaded()
+        save(default)
+    }
+}
