+package com.nuvio.app.features.settings
+
+import com.nuvio.app.core.storage.AppFileCache
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+/** Small on/off setting kept in the app file cache, shared by several fork features. */
+class ForkBoolPref(private val path: String, private val default: Boolean) {
+    private val _value = MutableStateFlow(default)
+    val value: StateFlow<Boolean> = _value.asStateFlow()
+    private var loaded = false
+
+    fun ensureLoaded() {
+        if (loaded) return
+        loaded = true
+        val stored = runCatching { AppFileCache.read(path)?.trim() }.getOrNull()
+        if (stored == "1") _value.value = true else if (stored == "0") _value.value = false
+    }
+
+    fun current(): Boolean {
+        ensureLoaded()
+        return _value.value
+    }
+
+    fun set(enabled: Boolean) {
+        ensureLoaded()
+        _value.value = enabled
+        runCatching { AppFileCache.write(path, if (enabled) "1" else "0") }
+    }
+}
+
+object ForkPrefs {
+    val swipeToSeek = ForkBoolPref("settings/swipe_to_seek", true)
+    val homeUpNextTonight = ForkBoolPref("settings/home_up_next_tonight", true)
+    val homeAiringWeek = ForkBoolPref("settings/home_airing_week", true)
+    val homeFinishSeries = ForkBoolPref("settings/home_finish_series", true)
+    val subtitleShadow = ForkBoolPref("settings/subtitle_shadow", false)
+    val subtitlesStartOff = ForkBoolPref("settings/subtitles_start_off", false)
+}
