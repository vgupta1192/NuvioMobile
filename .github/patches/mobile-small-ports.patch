+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.flow.flowOn
+import kotlinx.coroutines.withTimeoutOrNull
+
+private fun LibraryItem.toForkPreview() = MetaPreview(
+    id = id,
+    type = type,
+    name = name,
+    poster = poster,
+    banner = banner,
+    logo = logo,
+    posterShape = posterShape,
+    description = description,
+    releaseInfo = releaseInfo,
+    imdbRating = imdbRating,
+    genres = genres,
+    rawPosterUrl = rawPosterUrl,
+    landscapePoster = landscapePoster,
+)
+
+private fun forkSection(key: String, title: String, items: List<MetaPreview>) = HomeCatalogSection(
+    key = key,
+    title = title,
+    subtitle = "",
+    addonName = "",
+    target = CatalogTarget.Library(contentType = "series", sectionType = key),
+    items = items,
+)
+
+/** Extra Home rows built from the saved library: up next tonight, airing this week, finish a series. */
+@Composable
+internal fun ForkHomeLibraryRows(
+    sectionPadding: Dp,
+    onPosterClick: ((MetaPreview) -> Unit)?,
+) {
+    LaunchedEffect(Unit) {
+        ForkPrefs.homeUpNextTonight.ensureLoaded()
+        ForkPrefs.homeAiringWeek.ensureLoaded()
+        ForkPrefs.homeFinishSeries.ensureLoaded()
+    }
+    val showTonight by ForkPrefs.homeUpNextTonight.value.collectAsStateWithLifecycle()
+    val showWeek by ForkPrefs.homeAiringWeek.value.collectAsStateWithLifecycle()
+    val showFinish by ForkPrefs.homeFinishSeries.value.collectAsStateWithLifecycle()
+    val libraryState by LibraryRepository.uiState.collectAsStateWithLifecycle()
+    val progress by WatchProgressRepository.uiState.collectAsStateWithLifecycle()
+    val profileId = ProfileRepository.activeProfileId
+
+    var tonight by remember { mutableStateOf<List<MetaPreview>>(emptyList()) }
+    var week by remember { mutableStateOf<List<MetaPreview>>(emptyList()) }
+    var finish by remember { mutableStateOf<List<MetaPreview>>(emptyList()) }
+
+    val seriesItems = libraryState.items.filter { it.type.trim().lowercase() in setOf("series", "show", "tv") }
+
+    LaunchedEffect(seriesItems.map { it.id }, profileId, showTonight, showWeek) {
+        if (!showTonight && !showWeek) {
+            tonight = emptyList()
+            week = emptyList()
+            return@LaunchedEffect
+        }
+        if (seriesItems.isEmpty()) return@LaunchedEffect
+        loadLibraryCalendar(seriesItems, profileId).flowOn(Dispatchers.Default).collect { snapshot ->
+            val today = CurrentDateProvider.todayIsoDate()
+            val events = snapshot.eventsByDate.values.flatten().filter { it.key.startsWith("episode:") }
+            val dayOffsets = events.mapNotNull { event ->
+                daysUntilEpisodeRelease(today, event.rawReleaseInfo)?.let { event to it }
+            }
+            tonight = dayOffsets.filter { it.second == 0 }
+                .map { it.first.item }.distinctBy { it.id }.map { it.toForkPreview() }
+            week = dayOffsets.filter { it.second in 1..7 }
+                .sortedBy { it.second }
+                .map { it.first.item }.distinctBy { it.id }.map { it.toForkPreview() }
+        }
+    }
+
+    LaunchedEffect(progress.entries.size, showFinish) {
+        if (!showFinish) {
+            finish = emptyList()
+            return@LaunchedEffect
+        }
+        val completedBySeries = progress.entries
+            .filter { it.isCompleted && it.seasonNumber != null && it.episodeNumber != null && it.seasonNumber > 0 }
+            .groupBy { it.parentMetaId }
+            .mapValues { (_, list) -> list.map { it.seasonNumber to it.episodeNumber }.toSet().size }
+        val lastTouch = progress.entries.groupBy { it.parentMetaId }.mapValues { (_, list) -> list.maxOf { it.lastUpdatedEpochMs } }
+        val candidates = completedBySeries.entries
+            .filter { it.value >= 3 }
+            .sortedByDescending { lastTouch[it.key] ?: 0L }
+            .take(12)
+        val result = mutableListOf<MetaPreview>()
+        for ((seriesId, watchedCount) in candidates) {
+            val entry = progress.entries.firstOrNull { it.parentMetaId == seriesId } ?: continue
+            val meta = withTimeoutOrNull(15_000L) {
+                runCatching { MetaDetailsRepository.fetch(entry.parentMetaType, seriesId) }.getOrNull()
+            } ?: continue
+            val today = CurrentDateProvider.todayIsoDate()
+            val aired = meta.videos.count { video ->
+                (video.season ?: 0) > 0 && (video.episode ?: 0) > 0 &&
+                    (daysUntilEpisodeRelease(today, video.released)?.let { it <= 0 } ?: false)
+            }
+            if (aired == 0) continue
+            val ratio = watchedCount.toFloat() / aired.toFloat()
+            if (ratio >= 0.6f && ratio < 1f) {
+                result += MetaPreview(
+                    id = seriesId,
+                    type = entry.parentMetaType,
+                    name = meta.name,
+                    poster = meta.poster ?: entry.poster,
+                    banner = meta.background ?: entry.background,
+                    logo = meta.logo ?: entry.logo,
+                )
+                finish = result.toList()
+            }
+        }
+        finish = result.toList()
+    }
+
+    if (showTonight && tonight.isNotEmpty()) {
+        HomeCatalogRowSection(
+            section = forkSection("fork_up_next_tonight", "Up next tonight", tonight),
+            modifier = Modifier.padding(bottom = 12.dp),
+            sectionPadding = sectionPadding,
+            onPosterClick = onPosterClick,
+        )
+    }
+    if (showWeek && week.isNotEmpty()) {
+        HomeCatalogRowSection(
+            section = forkSection("fork_airing_week", "Airing this week", week),
+            modifier = Modifier.padding(bottom = 12.dp),
+            sectionPadding = sectionPadding,
+            onPosterClick = onPosterClick,
+        )
+    }
+    if (showFinish && finish.isNotEmpty()) {
+        HomeCatalogRowSection(
+            section = forkSection("fork_finish_series", "Finish a series", finish),
+            modifier = Modifier.padding(bottom = 12.dp),
+            sectionPadding = sectionPadding,
+            onPosterClick = onPosterClick,
+        )
+    }
+}
