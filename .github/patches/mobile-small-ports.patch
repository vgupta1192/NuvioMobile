+
+private data class FillerResult(val filler: List<Int>, val recap: List<Int>)
+
+private val fillerJson = Json { ignoreUnknownKeys = true; isLenient = true }
+private val fillerCache = mutableMapOf<String, FillerResult?>()
+
+internal fun MetaDetails.isFillerGuideCandidate(): Boolean {
+    if (type == "movie") return false
+    return genres.any { it.equals("Anime", ignoreCase = true) || it.equals("Animation", ignoreCase = true) }
+}
+
+private fun encodeQuery(text: String): String = buildString {
+    text.encodeToByteArray().forEach { b ->
+        val c = b.toInt() and 0xFF
+        if (c in 'a'.code..'z'.code || c in 'A'.code..'Z'.code || c in '0'.code..'9'.code) append(c.toChar())
+        else append('%').append("0123456789ABCDEF"[c shr 4]).append("0123456789ABCDEF"[c and 15])
+    }
+}
+
+private suspend fun loadFiller(title: String): FillerResult? {
+    if (fillerCache.containsKey(title)) return fillerCache[title]
+    val result = try {
+        val search = fillerJson.parseToJsonElement(
+            httpGetText("https://api.jikan.moe/v4/anime?q=${encodeQuery(title)}&limit=1&type=tv"),
+        ).jsonObject["data"]?.jsonArray?.firstOrNull()?.jsonObject
+        val malId = search?.get("mal_id")?.jsonPrimitive?.intOrNull
+        if (malId == null) {
+            null
+        } else {
+            val filler = mutableListOf<Int>()
+            val recap = mutableListOf<Int>()
+            var page = 1
+            while (page <= 12) {
+                if (page > 1) delay(400)
+                val root = fillerJson.parseToJsonElement(
+                    httpGetText("https://api.jikan.moe/v4/anime/$malId/episodes?page=$page"),
+                ).jsonObject
+                root["data"]?.jsonArray?.forEach { element ->
+                    val ep: JsonObject = element.jsonObject
+                    val number = ep["mal_id"]?.jsonPrimitive?.intOrNull ?: return@forEach
+                    if (ep["filler"]?.jsonPrimitive?.booleanOrNull == true) filler += number
+                    if (ep["recap"]?.jsonPrimitive?.booleanOrNull == true) recap += number
+                }
+                val hasNext = root["pagination"]?.jsonObject?.get("has_next_page")?.jsonPrimitive?.booleanOrNull == true
+                if (!hasNext) break
+                page++
+            }
+            FillerResult(filler, recap)
+        }
+    } catch (cancelled: CancellationException) {
+        throw cancelled
+    } catch (_: Exception) {
+        null
+    }
+    fillerCache[title] = result
+    return result
+}
+
+private fun List<Int>.asRanges(): String {
+    if (isEmpty()) return "none"
+    val sorted = distinct().sorted()
+    val parts = mutableListOf<String>()
+    var start = sorted.first()
+    var prev = start
+    for (n in sorted.drop(1)) {
+        if (n == prev + 1) {
+            prev = n
+            continue
+        }
+        parts += if (start == prev) "$start" else "$start-$prev"
+        start = n
+        prev = n
+    }
+    parts += if (start == prev) "$start" else "$start-$prev"
+    return parts.joinToString(", ")
+}
+
+@Composable
+internal fun DetailFillerGuide(meta: MetaDetails, modifier: Modifier = Modifier) {
+    var state by remember(meta.id) { mutableStateOf<FillerResult?>(null) }
+    var done by remember(meta.id) { mutableStateOf(false) }
+    LaunchedEffect(meta.id) {
+        state = loadFiller(meta.name)
+        done = true
+    }
+    val result = state
+    if (!done || result == null || (result.filler.isEmpty() && result.recap.isEmpty())) return
+    Column(
+        modifier = modifier.fillMaxWidth(),
+        verticalArrangement = Arrangement.spacedBy(6.dp),
+    ) {
+        Text(
+            text = "Filler guide",
+            style = MaterialTheme.typography.titleMedium,
+            color = MaterialTheme.colorScheme.onSurface,
+        )
+        Text(
+            text = "Filler episodes: ${result.filler.asRanges()}",
+            style = MaterialTheme.typography.bodyMedium,
+            color = MaterialTheme.colorScheme.onSurface,
+        )
+        if (result.recap.isNotEmpty()) {
+            Text(
+                text = "Recap episodes: ${result.recap.asRanges()}",
+                style = MaterialTheme.typography.bodyMedium,
+                color = MaterialTheme.colorScheme.onSurfaceVariant,
+            )
+        }
+        Text(
+            text = "Numbers follow MyAnimeList and count from the first episode of the show.",
+            style = MaterialTheme.typography.bodySmall,
+            color = MaterialTheme.colorScheme.onSurfaceVariant,
+        )
+    }
+}
