+    val provider by DohSetting.provider.collectAsStateWithLifecycle()
+    var show by remember { mutableStateOf(false) }
+    SettingsNavigationRow(
+        title = "DNS over HTTPS",
+        description = provider.label + if (provider == DohProvider.OFF) "" else " (applies to new connections)",
+        isTablet = isTablet,
+        onClick = { show = true },
+    )
+    if (show) {
+        DialogSurface(onDismissRequest = { show = false }, title = "DNS over HTTPS") {
+            DohProvider.entries.forEach { option ->
+                DialogOption(
+                    text = option.label,
+                    description = option.description,
+                    selected = provider == option,
+                    onClick = {
+                        DohSetting.set(option)
+                        show = false
+                    },
+                    modifier = Modifier.fillMaxWidth(),
+                )
+            }
+            DialogButtons {
+                DialogButton(text = "Done", onClick = { show = false })
+            }
+        }
+    }
+}
