+package com.nuvio.app.features.details
+
+import com.nuvio.app.core.storage.AppFileCache
+import com.nuvio.app.features.addons.httpGetText
+import kotlinx.coroutines.CancellationException
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.doubleOrNull
+import kotlinx.serialization.json.intOrNull
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+
+/** Fallback episode ratings from OMDb, used only when the user saved an OMDb key in settings. */
+object OmdbEpisodeRatings {
+    private const val KEY_PATH = "settings/omdb_key"
+    private val json = Json { ignoreUnknownKeys = true; isLenient = true }
+    private val cache = mutableMapOf<String, Map<Pair<Int, Int>, Double>>()
+
+    fun savedKey(): String = runCatching { AppFileCache.read(KEY_PATH)?.trim() }.getOrNull().orEmpty()
+
+    fun saveKey(key: String) {
+        runCatching { AppFileCache.write(KEY_PATH, key.trim()) }
+    }
+
+    suspend fun load(imdbId: String, seasons: List<Int>): Map<Pair<Int, Int>, Double> {
+        val key = savedKey()
+        if (key.isBlank() || seasons.isEmpty()) return emptyMap()
+        val cacheKey = "$imdbId:${seasons.sorted().joinToString(",")}"
+        cache[cacheKey]?.let { return it }
+        val out = mutableMapOf<Pair<Int, Int>, Double>()
+        for (season in seasons.distinct().sorted().take(40)) {
+            try {
+                val root = json.parseToJsonElement(
+                    httpGetText("https://www.omdbapi.com/?i=$imdbId&Season=$season&apikey=$key"),
+                ).jsonObject
+                root["Episodes"]?.jsonArray?.forEach { element ->
+                    val ep = element.jsonObject
+                    val number = ep["Episode"]?.jsonPrimitive?.intOrNull ?: return@forEach
+                    val rating = ep["imdbRating"]?.jsonPrimitive?.doubleOrNull ?: return@forEach
+                    if (rating > 0.0) out[season to number] = rating
+                }
+            } catch (cancelled: CancellationException) {
+                throw cancelled
+            } catch (_: Exception) {
+            }
+        }
+        if (out.isNotEmpty()) cache[cacheKey] = out
+        return out
+    }
+}
