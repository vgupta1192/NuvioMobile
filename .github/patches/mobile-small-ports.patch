-}
\ No newline at end of file
+
+    private fun resolveWithDoh(hostname: String): List<InetAddress>? {
+        val provider = DohSetting.current()
+        val endpoint = provider.endpoint ?: return null
+        if (hostname == "localhost" || hostname.all { it.isDigit() || it == '.' || it == ':' }) return null
+        val key = provider.id + "|" + hostname
+        val now = System.currentTimeMillis()
+        cache[key]?.let { (expires, list) -> if (expires > now) return list }
+        val result = runCatching { query(endpoint, hostname) }.getOrNull()
+        if (result.isNullOrEmpty()) return null
+        cache[key] = (now + CACHE_MS) to result
+        return result
+    }
+
+    private fun query(endpoint: String, hostname: String): List<InetAddress> {
+        val url = URL("$endpoint?name=${URLEncoder.encode(hostname, "UTF-8")}&type=A")
+        val connection = (url.openConnection() as HttpURLConnection).apply {
+            connectTimeout = 3_000
+            readTimeout = 3_000
+            setRequestProperty("accept", "application/dns-json")
+        }
+        try {
+            if (connection.responseCode != 200) return emptyList()
+            val body = connection.inputStream.bufferedReader().use { it.readText() }
+            val out = ArrayList<InetAddress>()
+            ANSWER_REGEX.findAll(body).forEach { match ->
+                val type = match.groupValues[1].toInt()
+                val data = match.groupValues[2]
+                if (type == 1) out += InetAddress.getByName(data)
+            }
+            return out
+        } finally {
+            connection.disconnect()
+        }
+    }
+
+    private companion object {
+        const val CACHE_MS = 5 * 60_000L
+        val cache = ConcurrentHashMap<String, Pair<Long, List<InetAddress>>>()
+        val ANSWER_REGEX = Regex("\"type\"\\s*:\\s*(\\d+)[^}]*?\"data\"\\s*:\\s*\"([^\"]+)\"")
+    }
+}
