+package com.nuvio.app.core.network
+
+import com.nuvio.app.core.storage.AppFileCache
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+/** Fork feature: resolve host names through DNS over HTTPS instead of the system resolver. */
+enum class DohProvider(val id: String, val label: String, val description: String, val endpoint: String?) {
+    OFF("off", "System DNS", "Use the DNS your network gives you.", null),
+    CLOUDFLARE("cloudflare", "Cloudflare", "1.1.1.1, fast and private.", "https://1.1.1.1/dns-query"),
+    GOOGLE("google", "Google", "8.8.8.8, works on most networks.", "https://8.8.8.8/resolve"),
+}
+
+object DohSetting {
+    private const val PATH = "settings/doh_provider"
+    private val _provider = MutableStateFlow(DohProvider.OFF)
+    val provider: StateFlow<DohProvider> = _provider.asStateFlow()
+    private var loaded = false
+
+    fun ensureLoaded() {
+        if (loaded) return
+        loaded = true
+        val id = runCatching { AppFileCache.read(PATH)?.trim() }.getOrNull()
+        _provider.value = DohProvider.entries.firstOrNull { it.id == id } ?: DohProvider.OFF
+    }
+
+    fun current(): DohProvider {
+        ensureLoaded()
+        return _provider.value
+    }
+
+    fun set(provider: DohProvider) {
+        ensureLoaded()
+        _provider.value = provider
+        runCatching { AppFileCache.write(PATH, provider.id) }
+    }
+}
