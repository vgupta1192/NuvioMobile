@@ -0,0 +1,310 @@
+package com.nuvio.app.features.player
+
+import com.nuvio.app.core.build.AppFeaturePolicy
+import com.nuvio.app.core.build.TrailerPlaybackMode
+import com.nuvio.app.features.addons.httpGetTextWithHeaders
+import com.nuvio.app.features.addons.httpPostJsonWithHeaders
+import kotlinx.coroutines.withTimeoutOrNull
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonArray
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.contentOrNull
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import kotlinx.serialization.json.put
+
+/**
+ * Nuvio fork: the subtitles YouTube itself has for a YouStream video. YouStream cannot send
+ * them (YouTube refuses its server), so the device asks YouTube the same way it resolves the
+ * video, and lists the caption tracks like any add-on subtitles. Only tracks whose text really
+ * downloads as WebVTT or SRT are listed, so the player and AutoSync can read them as they are.
+ */
+internal object YouTubeCaptions {
+    private const val ID_PREFIX = "youstream:"
+    private const val TIMEOUT_MS = 25_000L
+    private const val MAX_TRACKS = 8
+    private val VIDEO_ID = Regex("^[A-Za-z0-9_-]{11}$")
+    private val API_KEY = Regex("\"INNERTUBE_API_KEY\":\"([^\"]+)\"")
+    private val VISITOR_DATA = Regex("\"visitorData\":\"([^\"]+)\"")
+    private val FORMAT_PARAM = Regex("[?&]fmt=[^&]*")
+    private val json = Json { ignoreUnknownKeys = true }
+
+    private class Client(
+        val name: String,
+        val id: String,
+        val version: String,
+        val userAgent: String,
+        val context: JsonObject,
+    )
+
+    private val CLIENTS = listOf(
+        Client(
+            name = "ANDROID",
+            id = "3",
+            version = "20.10.35",
+            userAgent = "com.google.android.youtube/20.10.35 (Linux; U; Android 14; en_US) gzip",
+            context = buildJsonObject {
+                put("clientName", "ANDROID")
+                put("clientVersion", "20.10.35")
+                put("osName", "Android")
+                put("osVersion", "14")
+                put("platform", "MOBILE")
+                put("androidSdkVersion", 34)
+                put("hl", "en")
+                put("gl", "US")
+            },
+        ),
+        Client(
+            name = "IOS",
+            id = "5",
+            version = "20.10.1",
+            userAgent = "com.google.ios.youtube/20.10.1 (iPhone16,2; U; CPU iOS 17_4 like Mac OS X)",
+            context = buildJsonObject {
+                put("clientName", "IOS")
+                put("clientVersion", "20.10.1")
+                put("deviceModel", "iPhone16,2")
+                put("osName", "iPhone")
+                put("osVersion", "17.4.0.21E219")
+                put("platform", "MOBILE")
+                put("hl", "en")
+                put("gl", "US")
+            },
+        ),
+    )
+
+    private val EXTRA_CLIENTS = listOf(
+        Client(
+            name = "TVHTML5",
+            id = "7",
+            version = "7.20250219.14.00",
+            userAgent = "Mozilla/5.0 (ChromiumStylePlatform) Cobalt/Version",
+            context = buildJsonObject {
+                put("clientName", "TVHTML5")
+                put("clientVersion", "7.20250219.14.00")
+                put("hl", "en")
+                put("gl", "US")
+            },
+        ),
+        Client(
+            name = "WEB_EMBEDDED",
+            id = "56",
+            version = "1.20250310.01.00",
+            userAgent = "Mozilla/5.0 (Linux; Android 14) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Mobile Safari/537.36",
+            context = buildJsonObject {
+                put("clientName", "WEB_EMBEDDED_PLAYER")
+                put("clientVersion", "1.20250310.01.00")
+                put("hl", "en")
+                put("gl", "US")
+            },
+        ),
+        Client(
+            name = "MWEB",
+            id = "2",
+            version = "2.20250310.01.00",
+            userAgent = "Mozilla/5.0 (Linux; Android 14) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Mobile Safari/537.36",
+            context = buildJsonObject {
+                put("clientName", "MWEB")
+                put("clientVersion", "2.20250310.01.00")
+                put("hl", "en")
+                put("gl", "US")
+            },
+        ),
+    )
+
+    private class Track(val languageCode: String, val label: String, val baseUrl: String)
+
+    /** The YouTube video id of a YouStream video id, when captions can be asked for it here. */
+    fun videoIdOrNull(videoId: String): String? {
+        if (AppFeaturePolicy.trailerPlaybackMode != TrailerPlaybackMode.IN_APP) return null
+        return videoId.takeIf { it.startsWith(ID_PREFIX) }
+            ?.removePrefix(ID_PREFIX)
+            ?.substringBefore(':')
+            ?.takeIf { VIDEO_ID.matches(it) }
+    }
+
+    /** Whether [url] is one of the caption tracks listed here (YouTube's own timing: AutoSync has nothing to fix). */
+    fun isCaptionUrl(url: String): Boolean =
+        url.substringAfter("://", "").substringBefore('/').endsWith("youtube.com") && "/api/timedtext" in url
+
+    suspend fun fetch(youtubeId: String): List<AddonSubtitle> = try {
+        SyncedSubtitles.log("youtube captions: asking for $youtubeId")
+        withTimeoutOrNull(TIMEOUT_MS) { load(youtubeId) }
+            ?: run {
+                SyncedSubtitles.log("youtube captions: gave up after ${TIMEOUT_MS / 1000} s for $youtubeId")
+                emptyList()
+            }
+    } catch (error: kotlinx.coroutines.CancellationException) {
+        throw error
+    } catch (error: Exception) {
+        SyncedSubtitles.log("youtube captions: failed ${error::class.simpleName}: ${error.message}")
+        emptyList()
+    }
+
+    private suspend fun load(youtubeId: String): List<AddonSubtitle> {
+        val watch = runCatching {
+            httpGetTextWithHeaders(
+                url = "https://www.youtube.com/watch?v=$youtubeId&hl=en",
+                headers = mapOf(
+                    "Accept" to "text/html,*/*",
+                    "Accept-Language" to "en-US,en;q=0.9",
+                    "User-Agent" to "Mozilla/5.0 (Linux; Android 14) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Mobile Safari/537.36",
+                ),
+            )
+        }.onFailure { SyncedSubtitles.log("youtube captions: watch page failed: ${it.message}") }.getOrNull().orEmpty()
+        val apiKey = API_KEY.find(watch)?.groupValues?.get(1)
+        val visitorData = VISITOR_DATA.find(watch)?.groupValues?.get(1)
+        SyncedSubtitles.log("youtube captions: watch page ${watch.length} chars, key ${apiKey != null}, visitor ${visitorData != null}")
+        // Each source (the watch page, then each YouTube client) is probed with its first track; the first
+        // source whose track really downloads as vtt or srt wins, because the others may need a token.
+        val sources: List<Client?> = listOf(null) + CLIENTS + EXTRA_CLIENTS
+        var anyTracks = false
+        for (client in sources) {
+            val name = client?.name ?: "watch page"
+            val tracks = runCatching {
+                if (client == null) pageTracks(watch) else playerTracks(youtubeId, client, apiKey, visitorData)
+            }
+                .onFailure { SyncedSubtitles.log("youtube captions: $name failed: ${it.message}") }
+                .getOrNull().orEmpty()
+            if (tracks.isEmpty()) {
+                SyncedSubtitles.log("youtube captions: $name offers no tracks")
+                continue
+            }
+            anyTracks = true
+            val urls = mutableListOf<Pair<Track, String>>()
+            for (track in tracks.take(MAX_TRACKS)) {
+                val url = readableUrl(name, track)
+                if (url != null) urls += track to url
+                else if (urls.isEmpty()) break
+            }
+            if (urls.isEmpty()) {
+                SyncedSubtitles.log("youtube captions: $name tracks would not download as vtt or srt")
+                continue
+            }
+            SyncedSubtitles.log("youtube captions: $name gives ${urls.size} of ${tracks.size} tracks for $youtubeId")
+            return urls.mapIndexed { index, (track, url) ->
+                AddonSubtitle(
+                    id = "youtube_${youtubeId}_${track.languageCode}_$index",
+                    url = url,
+                    language = normalizeLanguageCode(track.languageCode) ?: track.languageCode,
+                    display = "${track.label} · YouTube",
+                    addonName = "YouTube",
+                )
+            }
+        }
+        SyncedSubtitles.log(
+            if (anyTracks) "youtube captions: tracks found but none downloads for $youtubeId"
+            else "youtube captions: none offered for $youtubeId",
+        )
+        return emptyList()
+    }
+
+    /** The caption tracks inside the watch page's own player response. */
+    private fun pageTracks(watch: String): List<Track> {
+        val start = watch.indexOf("\"captionTracks\":")
+        if (start < 0) return emptyList()
+        val open = watch.indexOf('[', start)
+        if (open < 0) return emptyList()
+        var depth = 0
+        var index = open
+        var inString = false
+        while (index < watch.length) {
+            val c = watch[index]
+            if (inString) {
+                if (c == '\\') index++ else if (c == '"') inString = false
+            } else when (c) {
+                '"' -> inString = true
+                '[' -> depth++
+                ']' -> { depth--; if (depth == 0) break }
+            }
+            index++
+        }
+        if (depth != 0) return emptyList()
+        val list = json.parseToJsonElement(watch.substring(open, index + 1)) as? JsonArray ?: return emptyList()
+        return tracksFrom(list)
+    }
+
+    private suspend fun playerTracks(
+        youtubeId: String,
+        client: Client,
+        apiKey: String?,
+        visitorData: String?,
+    ): List<Track> {
+        val endpoint = "https://www.youtube.com/youtubei/v1/player" + (apiKey?.let { "?key=$it" } ?: "")
+        val headers = buildMap {
+            put("Accept", "application/json")
+            put("Origin", "https://www.youtube.com")
+            put("User-Agent", client.userAgent)
+            put("X-YouTube-Client-Name", client.id)
+            put("X-YouTube-Client-Version", client.version)
+            if (!visitorData.isNullOrBlank()) put("X-Goog-Visitor-Id", visitorData)
+        }
+        val body = buildJsonObject {
+            put("videoId", youtubeId)
+            put("contentCheckOk", true)
+            put("racyCheckOk", true)
+            put("context", buildJsonObject { put("client", client.context) })
+        }.toString()
+        val response = json.parseToJsonElement(httpPostJsonWithHeaders(endpoint, body, headers)).jsonObject
+        val status = response["playabilityStatus"]?.jsonObject
+        SyncedSubtitles.log(
+            "youtube captions: ${client.name} ${status?.get("status")?.jsonPrimitive?.contentOrNull} " +
+                (status?.get("reason")?.jsonPrimitive?.contentOrNull.orEmpty()),
+        )
+        val list = response["captions"]?.jsonObject
+            ?.get("playerCaptionsTracklistRenderer")?.jsonObject
+            ?.get("captionTracks") as? JsonArray
+            ?: return emptyList()
+        return tracksFrom(list)
+    }
+
+    private fun tracksFrom(list: JsonArray): List<Track> {
+        return list.mapNotNull { element ->
+            val track = element as? JsonObject ?: return@mapNotNull null
+            val baseUrl = track["baseUrl"]?.jsonPrimitive?.contentOrNull?.takeIf { it.isNotBlank() }
+                ?: return@mapNotNull null
+                .let { if (it.startsWith("/")) "https://www.youtube.com$it" else it }
+            val code = track["languageCode"]?.jsonPrimitive?.contentOrNull?.takeIf { it.isNotBlank() }
+                ?: return@mapNotNull null
+            val name = track["name"]?.jsonObject
+            val label = name?.get("simpleText")?.jsonPrimitive?.contentOrNull
+                ?: name?.get("runs")?.jsonArray?.firstOrNull()?.jsonObject?.get("text")?.jsonPrimitive?.contentOrNull
+                ?: code
+            Track(code, label, baseUrl)
+        }
+    }
+
+    /** The track's address in a format the player reads as it is, or null when neither downloads. */
+    private suspend fun readableUrl(source: String, track: Track): String? {
+        // SRT first: YouTube's auto-generated WebVTT carries cue settings (align:start position:0%) that
+        // the player obeys, which pins the text to the left edge.
+        val srt = withFormat(track.baseUrl, "srt")
+        if (download(source, track, srt)?.let(::isSrt) == true) return srt
+        val vtt = withFormat(track.baseUrl, "vtt")
+        if (download(source, track, vtt)?.let(::isVtt) == true) return vtt
+        return null
+    }
+
+    private fun withFormat(baseUrl: String, format: String): String {
+        val cleaned = FORMAT_PARAM.replace(baseUrl) { if (it.value.startsWith("?")) "?" else "" }
+            .replace("?&", "?")
+            .trimEnd('?')
+        return cleaned + (if ('?' in cleaned) "&" else "?") + "fmt=$format"
+    }
+
+    private suspend fun download(source: String, track: Track, url: String): String? = runCatching {
+        httpGetTextWithHeaders(url = url, headers = mapOf("Accept" to "*/*"))
+    }.onSuccess {
+        SyncedSubtitles.log(
+            "youtube captions: $source ${track.languageCode} ${url.substringAfterLast("fmt=")} -> ${it.length} chars " +
+                it.take(40).replace('\n', ' '),
+        )
+    }.onFailure {
+        SyncedSubtitles.log("youtube captions: $source ${track.languageCode} download failed: ${it.message}")
+    }.getOrNull()
+
+    private fun isVtt(text: String) = text.trimStart('﻿', ' ', '\r', '\n', '\t').startsWith("WEBVTT") && "-->" in text
+
+    private fun isSrt(text: String) = "-->" in text && !text.trimStart().startsWith("<")
+}
