+/** TMDB / Trakt / Simkl episode rating with the service logo, same look as the addon detail episode cards. */
+@Composable
+private fun JellyfinEpisodeSourceBadge(label: String, value: Double) {
+    val logo = when (label) {
+        "TMDB" -> Res.drawable.rating_tmdb
+        "Trakt" -> Res.drawable.rating_trakt
+        "Simkl" -> Res.drawable.simkl_logo_glyph
+        else -> null
+    }
+    val valueColor = when (label) {
+        "TMDB" -> Color(0xFF01B4E4)
+        "Trakt" -> Color(0xFFED1C24)
+        else -> Color.White
+    }
+    Row(horizontalArrangement = Arrangement.spacedBy(4.dp), verticalAlignment = Alignment.CenterVertically) {
