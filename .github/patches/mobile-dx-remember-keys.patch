+package com.nuvio.app.features.settings
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.getValue
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import com.nuvio.app.features.player.DxRemember
+
+/** dx.bi port: remember volume and speed, and number keys 0-9 on a hardware keyboard. */
+@Composable
+internal fun DxRememberSettingsSection(isTablet: Boolean) {
+    LaunchedEffect(Unit) { DxRemember.ensureLoaded() }
+    val remember by DxRemember.remember.collectAsStateWithLifecycle()
+    val keys by DxRemember.keys.collectAsStateWithLifecycle()
+    SettingsSection(title = "Remember volume and speed", isTablet = isTablet) {
+        SettingsGroup(isTablet = isTablet) {
+            SettingsSwitchRow(
+                title = "Remember volume and speed",
+                description = "The next video starts with the volume you last set by swiping and the playback speed you last picked.",
+                checked = remember,
+                isTablet = isTablet,
+                onCheckedChange = DxRemember::setRemember,
+            )
+            SettingsGroupDivider(isTablet = isTablet)
+            SettingsSwitchRow(
+                title = "Number keys jump in the video",
+                description = "With a hardware keyboard, keys 0 to 9 jump to 0% to 90% of the video.",
+                checked = keys,
+                isTablet = isTablet,
+                onCheckedChange = DxRemember::setKeys,
+            )
+        }
+    }
+}
