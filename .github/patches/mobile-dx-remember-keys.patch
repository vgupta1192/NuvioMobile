+import androidx.compose.ui.input.key.KeyEventType
+import androidx.compose.ui.input.key.isAltPressed
+import androidx.compose.ui.input.key.isCtrlPressed
+import androidx.compose.ui.input.key.isMetaPressed
+import androidx.compose.ui.input.key.key
+import androidx.compose.ui.input.key.onKeyEvent
+import androidx.compose.ui.input.key.type
+import com.nuvio.app.core.storage.AppFileCache
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+/**
+ * dx.bi port: remembers the last swipe volume and playback speed from one video to the next, and lets the number
+ * keys 0-9 on a hardware keyboard jump to 0%..90% of the video. Both parts have a Settings switch.
+ */
+internal object DxRemember {
+    private const val PATH = "settings/dx_remember"
+    private val _remember = MutableStateFlow(true)
+    val remember: StateFlow<Boolean> = _remember.asStateFlow()
+    private val _keys = MutableStateFlow(true)
+    val keys: StateFlow<Boolean> = _keys.asStateFlow()
+    private var volume: Float? = null
+    private var speed: Float? = null
+    private var loaded = false
+
+    fun ensureLoaded() {
+        if (loaded) return
+        loaded = true
+        val values = HashMap<String, String>()
+        AppFileCache.read(PATH)?.lineSequence()?.forEach { line ->
+            val at = line.indexOf('=')
+            if (at > 0) values[line.substring(0, at)] = line.substring(at + 1)
+        }
+        _remember.value = values["remember"] != "0"
+        _keys.value = values["keys"] != "0"
+        volume = values["volume"]?.toFloatOrNull()?.takeIf { it in 0f..1f }
+        speed = values["speed"]?.toFloatOrNull()?.takeIf { it in 0.25f..4f }
+    }
+
+    private fun save() {
+        val text = buildString {
+            append("remember=").append(if (_remember.value) 1 else 0).append('\n')
+            append("keys=").append(if (_keys.value) 1 else 0)
+            volume?.let { append("\nvolume=").append(it) }
+            speed?.let { append("\nspeed=").append(it) }
+        }
+        runCatching { AppFileCache.write(PATH, text) }
+    }
+
+    fun setRemember(enabled: Boolean) {
+        ensureLoaded()
+        _remember.value = enabled
+        save()
+    }
+
+    fun setKeys(enabled: Boolean) {
+        ensureLoaded()
+        _keys.value = enabled
+        save()
+    }
+
+    /** Called after every swipe volume change. Boosted levels past 100% are never kept. */
+    fun noteVolume(level: PlayerAudioLevel?) {
+        ensureLoaded()
+        if (!_remember.value || level == null || level.fraction !in 0f..1f) return
+        if (volume == level.fraction) return
+        volume = level.fraction
+        save()
+    }
+
+    fun noteSpeed(value: Float) {
+        ensureLoaded()
+        if (!_remember.value || value !in 0.25f..4f) return
+        if (speed == value) return
+        speed = value
+        save()
+    }
+
+    fun restoreVolume(controller: PlayerGestureController) {
+        ensureLoaded()
+        if (!_remember.value) return
+        val saved = volume ?: return
+        runCatching { controller.setVolume(saved) }
+    }
+
+    /** Saved speed when it differs from 1x, else null. */
+    fun speedToRestore(): Float? {
+        ensureLoaded()
+        if (!_remember.value) return null
+        return speed?.takeIf { kotlin.math.abs(it - 1f) > 0.01f }
+    }
+
+    fun digitFor(key: Key): Int? = when (key) {
+        Key.Zero, Key.NumPad0 -> 0
+        Key.One, Key.NumPad1 -> 1
+        Key.Two, Key.NumPad2 -> 2
+        Key.Three, Key.NumPad3 -> 3
+        Key.Four, Key.NumPad4 -> 4
+        Key.Five, Key.NumPad5 -> 5
+        Key.Six, Key.NumPad6 -> 6
+        Key.Seven, Key.NumPad7 -> 7
+        Key.Eight, Key.NumPad8 -> 8
+        Key.Nine, Key.NumPad9 -> 9
+        else -> null
+    }
+}
+
+/** Hardware keyboard: 0-9 jump to 0%..90%. Without a keyboard nothing ever reaches this, so it does nothing. */
+internal fun Modifier.dxPlayerKeys(runtime: PlayerScreenRuntime): Modifier = composed {
+    val focusRequester = remember { FocusRequester() }
+    LaunchedEffect(Unit) {
+        DxRemember.ensureLoaded()
+        runCatching { focusRequester.requestFocus() }
+    }
+    this
+        .focusRequester(focusRequester)
+        .focusable()
+        .onKeyEvent { event ->
+            if (event.type != KeyEventType.KeyDown) return@onKeyEvent false
+            if (event.isCtrlPressed || event.isAltPressed || event.isMetaPressed) return@onKeyEvent false
+            if (!DxRemember.keys.value || runtime.isMiniPresentation) return@onKeyEvent false
+            val digit = DxRemember.digitFor(event.key) ?: return@onKeyEvent false
+            val durationMs = runtime.playbackSnapshot.durationMs
+            val controller = runtime.playerController
+            if (durationMs <= 0L || controller == null || runtime.partyBlocksControl()) return@onKeyEvent false
+            controller.seekTo(durationMs / 10L * digit)
+            DxPlayerHint.show("${digit * 10}%")
+            true
+        }
+}
