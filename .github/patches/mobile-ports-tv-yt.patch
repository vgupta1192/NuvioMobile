+/** A list page that loads more when the end is near: search results, a channel's videos, a playlist. */
+@Composable
+private fun PagedPage(
+    key: Any,
+    header: (@Composable () -> Unit)?,
+    load: suspend (token: String?) -> YtPageResult?,
+) {
+    val tokens = MaterialTheme.nuvio
+    val horizontal = tokens.spacing.screenHorizontal
+    var items by remember(key) { mutableStateOf<List<YtItem>>(emptyList()) }
+    var token by remember(key) { mutableStateOf<String?>(null) }
+    var loading by remember(key) { mutableStateOf(true) }
+    var failed by remember(key) { mutableStateOf(false) }
+    val scope = rememberCoroutineScope()
+    val hideShorts by YouTubePrefs.hideShorts.value.collectAsState()
+
+    fun startFetch(next: String?) {
+        loading = true
+        failed = false
+        scope.launch {
+            val result = runCatching { load(next) }.getOrNull()
+            if (result == null) {
+                if (items.isEmpty()) failed = true
+            } else {
+                items = (items + result.items).distinctBy { it.key }
+                token = result.continuation
+            }
+            loading = false
+        }
+    }
+
+    LaunchedEffect(key) { startFetch(null) }
+    val listState = rememberLazyListState()
+    val nearEnd by remember {
+        derivedStateOf {
+            val info = listState.layoutInfo
+            val last = info.visibleItemsInfo.lastOrNull()?.index ?: 0
+            last >= info.totalItemsCount - 4
+        }
+    }
+    LaunchedEffect(nearEnd, token, loading) {
+        val next = token
+        if (nearEnd && next != null && !loading) startFetch(next)
+    }
+
+    val visible = items.filter { !hideShorts || !it.isShort }
+    val shorts = visible.filter { it.isShort && it.kind == YtKind.VIDEO }
+    val rest = visible.filterNot { it.isShort && it.kind == YtKind.VIDEO }
+    LazyColumn(
+        state = listState,
+        modifier = Modifier.fillMaxSize(),
+        contentPadding = PaddingValues(start = horizontal, end = horizontal, top = 4.dp, bottom = 24.dp),
+        verticalArrangement = Arrangement.spacedBy(16.dp),
+    ) {
+        if (header != null) item(key = "header") { header() }
+        if (shorts.isNotEmpty()) {
+            item(key = "shorts-shelf") {
+                Column {
+                    SectionTitle("Shorts", 0.dp)
+                    LazyRow(horizontalArrangement = Arrangement.spacedBy(10.dp)) {
+                        items(shorts, key = { it.key }) { short -> ShortCard(short, shorts) }
+                    }
+                }
+            }
+        }
+        items(rest, key = { it.key }) { item -> ItemCard(item, Modifier.fillMaxWidth(), siblings = shorts) }
+        if (loading) item(key = "loading") { CenteredLoader() }
+        if (failed) {
+            item(key = "failed") { EmptyState("Could not load this page.", "Retry") { startFetch(null) } }
+        } else if (!loading && items.isEmpty()) {
+            item(key = "none") { EmptyState("Nothing found.", null) {} }
+        }
+    }
+}
