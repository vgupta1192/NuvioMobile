+@Composable
+fun YouTubeScreen(
+    onBack: () -> Unit,
+    onOpenInPlayer: (item: YtItem, positionMs: Long) -> Unit,
+) {
+    val tokens = MaterialTheme.nuvio
+    LaunchedEffect(Unit) {
+        YouTubeRepository.ensureLoaded()
+        YouTubePrefs.autoplay.ensureLoaded()
+        YouTubePrefs.hideShorts.ensureLoaded()
+    }
+    val pages by YouTubeRepository.pages.collectAsState()
+    val watch by YouTubeRepository.watch.collectAsState()
+    var tab by rememberSaveable { mutableIntStateOf(0) }
+    val page = pages.lastOrNull()
+
+    PlatformBackHandler(enabled = watch != null || pages.isNotEmpty()) {
+        if (watch != null) YouTubeRepository.closeWatch() else YouTubeRepository.popPage()
+    }
+    DisposableEffect(Unit) {
+        onDispose { YouTubeRepository.closeWatch() }
+    }
+
+    val title = when (page) {
+        null -> "YouTube"
+        is YtPage.Search -> page.query
+        is YtPage.Channel -> page.name.ifBlank { "Channel" }
+        is YtPage.Playlist -> page.title.ifBlank { "Playlist" }
+        YtPage.Shorts -> "Shorts"
+    }
+
+    CompositionLocalProvider(LocalFullPlayer provides onOpenInPlayer) {
+        Box(Modifier.fillMaxSize().background(tokens.colors.background)) {
+            Column(Modifier.fillMaxSize().windowInsetsPadding(WindowInsets.navigationBars)) {
+                NuvioScreenHeader(
+                    title = title,
+                    modifier = Modifier.padding(horizontal = tokens.spacing.screenHorizontal),
+                    onBack = { if (!YouTubeRepository.popPage()) onBack() },
+                )
+                when (page) {
+                    null -> RootContent(tab = tab, onTab = { tab = it })
+                    is YtPage.Search -> PagedPage(
+                        key = page,
+                        header = null,
+                        load = { token ->
+                            if (token == null) YtInnertube.search(page.query) else YtInnertube.continuation(token)
+                        },
+                    )
+                    is YtPage.Channel -> PagedPage(
+                        key = page,
+                        header = { ChannelHeader(page.id, page.name) },
+                        load = { token ->
+                            if (token == null) YtInnertube.channel(page.id) else YtInnertube.continuation(token)
+                        },
+                    )
+                    is YtPage.Playlist -> PagedPage(
+                        key = page,
+                        header = null,
+                        load = { token ->
+                            if (token == null) YtInnertube.playlist(page.id) else YtInnertube.continuation(token)
+                        },
+                    )
+                    YtPage.Shorts -> ShortsHost(Modifier.weight(1f))
+                }
+            }
+            watch?.let { current ->
+                WatchPane(
+                    watch = current,
+                    modifier = Modifier.fillMaxSize().background(tokens.colors.background).windowInsetsPadding(WindowInsets.navigationBars),
+                )
+            }
+        }
+    }
+}
