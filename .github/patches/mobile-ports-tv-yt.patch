+@Composable
+private fun SearchField(modifier: Modifier = Modifier) {
+    val tokens = MaterialTheme.nuvio
+    var query by rememberSaveable { mutableStateOf("") }
+    val saved by YouTubeRepository.saved.collectAsState()
+    fun submit(text: String) {
+        val q = text.trim()
+        if (q.isBlank()) return
+        YouTubeRepository.rememberSearch(q)
+        YouTubeRepository.push(YtPage.Search(q))
+        query = ""
+    }
+    Column(modifier) {
+        OutlinedTextField(
+            value = query,
+            onValueChange = { query = it },
+            modifier = Modifier.fillMaxWidth(),
+            singleLine = true,
+            shape = RoundedCornerShape(24.dp),
+            placeholder = { Text("Search YouTube", color = tokens.colors.textMuted) },
+            leadingIcon = { Icon(Icons.Rounded.Search, contentDescription = null, tint = tokens.colors.textMuted) },
+            trailingIcon = {
+                if (query.isNotEmpty()) {
+                    IconButton(onClick = { query = "" }) {
+                        Icon(Icons.Rounded.Close, contentDescription = "Clear", tint = tokens.colors.textMuted)
+                    }
+                }
+            },
+            keyboardOptions = KeyboardOptions(imeAction = ImeAction.Search),
+            keyboardActions = KeyboardActions(onSearch = { submit(query) }),
+        )
+        if (query.isBlank() && saved.searches.isNotEmpty()) {
+            Spacer(Modifier.height(8.dp))
+            LazyRow(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                items(saved.searches, key = { it }) { term -> Pill(text = term) { submit(term) } }
+            }
+        }
+    }
