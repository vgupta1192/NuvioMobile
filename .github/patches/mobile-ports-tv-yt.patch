+import com.nuvio.app.features.player.PlayerEngineController
+import com.nuvio.app.features.player.PlayerPlaybackSnapshot
+import com.nuvio.app.features.player.PlayerResizeMode
+import com.nuvio.app.features.trailer.TrailerPlaybackSource
+import kotlinx.coroutines.launch
+
+/**
+ * Vertical pager of Shorts. Only the visible page owns a player; the next page's stream is resolved ahead of time.
+ * A tap pauses or resumes, and a Short that ends starts again.
+ */
+@Composable
+internal fun YouTubeShortsPlayer(
+    items: List<YtItem>,
+    loadingMore: Boolean,
+    onNeedMore: () -> Unit,
+    onOpenChannel: (channelId: String, name: String) -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    Box(modifier = modifier.fillMaxSize().background(Color.Black)) {
+        if (items.isEmpty()) {
+            if (loadingMore) {
+                NuvioLoadingIndicator(modifier = Modifier.align(Alignment.Center))
+            } else {
+                Text(
+                    text = "No Shorts found. Check the connection and open the tab again.",
+                    color = Color.White.copy(alpha = 0.8f),
+                    modifier = Modifier.align(Alignment.Center).padding(24.dp),
+                )
+            }
+            return@Box
+        }
+        val pagerState = rememberPagerState(initialPage = 0) { items.size }
+        val sources = remember { mutableStateMapOf<String, TrailerPlaybackSource>() }
+        val failed = remember { mutableStateMapOf<String, Boolean>() }
+
+        LaunchedEffect(pagerState.currentPage, items.size) {
+            if (pagerState.currentPage >= items.size - 3) onNeedMore()
+            for (index in pagerState.currentPage..pagerState.currentPage + 1) {
+                val id = items.getOrNull(index)?.id ?: continue
+                if (sources.containsKey(id) || failed[id] == true) continue
+                launch {
+                    val source = runCatching { YouTubeRepository.resolve(id) }.getOrNull()
+                    if (source != null) sources[id] = source else failed[id] = true
+                }
+            }
+        }
+
+        VerticalPager(
+            state = pagerState,
+            modifier = Modifier.fillMaxSize(),
+            beyondViewportPageCount = 0,
+        ) { page ->
+            val item = items[page]
+            ShortPage(
+                item = item,
+                isCurrent = page == pagerState.currentPage,
+                source = sources[item.id],
+                failed = failed[item.id] == true,
+                onOpenChannel = onOpenChannel,
+            )
+        }
+    }
+}
+
+@Composable
+private fun ShortPage(
+    item: YtItem,
+    isCurrent: Boolean,
+    source: TrailerPlaybackSource?,
+    failed: Boolean,
+    onOpenChannel: (channelId: String, name: String) -> Unit,
+) {
+    val scope = rememberCoroutineScope()
+    val saved by YouTubeRepository.saved.collectAsState()
+    val isSaved = saved.watchLater.any { it.id == item.id }
+    var paused by remember(isCurrent) { mutableStateOf(false) }
+    var controller by remember(item.id) { mutableStateOf<PlayerEngineController?>(null) }
+    var snapshot by remember(item.id) { mutableStateOf(PlayerPlaybackSnapshot()) }
+    var channelLookup by remember(item.id) { mutableStateOf(false) }
+
+    LaunchedEffect(snapshot.isEnded) {
+        if (snapshot.isEnded && isCurrent) {
+            controller?.seekTo(0L)
+            controller?.play()
+        }
+    }
+
+    Box(
+        modifier = Modifier
+            .fillMaxSize()
+            .background(Color.Black)
+            .clickable(
+                interactionSource = remember { MutableInteractionSource() },
+                indication = null,
+            ) { paused = !paused },
+    ) {
+        AsyncImage(
+            model = item.thumb,
+            contentDescription = null,
+            contentScale = ContentScale.Fit,
+            modifier = Modifier.fillMaxSize(),
+        )
+        if (isCurrent && source != null) {
+            PlatformPlayerSurface(
+                sourceUrl = source.videoUrl,
+                sourceAudioUrl = source.audioUrl,
+                useYoutubeChunkedPlayback = true,
+                modifier = Modifier.fillMaxSize(),
+                playWhenReady = !paused,
+                resizeMode = PlayerResizeMode.Fit,
+                useNativeController = false,
+                onControllerReady = { controller = it },
+                onSnapshot = { snapshot = it },
+                onError = { },
+            )
+        }
+        if (isCurrent && !failed && (source == null || snapshot.isLoading)) {
+            NuvioLoadingIndicator(modifier = Modifier.align(Alignment.Center))
+        }
+        if (failed) {
+            Text(
+                text = "Could not load this Short. Swipe for the next one.",
+                color = Color.White,
+                modifier = Modifier.align(Alignment.Center).padding(24.dp),
+            )
+        }
+        if (paused && isCurrent) {
+            Icon(
+                imageVector = Icons.Rounded.PlayArrow,
+                contentDescription = "Paused",
+                tint = Color.White.copy(alpha = 0.85f),
+                modifier = Modifier.align(Alignment.Center).size(72.dp),
+            )
+        }
+        Box(
+            modifier = Modifier
+                .align(Alignment.BottomCenter)
+                .fillMaxWidth()
+                .background(Brush.verticalGradient(listOf(Color.Transparent, Color.Black.copy(alpha = 0.75f))))
+                .padding(start = 16.dp, end = 8.dp, top = 40.dp, bottom = 20.dp),
+        ) {
+            Column(
+                modifier = Modifier.align(Alignment.BottomStart).fillMaxWidth(0.78f),
+                verticalArrangement = Arrangement.spacedBy(8.dp),
+            ) {
+                Text(
+                    text = item.title,
+                    color = Color.White,
+                    style = MaterialTheme.typography.titleSmall,
+                    maxLines = 3,
+                    overflow = TextOverflow.Ellipsis,
+                )
+                if (item.meta.isNotBlank()) {
+                    Text(text = item.meta, color = Color.White.copy(alpha = 0.7f), style = MaterialTheme.typography.bodySmall)
+                }
+                FilledTonalButton(
+                    enabled = !channelLookup,
+                    onClick = {
+                        if (item.channelId.isNotBlank()) {
+                            onOpenChannel(item.channelId, item.channel)
+                        } else {
+                            channelLookup = true
+                            scope.launch {
+                                val owner = YouTubeRepository.ownerOf(item.id)
+                                channelLookup = false
+                                if (owner != null) onOpenChannel(owner.first, owner.second)
+                            }
+                        }
+                    },
+                ) {
+                    Text(if (item.channel.isNotBlank()) "Channel: ${item.channel}" else "Channel", maxLines = 1, overflow = TextOverflow.Ellipsis)
+                }
+            }
+            IconButton(
+                onClick = { YouTubeRepository.toggleWatchLater(item) },
+                modifier = Modifier.align(Alignment.BottomEnd),
+            ) {
+                Icon(
+                    imageVector = if (isSaved) Icons.Rounded.Star else Icons.Rounded.StarBorder,
+                    contentDescription = if (isSaved) "Remove from Watch later" else "Watch later",
+                    tint = Color.White,
+                    modifier = Modifier.size(30.dp),
+                )
+            }
+        }
+    }
+}
