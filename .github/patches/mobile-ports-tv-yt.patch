+package com.nuvio.app.features.settings
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.collectAsState
+import androidx.compose.runtime.getValue
+import com.nuvio.app.features.youtube.YouTubePrefs
+
+/** Fork settings: YouTube tab (Extra menu entry, autoplay, Shorts filter). */
+@Composable
+internal fun ExtraYouTubeSection(isTablet: Boolean) {
+    LaunchedEffect(Unit) {
+        YouTubePrefs.tabEnabled.ensureLoaded()
+        YouTubePrefs.autoplay.ensureLoaded()
+        YouTubePrefs.hideShorts.ensureLoaded()
+    }
+    val tabEnabled by YouTubePrefs.tabEnabled.value.collectAsState()
+    val autoplay by YouTubePrefs.autoplay.value.collectAsState()
+    val hideShorts by YouTubePrefs.hideShorts.value.collectAsState()
+    SettingsSection(title = "YouTube", isTablet = isTablet) {
+        SettingsGroup(isTablet = isTablet) {
+            SettingsSwitchRow(
+                title = "YouTube tab",
+                description = "Show YouTube in the Extra menu: search, channels, playlists, Watch later and Shorts.",
+                checked = tabEnabled,
+                isTablet = isTablet,
+                onCheckedChange = { YouTubePrefs.tabEnabled.set(it) },
+            )
+            SettingsGroupDivider(isTablet = isTablet)
+            SettingsSwitchRow(
+                title = "Autoplay next video",
+                description = "Start the first Up next video when one ends.",
+                checked = autoplay,
+                isTablet = isTablet,
+                onCheckedChange = { YouTubePrefs.autoplay.set(it) },
+            )
+            SettingsGroupDivider(isTablet = isTablet)
+            SettingsSwitchRow(
+                title = "Hide Shorts in lists",
+                description = "Remove Shorts from Home rows and search results. The Shorts tab stays.",
+                checked = hideShorts,
+                isTablet = isTablet,
+                onCheckedChange = { YouTubePrefs.hideShorts.set(it) },
+            )
+        }
+    }
+}
diff --git a/composeApp/src/commonMain/kotlin/com/nuvio/app/features/youtube/YouTubeInnertube.kt b/composeApp/src/commonMain/kotlin/com/nuvio/app/features/youtube/YouTubeInnertube.kt
