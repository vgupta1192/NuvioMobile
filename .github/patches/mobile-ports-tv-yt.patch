+package com.nuvio.app.features.youtube
+
+import com.nuvio.app.core.storage.AppFileCache
+import com.nuvio.app.features.settings.ForkBoolPref
+import com.nuvio.app.features.trailer.TrailerPlaybackResolver
+import com.nuvio.app.features.trailer.TrailerPlaybackSource
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.async
+import kotlinx.coroutines.awaitAll
+import kotlinx.coroutines.flow.MutableSharedFlow
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.SharedFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asSharedFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.update
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.sync.Semaphore
+import kotlinx.coroutines.sync.withPermit
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.json.Json
+
+/** Lets the Extra menu entry open the YouTube route without threading a callback through the shell. */
+object YouTubeLauncher {
+    private val _openRequests = MutableSharedFlow<Unit>(extraBufferCapacity = 1)
+    val openRequests: SharedFlow<Unit> = _openRequests.asSharedFlow()
+
+    fun open() {
+        _openRequests.tryEmit(Unit)
+    }
+}
+
+object YouTubePrefs {
+    val tabEnabled = ForkBoolPref("settings/youtube_tab", true)
+    val autoplay = ForkBoolPref("settings/youtube_autoplay", true)
+    val hideShorts = ForkBoolPref("settings/youtube_hide_shorts", false)
+}
+
+@Serializable
+data class YtProgress(val item: YtItem, val positionMs: Long, val durationMs: Long)
+
+@Serializable
+data class YtSaved(
+    val watchLater: List<YtItem> = emptyList(),
+    val subscriptions: List<YtItem> = emptyList(),
+    val continueWatching: List<YtProgress> = emptyList(),
+    val searches: List<String> = emptyList(),
+)
+
+data class YtRow(val order: Int, val title: String, val items: List<YtItem>)
+
+sealed interface YtPage {
+    data class Search(val query: String) : YtPage
+    data class Channel(val id: String, val name: String) : YtPage
+    data class Playlist(val id: String, val title: String) : YtPage
+    data object Shorts : YtPage
+}
+
+data class YtWatch(
+    val item: YtItem,
+    val source: TrailerPlaybackSource? = null,
+    val loading: Boolean = true,
+    val error: String? = null,
+    val related: List<YtItem> = emptyList(),
+    val startPositionMs: Long = 0L,
+)
+
+/** App-wide state for the YouTube tab: saved lists, feeds, the page stack and the open video. */
+object YouTubeRepository {
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.Default)
+    private val json = Json { ignoreUnknownKeys = true; encodeDefaults = true }
+    private const val STORE_PATH = "youtube/state.json"
+
+    private val _saved = MutableStateFlow(YtSaved())
+    val saved: StateFlow<YtSaved> = _saved.asStateFlow()
+    private var savedLoaded = false
+
+    private val _homeRows = MutableStateFlow<List<YtRow>>(emptyList())
+    val homeRows: StateFlow<List<YtRow>> = _homeRows.asStateFlow()
+    private val _homeLoading = MutableStateFlow(false)
+    val homeLoading: StateFlow<Boolean> = _homeLoading.asStateFlow()
+
+    private val _subsFeed = MutableStateFlow<List<YtItem>>(emptyList())
+    val subsFeed: StateFlow<List<YtItem>> = _subsFeed.asStateFlow()
+    private val _subsLoading = MutableStateFlow(false)
+    val subsLoading: StateFlow<Boolean> = _subsLoading.asStateFlow()
+    private var subsKey = ""
+
+    private val _shorts = MutableStateFlow<List<YtItem>>(emptyList())
+    val shorts: StateFlow<List<YtItem>> = _shorts.asStateFlow()
+    private val _shortsLoading = MutableStateFlow(false)
+    val shortsLoading: StateFlow<Boolean> = _shortsLoading.asStateFlow()
+    private var shortsTopicIndex = 0
+
+    private val _pages = MutableStateFlow<List<YtPage>>(emptyList())
+    val pages: StateFlow<List<YtPage>> = _pages.asStateFlow()
+
+    private val _watch = MutableStateFlow<YtWatch?>(null)
+    val watch: StateFlow<YtWatch?> = _watch.asStateFlow()
+    private var watchJob: Job? = null
+    private var lastProgressSaveMs = -10_000L
+
+    private val homeTopics = listOf(
+        "Trending" to "trending videos this week",
+        "Music" to "new music videos",
+        "Movies and TV" to "official movie trailers",
+        "Gaming" to "gaming highlights",
+        "Tech" to "tech reviews",
+        "News" to "world news today",
+        "Sports" to "sports highlights",
+        "Food" to "easy recipes",
+        "Learning" to "documentary full",
+    )
+    private val shortsTopics = listOf(
+        "funny", "music", "satisfying", "cooking", "sports", "gaming", "animals", "science", "travel", "movies", "tech", "art",
+    )
+
+    // --- saved state ---
+
+    fun ensureLoaded() {
+        if (savedLoaded) return
+        savedLoaded = true
+        YouTubePrefs.tabEnabled.ensureLoaded()
+        YouTubePrefs.autoplay.ensureLoaded()
+        YouTubePrefs.hideShorts.ensureLoaded()
+        val raw = runCatching { AppFileCache.read(STORE_PATH) }.getOrNull() ?: return
+        runCatching { json.decodeFromString(YtSaved.serializer(), raw) }.getOrNull()?.let { _saved.value = it }
+    }
+
+    private fun updateSaved(transform: (YtSaved) -> YtSaved) {
+        ensureLoaded()
+        _saved.update(transform)
+        val snapshot = _saved.value
+        runCatching { AppFileCache.write(STORE_PATH, json.encodeToString(YtSaved.serializer(), snapshot)) }
+    }
+
+    fun isWatchLater(videoId: String): Boolean = _saved.value.watchLater.any { it.id == videoId }
+
+    fun toggleWatchLater(item: YtItem) {
+        if (item.kind != YtKind.VIDEO) return
+        updateSaved { s ->
+            if (s.watchLater.any { it.id == item.id }) s.copy(watchLater = s.watchLater.filterNot { it.id == item.id })
+            else s.copy(watchLater = listOf(item) + s.watchLater)
+        }
+    }
+
+    fun isSubscribed(channelId: String): Boolean = _saved.value.subscriptions.any { it.id == channelId }
+
+    fun toggleSubscription(channelId: String, name: String, thumb: String = "") {
+        if (channelId.isBlank()) return
+        updateSaved { s ->
+            if (s.subscriptions.any { it.id == channelId }) {
+                s.copy(subscriptions = s.subscriptions.filterNot { it.id == channelId })
+            } else {
+                val channel = YtItem(kind = YtKind.CHANNEL, id = channelId, title = name.ifBlank { "Channel" }, channelId = channelId, thumb = thumb)
+                s.copy(subscriptions = s.subscriptions + channel)
+            }
+        }
+    }
+
+    fun rememberSearch(query: String) {
+        val q = query.trim()
+        if (q.isBlank()) return
+        updateSaved { s -> s.copy(searches = (listOf(q) + s.searches.filterNot { it.equals(q, true) }).take(12)) }
+    }
+
+    fun clearSearches() = updateSaved { it.copy(searches = emptyList()) }
+
+    fun removeContinue(videoId: String) = updateSaved { s -> s.copy(continueWatching = s.continueWatching.filterNot { it.item.id == videoId }) }
+
+    /** Called about once a second by the player; it stores the position every few seconds. */
+    fun saveProgress(item: YtItem, positionMs: Long, durationMs: Long, force: Boolean = false) {
+        if (item.isShort || item.isLive || durationMs <= 0L || positionMs < 5_000L) return
+        if (!force && kotlin.math.abs(positionMs - lastProgressSaveMs) < 5_000L) return
+        lastProgressSaveMs = positionMs
+        updateSaved { s ->
+            val rest = s.continueWatching.filterNot { it.item.id == item.id }
+            if (positionMs * 100 >= durationMs * 95) {
+                s.copy(continueWatching = rest)
+            } else {
+                s.copy(continueWatching = (listOf(YtProgress(item, positionMs, durationMs)) + rest).take(30))
+            }
+        }
+    }
+
+    // --- feeds ---
+
+    fun loadHome(force: Boolean = false) {
+        ensureLoaded()
+        if (_homeLoading.value || (!force && _homeRows.value.isNotEmpty())) return
+        _homeLoading.value = true
+        if (force) _homeRows.value = emptyList()
+        scope.launch {
+            val gate = Semaphore(3)
+            homeTopics.mapIndexed { index, (title, query) ->
+                async {
+                    gate.withPermit {
+                        val result = runCatching { YtInnertube.search(query, YtInnertube.VIDEOS_ONLY) }.getOrNull()
+                        val items = result?.items.orEmpty().filter { it.kind == YtKind.VIDEO && !it.isShort }.take(24)
+                        if (items.isNotEmpty()) {
+                            _homeRows.update { rows -> (rows.filterNot { it.order == index } + YtRow(index, title, items)).sortedBy { it.order } }
+                        }
+                    }
+                }
+            }.awaitAll()
+            _homeLoading.value = false
+        }
+    }
+
+    fun loadSubscriptions(force: Boolean = false) {
+        ensureLoaded()
+        val subs = _saved.value.subscriptions.take(24)
+        val key = subs.joinToString(",") { it.id }
+        if (_subsLoading.value || (!force && key == subsKey)) return
+        subsKey = key
+        if (subs.isEmpty()) {
+            _subsFeed.value = emptyList()
+            return
+        }
+        _subsLoading.value = true
+        scope.launch {
+            val gate = Semaphore(4)
+            val lists = subs.map { channel ->
+                async {
+                    gate.withPermit {
+                        runCatching { YtInnertube.channel(channel.id) }.getOrNull()?.items.orEmpty()
+                            .filter { it.kind == YtKind.VIDEO }
+                            .take(6)
+                            .map { it.copy(channel = it.channel.ifBlank { channel.title }, channelId = channel.id) }
+                    }
+                }
+            }.awaitAll()
+            _subsFeed.value = lists.flatten().distinctBy { it.id }.sortedBy { ageMinutes(it.meta) }.take(150)
+            _subsLoading.value = false
+        }
+    }
+
+    fun loadShorts(reset: Boolean = false) {
+        if (_shortsLoading.value) return
+        if (reset) {
+            _shorts.value = emptyList()
+            shortsTopicIndex = 0
+        }
+        _shortsLoading.value = true
+        scope.launch {
+            val before = _shorts.value.size
+            var attempts = 0
+            while (_shorts.value.size - before < 10 && attempts < 3) {
+                val topic = shortsTopics[shortsTopicIndex % shortsTopics.size]
+                shortsTopicIndex++
+                attempts++
+                val result = runCatching { YtInnertube.search("$topic #shorts") }.getOrNull()
+                val fresh = result?.items.orEmpty().filter { it.isShort }
+                if (fresh.isNotEmpty()) {
+                    _shorts.update { current -> (current + fresh.filter { f -> current.none { it.id == f.id } }) }
+                }
+            }
+            _shortsLoading.value = false
+        }
+    }
+
+    /** Puts [item] first in the Shorts pool (used when a Short is opened from a search result). */
+    fun openShortsAt(item: YtItem, siblings: List<YtItem>) {
+        val ordered = listOf(item) + siblings.filter { it.isShort && it.id != item.id }
+        _shorts.value = ordered
+        shortsTopicIndex = 0
+    }
+
+    suspend fun ownerOf(videoId: String): Pair<String, String>? = runCatching { YtInnertube.owner(videoId) }.getOrNull()
+
+    // --- navigation inside the tab ---
+
+    fun push(page: YtPage) {
+        _pages.update { it + page }
+    }
+
+    fun popPage(): Boolean {
+        if (_pages.value.isEmpty()) return false
+        _pages.update { it.dropLast(1) }
+        return true
+    }
+
+    fun resetPages() {
+        _pages.value = emptyList()
+    }
+
+    // --- playback ---
+
+    suspend fun resolve(videoId: String): TrailerPlaybackSource? =
+        TrailerPlaybackResolver.resolveFromYouTubeUrl("https://www.youtube.com/watch?v=$videoId")
+
+    fun play(item: YtItem) {
+        ensureLoaded()
+        if (item.kind == YtKind.PLAYLIST) {
+            push(YtPage.Playlist(item.id, item.title))
+            return
+        }
+        if (item.kind == YtKind.CHANNEL) {
+            push(YtPage.Channel(item.id, item.title))
+            return
+        }
+        watchJob?.cancel()
+        lastProgressSaveMs = -10_000L
+        val resume = _saved.value.continueWatching.firstOrNull { it.item.id == item.id }?.positionMs ?: 0L
+        _watch.value = YtWatch(item = item, startPositionMs = resume)
+        watchJob = scope.launch {
+            val relatedJob = async { runCatching { YtInnertube.related(item.id) }.getOrDefault(emptyList()) }
+            val source = runCatching { resolve(item.id) }.getOrNull()
+            _watch.update { current ->
+                if (current?.item?.id != item.id) current
+                else current.copy(source = source, loading = false, error = if (source == null) "Could not load this video." else null)
+            }
+            val related = relatedJob.await()
+            _watch.update { current -> if (current?.item?.id != item.id) current else current.copy(related = related) }
+        }
+    }
+
+    fun retryWatch() {
+        _watch.value?.item?.let(::play)
+    }
+
+    fun playNext() {
+        val current = _watch.value ?: return
+        val hideShorts = YouTubePrefs.hideShorts.current()
+        val next = current.related.firstOrNull { it.kind == YtKind.VIDEO && (!hideShorts || !it.isShort) } ?: return
+        play(next)
+    }
+
+    fun closeWatch() {
+        val current = _watch.value
+        watchJob?.cancel()
+        watchJob = null
+        _watch.value = null
+        if (current != null) lastProgressSaveMs = -10_000L
+    }
+}
