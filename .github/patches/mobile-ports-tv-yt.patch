+@Composable
+private fun WatchPane(watch: YtWatch, modifier: Modifier) {
+    val tokens = MaterialTheme.nuvio
+    val horizontal = tokens.spacing.screenHorizontal
+    val fullPlayer = LocalFullPlayer.current
+    val saved by YouTubeRepository.saved.collectAsState()
+    val autoplay by YouTubePrefs.autoplay.value.collectAsState()
+    val item = watch.item
+    var snapshot by remember(item.id) { mutableStateOf(PlayerPlaybackSnapshot()) }
+    var controller by remember(item.id) { mutableStateOf<PlayerEngineController?>(null) }
+    var playerError by remember(item.id) { mutableStateOf<String?>(null) }
+    val latest = rememberUpdatedState(snapshot)
+
+    DisposableEffect(item.id) {
+        onDispose {
+            val last = latest.value
+            YouTubeRepository.saveProgress(item, last.positionMs, last.durationMs, force = true)
+        }
+    }
+    LaunchedEffect(snapshot.isEnded) {
+        if (snapshot.isEnded && autoplay) YouTubeRepository.playNext()
+    }
+
+    Column(modifier) {
+        Column(Modifier.fillMaxWidth().background(Color.Black)) {
+            Spacer(Modifier.windowInsetsTopHeight(WindowInsets.statusBars))
+            Box(Modifier.fillMaxWidth().aspectRatio(16f / 9f)) {
+                val source = watch.source
+                if (source != null) {
+                    PlatformPlayerSurface(
+                        sourceUrl = source.videoUrl,
+                        sourceAudioUrl = source.audioUrl,
+                        useYoutubeChunkedPlayback = true,
+                        modifier = Modifier.fillMaxSize(),
+                        playWhenReady = true,
+                        initialPositionMs = watch.startPositionMs.takeIf { it > 5_000L },
+                        initialPositionRequestKey = item.id,
+                        resizeMode = PlayerResizeMode.Fit,
+                        useNativeController = true,
+                        onControllerReady = { controller = it },
+                        onSnapshot = {
+                            snapshot = it
+                            YouTubeRepository.saveProgress(item, it.positionMs, it.durationMs)
+                        },
+                        onError = { playerError = it },
+                    )
+                }
+                val error = watch.error ?: playerError
+                if (error == null && (watch.loading || snapshot.isLoading)) {
+                    NuvioLoadingIndicator(modifier = Modifier.align(Alignment.Center))
+                }
+                if (error != null) {
+                    Column(
+                        modifier = Modifier.align(Alignment.Center).padding(16.dp),
+                        horizontalAlignment = Alignment.CenterHorizontally,
+                        verticalArrangement = Arrangement.spacedBy(8.dp),
+                    ) {
+                        Text(error, color = Color.White, style = MaterialTheme.typography.bodyMedium, maxLines = 3, overflow = TextOverflow.Ellipsis)
+                        TextButton(onClick = {
+                            playerError = null
+                            YouTubeRepository.retryWatch()
+                        }) { Text("Retry") }
+                    }
+                }
+                IconButton(
+                    onClick = { YouTubeRepository.closeWatch() },
+                    modifier = Modifier.align(Alignment.TopStart),
+                ) {
+                    Icon(Icons.AutoMirrored.Rounded.ArrowBack, contentDescription = "Close player", tint = Color.White)
+                }
+            }
+        }
+        LazyColumn(
+            modifier = Modifier.fillMaxSize(),
+            contentPadding = PaddingValues(start = horizontal, end = horizontal, top = 12.dp, bottom = 24.dp),
+            verticalArrangement = Arrangement.spacedBy(14.dp),
+        ) {
+            item(key = "info") {
+                Column(verticalArrangement = Arrangement.spacedBy(4.dp)) {
+                    Text(item.title, color = tokens.colors.textPrimary, style = MaterialTheme.typography.titleMedium)
+                    val sub = listOf(item.channel, item.meta).filter { it.isNotBlank() }.joinToString(" • ")
+                    if (sub.isNotBlank()) {
+                        Text(sub, color = tokens.colors.textMuted, style = MaterialTheme.typography.bodySmall)
+                    }
+                }
+            }
+            item(key = "actions") {
+                val isSaved = saved.watchLater.any { it.id == item.id }
+                Column(verticalArrangement = Arrangement.spacedBy(10.dp)) {
+                    LazyRow(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                        item {
+                            Pill(if (isSaved) "Saved to Watch later" else "Watch later", selected = isSaved) {
+                                YouTubeRepository.toggleWatchLater(item)
+                            }
+                        }
+                        if (item.channelId.isNotBlank()) {
+                            item {
+                                Pill("Channel") {
+                                    YouTubeRepository.closeWatch()
+                                    YouTubeRepository.push(YtPage.Channel(item.channelId, item.channel))
+                                }
+                            }
+                        }
+                        item {
+                            Pill("Full player") {
+                                controller?.pause()
+                                val position = latest.value.positionMs
+                                YouTubeRepository.saveProgress(item, position, latest.value.durationMs, force = true)
+                                fullPlayer(item, position)
+                            }
+                        }
+                    }
+                    Row(verticalAlignment = Alignment.CenterVertically) {
+                        Text(
+                            "Autoplay next video",
+                            color = tokens.colors.textPrimary,
+                            style = MaterialTheme.typography.bodyMedium,
+                            modifier = Modifier.weight(1f),
+                        )
+                        Switch(checked = autoplay, onCheckedChange = { YouTubePrefs.autoplay.set(it) })
+                    }
+                }
+            }
+            item(key = "upnext") { SectionTitle("Up next", 0.dp) }
+            if (watch.related.isEmpty()) {
+                item(key = "related-loading") { CenteredLoader() }
+            }
+            items(watch.related, key = { it.key }) { related ->
+                ItemCard(related, Modifier.fillMaxWidth(), siblings = emptyList())
+            }
+        }
+    }
+}
+
+@Composable
+private fun SectionTitle(text: String, horizontalPadding: androidx.compose.ui.unit.Dp) {
+    val tokens = MaterialTheme.nuvio
+    Text(
+        text = text,
+        color = tokens.colors.textPrimary,
+        style = MaterialTheme.typography.titleMedium,
+        fontWeight = FontWeight.SemiBold,
+        modifier = Modifier.padding(start = horizontalPadding, end = horizontalPadding, bottom = 8.dp),
+    )
+}
+
+@Composable
+private fun Pill(text: String, selected: Boolean = false, onClick: () -> Unit) {
+    val tokens = MaterialTheme.nuvio
+    Box(
+        modifier = Modifier
+            .clip(RoundedCornerShape(50))
+            .background(if (selected) tokens.colors.accent else tokens.colors.surfaceCard)
+            .clickable(onClick = onClick)
+            .padding(horizontal = 14.dp, vertical = 8.dp),
+    ) {
+        Text(
+            text = text,
+            color = if (selected) tokens.colors.onAccent else tokens.colors.textPrimary,
+            style = MaterialTheme.typography.labelLarge,
+            maxLines = 1,
+        )
+    }
+}
+
+@Composable
+private fun CenteredLoader() {
+    Box(Modifier.fillMaxWidth().padding(24.dp), contentAlignment = Alignment.Center) {
+        NuvioLoadingIndicator()
+    }
+}
+
+@Composable
+private fun EmptyState(message: String, actionLabel: String?, onAction: () -> Unit) {
+    val tokens = MaterialTheme.nuvio
+    Column(
+        modifier = Modifier.fillMaxWidth().padding(24.dp),
+        horizontalAlignment = Alignment.CenterHorizontally,
+        verticalArrangement = Arrangement.spacedBy(10.dp),
+    ) {
+        Text(message, color = tokens.colors.textMuted, style = MaterialTheme.typography.bodyMedium)
+        if (actionLabel != null) {
+            OutlinedButton(onClick = onAction) { Text(actionLabel) }
+        }
+    }
+}
