--- /dev/null
+++ b/composeApp/src/commonMain/kotlin/com/nuvio/app/features/youtube/YouTubeInnertube.kt
@@ -0,0 +1,411 @@
+package com.nuvio.app.features.youtube
+
+import com.nuvio.app.features.addons.httpRequestRaw
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonArray
+import kotlinx.serialization.json.JsonElement
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.contentOrNull
+import kotlinx.serialization.json.put
+import kotlinx.serialization.json.putJsonObject
+
+@Serializable
+enum class YtKind { VIDEO, CHANNEL, PLAYLIST }
+
+/** One card in a YouTube feed: a video, a Short, a playlist or a channel. */
+@Serializable
+data class YtItem(
+    val kind: YtKind = YtKind.VIDEO,
+    val id: String,
+    val title: String,
+    val channel: String = "",
+    val channelId: String = "",
+    val thumb: String = "",
+    val meta: String = "",
+    val duration: String = "",
+    val isShort: Boolean = false,
+    val isLive: Boolean = false,
+) {
+    val key: String get() = "${kind.name}:$id"
+    val durationSeconds: Int get() = parseDurationSeconds(duration)
+}
+
+data class YtPageResult(val items: List<YtItem>, val continuation: String?, val title: String = "")
+
+internal fun parseDurationSeconds(text: String): Int {
+    if (text.isBlank()) return 0
+    val parts = text.trim().split(':').map { it.trim().toIntOrNull() ?: return 0 }
+    return parts.fold(0) { acc, part -> acc * 60 + part }
+}
+
+/** "3 days ago" / "2 years ago" / "Streamed 5 hours ago" to minutes, for ordering mixed feeds. */
+internal fun ageMinutes(meta: String): Int {
+    val match = Regex("(\\d+)\\s+(second|minute|hour|day|week|month|year)s?\\s+ago").find(meta) ?: return Int.MAX_VALUE
+    val n = match.groupValues[1].toIntOrNull() ?: return Int.MAX_VALUE
+    return when (match.groupValues[2]) {
+        "second" -> 0
+        "minute" -> n
+        "hour" -> n * 60
+        "day" -> n * 1440
+        "week" -> n * 10080
+        "month" -> n * 43200
+        else -> n * 525600
+    }
+}
+
+/**
+ * Small anonymous YouTube "innertube" client (web client, no account). It reads the page version and
+ * visitor id from youtube.com once, then calls search/browse/next and turns the renderer JSON into [YtItem]s.
+ * Playback is not done here: videos are played through the app's existing YouTube resolver.
+ */
+internal object YtInnertube {
+    private const val API_KEY = "AIzaSyAO_FJ2SlqU8Q4STEHLGCilw_Y9_11qcW8"
+    private const val UA = "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36"
+    private const val BASE = "https://www.youtube.com"
+    const val VIDEOS_ONLY = "EgIQAQ=="
+    const val LIVE_ONLY = "EgJAAQ=="
+    const val CHANNEL_VIDEOS_TAB = "EgZ2aWRlb3PyBgQKAjoA"
+
+    private val json = Json { ignoreUnknownKeys = true; isLenient = true }
+    private val initMutex = Mutex()
+    private var initialized = false
+    private var clientVersion = "2.20260101.00.00"
+    private var visitorData: String? = null
+
+    private suspend fun ensureInit() {
+        if (initialized) return
+        initMutex.withLock {
+            if (initialized) return@withLock
+            runCatching {
+                val response = httpRequestRaw(
+                    method = "GET",
+                    url = "$BASE/",
+                    headers = mapOf(
+                        "User-Agent" to UA,
+                        "Accept-Language" to "en-US,en;q=0.9",
+                        "Cookie" to "SOCS=CAI",
+                    ),
+                    body = "",
+                    maxResponseBodyBytes = 6_000_000,
+                )
+                Regex("\"INNERTUBE_CLIENT_VERSION\":\"([^\"]+)\"").find(response.body)?.groupValues?.get(1)
+                    ?.let { clientVersion = it }
+                Regex("\"visitorData\":\"([^\"]+)\"").find(response.body)?.groupValues?.get(1)
+                    ?.let { visitorData = it }
+            }
+            initialized = true
+        }
+    }
+
+    private suspend fun post(endpoint: String, fill: kotlinx.serialization.json.JsonObjectBuilder.() -> Unit): JsonObject? {
+        ensureInit()
+        val visitor = visitorData
+        val body = buildJsonObject {
+            putJsonObject("context") {
+                putJsonObject("client") {
+                    put("clientName", "WEB")
+                    put("clientVersion", clientVersion)
+                    put("hl", "en")
+                    put("gl", "US")
+                    if (visitor != null) put("visitorData", visitor)
+                }
+            }
+            fill()
+        }.toString()
+        val headers = buildMap {
+            put("Content-Type", "application/json")
+            put("User-Agent", UA)
+            put("Origin", BASE)
+            put("Accept-Language", "en-US,en;q=0.9")
+            put("Cookie", "SOCS=CAI")
+            if (visitor != null) put("X-Goog-Visitor-Id", visitor)
+        }
+        val response = httpRequestRaw(
+            method = "POST",
+            url = "$BASE/youtubei/v1/$endpoint?key=$API_KEY&prettyPrint=false",
+            headers = headers,
+            body = body,
+            maxResponseBodyBytes = 12_000_000,
+        )
+        if (response.status !in 200..299) return null
+        return runCatching { json.parseToJsonElement(response.body) as? JsonObject }.getOrNull()
+    }
+
+    suspend fun search(query: String, params: String? = null): YtPageResult? {
+        val root = post("search") {
+            put("query", query)
+            if (params != null) put("params", params)
+        } ?: return null
+        return parse(root, "search")
+    }
+
+    suspend fun channel(channelId: String, videosTab: Boolean = true): YtPageResult? {
+        val root = post("browse") {
+            put("browseId", channelId)
+            if (videosTab) put("params", CHANNEL_VIDEOS_TAB)
+        } ?: return null
+        val name = path(root, "metadata", "channelMetadataRenderer")?.asObj()?.str("title")
+            ?: path(root, "header", "pageHeaderRenderer")?.asObj()?.str("pageTitle")
+            ?: ""
+        return parse(root, "browse").copy(title = name).let { page ->
+            // Videos on a channel page carry no channel name of their own in lockups' first row on some layouts.
+            page.copy(items = page.items.map { if (it.channelId.isBlank()) it.copy(channelId = channelId, channel = it.channel.ifBlank { name }) else it })
+        }
+    }
+
+    suspend fun playlist(playlistId: String): YtPageResult? {
+        val browseId = if (playlistId.startsWith("VL")) playlistId else "VL$playlistId"
+        val root = post("browse") { put("browseId", browseId) } ?: return null
+        val title = path(root, "header", "pageHeaderRenderer")?.asObj()?.str("pageTitle") ?: ""
+        return parse(root, "browse").copy(title = title)
+    }
+
+    /** Videos YouTube suggests after [videoId] (the "Up next" list). */
+    suspend fun related(videoId: String): List<YtItem> {
+        val root = post("next") { put("videoId", videoId) } ?: return emptyList()
+        return parse(root, "next").items.filter { it.kind == YtKind.VIDEO && it.id != videoId }
+    }
+
+    /** Channel id and name of the video's uploader, read from the watch-page data. */
+    suspend fun owner(videoId: String): Pair<String, String>? {
+        val root = post("next") { put("videoId", videoId) } ?: return null
+        val renderer = findObject(root, "videoOwnerRenderer") ?: return null
+        val id = findString(renderer["navigationEndpoint"], "browseId") ?: return null
+        return id to text(renderer["title"])
+    }
+
+    suspend fun continuation(token: String): YtPageResult? {
+        val endpoint = token.substringBefore(':')
+        val value = token.substringAfter(':')
+        if (endpoint !in setOf("search", "browse", "next")) return null
+        val root = post(endpoint) { put("continuation", value) } ?: return null
+        return parse(root, endpoint)
+    }
+
+    // --- parsing ---
+
+    private fun parse(root: JsonObject, endpoint: String): YtPageResult {
+        val items = LinkedHashMap<String, YtItem>()
+        var continuation: String? = null
+        fun walk(element: JsonElement?) {
+            when (element) {
+                is JsonObject -> for ((key, value) in element) {
+                    val obj = value as? JsonObject
+                    when (key) {
+                        "videoRenderer", "gridVideoRenderer", "compactVideoRenderer", "playlistVideoRenderer" ->
+                            obj?.let(::videoRenderer)?.let { items.putIfAbsent(it.key, it) }
+                        "lockupViewModel" -> obj?.let(::lockup)?.let { items.putIfAbsent(it.key, it) }
+                        "shortsLockupViewModel" -> obj?.let(::shortsLockup)?.let { items.putIfAbsent(it.key, it) }
+                        "playlistRenderer", "gridPlaylistRenderer" ->
+                            obj?.let(::playlistRenderer)?.let { items.putIfAbsent(it.key, it) }
+                        "channelRenderer", "gridChannelRenderer" ->
+                            obj?.let(::channelRenderer)?.let { items.putIfAbsent(it.key, it) }
+                        "continuationItemRenderer" -> {
+                            if (continuation == null && endpoint != "next") {
+                                val token = path(obj, "continuationEndpoint", "continuationCommand")?.asObj()?.str("token")
+                                    ?: findString(obj, "token")
+                                if (token != null) continuation = "$endpoint:$token"
+                            }
+                        }
+                        else -> walk(value)
+                    }
+                }
+                is JsonArray -> element.forEach(::walk)
+                else -> Unit
+            }
+        }
+        walk(root)
+        return YtPageResult(items.values.toList(), continuation)
+    }
+
+    private fun videoRenderer(r: JsonObject): YtItem? {
+        val id = r.str("videoId") ?: return null
+        val title = text(r["title"]).ifBlank { return null }
+        val byline = r["longBylineText"] ?: r["ownerText"] ?: r["shortBylineText"]
+        val channelId = findString(byline, "browseId").orEmpty()
+        val duration = text(r["lengthText"])
+        val views = text(r["viewCountText"]).ifBlank { text(r["shortViewCountText"]) }
+        val live = views.contains("watching", ignoreCase = true) ||
+            r["thumbnailOverlays"].toString().contains("\"LIVE\"")
+        val url = path(r, "navigationEndpoint", "commandMetadata", "webCommandMetadata")?.asObj()?.str("url").orEmpty()
+        val short = url.startsWith("/shorts/") || r["thumbnailOverlays"].toString().contains("\"SHORTS\"")
+        return YtItem(
+            kind = YtKind.VIDEO,
+            id = id,
+            title = title,
+            channel = text(byline),
+            channelId = channelId,
+            thumb = bestThumb(r["thumbnail"]) ?: "https://i.ytimg.com/vi/$id/hqdefault.jpg",
+            meta = listOf(views, text(r["publishedTimeText"])).filter { it.isNotBlank() }.joinToString(" • "),
+            duration = if (live) "" else duration,
+            isShort = short,
+            isLive = live,
+        )
+    }
+
+    private fun lockup(l: JsonObject): YtItem? {
+        val id = l.str("contentId") ?: return null
+        val type = l.str("contentType").orEmpty()
+        val kind = when {
+            type.endsWith("VIDEO") -> YtKind.VIDEO
+            type.contains("PLAYLIST") || type.contains("PODCAST") -> YtKind.PLAYLIST
+            type.contains("CHANNEL") -> YtKind.CHANNEL
+            else -> return null
+        }
+        // Radio mixes (RD...) are generated per video and cannot be browsed as a playlist.
+        if (kind == YtKind.PLAYLIST && id.startsWith("RD")) return null
+        val meta = path(l, "metadata", "lockupMetadataViewModel")?.asObj() ?: return null
+        val title = path(meta, "title")?.asObj()?.str("content").orEmpty().ifBlank { return null }
+        val rows = (path(meta, "metadata", "contentMetadataViewModel", "metadataRows") as? JsonArray)
+            ?.mapNotNull { row ->
+                (row.asObj()?.get("metadataParts") as? JsonArray)?.mapNotNull { part ->
+                    path(part, "text")?.asObj()?.str("content")?.takeIf { it.isNotBlank() }
+                }?.takeIf { it.isNotEmpty() }
+            }.orEmpty()
+        val badge = findObject(l["contentImage"], "thumbnailBadgeViewModel")?.str("text").orEmpty()
+        val thumbSources = findArray(l["contentImage"], "sources")
+        val thumb = thumbSources?.lastOrNull()?.asObj()?.str("url")
+            ?: if (kind == YtKind.VIDEO) "https://i.ytimg.com/vi/$id/hqdefault.jpg" else ""
+        return when (kind) {
+            YtKind.VIDEO -> {
+                val channelRow = rows.getOrNull(0)
+                val metaRow = rows.getOrNull(1)
+                val channelId = findString(
+                    (path(meta, "metadata", "contentMetadataViewModel", "metadataRows") as? JsonArray)?.firstOrNull(),
+                    "browseId",
+                ).orEmpty()
+                YtItem(
+                    kind = kind,
+                    id = id,
+                    title = title,
+                    channel = channelRow?.firstOrNull().orEmpty(),
+                    channelId = channelId,
+                    thumb = thumb,
+                    meta = metaRow?.joinToString(" • ").orEmpty(),
+                    duration = if (badge.contains(':')) badge else "",
+                    isLive = metaRow?.any { it.contains("watching", ignoreCase = true) } == true,
+                )
+            }
+            else -> YtItem(
+                kind = kind,
+                id = id,
+                title = title,
+                channel = if (kind == YtKind.PLAYLIST) rows.getOrNull(0)?.firstOrNull().orEmpty() else "",
+                thumb = thumb,
+                meta = listOfNotNull(badge.takeIf { it.isNotBlank() }, rows.getOrNull(1)?.joinToString(" • ")).joinToString(" • "),
+            )
+        }
+    }
+
+    private fun shortsLockup(s: JsonObject): YtItem? {
+        val id = path(s, "onTap", "innertubeCommand", "reelWatchEndpoint")?.asObj()?.str("videoId")
+            ?: s.str("entityId")?.removePrefix("shorts-shelf-item-")?.takeIf { it.length == 11 }
+            ?: return null
+        val overlay = s["overlayMetadata"]?.asObj()
+        val title = path(overlay, "primaryText")?.asObj()?.str("content")
+            ?: s.str("accessibilityText")?.substringBeforeLast(" - play Short")?.substringBeforeLast(", ")
+            ?: return null
+        val thumb = findArray(s["thumbnailViewModel"], "sources")?.firstOrNull()?.asObj()?.str("url")
+            ?: "https://i.ytimg.com/vi/$id/hqdefault.jpg"
+        return YtItem(
+            kind = YtKind.VIDEO,
+            id = id,
+            title = title,
+            thumb = thumb,
+            meta = path(overlay, "secondaryText")?.asObj()?.str("content").orEmpty(),
+            isShort = true,
+        )
+    }
+
+    private fun playlistRenderer(p: JsonObject): YtItem? {
+        val id = p.str("playlistId") ?: return null
+        if (id.startsWith("RD")) return null
+        val title = text(p["title"]).ifBlank { return null }
+        val thumbs = p["thumbnails"] as? JsonArray
+        val thumb = thumbs?.firstOrNull()?.let { bestThumb(it) } ?: bestThumb(p["thumbnail"]).orEmpty()
+        val count = p.str("videoCount")?.let { "$it videos" }.orEmpty()
+        return YtItem(
+            kind = YtKind.PLAYLIST,
+            id = id,
+            title = title,
+            channel = text(p["longBylineText"] ?: p["shortBylineText"]),
+            thumb = thumb,
+            meta = count,
+        )
+    }
+
+    private fun channelRenderer(c: JsonObject): YtItem? {
+        val id = c.str("channelId") ?: return null
+        val title = text(c["title"]).ifBlank { return null }
+        val thumb = bestThumb(c["thumbnail"])?.let { if (it.startsWith("//")) "https:$it" else it }.orEmpty()
+        val meta = listOf(text(c["subscriberCountText"]), text(c["videoCountText"])).filter { it.isNotBlank() }.joinToString(" • ")
+        return YtItem(kind = YtKind.CHANNEL, id = id, title = title, channelId = id, thumb = thumb, meta = meta)
+    }
+
+    // --- JSON helpers ---
+
+    private fun JsonElement?.asObj(): JsonObject? = this as? JsonObject
+
+    private fun JsonObject.str(key: String): String? = (this[key] as? JsonPrimitive)?.contentOrNull
+
+    private fun path(root: JsonElement?, vararg keys: String): JsonElement? {
+        var current: JsonElement? = root
+        for (key in keys) current = (current as? JsonObject)?.get(key) ?: return null
+        return current
+    }
+
+    private fun text(element: JsonElement?): String {
+        val obj = element as? JsonObject ?: return (element as? JsonPrimitive)?.contentOrNull.orEmpty()
+        obj.str("simpleText")?.let { return it }
+        obj.str("content")?.let { return it }
+        val runs = obj["runs"] as? JsonArray ?: return ""
+        return runs.joinToString("") { it.asObj()?.str("text").orEmpty() }
+    }
+
+    private fun bestThumb(element: JsonElement?): String? {
+        val obj = element as? JsonObject ?: return null
+        val list = obj["thumbnails"] as? JsonArray ?: return null
+        return list.lastOrNull()?.asObj()?.str("url")
+    }
+
+    private fun findString(element: JsonElement?, key: String): String? {
+        when (element) {
+            is JsonObject -> {
+                (element[key] as? JsonPrimitive)?.contentOrNull?.let { return it }
+                for (value in element.values) findString(value, key)?.let { return it }
+            }
+            is JsonArray -> for (value in element) findString(value, key)?.let { return it }
+            else -> Unit
+        }
+        return null
+    }
+
+    private fun findObject(element: JsonElement?, key: String): JsonObject? {
+        when (element) {
+            is JsonObject -> {
+                (element[key] as? JsonObject)?.let { return it }
+                for (value in element.values) findObject(value, key)?.let { return it }
+            }
+            is JsonArray -> for (value in element) findObject(value, key)?.let { return it }
+            else -> Unit
+        }
+        return null
+    }
+
+    private fun findArray(element: JsonElement?, key: String): JsonArray? {
+        when (element) {
+            is JsonObject -> {
+                (element[key] as? JsonArray)?.let { return it }
+                for (value in element.values) findArray(value, key)?.let { return it }
+            }
+            is JsonArray -> for (value in element) findArray(value, key)?.let { return it }
+            else -> Unit
+        }
+        return null
+    }
+}
