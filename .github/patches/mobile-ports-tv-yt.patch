+/** Opens a video in the app's full player: item and the position to start from. */
+private val LocalFullPlayer = staticCompositionLocalOf<(YtItem, Long) -> Unit> { { _, _ -> } }
+
+private fun openItem(item: YtItem, siblings: List<YtItem>) {
+    if (item.kind == YtKind.VIDEO && item.isShort) {
+        YouTubeRepository.openShortsAt(item, siblings)
+        YouTubeRepository.push(YtPage.Shorts)
+    } else {
+        YouTubeRepository.play(item)
+    }
+}
