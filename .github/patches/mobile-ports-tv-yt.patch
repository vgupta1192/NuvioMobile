+@Composable
+private fun RootContent(tab: Int, onTab: (Int) -> Unit) {
+    val tokens = MaterialTheme.nuvio
+    val horizontal = tokens.spacing.screenHorizontal
+    Column(Modifier.fillMaxSize()) {
+        if (tab != 2) {
+            SearchField(Modifier.padding(horizontal = horizontal))
+            Spacer(Modifier.height(10.dp))
+        }
+        LazyRow(
+            contentPadding = PaddingValues(horizontal = horizontal),
+            horizontalArrangement = Arrangement.spacedBy(8.dp),
+        ) {
+            val labels = listOf("Home", "Subscriptions", "Shorts", "Saved")
+            items(labels.size) { index ->
+                Pill(text = labels[index], selected = tab == index) { onTab(index) }
+            }
+        }
+        Spacer(Modifier.height(12.dp))
+        when (tab) {
+            0 -> HomeTab()
+            1 -> SubscriptionsTab()
+            2 -> ShortsHost(Modifier.weight(1f))
+            else -> SavedTab()
+        }
+    }
+}
