+            override fun getVideoQualities(): List<VideoQualityOption> {
+                val count = bridge.getProperty("track-list/count").toIntOrNull() ?: return emptyList()
+                val variants = ArrayList<Triple<Int, Int, Boolean>>()
+                for (i in 0 until count) {
+                    if (bridge.getProperty("track-list/$i/type") != "video") continue
+                    if (bridge.getProperty("track-list/$i/albumart") == "yes") continue
+                    val height = bridge.getProperty("track-list/$i/demux-h").toIntOrNull() ?: continue
+                    if (height <= 0) continue
+                    val bitrate = bridge.getProperty("track-list/$i/hls-bitrate").toIntOrNull() ?: 0
+                    variants += Triple(height, bitrate, bridge.getProperty("track-list/$i/selected") == "yes")
+                }
+                if (variants.size < 2) return emptyList()
+                return variants
+                    .groupBy { it.first }
+                    .map { (height, group) ->
+                        val bitrate = group.maxOf { it.second }
+                        VideoQualityOption(
+                            heightPx = height,
+                            label = "${height}p",
+                            bitrate = bitrate.takeIf { it > 0 },
+                            isSelected = group.any { it.third },
+                        )
+                    }
+                    .sortedByDescending { it.heightPx }
+            }
+
+            override fun selectVideoQuality(heightPx: Int?) {
+                if (heightPx == null) {
+                    bridge.setProperty("vid", "auto")
+                    return
+                }
+                val count = bridge.getProperty("track-list/count").toIntOrNull() ?: return
+                var bestId: String? = null
+                var bestBitrate = -1
+                for (i in 0 until count) {
+                    if (bridge.getProperty("track-list/$i/type") != "video") continue
+                    if (bridge.getProperty("track-list/$i/demux-h").toIntOrNull() != heightPx) continue
+                    val bitrate = bridge.getProperty("track-list/$i/hls-bitrate").toIntOrNull() ?: 0
+                    if (bitrate > bestBitrate) {
+                        bestBitrate = bitrate
+                        bestId = bridge.getProperty("track-list/$i/id").ifBlank { null }
+                    }
+                }
+                bestId?.let { bridge.setProperty("vid", it) }
+            }
