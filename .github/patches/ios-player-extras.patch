--- /dev/null
+++ b/composeApp/src/commonMain/kotlin/com/nuvio/app/features/player/PlayerAudioDelay.kt
@@ -0,0 +1,18 @@
+package com.nuvio.app.features.player
+
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+const val AUDIO_DELAY_MIN_MS = -2000
+const val AUDIO_DELAY_MAX_MS = 2000
+
+/** Manual audio delay in milliseconds (positive plays the sound later); applied by the iOS mpv player. */
+object PlayerAudioDelay {
+    private val _delayMs = MutableStateFlow(0)
+    val delayMs: StateFlow<Int> = _delayMs.asStateFlow()
+
+    fun set(value: Int) {
+        _delayMs.value = value.coerceIn(AUDIO_DELAY_MIN_MS, AUDIO_DELAY_MAX_MS)
+    }
+}
