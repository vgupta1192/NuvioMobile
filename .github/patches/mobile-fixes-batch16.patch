+package com.nuvio.app.features.settings
+
+import androidx.compose.foundation.layout.Row
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.foundation.layout.padding
+import androidx.compose.material3.Switch
+import androidx.compose.material3.Text
+import androidx.compose.material3.TextButton
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.getValue
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.unit.dp
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import com.nuvio.app.features.player.ForkButtonLayout
+import com.nuvio.app.features.player.ForkLegacyBottomButtons
+import com.nuvio.app.features.player.ForkLegacyTopButtons
+import com.nuvio.app.features.player.ForkPlayerToolbar
+
+@Composable
+internal fun ForkPlayerButtonsSettingsSection(isTablet: Boolean) {
+    ForkButtonLayoutSection(
+        title = "Player toolbar (standard layout)",
+        layout = ForkPlayerToolbar,
+        resetLabel = "Reset toolbar",
+        isTablet = isTablet,
+    )
+    ForkButtonLayoutSection(
+        title = "Legacy player: top buttons",
+        layout = ForkLegacyTopButtons,
+        resetLabel = "Reset top buttons",
+        isTablet = isTablet,
+    )
+    ForkButtonLayoutSection(
+        title = "Legacy player: bottom buttons",
+        layout = ForkLegacyBottomButtons,
+        resetLabel = "Reset bottom buttons",
+        isTablet = isTablet,
+    )
+}
+
+@Composable
+private fun ForkButtonLayoutSection(
+    title: String,
+    layout: ForkButtonLayout,
+    resetLabel: String,
+    isTablet: Boolean,
+) {
+    val entries by layout.entries.collectAsStateWithLifecycle()
+    LaunchedEffect(layout) { layout.ensureLoaded() }
+    SettingsSection(title = title, isTablet = isTablet) {
+        SettingsGroup(isTablet = isTablet) {
+            entries.forEachIndexed { index, entry ->
+                val label = layout.buttons.firstOrNull { it.id == entry.id }?.label ?: entry.id
+                Row(
+                    modifier = Modifier.fillMaxWidth().padding(horizontal = 16.dp, vertical = 4.dp),
+                    verticalAlignment = Alignment.CenterVertically,
+                ) {
+                    Text(text = label, modifier = Modifier.weight(1f))
+                    TextButton(onClick = { layout.move(entry.id, -1) }, enabled = index > 0) { Text("Up") }
+                    TextButton(onClick = { layout.move(entry.id, 1) }, enabled = index < entries.lastIndex) { Text("Down") }
+                    Switch(checked = entry.visible, onCheckedChange = { layout.setVisible(entry.id, it) })
+                }
+                if (index < entries.lastIndex) SettingsGroupDivider(isTablet = isTablet)
+            }
+            SettingsGroupDivider(isTablet = isTablet)
+            TextButton(onClick = { layout.reset() }, modifier = Modifier.padding(horizontal = 8.dp)) { Text(resetLabel) }
+        }
+    }
+}
