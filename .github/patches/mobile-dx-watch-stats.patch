+
+/** dx.bi port: "Your stats" page (hours watched, streaks, top titles and genres). Count switch and reset live here. */
+@Composable
+internal fun DxWatchStatsSettingsSection(isTablet: Boolean) {
+    LaunchedEffect(Unit) { DxWatchStats.ensureLoaded() }
+    val enabled by DxWatchStats.enabled.collectAsStateWithLifecycle()
+    var open by remember { mutableStateOf(false) }
+    SettingsSection(title = "Your stats", isTablet = isTablet) {
+        SettingsGroup(isTablet = isTablet) {
+            SettingsNavigationRow(
+                title = "Your stats",
+                description = "Hours watched, streaks, your most watched titles and top genres.",
+                isTablet = isTablet,
+                onClick = { open = true },
+            )
+            SettingsGroupDivider(isTablet = isTablet)
+            SettingsSwitchRow(
+                title = "Count watch time",
+                description = "Counts the time a video is really playing, on this device only. Off stops counting; what is already counted stays.",
+                checked = enabled,
+                isTablet = isTablet,
+                onCheckedChange = DxWatchStats::setEnabled,
+            )
+        }
+    }
+    if (open) DxWatchStatsDialog(onDismiss = { open = false })
+}
+
+private fun hoursText(seconds: Double): String {
+    val s = seconds.roundToInt()
+    if (s < 60) return if (s > 0) "<1m" else "0m"
+    val h = s / 3600
+    val m = (s % 3600) / 60
+    return if (h > 0) "${h}h ${m.toString().padStart(2, '0')}m" else "${m}m"
+}
+
+@Composable
+private fun DxWatchStatsDialog(onDismiss: () -> Unit) {
+    val progress by WatchProgressRepository.uiState.collectAsStateWithLifecycle()
+    val watched by remember {
+        WatchedRepository.ensureLoaded()
+        WatchedRepository.uiState
+    }.collectAsStateWithLifecycle()
+    var refresh by remember { mutableStateOf(0) }
+    DisposableEffect(Unit) { onDispose { DxWatchStats.flush() } }
+    val summary = remember(progress.entries, refresh) { DxWatchStats.summary(progress.entries) }
+    val films = remember(watched.items) { watched.items.count { it.season == null && it.type.equals("movie", true) } }
+    val series = remember(watched.items) { watched.items.filter { it.season != null || !it.type.equals("movie", true) }.map { it.id }.toSet().size }
+
+    Dialog(
+        onDismissRequest = onDismiss,
+        properties = DialogProperties(usePlatformDefaultWidth = false, decorFitsSystemWindows = false),
+    ) {
+        Box(
+            modifier = Modifier
+                .fillMaxSize()
+                .background(MaterialTheme.colorScheme.background),
+        ) {
+            Column(modifier = Modifier.fillMaxSize()) {
+                Row(
+                    modifier = Modifier.fillMaxWidth().padding(start = 20.dp, end = 8.dp, top = 28.dp, bottom = 8.dp),
+                    verticalAlignment = Alignment.CenterVertically,
+                ) {
+                    Column(modifier = Modifier.weight(1f)) {
+                        Text("Your stats", style = MaterialTheme.typography.headlineSmall, color = MaterialTheme.colorScheme.onBackground)
+                        Text(
+                            "${hoursText(summary.total)} in total, counted since ${summary.since}",
+                            style = MaterialTheme.typography.bodySmall,
+                            color = MaterialTheme.colorScheme.onSurfaceVariant,
+                        )
+                    }
+                    TextButton(onClick = onDismiss) { Text("Close") }
+                }
+                DxWatchStatsBody(summary = summary, films = films, series = series, onReset = {
+                    DxWatchStats.reset()
+                    refresh++
+                })
+            }
+        }
+    }
+}
+
+@OptIn(ExperimentalLayoutApi::class)
+@Composable
+private fun DxWatchStatsBody(summary: DxStatSummary, films: Int, series: Int, onReset: () -> Unit) {
+    val muted = MaterialTheme.colorScheme.onSurfaceVariant
+    val primary = MaterialTheme.colorScheme.primary
+    Column(
+        modifier = Modifier.fillMaxSize().verticalScroll(rememberScrollState()).padding(horizontal = 20.dp),
+        verticalArrangement = Arrangement.spacedBy(18.dp),
+    ) {
+        FlowRow(horizontalArrangement = Arrangement.spacedBy(10.dp), verticalArrangement = Arrangement.spacedBy(10.dp)) {
+            StatTile("Today", hoursText(summary.today))
+            StatTile("This week", hoursText(summary.week))
+            StatTile("This month", hoursText(summary.month))
+            StatTile(summary.yearLabel, hoursText(summary.year))
+            StatTile(
+                "Streak",
+                "${summary.currentStreak} day${if (summary.currentStreak == 1) "" else "s"}",
+                "best ${summary.bestStreak}",
+            )
+        }
+
+        Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+            SectionLabel("Last 30 days")
+            val peak = summary.last30.maxOfOrNull { it.second }?.coerceAtLeast(1.0) ?: 1.0
+            Row(
+                modifier = Modifier.fillMaxWidth().height(72.dp),
+                horizontalArrangement = Arrangement.spacedBy(2.dp),
+                verticalAlignment = Alignment.Bottom,
+            ) {
+                summary.last30.forEach { (_, sec) ->
+                    val fraction = if (sec <= 0.0) 0.04f else (sec / peak).toFloat().coerceIn(0.06f, 1f)
+                    Box(
+                        modifier = Modifier
+                            .weight(1f)
+                            .fillMaxHeight(fraction)
+                            .clip(RoundedCornerShape(topStart = 2.dp, topEnd = 2.dp))
+                            .background(if (sec <= 0.0) muted.copy(alpha = 0.25f) else primary),
+                    )
+                }
+            }
+        }
+
+        Column(verticalArrangement = Arrangement.spacedBy(10.dp)) {
+            SectionLabel("Most watched in ${summary.yearLabel}")
+            if (summary.topTitles.isEmpty()) {
+                Text("Nothing yet this year. Start watching and it shows up here.", style = MaterialTheme.typography.bodyMedium, color = muted)
+            } else {
+                summary.topTitles.forEachIndexed { index, row -> TopTitleRow(index + 1, row) }
+            }
+        }
+
+        Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+            SectionLabel("Top genres in ${summary.yearLabel}")
+            if (summary.topGenres.isEmpty()) {
+                Text("Genres appear once you have watched a few titles with the counter on.", style = MaterialTheme.typography.bodyMedium, color = muted)
+            } else {
+                val genreTotal = summary.topGenres.sumOf { it.second }.coerceAtLeast(1.0)
+                summary.topGenres.forEach { (genre, sec) ->
+                    val percent = ((sec / genreTotal) * 100).roundToInt()
+                    Row(verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(10.dp)) {
+                        Text(genre, modifier = Modifier.width(96.dp), style = MaterialTheme.typography.bodyMedium, maxLines = 1, overflow = TextOverflow.Ellipsis, color = MaterialTheme.colorScheme.onBackground)
+                        Box(modifier = Modifier.weight(1f).height(8.dp).clip(RoundedCornerShape(4.dp)).background(muted.copy(alpha = 0.25f))) {
+                            Box(modifier = Modifier.fillMaxHeight().fillMaxWidth(percent / 100f).background(primary))
+                        }
+                        Text("$percent%", style = MaterialTheme.typography.labelMedium, color = muted)
+                    }
+                }
+            }
+        }
+
+        Column(verticalArrangement = Arrangement.spacedBy(6.dp)) {
+            SectionLabel("Habits")
+            FactRow("Busiest day", summary.busiestWeekday ?: "-")
+            FactRow("Marked as watched", "$films film${if (films == 1) "" else "s"} and $series series")
+            if (summary.estimated > 0.0) {
+                FactRow("Estimated from your history", hoursText(summary.estimated))
+            }
+        }
+
+        Text(
+            "Stats stay on this device. Only time spent actually playing counts; watching before the counter started is estimated from your saved progress, and genres only count from now on.",
+            style = MaterialTheme.typography.bodySmall,
+            color = muted,
+        )
+        TextButton(onClick = onReset) { Text("Reset my stats") }
+        Box(modifier = Modifier.height(24.dp))
+    }
+}
+
+@Composable
+private fun SectionLabel(text: String) {
+    Text(
+        text.uppercase(),
+        style = MaterialTheme.typography.labelMedium,
+        color = MaterialTheme.colorScheme.onSurfaceVariant,
+        fontWeight = FontWeight.SemiBold,
+    )
+}
+
+@Composable
+private fun StatTile(label: String, value: String, note: String? = null) {
+    Column(
+        modifier = Modifier
+            .width(104.dp)
+            .clip(RoundedCornerShape(12.dp))
+            .background(MaterialTheme.colorScheme.surface)
+            .padding(12.dp),
+        verticalArrangement = Arrangement.spacedBy(2.dp),
+    ) {
+        Text(label, style = MaterialTheme.typography.labelSmall, color = MaterialTheme.colorScheme.onSurfaceVariant, maxLines = 1)
+        Text(value, style = MaterialTheme.typography.titleMedium, color = MaterialTheme.colorScheme.onSurface, fontWeight = FontWeight.SemiBold, maxLines = 1)
+        if (note != null) Text(note, style = MaterialTheme.typography.labelSmall, color = MaterialTheme.colorScheme.onSurfaceVariant)
+    }
+}
+
+@Composable
+private fun FactRow(label: String, value: String) {
+    Row(modifier = Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween) {
+        Text(label, style = MaterialTheme.typography.bodyMedium, color = MaterialTheme.colorScheme.onSurfaceVariant)
+        Text(value, style = MaterialTheme.typography.bodyMedium, color = MaterialTheme.colorScheme.onBackground, fontWeight = FontWeight.Medium)
+    }
+}
+
+@Composable
+private fun TopTitleRow(rank: Int, row: DxStatRow) {
+    Row(verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(12.dp)) {
+        Text("$rank", modifier = Modifier.width(18.dp), style = MaterialTheme.typography.titleMedium, color = MaterialTheme.colorScheme.onSurfaceVariant)
+        Box(
+            modifier = Modifier
+                .width(36.dp)
+                .height(54.dp)
+                .clip(RoundedCornerShape(6.dp))
+                .background(MaterialTheme.colorScheme.surface),
+        ) {
+            if (!row.poster.isNullOrBlank()) {
+                AsyncImage(model = row.poster, contentDescription = row.name, modifier = Modifier.fillMaxSize(), contentScale = ContentScale.Crop)
+            }
+        }
+        Column(modifier = Modifier.weight(1f)) {
+            Text(row.name, style = MaterialTheme.typography.bodyLarge, maxLines = 1, overflow = TextOverflow.Ellipsis, color = MaterialTheme.colorScheme.onBackground)
+            val kind = if (row.type.equals("movie", true)) "Film" else "Series"
+            Text("$kind - ${hoursText(row.seconds)}", style = MaterialTheme.typography.bodySmall, color = MaterialTheme.colorScheme.onSurfaceVariant)
+        }
+    }
+}
