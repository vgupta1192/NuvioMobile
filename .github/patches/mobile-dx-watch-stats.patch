+package com.nuvio.app.features.player
+
+import com.nuvio.app.core.storage.AppFileCache
+import com.nuvio.app.core.time.EpisodeReleaseDatePlatform
+import com.nuvio.app.features.watchprogress.WatchProgressClock
+import com.nuvio.app.features.watchprogress.WatchProgressEntry
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.json.Json
+
+@Serializable
+internal data class DxStatTitle(
+    val n: String = "",
+    val t: String = "",
+    val p: String? = null,
+    val s: Double = 0.0,
+    val y: Map<String, Double> = emptyMap(),
+)
+
+@Serializable
+internal data class DxStatData(
+    val since: Long = 0L,
+    val days: Map<String, Double> = emptyMap(),
+    val titles: Map<String, DxStatTitle> = emptyMap(),
+    val genres: Map<String, Map<String, Double>> = emptyMap(),
+)
+
+internal data class DxStatRow(val name: String, val type: String, val poster: String?, val seconds: Double)
+
+internal data class DxStatSummary(
+    val today: Double,
+    val week: Double,
+    val month: Double,
+    val year: Double,
+    val total: Double,
+    val currentStreak: Int,
+    val bestStreak: Int,
+    val last30: List<Pair<String, Double>>,
+    val topTitles: List<DxStatRow>,
+    val topGenres: List<Pair<String, Double>>,
+    val busiestWeekday: String?,
+    val yearLabel: String,
+    val since: String,
+    val estimated: Double,
+)
+
+/**
+ * dx.bi port: "Your stats". Counts the seconds a video is really playing (same rule as the plugin: wall-clock
+ * time between playback updates, gaps over 5 s do not count), per day, per title and per genre, on this device
+ * only. Time before tracking started is estimated from the watch progress already stored (position or full
+ * length per episode or film, on the day it was last updated), so the page is not empty on day one.
+ */
+internal object DxWatchStats {
+    private const val PATH = "settings/dx_watch_stats"
+    private const val ENABLED_PATH = "settings/dx_watch_stats_enabled"
+    private const val MAX_GAP_MS = 5_000L
+    private val json = Json { ignoreUnknownKeys = true; encodeDefaults = true }
+
+    private val _enabled = MutableStateFlow(true)
+    val enabled: StateFlow<Boolean> = _enabled.asStateFlow()
+    private var data = DxStatData()
+    private var loaded = false
+    private var unsaved = 0.0
+    private var lastTickMs = 0L
+
+    fun ensureLoaded() {
+        if (loaded) return
+        loaded = true
+        _enabled.value = runCatching { AppFileCache.read(ENABLED_PATH)?.trim() }.getOrNull() != "0"
+        data = runCatching {
+            AppFileCache.read(PATH)?.let { json.decodeFromString(DxStatData.serializer(), it) }
+        }.getOrNull() ?: DxStatData()
+        if (data.since == 0L) data = data.copy(since = WatchProgressClock.nowEpochMs())
+    }
+
+    fun setEnabled(on: Boolean) {
+        ensureLoaded()
+        _enabled.value = on
+        lastTickMs = 0L
+        runCatching { AppFileCache.write(ENABLED_PATH, if (on) "1" else "0") }
+    }
+
+    fun reset() {
+        ensureLoaded()
+        data = DxStatData(since = WatchProgressClock.nowEpochMs())
+        unsaved = 0.0
+        runCatching { AppFileCache.write(PATH, json.encodeToString(DxStatData.serializer(), data)) }
+    }
+
+    /** Called on every player position update. */
+    fun tick(
+        isPlaying: Boolean,
+        titleId: String,
+        titleType: String,
+        titleName: String,
+        poster: String?,
+        genres: List<String>,
+    ) {
+        ensureLoaded()
+        val now = WatchProgressClock.nowEpochMs()
+        if (!_enabled.value || !isPlaying || PrivateViewing.isEnabled()) {
+            lastTickMs = 0L
+            return
+        }
+        val previous = lastTickMs
+        lastTickMs = now
+        val gap = now - previous
+        if (previous == 0L || gap <= 0L || gap > MAX_GAP_MS) return
+        add(gap / 1000.0, now, titleId, titleType, titleName, poster, genres)
+    }
+
+    private fun add(
+        seconds: Double,
+        now: Long,
+        id: String,
+        type: String,
+        name: String,
+        poster: String?,
+        genres: List<String>,
+    ) {
+        val day = dayKey(now)
+        val year = day.take(4)
+        val days = data.days.toMutableMap()
+        days[day] = (days[day] ?: 0.0) + seconds
+        val titles = data.titles.toMutableMap()
+        if (id.isNotBlank()) {
+            val old = titles[id] ?: DxStatTitle()
+            val y = old.y.toMutableMap()
+            y[year] = (y[year] ?: 0.0) + seconds
+            titles[id] = old.copy(
+                n = name.ifBlank { old.n },
+                t = type.ifBlank { old.t },
+                p = poster ?: old.p,
+                s = old.s + seconds,
+                y = y,
+            )
+        }
+        val genreMap = data.genres.toMutableMap()
+        genres.take(3).forEach { genre ->
+            val entry = (genreMap[genre] ?: emptyMap()).toMutableMap()
+            entry[year] = (entry[year] ?: 0.0) + seconds
+            genreMap[genre] = entry
+        }
+        data = data.copy(days = days, titles = titles, genres = genreMap)
+        unsaved += seconds
+        if (unsaved >= 30.0) flush()
+    }
+
+    fun flush() {
+        if (!loaded || unsaved <= 0.0) return
+        unsaved = 0.0
+        // keep it compact: about two years of days and the 400 most watched titles
+        var d = data
+        if (d.days.size > 800) d = d.copy(days = d.days.entries.sortedBy { it.key }.takeLast(800).associate { it.key to it.value })
+        if (d.titles.size > 400) d = d.copy(titles = d.titles.entries.sortedByDescending { it.value.s }.take(400).associate { it.key to it.value })
+        data = d
+        runCatching { AppFileCache.write(PATH, json.encodeToString(DxStatData.serializer(), d)) }
+    }
+
+    fun summary(history: List<WatchProgressEntry>): DxStatSummary {
+        ensureLoaded()
+        flush()
+        val now = WatchProgressClock.nowEpochMs()
+        val todayKey = dayKey(now)
+        val year = todayKey.take(4)
+        val days = data.days.toMutableMap()
+        val titles = data.titles.mapValues { it.value.copy(y = it.value.y.toMutableMap()) }.toMutableMap()
+        // estimate from stored progress for everything that happened before tracking started
+        var estimated = 0.0
+        history.forEach { entry ->
+            if (entry.lastUpdatedEpochMs <= 0L || entry.lastUpdatedEpochMs >= data.since) return@forEach
+            val ms = if (entry.isEffectivelyCompleted && entry.durationMs > 0L) entry.durationMs else entry.lastPositionMs
+            val sec = ms / 1000.0
+            if (sec < 30.0) return@forEach
+            estimated += sec
+            val key = dayKey(entry.lastUpdatedEpochMs)
+            days[key] = (days[key] ?: 0.0) + sec
+            val y = key.take(4)
+            val old = titles[entry.parentMetaId] ?: DxStatTitle()
+            val ys = old.y.toMutableMap()
+            ys[y] = (ys[y] ?: 0.0) + sec
+            titles[entry.parentMetaId] = old.copy(
+                n = entry.title.ifBlank { old.n },
+                t = entry.parentMetaType.ifBlank { old.t },
+                p = entry.poster ?: old.p,
+                s = old.s + sec,
+                y = ys,
+            )
+        }
+        val todayEpochDay = epochDay(todayKey)
+        fun sumFrom(fromDay: Long): Double = days.entries.fold(0.0) { acc, e -> if (epochDay(e.key) in fromDay..todayEpochDay) acc + e.value else acc }
+        val weekStart = todayEpochDay - ((todayEpochDay + 3) % 7)
+        val monthStart = epochDay(todayKey.take(8) + "01")
+        val yearStart = epochDay("$year-01-01")
+        val active = days.filter { it.value >= 60.0 }.keys.map { epochDay(it) }.toSet()
+        var best = 0
+        var run = 0
+        var prev = Long.MIN_VALUE
+        active.sorted().forEach { d ->
+            run = if (prev != Long.MIN_VALUE && d - prev == 1L) run + 1 else 1
+            best = maxOf(best, run)
+            prev = d
+        }
+        var current = 0
+        var cursor = todayEpochDay
+        if (cursor !in active) cursor -= 1
+        while (cursor in active) {
+            current++
+            cursor -= 1
+        }
+        val last30 = (29 downTo 0).map { i ->
+            val k = dayKeyOfEpochDay(todayEpochDay - i)
+            k to (days[k] ?: 0.0)
+        }
+        val top = titles.entries
+            .map { (_, t) -> DxStatRow(t.n.ifBlank { "Untitled" }, t.t, t.p, t.y[year] ?: 0.0) }
+            .filter { it.seconds > 0.0 }
+            .sortedByDescending { it.seconds }
+            .take(6)
+        val genres = data.genres.entries
+            .map { it.key to (it.value[year] ?: 0.0) }
+            .filter { it.second > 0.0 }
+            .sortedByDescending { it.second }
+            .take(6)
+        val weekdayNames = listOf("Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday")
+        val byWeekday = DoubleArray(7)
+        days.forEach { (k, v) -> if (k.startsWith(year)) byWeekday[((epochDay(k) + 3) % 7).toInt()] += v }
+        val busiest = byWeekday.withIndex().maxByOrNull { it.value }?.takeIf { it.value > 0.0 }?.let { weekdayNames[it.index] }
+        return DxStatSummary(
+            today = days[todayKey] ?: 0.0,
+            week = sumFrom(weekStart),
+            month = sumFrom(monthStart),
+            year = sumFrom(yearStart),
+            total = days.values.sum(),
+            currentStreak = current,
+            bestStreak = best,
+            last30 = last30,
+            topTitles = top,
+            topGenres = genres,
+            busiestWeekday = busiest,
+            yearLabel = year,
+            since = dayKey(data.since),
+            estimated = estimated,
+        )
+    }
+
+    private fun dayKey(epochMs: Long): String =
+        EpisodeReleaseDatePlatform.localIsoDateAtEpochMs(epochMs) ?: dayKeyOfEpochDay(floorDivMs(epochMs))
+
+    private fun floorDivMs(a: Long): Long = if (a >= 0) a / 86_400_000L else -((-a + 86_400_000L - 1) / 86_400_000L)
+
+    private fun epochDay(key: String): Long {
+        val y = key.substring(0, 4).toInt()
+        val m = key.substring(5, 7).toInt()
+        val d = key.substring(8, 10).toInt()
+        val yy = if (m <= 2) y - 1 else y
+        val era = (if (yy >= 0) yy else yy - 399) / 400
+        val yoe = yy - era * 400
+        val doy = (153 * (m + (if (m > 2) -3 else 9)) + 2) / 5 + d - 1
+        val doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
+        return era * 146097L + doe - 719468L
+    }
+
+    private fun dayKeyOfEpochDay(epochDay: Long): String {
+        val z = epochDay + 719468L
+        val era = (if (z >= 0) z else z - 146096L) / 146097L
+        val doe = z - era * 146097L
+        val yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
+        val y = yoe + era * 400
+        val doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
+        val mp = (5 * doy + 2) / 153
+        val d = (doy - (153 * mp + 2) / 5 + 1).toInt()
+        val m = (if (mp < 10) mp + 3 else mp - 9).toInt()
+        val year = (if (m <= 2) y + 1 else y).toInt()
+        return "${year.toString().padStart(4, '0')}-${m.toString().padStart(2, '0')}-${d.toString().padStart(2, '0')}"
+    }
+}
