+package com.nuvio.app.features.settings
+
+/**
+ * Last app crashes and process exit reasons, kept in a local file so the user can copy them
+ * from Settings after the app dies (for example during playback).
+ */
+expect object CrashLog {
+    fun read(): String
+    fun clear()
+}
