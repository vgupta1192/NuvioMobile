+package com.nuvio.app.features.settings
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.getValue
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import com.nuvio.app.core.ui.Chip
+import com.nuvio.app.features.player.DxSound
+import com.nuvio.app.features.player.DxSoundMode
+
+/** dx.bi port: Dialogue boost and Night mode. The switch hides the row in the player and turns the effect off. */
+@Composable
+internal fun DxSoundSettingsSection(isTablet: Boolean) {
+    LaunchedEffect(Unit) { DxSound.ensureLoaded() }
+    val enabled by DxSound.rowEnabled.collectAsStateWithLifecycle()
+    val mode by DxSound.mode.collectAsStateWithLifecycle()
+    SettingsSection(title = "Dialogue boost & Night mode", isTablet = isTablet) {
+        SettingsGroup(isTablet = isTablet) {
+            SettingsSwitchRow(
+                title = "Dialogue boost and Night mode",
+                description = "Shows the voice and night chips in the player's audio panel. Off also switches the effect off.",
+                checked = enabled,
+                isTablet = isTablet,
+                onCheckedChange = DxSound::setRowEnabled,
+            )
+            SettingsGroupDivider(isTablet = isTablet)
+            SettingsChipRow(
+                title = "Mode",
+                description = "Dialogue boost lifts voices and softens booming lows. Night mode also evens out loud and quiet scenes.",
+                isTablet = isTablet,
+            ) {
+                DxSoundMode.values().forEach { option ->
+                    Chip(
+                        label = option.label,
+                        selected = mode == option,
+                        onClick = { DxSound.setMode(option) },
+                    )
+                }
+            }
+        }
+    }
+}
