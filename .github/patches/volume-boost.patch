diff --git a/composeApp/src/commonMain/kotlin/com/nuvio/app/features/player/volumeboost/VolumeBoost.kt b/composeApp/src/commonMain/kotlin/com/nuvio/app/features/player/volumeboost/VolumeBoost.kt
