+internal fun cloudStreamDiagnosticsGroup(
+    type: String,
+    request: CloudStreamSearchRequest?,
+    matchedProviderIds: Set<String>,
+): AddonStreamGroup? {
+    CloudStreamRepository.initialize()
+    val plugins = CloudStreamRepository.uiState.value.plugins.filter { it.isInstalled }
+    if (plugins.isEmpty()) return null
+    val runnable = plugins.filter(CloudStreamPluginItem::isRunnable)
+    val lines = buildList {
+        add("Installed ${plugins.size}, runnable ${runnable.size}, matching $type ${matchedProviderIds.size}")
+        add("Search title: ${request?.title ?: "unavailable"}")
+        plugins.take(40).forEach { plugin ->
+            val reason = when {
+                !plugin.enabled -> "disabled"
+                !plugin.verified -> "not verified"
+                !plugin.compatibility.isRunnable -> "incompatible: ${plugin.compatibility.reason}"
+                plugin.metadata.id.value in matchedProviderIds -> "queried"
+                else -> "skipped, types ${plugin.metadata.rawTvTypes.joinToString("/").ifBlank { "none" }} do not fit $type"
+            }
+            add("${plugin.metadata.name}: $reason")
+        }
+        if (plugins.size > 40) add("... ${plugins.size - 40} more")
+    }
+    return AddonStreamGroup(
+        addonName = "CS3 diagnostics",
+        addonId = "cloudstream-diagnostics",
+        streams = emptyList(),
+        isLoading = false,
+        error = lines.joinToString("\n"),
+    )
+}
