+    /** Video/audio/subtitle badge labels from the full item's MediaStreams (list fetches have none). */
+    private fun parseMediaInfo(obj: JsonObject): JellyfinMediaInfo? {
+        val streams = obj.array("MediaStreams") ?: return null
+        var video: String? = null
+        var audio: String? = null
+        var subtitleCount = 0
+        for (element in streams) {
+            val stream = element as? JsonObject ?: continue
+            when (stream.string("Type")) {
+                "Video" -> if (video == null) video = videoLabel(stream)
+                "Audio" -> if (audio == null) audio = audioLabel(stream)
+                "Subtitle" -> subtitleCount++
+            }
+        }
+        if (video == null && audio == null && subtitleCount == 0) return null
+        return JellyfinMediaInfo(videoLabel = video, audioLabel = audio, subtitleCount = subtitleCount)
+    }
+
+    private fun videoLabel(stream: JsonObject): String? {
+        val height = stream.int("Height") ?: return null
+        val resolution = when {
+            height >= 1900 -> "4K"
+            height >= 1300 -> "1440p"
+            height >= 900 -> "1080p"
+            height >= 600 -> "720p"
+            height >= 550 -> "576p"
+            else -> "480p"
+        }
+        val codec = when (stream.string("Codec")?.lowercase()) {
+            "h264", "avc" -> "H264"
+            "hevc", "h265" -> "HEVC"
+            "av1" -> "AV1"
+            "vp9" -> "VP9"
+            "mpeg2video" -> "MPEG2"
+            "vc1" -> "VC1"
+            null -> null
+            else -> stream.string("Codec")?.uppercase()
+        }
+        return listOfNotNull(resolution, codec).joinToString(" ").takeIf { it.isNotBlank() }
+    }
+
+    private fun audioLabel(stream: JsonObject): String? {
+        stream.string("DisplayTitle")?.trim()?.takeIf { it.isNotBlank() }?.let { return it }
+        val language = stream.string("Language")?.takeIf { it.isNotBlank() }?.let { lang ->
+            if (lang.length == 2) lang.replaceFirstChar { it.uppercaseChar() } else lang
+        }
+        val codec = when (stream.string("Codec")?.lowercase()) {
+            "eac3" -> "EAC3"
+            "ac3" -> "AC3"
+            "truehd" -> "TrueHD"
+            "dts" -> "DTS"
+            "aac" -> "AAC"
+            "flac" -> "FLAC"
+            "mp3" -> "MP3"
+            "opus" -> "Opus"
+            "vorbis" -> "Vorbis"
+            null -> null
+            else -> stream.string("Codec")?.uppercase()
+        }
+        val channels = when (stream.int("Channels")) {
+            8 -> "7.1"
+            6 -> "5.1"
+            2 -> "2.0"
+            1 -> "1.0"
+            else -> null
+        }
+        return listOfNotNull(language, codec, channels).joinToString(" ").takeIf { it.isNotBlank() }
+    }
