+package com.nuvio.app.features.settings
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.getValue
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import com.nuvio.app.features.player.DxSecondSubtitle
+
+/** dx.bi port: second subtitle language on top of the picture. The switch hides the picker and the overlay. */
+@Composable
+internal fun DxSecondSubtitleSettingsSection(isTablet: Boolean) {
+    LaunchedEffect(Unit) { DxSecondSubtitle.ensureLoaded() }
+    val enabled by DxSecondSubtitle.enabled.collectAsStateWithLifecycle()
+    SettingsSection(title = "Second subtitle on top", isTablet = isTablet) {
+        SettingsGroup(isTablet = isTablet) {
+            SettingsSwitchRow(
+                title = "Second subtitle language",
+                description = "Shows a second subtitle language at the top of the picture. Pick the language in the player's Subtitles menu. Off hides the picker and the extra line.",
+                checked = enabled,
+                isTablet = isTablet,
+                onCheckedChange = DxSecondSubtitle::setEnabled,
+            )
+        }
+    }
+}
