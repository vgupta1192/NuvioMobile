+
+/**
+ * dx.bi port: a second subtitle language drawn on top of the picture, next to the normal subtitles (handy for learning
+ * a language or watching with a friend). The lines come from the addon subtitles of the title, so the second language
+ * is any language an addon offers. Pick it in the player's Subtitles menu; the choice is remembered.
+ */
+internal object DxSecondSubtitle {
+    private const val PATH = "settings/dx_sub2"
+    private val _enabled = MutableStateFlow(true)
+    val enabled: StateFlow<Boolean> = _enabled.asStateFlow()
+    private val _language = MutableStateFlow<String?>(null)
+    val language: StateFlow<String?> = _language.asStateFlow()
+    private var loaded = false
+
+    fun ensureLoaded() {
+        if (loaded) return
+        loaded = true
+        val values = HashMap<String, String>()
+        AppFileCache.read(PATH)?.lineSequence()?.forEach { line ->
+            val at = line.indexOf('=')
+            if (at > 0) values[line.substring(0, at)] = line.substring(at + 1)
+        }
+        _enabled.value = values["enabled"] != "0"
+        _language.value = values["language"]?.takeIf { it.isNotBlank() }
+    }
+
+    private fun save() {
+        val text = "enabled=${if (_enabled.value) 1 else 0}\nlanguage=${_language.value.orEmpty()}"
+        runCatching { AppFileCache.write(PATH, text) }
+    }
+
+    fun setEnabled(enabled: Boolean) {
+        ensureLoaded()
+        _enabled.value = enabled
+        save()
+    }
+
+    fun setLanguage(code: String?) {
+        ensureLoaded()
+        _language.value = code?.takeIf { it.isNotBlank() }
+        save()
+    }
+
+    /** The addon subtitle to draw as the second line: the chosen language, never the one already playing. */
+    fun pick(language: String?, addonSubtitles: List<AddonSubtitle>, playingId: String?): AddonSubtitle? {
+        val wanted = language ?: return null
+        return addonSubtitles.firstOrNull { subtitle ->
+            subtitle.id != playingId && normalizeLanguageCode(subtitle.language) == wanted
+        }
+    }
+
+    fun cueAt(cues: List<SubtitleSyncCue>, timeMs: Long): String? {
+        for (index in cues.indices) {
+            val cue = cues[index]
+            if (cue.startTimeMs > timeMs) break
+            if (timeMs < cue.endTimeMs) return cue.text
+        }
+        return null
+    }
+}
+
+/** Picker row inside the Subtitles menu. */
+@Composable
+internal fun DxSecondSubtitlePicker(addonSubtitles: List<AddonSubtitle>) {
+    LaunchedEffect(Unit) { DxSecondSubtitle.ensureLoaded() }
+    val enabled by DxSecondSubtitle.enabled.collectAsStateWithLifecycle()
+    val chosen by DxSecondSubtitle.language.collectAsStateWithLifecycle()
+    if (!enabled) return
+    val codes = remember(addonSubtitles.size) {
+        addonSubtitles.mapNotNull { normalizeLanguageCode(it.language) }.distinct()
+    }
+    if (codes.isEmpty() && chosen == null) return
+    Text(
+        text = "Second subtitle on top",
+        color = Color.White,
+        fontSize = 14.sp,
+        fontWeight = FontWeight.Medium,
+        modifier = Modifier.padding(top = 10.dp, bottom = 6.dp),
+    )
+    Row(
+        modifier = Modifier.horizontalScroll(rememberScrollState()),
+        horizontalArrangement = Arrangement.spacedBy(8.dp),
+    ) {
+        com.nuvio.app.core.ui.Chip(label = "Off", selected = chosen == null, onClick = { DxSecondSubtitle.setLanguage(null) })
+        val shown = if (chosen != null && chosen !in codes) listOf(chosen!!) + codes else codes
+        shown.forEach { code ->
+            com.nuvio.app.core.ui.Chip(
+                label = languageLabelForCode(code),
+                selected = chosen == code,
+                onClick = { DxSecondSubtitle.setLanguage(code) },
+            )
+        }
+    }
+}
+
+/** The second line itself, near the top of the picture in a warm yellow so it reads apart from the main subtitles. */
+@Composable
+internal fun PlayerScreenRuntime.DxSecondSubtitleOverlay() {
+    LaunchedEffect(Unit) { DxSecondSubtitle.ensureLoaded() }
+    val enabled by DxSecondSubtitle.enabled.collectAsStateWithLifecycle()
+    val language by DxSecondSubtitle.language.collectAsStateWithLifecycle()
+    if (!enabled || language == null) return
+    val pick = DxSecondSubtitle.pick(language, addonSubtitles, selectedAddonSubtitleId)
+    var cues by remember { mutableStateOf<List<SubtitleSyncCue>>(emptyList()) }
+    val headers = activeSourceHeaders
+    LaunchedEffect(pick?.url) {
+        val subtitle = pick
+        if (subtitle == null) {
+            cues = emptyList()
+            return@LaunchedEffect
+        }
+        cues = emptyList()
+        cues = runCatching {
+            val body = httpGetTextWithHeaders(url = subtitle.url, headers = headers)
+            PlayerSubtitleCueParser.parse(body, subtitle.url)
+        }.getOrDefault(emptyList())
+    }
+    if (cues.isEmpty()) return
+    val text = DxSecondSubtitle.cueAt(cues, playbackSnapshot.positionMs - subtitleDelayMs) ?: return
+    BoxWithConstraints(modifier = Modifier.fillMaxSize()) {
+        val size = (minOf(maxWidth.value, maxHeight.value) * 0.045f).coerceIn(12f, 22f)
+        Text(
+            text = text.replace(Regex("<[^>]+>"), ""),
+            color = Color(0xFFFFE39A),
+            textAlign = TextAlign.Center,
+            style = TextStyle(
+                fontSize = size.sp,
+                fontWeight = FontWeight.SemiBold,
+                shadow = Shadow(color = Color.Black, offset = Offset(0f, 2f), blurRadius = 6f),
+            ),
+            modifier = Modifier
+                .align(Alignment.TopCenter)
+                .fillMaxWidth()
+                .padding(top = (maxHeight * 0.05f), start = 48.dp, end = 48.dp),
+        )
+    }
+}
