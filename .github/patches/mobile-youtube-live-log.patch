diff --git a/composeApp/src/commonMain/kotlin/com/nuvio/app/features/youtube/YouTubeLiveLog.kt b/composeApp/src/commonMain/kotlin/com/nuvio/app/features/youtube/YouTubeLiveLog.kt
new file mode 100644
index 000000000..50cdb357b
--- /dev/null
+++ b/composeApp/src/commonMain/kotlin/com/nuvio/app/features/youtube/YouTubeLiveLog.kt
@@ -0,0 +1,68 @@
+package com.nuvio.app.features.youtube
+
+import androidx.compose.foundation.background
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.BoxScope
+import androidx.compose.foundation.layout.padding
+import androidx.compose.material3.Text
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.collectAsState
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.unit.dp
+import androidx.compose.ui.unit.sp
+import kotlin.time.TimeSource
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+
+/**
+ * Nuvio fork: short in-memory log of one YouTube start (extractor, preview, full player, load errors),
+ * drawn on screen so a stuck live stream can be diagnosed from a screenshot.
+ */
+object YouTubeLiveLog {
+    private const val MAX_LINES = 80
+    private val origin = TimeSource.Monotonic.markNow()
+    private val _lines = MutableStateFlow<List<String>>(emptyList())
+    val lines: StateFlow<List<String>> = _lines
+
+    fun add(tag: String, message: String) {
+        val secs = origin.elapsedNow().inWholeMilliseconds / 1000.0
+        val stamp = (kotlin.math.round(secs * 10) / 10.0).toString()
+        val line = "$stamp $tag ${message.replace('\n', ' ').take(170)}"
+        while (true) {
+            val old = _lines.value
+            val next = (old + line).takeLast(MAX_LINES)
+            if (_lines.compareAndSet(old, next)) break
+        }
+    }
+
+    fun clear() { _lines.value = emptyList() }
+
+    /** Host and the tail of the path of an address, without query strings that carry tokens. */
+    fun shortUrl(url: String?): String {
+        if (url.isNullOrBlank()) return "-"
+        val noQuery = url.substringBefore('?')
+        val host = noQuery.substringAfter("://").substringBefore('/')
+        val path = noQuery.substringAfter("://").substringAfter('/', "")
+        return host + "/" + path.takeLast(28)
+    }
+}
+
+/** Last lines of [YouTubeLiveLog] over a dark strip. */
+@Composable
+fun BoxScope.YouTubeLogPanel(maxLines: Int = 14, modifier: Modifier = Modifier) {
+    val lines by YouTubeLiveLog.lines.collectAsState()
+    if (lines.isEmpty()) return
+    Text(
+        text = lines.takeLast(maxLines).joinToString("\n"),
+        color = Color.White,
+        fontSize = 8.sp,
+        lineHeight = 10.sp,
+        modifier = modifier
+            .align(Alignment.BottomStart)
+            .background(Color.Black.copy(alpha = 0.7f))
+            .padding(4.dp),
+    )
+}
