+/** A feed that only exists for a signed-in account: history and playlists. */
+@Composable
+private fun AccountFeedTab(id: String, browseId: String, signInHint: String) {
+    val horizontal = MaterialTheme.nuvio.spacing.screenHorizontal
+    val account by YouTubeAccount.state.collectAsState()
+    if (!account.signedIn) {
+        Column(Modifier.fillMaxWidth().padding(horizontal = horizontal), verticalArrangement = Arrangement.spacedBy(12.dp)) {
+            YouTubeAccountPanel()
+            EmptyState(signInHint, null) {}
+        }
+        return
+    }
+    PagedPage(key = "tab-$id-${account.activePageId}-${account.label}", header = null) { token ->
+        if (token == null) YtInnertube.browseFeed(browseId) else YtInnertube.continuation(token)
+    }
+}
+
+/** Live, Music, Gaming, News and Sports: the YouTube topic pages, with a search when the page comes back empty. */
+@Composable
+private fun TopicTab(id: String) {
+    val account by YouTubeAccount.state.collectAsState()
+    val feed = YouTubeSettings.topicFeeds[id]
+    PagedPage(key = "tab-$id-${account.signedIn}-${account.activePageId}", header = null) { token ->
+        if (token != null) return@PagedPage YtInnertube.continuation(token)
+        val page = feed?.let { YtInnertube.browseFeed(it.first) }
+        if (page != null && page.items.isNotEmpty()) page else feed?.let { YtInnertube.search(it.second, YtInnertube.VIDEOS_ONLY) } ?: page
+    }
+}
+
+/** Channels the user follows: the local list, plus the channels of the signed-in account's subscriptions feed. */
+@Composable
+private fun ChannelsTab() {
+    val tokens = MaterialTheme.nuvio
+    val horizontal = tokens.spacing.screenHorizontal
+    val saved by YouTubeRepository.saved.collectAsState()
+    val feed by YouTubeRepository.subsFeed.collectAsState()
+    val account by YouTubeAccount.state.collectAsState()
+    LaunchedEffect(saved.subscriptions, account.signedIn) { YouTubeRepository.loadSubscriptions() }
+    val channels = (saved.subscriptions + feed.filter { it.channelId.isNotBlank() }
+        .distinctBy { it.channelId }
+        .map { YtItem(kind = YtKind.CHANNEL, id = it.channelId, title = it.channel, thumb = "") })
+        .distinctBy { it.id }
+    if (channels.isEmpty()) {
+        Column(Modifier.fillMaxWidth().padding(horizontal = horizontal), verticalArrangement = Arrangement.spacedBy(12.dp)) {
+            if (!account.signedIn) YouTubeAccountPanel()
+            EmptyState("No channels yet. Open a channel and tap Subscribe.", null) {}
+        }
+        return
+    }
+    LazyColumn(
+        modifier = Modifier.fillMaxSize(),
+        contentPadding = PaddingValues(start = horizontal, end = horizontal, bottom = 24.dp),
+        verticalArrangement = Arrangement.spacedBy(12.dp),
+    ) {
+        items(channels.chunked(4)) { row ->
+            Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.spacedBy(14.dp)) {
+                row.forEach { channel -> ChannelBubble(channel) }
+            }
+        }
+    }
+}
