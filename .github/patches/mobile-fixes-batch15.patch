+    private suspend fun fetchSimkl(imdbId: String?): Map<Pair<Int, Int>, Double> {
+        if (imdbId == null || SimklConfig.CLIENT_ID.isBlank()) return emptyMap()
+        return try {
+            val ids = SimklIdResolver.resolveIds("imdb", imdbId, "series") ?: return emptyMap()
+            val text = httpGetText(
+                "$SIMKL_API_BASE_URL/${ids.type}/episodes/${ids.simklId}?extended=full" +
+                    "&client_id=${SimklConfig.CLIENT_ID}&app-name=${SimklConfig.APP_NAME}&app-version=1.0",
+            )
+            val out = mutableMapOf<Pair<Int, Int>, Double>()
+            json.parseToJsonElement(text).jsonArray.forEach { el ->
+                val ep = el.jsonObject
+                if (ep["type"]?.jsonPrimitive?.contentOrNull?.let { it != "episode" } == true) return@forEach
+                val sn = ep["season"]?.jsonPrimitive?.intOrNull ?: return@forEach
+                val en = ep["episode"]?.jsonPrimitive?.intOrNull ?: return@forEach
+                val r = ep["ratings"]?.jsonObject?.get("simkl")?.jsonObject?.get("rating")?.jsonPrimitive?.doubleOrNull
+                    ?: ep["rating"]?.jsonPrimitive?.doubleOrNull
+                    ?: return@forEach
+                if (r > 0.0) out[sn to en] = r
+            }
+            out
+        } catch (cancelled: CancellationException) {
+            throw cancelled
+        } catch (_: Exception) {
+            emptyMap()
+        }
+    }
