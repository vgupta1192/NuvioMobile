+@Composable
+private fun EpisodeSourceRatingBadge(
+    label: String,
+    rating: String,
+    textSize: androidx.compose.ui.unit.TextUnit,
+) {
+    val logo = when (label) {
+        "TMDB" -> Res.drawable.rating_tmdb
+        "Trakt" -> Res.drawable.rating_trakt
+        "Simkl" -> Res.drawable.simkl_logo_glyph
+        else -> null
+    }
+    val valueColor = when (label) {
+        "TMDB" -> Color(0xFF01B4E4)
+        "Trakt" -> Color(0xFFED1C24)
+        "Simkl" -> Color(0xFFFFFFFF)
+        else -> Color.White.copy(alpha = 0.78f)
+    }
+    Row(
+        horizontalArrangement = Arrangement.spacedBy(4.dp),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        if (logo != null) {
+            Image(
+                painter = painterResource(logo),
+                contentDescription = label,
+                modifier = Modifier.height(12.dp).width(16.dp),
+                contentScale = ContentScale.Fit,
+            )
+        } else {
+            Text(
+                text = label,
+                style = MaterialTheme.typography.labelSmall.copy(fontSize = textSize, fontWeight = FontWeight.SemiBold),
+                color = Color.White.copy(alpha = 0.78f),
+                maxLines = 1,
+            )
+        }
+        Text(
+            text = rating,
+            style = MaterialTheme.typography.labelSmall.copy(fontSize = textSize, fontWeight = FontWeight.SemiBold),
+            color = valueColor,
+            maxLines = 1,
+        )
+    }
