+/**
+ * Nuvio fork: Smart Highlights settings — the rail toggle plus the per-profile Gemini API key
+ * (masked field, test connection, remove). Placed in Home screen settings, next to the other
+ * home layout switches. The key is never displayed back and never logged; only its presence is
+ * reflected in the UI.
+ */
+@Composable
+internal fun SmartHighlightsSettingsSection(isTablet: Boolean) {
+    val enabled by SmartHighlightsPreferences.enabled.collectAsStateWithLifecycle()
+    val apiKeyConfigured by SmartHighlightsPreferences.apiKeyConfigured.collectAsStateWithLifecycle()
+
+    SettingsSection(
