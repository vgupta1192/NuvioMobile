+package com.nuvio.app.features.highlights
+
+import io.ktor.client.HttpClient
+
+/**
+ * Nuvio fork: dedicated HTTP client for Gemini ranking calls — no logging plugins and hard
+ * timeouts (5s connect / 10s read) so home can never hang on a ranking request. Platform files
+ * build it so the connection pool stays separate from the addon/proxy clients.
+ */
+internal expect fun createGeminiHttpClient(): HttpClient
