@@ -0,0 +1,296 @@
+package com.nuvio.app.features.player
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.DisposableEffect
+import androidx.compose.runtime.LaunchedEffect
+import co.touchlab.kermit.Logger
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.isActive
+
+/*
+ * Nuvio fork: auto quality for adaptive (multi-rendition) streams, driven by a measured
+ * throughput sample of the playing stream. Three pieces:
+ *
+ *  - [AutoQualitySpeedTest] keeps the latest measured download speed. On Android's ExoPlayer it is
+ *    fed from the player's own bandwidth meter (an AnalyticsListener hook reporting real bytes
+ *    over real load time); on Android's libmpv engine from its `cache-speed` fill rate. The
+ *    latest result also surfaces in the dx stream stats overlay. Other platforms sample nothing.
+ *  - Auto quality hot swap: while enabled and an adaptive stream plays, the playing rendition is
+ *    compared against the measured speed every tick. An upgrade needs the estimate to stay above
+ *    1.3x the next rendition's bitrate for AUTO_QUALITY_UPGRADE_HOLD_MS with at least
+ *    AUTO_QUALITY_UPGRADE_MIN_BUFFER_MS of buffer; a downgrade takes
+ *    AUTO_QUALITY_DOWNGRADE_SAMPLES consecutive samples below the playing rendition's bitrate.
+ *    Switches happen one step at a time through the same HLS variant switch the Quality panel
+ *    uses (position-preserving), with AUTO_QUALITY_SWITCH_SETTLE_MS between switches.
+ *  - Fast start: when enabled (with auto quality on), a fresh adaptive stream starts on its
+ *    lowest rendition and upgrades run through the same hysteresis once the first buffering has
+ *    completed.
+ *
+ * A quality picked by hand in the player (any override the engine did not set) stands the engine
+ * down until the panel's Auto entry is picked again.
+ */
+
+private val autoQualityLog = Logger.withTag("AutoQuality")
+
+private const val AUTO_QUALITY_UPGRADE_HEADROOM = 1.3
+private const val AUTO_QUALITY_UPGRADE_HOLD_MS = 5_000L
+private const val AUTO_QUALITY_UPGRADE_MIN_BUFFER_MS = 10_000L
+private const val AUTO_QUALITY_DOWNGRADE_SAMPLES = 2
+private const val AUTO_QUALITY_SWITCH_SETTLE_MS = 10_000L
+private const val AUTO_QUALITY_TICK_MS = 500L
+
+/**
+ * Nuvio fork: per-playback state of the auto quality controller, owned by the player screen's
+ * runtime and only touched from its tick coroutine. Nothing here survives the player screen.
+ */
+internal class PlayerAutoQualityState {
+    /** The stream the state below was built for; a change resets everything transient. */
+    var lastSeenStreamKey: String = ""
+
+    /** The rendition the controller pinned through the variant-switch state, if any. */
+    var pinnedQualityId: String? = null
+
+    /** True while a fresh stream still has to be pinned to its lowest rendition. */
+    var fastStartPending: Boolean = false
+
+    /** When the estimate first satisfied the upgrade hysteresis, for its hold window. */
+    var upgradeHoldSinceMs: Long? = null
+
+    /** Consecutive samples that measured below the playing rendition's bitrate. */
+    var downgradeStreak: Int = 0
+
+    /** When the last rendition switch was applied, for the settle window between switches. */
+    var lastSwitchAtMs: Long = 0L
+
+    /** Drops everything that belongs to the previous stream. */
+    fun onStreamChanged() {
+        upgradeHoldSinceMs = null
+        downgradeStreak = 0
+        lastSwitchAtMs = 0L
+    }
+}
+
+/**
+ * The latest measured download speed. Samples are an exponential moving average so a single fast
+ * burst cannot trigger an upgrade on its own.
+ */
+object AutoQualitySpeedTest {
+    /** Smoothing weight of a new measurement (EMA). */
+    private const val EMA_NEW_WEIGHT = 0.3
+
+    /** A result older than this is from another session and is not used. */
+    private const val FRESH_MS = 120_000L
+
+    private val lock = Any()
+    @Volatile private var estimateBps: Long = 0L
+    @Volatile private var latestAtMs: Long = 0L
+
+    /** One bandwidth-meter reading (bits/s); several arrive while data loads. */
+    fun recordBandwidthEstimate(bitrateEstimateBps: Long) {
+        if (bitrateEstimateBps <= 0L) return
+        synchronized(lock) {
+            estimateBps = if (estimateBps <= 0L) {
+                bitrateEstimateBps
+            } else {
+                (estimateBps * (1.0 - EMA_NEW_WEIGHT) + bitrateEstimateBps * EMA_NEW_WEIGHT).toLong()
+            }
+            latestAtMs = nowMs()
+        }
+    }
+
+    /** A demuxer fill rate (bytes/s), sampled from the mpv engine; feeds the overlay only. */
+    fun recordBytesPerSecondRate(bytesPerSecond: Long) {
+        if (bytesPerSecond <= 0L) return
+        recordBandwidthEstimate(bytesPerSecond * 8L)
+    }
+
+    /** The smoothed measurement in bits/s, or null when nothing has been measured recently. */
+    fun latestBps(): Long? {
+        val at = latestAtMs
+        if (at == 0L || nowMs() - at > FRESH_MS) return null
+        return estimateBps.takeIf { it > 0L }
+    }
+
+    private fun nowMs(): Long = kotlin.time.Clock.System.now().toEpochMilliseconds()
+}
+
+/** The currently playing rendition id (manual override or the resolver's recommendation). */
+private val PlayerScreenRuntime.playingQualityId: String?
+    get() = selectedPlayerQualityId ?: playerQualityState.recommendedVariantId
+
+/** The effective playback URL the surface consumes, variant switch included. */
+private val PlayerScreenRuntime.effectivePlaybackUrl: String?
+    get() = qualityPlaybackUrl ?: activeSourceUrl
+
+/**
+ * One look at playback, from the engine's own ~500 ms ticker. mpv and streams without rendition
+ * metadata do nothing but feed the speed test, so nothing is faked there. With auto quality off
+ * the function returns immediately and nothing about playback changes.
+ */
+internal fun PlayerScreenRuntime.autoQualityTick(nowMs: Long) {
+    if (!playerSettingsUiState.autoQualityEnabled) return
+    // Torrent/P2P sources have no rendition ladder to hot-swap.
+    if (activeTorrentInfoHash != null) return
+
+    val state = autoQualityState
+    val streamKey = effectivePlaybackUrl.orEmpty()
+    if (streamKey != state.lastSeenStreamKey) {
+        val wasOurs = state.pinnedQualityId != null && selectedPlayerQualityId == state.pinnedQualityId
+        if (wasOurs) {
+            // A new stream: drop the variant pin so the fresh stream starts from the master URL.
+            selectedPlayerQualityId = null
+            qualityPlaybackUrl = null
+        }
+        state.onStreamChanged()
+        state.lastSeenStreamKey = streamKey
+        state.pinnedQualityId = null
+        state.fastStartPending = playerSettingsUiState.fastStartEnabled
+    }
+
+    if (playbackSnapshot.isEnded || !errorMessage.isNullOrBlank()) return
+    val variants = playerQualityState.variants
+    if (variants.size < 2) return
+
+    val pinned = state.pinnedQualityId
+    if (selectedPlayerQualityId != pinned) {
+        if (pinned != null && selectedPlayerQualityId == null) {
+            // The user picked Auto again: the engine takes over from the ladder's default.
+            state.pinnedQualityId = null
+        } else {
+            // A hand-picked quality stands until the chooser's Auto entry clears it.
+            state.upgradeHoldSinceMs = null
+            state.downgradeStreak = 0
+            return
+        }
+    }
+
+    // Fast start: pin the lowest rendition as soon as the ladder is known, before the initial
+    // buffering completes. The settle window below is what defers the first upgrade until after
+    // the first buffering has completed.
+    if (state.fastStartPending) {
+        state.fastStartPending = false
+        val lowest = variants.minByOrNull { it.sortHeight } ?: return
+        if (lowest.id != playingQualityId) {
+            applyAutoQualityVariant(lowest.id, state, nowMs)
+        }
+        return
+    }
+
+    if (!initialLoadCompleted) return
+    val snapshot = playbackSnapshot
+    if (!snapshot.isPlaying || snapshot.isLoading) return
+    if (nowMs - state.lastSwitchAtMs < AUTO_QUALITY_SWITCH_SETTLE_MS) return
+
+    val estimateBps = AutoQualitySpeedTest.latestBps() ?: return
+    val current = playingQualityId
+        ?.let { id -> variants.firstOrNull { it.id == id } }
+        ?: return
+    val playingBitrateBps = current.bandwidth?.takeIf { it > 0L } ?: return
+
+    // Downgrade first: two consecutive samples below what is playing. The target is one step down
+    // (the next-lower rendition); it always fits by construction of the ladder order.
+    if (estimateBps < playingBitrateBps) {
+        state.upgradeHoldSinceMs = null
+        state.downgradeStreak += 1
+        if (state.downgradeStreak >= AUTO_QUALITY_DOWNGRADE_SAMPLES) {
+            state.downgradeStreak = 0
+            val target = variants
+                .filter { it.sortHeight < current.sortHeight }
+                .maxByOrNull { it.sortHeight }
+                ?: return
+            applyAutoQualityVariant(target.id, state, nowMs)
+        }
+        return
+    }
+    state.downgradeStreak = 0
+
+    // Upgrade: the estimate must stay above 1.3x the next rendition for a while, with buffer to
+    // hide the switch, and the next rendition must declare a bitrate (missing metadata is not
+    // evidence that it fits).
+    val bufferedAheadMs = (snapshot.bufferedPositionMs - snapshot.positionMs).coerceAtLeast(0L)
+    val next = variants
+        .filter { it.sortHeight > current.sortHeight }
+        .minByOrNull { it.sortHeight }
+    val nextBitrateBps = next?.bandwidth?.takeIf { it > 0L }
+    val upgradeSustained = if (
+        bufferedAheadMs >= AUTO_QUALITY_UPGRADE_MIN_BUFFER_MS &&
+        nextBitrateBps != null &&
+        nextBitrateBps * AUTO_QUALITY_UPGRADE_HEADROOM <= estimateBps
+    ) {
+        val since = state.upgradeHoldSinceMs
+        if (since == null) {
+            state.upgradeHoldSinceMs = nowMs
+            false
+        } else {
+            nowMs - since >= AUTO_QUALITY_UPGRADE_HOLD_MS
+        }
+    } else {
+        state.upgradeHoldSinceMs = null
+        false
+    }
+    if (upgradeSustained && next != null) {
+        state.upgradeHoldSinceMs = null
+        applyAutoQualityVariant(next.id, state, nowMs)
+    }
+}
+
+/**
+ * Applies a rendition switch through the same HLS variant mechanism the Quality panel uses
+ * ([PlayerScreenRuntime.selectPlayerQuality]'s state changes, without its UI side effects) and
+ * records it as the engine's own pin, so a user's hand-picked quality is never mistaken for it.
+ */
+private fun PlayerScreenRuntime.applyAutoQualityVariant(
+    variantId: String,
+    state: PlayerAutoQualityState,
+    nowMs: Long,
+) {
+    val targetUrl = playerQualityState.playbackUrlFor(variantId)
+    if (targetUrl == null || targetUrl == effectivePlaybackUrl) return
+    val previous = state.pinnedQualityId
+    val previousVariant = previous?.let { id -> playerQualityState.variants.firstOrNull { it.id == id } }
+    val nextVariant = playerQualityState.variants.firstOrNull { it.id == variantId }
+    state.pinnedQualityId = variantId
+    state.lastSwitchAtMs = nowMs
+    selectedPlayerQualityId = variantId
+    qualityPlaybackUrl = targetUrl
+    activeInitialPositionMs = playbackSnapshot.positionMs
+    initialSeekApplied = false
+    playbackSnapshot = playbackSnapshot.copy(isLoading = true, videoWidth = 0, videoHeight = 0)
+    initialLoadCompleted = false
+    errorMessage = null
+    shouldPlay = true
+    val direction = if (previousVariant != null && nextVariant != null &&
+        nextVariant.sortHeight < previousVariant.sortHeight
+    ) {
+        "down"
+    } else {
+        "up"
+    }
+    autoQualityLog.i { "auto quality $direction rendition=$variantId" }
+}
+
+/**
+ * The engine's ticker plus the bandwidth sampling hookup. Runs for the player's whole lifetime;
+ * with auto quality and fast start off the tick returns immediately, so the only cost is the
+ * timer and (on ExoPlayer) the meter listener the player already produces anyway.
+ */
+@Composable
+internal fun PlayerAutoQualityEffects(runtime: PlayerScreenRuntime) {
+    val controller = runtime.playerController
+    DisposableEffect(controller) {
+        controller?.setAutoQualityBandwidthListener(
+            PlayerBandwidthSampleListener { bitrateEstimateBps ->
+                AutoQualitySpeedTest.recordBandwidthEstimate(bitrateEstimateBps)
+            },
+        )
+        onDispose {
+            controller?.setAutoQualityBandwidthListener(null)
+        }
+    }
+    LaunchedEffect(runtime) {
+        while (isActive) {
+            delay(AUTO_QUALITY_TICK_MS)
+            runtime.autoQualityTick(nowMs = kotlin.time.Clock.System.now().toEpochMilliseconds())
+        }
+    }
+}
