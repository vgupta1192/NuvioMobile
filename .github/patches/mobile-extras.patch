+import com.nuvio.app.core.storage.ProfileScopedKey
+import java.time.Instant
+import java.time.ZoneId
+import java.time.format.DateTimeFormatter
+import java.util.Locale
+
+internal actual object ReleaseRemindersStorage {
+    private const val preferencesName = "nuvio_release_reminders"
+    private const val payloadKey = "release_reminders_payload"
+
+    private var preferences: SharedPreferences? = null
+
+    fun initialize(context: Context) {
+        preferences = context.getSharedPreferences(preferencesName, Context.MODE_PRIVATE)
+    }
+
+    actual fun loadPayload(): String? =
+        preferences?.getString(ProfileScopedKey.of(payloadKey), null)
+
+    actual fun savePayload(payload: String) {
+        preferences
+            ?.edit()
+            ?.putString(ProfileScopedKey.of(payloadKey), payload)
+            ?.apply()
+    }
+}
+
+internal actual fun formatReminderReleaseDate(releaseDateMs: Long): String =
+    DateTimeFormatter.ofPattern("MMMM d, yyyy", Locale.getDefault())
+        .format(Instant.ofEpochMilli(releaseDateMs).atZone(ZoneId.systemDefault()).toLocalDate())
