@@ -0,0 +1,93 @@
+package com.nuvio.app.features.details.components
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.remember
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import com.nuvio.app.features.details.MetaDetails
+import com.nuvio.app.features.reminders.ReleaseRemindersRepository
+import com.nuvio.app.features.watchprogress.WatchProgressClock
+import com.nuvio.app.features.watchprogress.parseReleaseDateToEpochMs
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+
+internal data class ReleaseReminderAction(
+    val itemId: String,
+    val title: String,
+    val releaseDateMs: Long,
+    val posterUrl: String?,
+    val isReminded: Boolean,
+    val onToggle: () -> Unit,
+)
+
+/**
+ * Nuvio fork: the "Remind me" detail action for titles that have not been released yet.
+ *
+ * The release instant is the title's earliest upcoming dated video (movies carry their single
+ * video's release date). When the release date is unknown or already in the past, the action is
+ * absent and the details screen is byte-identical to before.
+ */
+@Composable
+internal fun rememberReleaseReminderAction(meta: MetaDetails?): ReleaseReminderAction? {
+    val remindersState by ReleaseRemindersRepository.uiState.collectAsStateWithLifecycle()
+
+    LaunchedEffect(Unit) {
+        ReleaseRemindersRepository.ensureLoaded()
+    }
+
+    val target = remember(meta) {
+        val details = meta ?: return@remember null
+        val releaseDateMs = upcomingReleaseDateMs(details) ?: return@remember null
+        ReleaseReminderTarget(
+            itemId = "${details.type.trim().lowercase()}:${details.id}",
+            title = details.name,
+            releaseDateMs = releaseDateMs,
+            posterUrl = details.poster ?: details.background,
+        )
+    } ?: return null
+
+    val isReminded = remindersState.reminders.any {
+        it.itemId == target.itemId && it.releaseDateMs == target.releaseDateMs
+    }
+    return ReleaseReminderAction(
+        itemId = target.itemId,
+        title = target.title,
+        releaseDateMs = target.releaseDateMs,
+        posterUrl = target.posterUrl,
+        isReminded = isReminded,
+        onToggle = {
+            val next = !isReminded
+            ReleaseRemindersRepository.setReminded(
+                itemId = target.itemId,
+                title = target.title,
+                releaseDateMs = target.releaseDateMs,
+                posterUrl = target.posterUrl,
+                reminded = next,
+            )
+            if (next && !remindersState.permissionGranted) {
+                // Fire-and-forget: the repository records the grant for the next render.
+                CoroutineScope(Dispatchers.Default).launch {
+                    ReleaseRemindersRepository.requestPermission()
+                }
+            }
+        },
+    )
+}
+
+internal data class ReleaseReminderTarget(
+    val itemId: String,
+    val title: String,
+    val releaseDateMs: Long,
+    val posterUrl: String?,
+)
+
+/** The earliest upcoming, precisely dated release instant of [details], or null. */
+private fun upcomingReleaseDateMs(details: MetaDetails): Long? {
+    val nowEpochMs = WatchProgressClock.nowEpochMs()
+    return details.videos.asSequence()
+        .mapNotNull { episode -> parseReleaseDateToEpochMs(episode.released) }
+        .filter { it > nowEpochMs }
+        .minOrNull()
+}
