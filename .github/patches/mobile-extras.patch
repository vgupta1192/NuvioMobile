+package com.nuvio.app.features.reminders
+
+/**
+ * Nuvio fork: per-profile persistence for release reminders. One JSON payload of
+ * [ReleaseReminder] entries keyed under a profile-scoped preference.
+ */
+internal expect object ReleaseRemindersStorage {
+    fun loadPayload(): String?
+    fun savePayload(payload: String)
+}
