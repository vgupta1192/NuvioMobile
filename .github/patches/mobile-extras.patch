+package com.nuvio.app.features.reminders
+
+import kotlinx.serialization.Serializable
+
+/**
+ * Nuvio fork: one release reminder the user set from a detail screen of an unreleased title.
+ * Stored per profile; a local notification is delivered at [releaseDateMs].
+ */
+@Serializable
+data class ReleaseReminder(
+    /** Stable content key, "$type:$id" of the title the reminder belongs to. */
+    val itemId: String,
+    val title: String,
+    val releaseDateMs: Long,
+    val posterUrl: String? = null,
+) {
+    val itemType: String
+        get() = itemId.substringBefore(':', missingDelimiterValue = "")
+
+    val contentId: String
+        get() = itemId.substringAfter(':', missingDelimiterValue = itemId)
+}
+
+data class ReleaseRemindersUiState(
+    val reminders: List<ReleaseReminder> = emptyList(),
+    val permissionGranted: Boolean = false,
+)
+
+internal fun buildReleaseReminderId(reminder: ReleaseReminder): String {
+    val contentHash = kotlin.math.abs(reminder.itemId.hashCode())
+    return "release-reminder-${com.nuvio.app.features.profiles.ProfileRepository.activeProfileId}-$contentHash-${reminder.releaseDateMs}"
+}
+
+/**
+ * Formats a reminder's release timestamp for the notification body and the settings list.
+ * Uses the same day-precision display the rest of the app uses for release dates.
+ */
+internal expect fun formatReminderReleaseDate(releaseDateMs: Long): String
