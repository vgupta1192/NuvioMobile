+package com.nuvio.app.features.reminders
+
+/**
+ * Nuvio fork: platform notification delivery for release reminders.
+ *
+ * - Android: scheduled as WorkManager one-time jobs (the same mechanism the tree's episode
+ *   release notifications use). WorkManager persists pending work across reboots on its own, so
+ *   no BOOT receiver and no exact-alarm permission are needed; an in-process refresh also runs
+ *   on app start via [ReleaseRemindersRepository].
+ * - iOS: UNUserNotificationCenter calendar triggers (the tree's iosMain already links
+ *   UserNotifications for episode release notifications).
+ */
+internal expect object ReleaseReminderNotificationPlatform {
+    suspend fun notificationsAuthorized(): Boolean
+    suspend fun requestAuthorization(): Boolean
+    suspend fun schedule(reminders: List<ReleaseReminder>)
+    suspend fun clearAll()
+}
