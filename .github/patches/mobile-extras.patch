+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.collectLatest
+import kotlinx.coroutines.flow.combine
+import kotlinx.coroutines.flow.distinctUntilChanged
+import kotlinx.coroutines.launch
+import kotlin.concurrent.Volatile
+
+private data class SmartHighlightsInput(
+    val enabled: Boolean,
+    val hasApiKey: Boolean,
+    val homeRevision: Int,
+    val libraryRevision: Int,
+    val progressRevision: Int,
+)
+
+/**
+ * Nuvio fork: the Smart Highlights home rail pipeline.
+ *
+ * Candidates are a blend of the profile's in-progress continue-watching titles (most recently
+ * watched first), the saved library (most recently listed first) and the already-fetched home
+ * catalog items, deduplicated and capped. The rail renders the fallback order straight away;
+ * while a Gemini key is configured for the profile, a cached or freshly fetched ranking reorders
+ * the same candidates and attaches a short reason to each pick. With no key nothing is fetched —
+ * the fallback order is the rail, silently.
+ */
+object SmartHighlightsRepository {
+    private val log = Logger.withTag("SmartHighlights")
+
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.Default)
+    private val client = GeminiRankingClient()
+    private val rankingCache = SmartHighlightsRankingCache()
+
+    private val _picks = MutableStateFlow<List<SmartHighlightPick>>(emptyList())
+    val picks: StateFlow<List<SmartHighlightPick>> = _picks.asStateFlow()
+
+    @Volatile private var started = false
+    @Volatile private var generation = 0
+
+    /** Starts the pipeline once; safe to call from every home render. */
+    fun ensureStarted() {
+        if (started) return
+        started = true
+        SmartHighlightsPreferences.ensureLoaded()
+        scope.launch {
+            var firstRun = true
+            combine(
+                SmartHighlightsPreferences.enabled,
+                SmartHighlightsPreferences.apiKeyConfigured,
+                HomeRepository.uiState,
+                LibraryRepository.uiState,
+                WatchProgressRepository.uiState,
+            ) { enabled, hasApiKey, home, library, progress ->
+                SmartHighlightsInput(
+                    enabled = enabled,
+                    hasApiKey = hasApiKey,
+                    homeRevision = home.sections.sumOf { section ->
+                        section.items.size * 31 + section.key.hashCode()
+                    } + home.heroItems.size,
+                    libraryRevision = library.items.size * 31 +
+                        library.items.fold(0) { acc, item -> acc + item.id.hashCode() },
+                    progressRevision = progress.entries.size * 31 +
+                        progress.entries.fold(0) { acc, entry -> acc + entry.videoId.hashCode() },
+                )
+            }
+                .distinctUntilChanged()
+                .collectLatest { input ->
+                    val requestGeneration = generation
+                    if (!input.enabled) {
+                        _picks.value = emptyList()
+                        firstRun = false
+                        return@collectLatest
+                    }
+                    if (firstRun) {
+                        // Let home's catalogs and continue watching load before spending work on the rail.
+                        delay(SMART_HIGHLIGHTS_STARTUP_DELAY_MS)
+                    }
+                    firstRun = false
+                    val candidates = buildSmartHighlightCandidates(
+                        homeItems = homeCandidates(),
+                        libraryItems = library.items.sortedByDescending { it.savedAtEpochMs },
+                        continueWatchingEntries = WatchProgressRepository.uiState.value.entries
+                            .continueWatchingEntries(),
+                    )
+                    _picks.value = if (candidates.isEmpty()) {
+                        emptyList()
+                    } else {
+                        computeSmartHighlightPicks(candidates, input.hasApiKey, requestGeneration)
+                    }
+                }
+        }
+    }
+
+    fun onProfileChanged() {
+        generation++
+        SmartHighlightsPreferences.onProfileChanged()
+        _picks.value = emptyList()
+    }
+
+    fun clearLocalState() {
+        generation++
+        SmartHighlightsPreferences.clearLocalState()
+        _picks.value = emptyList()
+    }
+
+    private fun homeCandidates(): List<MetaPreview> =
+        buildList {
+            addAll(HomeRepository.uiState.value.heroItems)
+            HomeRepository.uiState.value.sections.forEach { section -> addAll(section.items) }
+        }
+
+    private suspend fun computeSmartHighlightPicks(
+        candidates: List<SmartHighlightCandidate>,
+        hasApiKey: Boolean,
+        requestGeneration: Int,
+    ): List<SmartHighlightPick> {
+        val fallback = candidates
+            .take(SMART_HIGHLIGHTS_MAX_PICKS)
+            .map { it.toPick(fallbackReason(it)) }
+        if (!hasApiKey) return fallback
+
+        // The cache key covers the candidate set: a changed library or progress picture misses it.
+        val hash = candidates.joinToString("|") { it.cacheToken } + "#${candidates.size}"
+        val cached = rankingCache.read(hash)
+        if (cached != null) return applySmartHighlightsRanking(candidates, cached)
+
+        val fetched = runCatching {
+            client.rank(
+                candidates = candidates.take(SMART_HIGHLIGHTS_MAX_CANDIDATES).map(::describeCandidate),
+                pickCount = SMART_HIGHLIGHTS_MAX_PICKS,
+            )
+        }.getOrElse { error ->
+            if (error is CancellationException) throw error
+            log.i { "Smart Highlights ranking skipped: ${error.message}" }
+            null
+        }
+        if (generation != requestGeneration) return fallback
+        if (fetched != null) rankingCache.write(hash, fetched)
+        return fetched?.let { applySmartHighlightsRanking(candidates, it) } ?: fallback
+    }
+}
+
+/** Ranked picks in Gemini's order, with the remaining candidates appended in fallback order. */
+private fun applySmartHighlightsRanking(
+    candidates: List<SmartHighlightCandidate>,
+    ranking: List<GeminiRankEntry>,
+): List<SmartHighlightPick> {
+    val byIndex = candidates.withIndex().associate { (index, candidate) -> index to candidate }
+    val ranked = ranking.mapNotNull { entry ->
+        byIndex[entry.index]?.let { candidate ->
+            SmartHighlightPick(item = candidate.item, reason = entry.reason, ranked = true)
+        }
+    }
+    val rankedKeys = ranked.map { it.item.stableKey() }.toSet()
+    val remainder = candidates
+        .filter { it.item.stableKey() !in rankedKeys }
+        .map { it.toPick(fallbackReason(it)) }
+    return (ranked + remainder)
+        .distinctBy { it.item.stableKey() }
+        .take(SMART_HIGHLIGHTS_MAX_PICKS)
+}
+
+internal fun buildSmartHighlightCandidates(
+    homeItems: List<MetaPreview>,
+    libraryItems: List<LibraryItem>,
+    continueWatchingEntries: List<com.nuvio.app.features.watchprogress.WatchProgressEntry>,
+): List<SmartHighlightCandidate> {
+    val nowEpochMs = EpisodeReleaseDatePlatform.nowEpochMs()
+    val todayIsoDate = CurrentDateProvider.todayIsoDate()
+    val seen = HashSet<String>()
+    val candidates = ArrayList<SmartHighlightCandidate>()
+
+    fun addCandidate(item: MetaPreview, progressPercent: Int?, fromLibrary: Boolean) {
+        if (item.name.isBlank()) return
+        // A card without art would render as an empty frame on the home screen.
+        if (item.poster.isNullOrBlank() && item.banner.isNullOrBlank() && item.landscapePoster.isNullOrBlank()) return
+        if (item.isUnreleased(todayIsoDate, nowEpochMs)) return
+        if (!seen.add(item.stableKey())) return
+        candidates += SmartHighlightCandidate(item, progressPercent, fromLibrary)
+    }
+
+    continueWatchingEntries.asSequence()
+        .filter { entry -> entry.title.isNotBlank() }
+        .take(SMART_HIGHLIGHTS_MAX_PROGRESS_CANDIDATES)
+        .forEach { entry ->
+            val percent = entry.normalizedProgressPercent
+                ?.toInt()
+                ?.takeIf { it in 1..99 }
+            addCandidate(
+                item = MetaPreview(
+                    id = entry.parentMetaId,
+                    type = entry.parentMetaType,
+                    name = entry.title,
+                    poster = entry.poster,
+                    banner = entry.background,
+                    logo = entry.logo,
+                    posterShape = PosterShape.Poster,
+                ),
+                progressPercent = percent,
+                fromLibrary = false,
+            )
+        }
+
+    libraryItems.asSequence()
+        .take(SMART_HIGHLIGHTS_MAX_LIBRARY_CANDIDATES)
+        .forEach { libraryItem ->
+            addCandidate(libraryItem.toMetaPreview(), progressPercent = null, fromLibrary = true)
+        }
+
+    homeItems.asSequence()
+        .take(SMART_HIGHLIGHTS_MAX_LIBRARY_CANDIDATES)
+        .forEach { preview ->
+            addCandidate(preview, progressPercent = null, fromLibrary = true)
+        }
+
+    return candidates.take(SMART_HIGHLIGHTS_MAX_CANDIDATES)
+}
+
+/** One prompt line per candidate: title, type, year, genres and how far along the viewer is. */
+private fun describeCandidate(candidate: SmartHighlightCandidate): String = buildString {
+    append(candidate.item.name)
+    append(" (")
+    append(candidate.item.type)
+    candidate.item.releaseInfo?.trim()?.takeIf { it.isNotEmpty() }?.let { year ->
+        append(", ")
+        append(year.take(12))
+    }
+    append(")")
+    val genres = candidate.item.genres.take(3).filter { it.isNotBlank() }
+    if (genres.isNotEmpty()) {
+        append(" [")
+        append(genres.joinToString(", "))
+        append("]")
+    }
+    when {
+        candidate.progressPercent != null -> {
+            append(" — ")
+            append(candidate.progressPercent)
+            append("% watched")
+        }
+        candidate.fromLibrary -> append(" — in their watchlist")
+    }
+}
+
+private fun SmartHighlightCandidate.toPick(reason: String) =
+    SmartHighlightPick(item = item, reason = reason, ranked = false)
+
+private fun fallbackReason(candidate: SmartHighlightCandidate): String =
+    if (candidate.progressPercent != null) {
+        "Continue watching"
+    } else {
+        "Saved recently"
+    }
