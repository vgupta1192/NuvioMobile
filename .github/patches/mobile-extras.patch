+                description = stringResource(Res.string.settings_highlights_toggle_description),
+                checked = enabled,
+                isTablet = isTablet,
+                onCheckedChange = SmartHighlightsPreferences::setEnabled,
+            )
+            SettingsGroupDivider(isTablet = isTablet)
+            GeminiApiKeyRow(
+                isTablet = isTablet,
+                apiKeyConfigured = apiKeyConfigured,
+            )
+        }
+    }
+}
+
+@Composable
+private fun GeminiApiKeyRow(
+    isTablet: Boolean,
+    apiKeyConfigured: Boolean,
+) {
+    // The stored key is never prefilled or displayed; the draft starts empty every time.
+    var draft by rememberSaveable { mutableStateOf("") }
+    var statusMessage by rememberSaveable { mutableStateOf("") }
+    var busy by rememberSaveable { mutableStateOf(false) }
+    val scope = rememberCoroutineScope()
+    val uriHandler = LocalUriHandler.current
+    val keySavedMessage = stringResource(Res.string.settings_highlights_gemini_key_saved)
+    val connectedMessage = stringResource(Res.string.settings_highlights_gemini_status_connected)
+    val invalidKeyMessage = stringResource(Res.string.settings_highlights_gemini_status_invalid_key)
+    val rateLimitedMessage = stringResource(Res.string.settings_highlights_gemini_status_rate_limited)
+    val unreachableMessage = stringResource(Res.string.settings_highlights_gemini_status_unreachable)
+
+    Column(
+        modifier = Modifier
+            .fillMaxWidth()
+            .padding(horizontal = if (isTablet) 20.dp else 16.dp, vertical = if (isTablet) 16.dp else 14.dp),
+        verticalArrangement = Arrangement.spacedBy(10.dp),
+    ) {
+        Column(verticalArrangement = Arrangement.spacedBy(4.dp)) {
+            Text(
+                text = stringResource(Res.string.settings_highlights_gemini_personal_key),
+                style = MaterialTheme.typography.bodyLarge,
+                color = MaterialTheme.colorScheme.onSurface,
+                fontWeight = FontWeight.Medium,
+            )
+            Text(
+                text = stringResource(Res.string.settings_highlights_gemini_personal_key_description),
+                style = MaterialTheme.typography.bodyMedium,
+                color = MaterialTheme.colorScheme.onSurfaceVariant,
+            )
+        }
+        SettingsSecretTextField(
+            value = draft,
+            onValueChange = { draft = it },
+            modifier = Modifier.fillMaxWidth(),
+            label = stringResource(Res.string.settings_highlights_gemini_key_label),
+        )
+        Row(horizontalArrangement = Arrangement.spacedBy(10.dp)) {
+            Button(
+                onClick = {
+                    SmartHighlightsPreferences.setApiKey(draft.trim())
+                    draft = ""
+                    statusMessage = keySavedMessage
+                },
+                enabled = draft.isNotBlank(),
+            ) {
+                Text(stringResource(Res.string.action_save))
+            }
+            Button(
+                onClick = {
+                    if (busy) return@Button
+                    busy = true
+                    statusMessage = ""
+                    scope.launch {
+                        val result = runCatching { GeminiRankingClient().testConnection() }
+                        busy = false
+                        statusMessage = result.fold(
+                            onSuccess = { connectedMessage },
+                            onFailure = { error ->
+                                when ((error as? GeminiRankingException)?.reason) {
+                                    GeminiRankingException.Reason.NO_KEY,
+                                    GeminiRankingException.Reason.AUTHENTICATION -> invalidKeyMessage
+                                    GeminiRankingException.Reason.RATE_LIMIT -> rateLimitedMessage
+                                    else -> unreachableMessage
+                                }
+                            },
+                        )
+                    }
+                },
+                enabled = SmartHighlightsPreferences.hasApiKey() && !busy,
+            ) {
+                Text(stringResource(Res.string.settings_highlights_gemini_test_connection))
+            }
+            if (apiKeyConfigured) {
+                Button(
+                    onClick = {
+                        SmartHighlightsPreferences.setApiKey(null)
+                        SmartHighlightsRankingCache().clear()
+                        draft = ""
+                        statusMessage = ""
+                    },
+                ) {
+                    Text(stringResource(Res.string.action_reset))
+                }
+            }
+        }
+        if (statusMessage.isNotBlank()) {
+            Text(
+                text = statusMessage,
+                style = MaterialTheme.typography.bodySmall,
+                color = MaterialTheme.colorScheme.onSurfaceVariant,
+            )
+        }
+        Text(
+            text = stringResource(Res.string.settings_highlights_gemini_get_key),
+            style = MaterialTheme.typography.bodySmall,
+            color = MaterialTheme.colorScheme.primary,
+            modifier = Modifier.clickable { uriHandler.openUri("https://aistudio.google.com/app/apikey") },
+        )
+    }
+}
