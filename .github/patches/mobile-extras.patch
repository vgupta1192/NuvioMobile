+ */
+internal actual object ReleaseReminderNotificationPlatform {
+    private const val scheduledIdsKey = "release_reminder_scheduled_ids"
+    private const val remindersHour = 9L
+    private const val remindersMinute = 0L
+
+    actual suspend fun notificationsAuthorized(): Boolean = suspendCancellableCoroutine { continuation ->
+        UNUserNotificationCenter.currentNotificationCenter().getNotificationSettingsWithCompletionHandler { settings ->
+            val status = settings?.authorizationStatus
+            continuation.resume(
+                status == UNAuthorizationStatusAuthorized || status == UNAuthorizationStatusProvisional,
+            )
+        }
+    }
+
+    actual suspend fun requestAuthorization(): Boolean = suspendCancellableCoroutine { continuation ->
+        UNUserNotificationCenter.currentNotificationCenter().requestAuthorizationWithOptions(
+            options = UNAuthorizationOptionAlert or UNAuthorizationOptionSound or UNAuthorizationOptionBadge,
+        ) { granted, _ ->
+            continuation.resume(granted)
+        }
+    }
+
+    actual suspend fun schedule(reminders: List<ReleaseReminder>) {
+        clearAll()
+
+        val center = UNUserNotificationCenter.currentNotificationCenter()
+        val scheduledIds = mutableListOf<String>()
+        reminders.forEach { reminder ->
+            val dateComponents = dateComponentsFor(reminder.releaseDateMs) ?: return@forEach
+            val scheduledDate = NSCalendar.currentCalendar.dateFromComponents(dateComponents) ?: return@forEach
+            if (scheduledDate.timeIntervalSince1970 <= NSDate().timeIntervalSince1970) return@forEach
+
+            val content = UNMutableNotificationContent().apply {
+                setTitle(
+                    runBlocking {
+                        getString(Res.string.reminders_notification_title_released, reminder.title)
+                    },
+                )
+                setBody(
+                    runBlocking {
+                        getString(
+                            Res.string.reminders_notification_body,
+                            formatReminderReleaseDate(reminder.releaseDateMs),
+                        )
+                    },
+                )
+                setUserInfo(
+                    mapOf(
+                        "deeplink" to buildMetaDeepLinkUrl(
+                            type = reminder.itemType,
+                            id = reminder.contentId,
+                        ),
+                    ),
+                )
+            }
+            val trigger = UNCalendarNotificationTrigger.triggerWithDateMatchingComponents(
+                dateComponents = dateComponents,
+                repeats = false,
+            )
+            val identifier = buildReleaseReminderId(reminder)
+            center.addNotificationRequest(
+                UNNotificationRequest.requestWithIdentifier(
+                    identifier = identifier,
+                    content = content,
+                    trigger = trigger,
+                ),
+            ) { _ -> }
+            scheduledIds += identifier
+        }
+
+        storeScheduledIds(scheduledIds.joinToString(separator = "|"))
+    }
+
+    actual suspend fun clearAll() {
+        val identifiers = readScheduledIds()
+            ?.split('|')
+            ?.filter { value -> value.isNotBlank() }
+            .orEmpty()
+        if (identifiers.isNotEmpty()) {
+            UNUserNotificationCenter.currentNotificationCenter()
+                .removePendingNotificationRequestsWithIdentifiers(identifiers)
+        }
+        clearScheduledIds()
+    }
+
+    private fun dateComponentsFor(releaseDateMs: Long): NSDateComponents? {
+        if (releaseDateMs <= 0L) return null
+        val date = NSDate.dateWithTimeIntervalSince1970(releaseDateMs / 1000.0)
+        val units = NSCalendarUnitYear or NSCalendarUnitMonth or NSCalendarUnitDay or
+            NSCalendarUnitHour or NSCalendarUnitMinute
+        val components = NSCalendar.currentCalendar.components(units, fromDate = date) ?: return null
+        components.hour = remindersHour
+        components.minute = remindersMinute
+        components.second = 0
+        return components
+    }
+
+    private fun storeScheduledIds(value: String) {
+        platform.Foundation.NSUserDefaults.standardUserDefaults.setObject(
+            value,
+            forKey = ProfileScopedKey.of(scheduledIdsKey),
+        )
+    }
+
+    private fun readScheduledIds(): String? =
+        platform.Foundation.NSUserDefaults.standardUserDefaults.stringForKey(
+            ProfileScopedKey.of(scheduledIdsKey),
+        )
+
+    private fun clearScheduledIds() {
+        platform.Foundation.NSUserDefaults.standardUserDefaults.removeObjectForKey(
+            ProfileScopedKey.of(scheduledIdsKey),
+        )
+    }
+}
