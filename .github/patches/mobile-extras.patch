+import coil3.compose.AsyncImage
+import com.nuvio.app.features.genres.GenreEntry
+import nuvio.composeapp.generated.resources.Res
+import nuvio.composeapp.generated.resources.home_genres_title
+import org.jetbrains.compose.resources.stringResource
+
+/**
+ * Nuvio fork: the home "Genres" row — one chip per locally derived genre. Tapping a chip opens
+ * the genre's browse grid. Renders nothing (zero height) while the index is empty, so with no
+ * fetched metadata yet home looks exactly as before.
+ */
+@Composable
+internal fun ForkHomeGenresRow(
+    genres: List<GenreEntry>,
+    sectionPadding: Dp,
+    modifier: Modifier = Modifier,
+    onGenreClick: ((genre: String) -> Unit)? = null,
+) {
+    if (genres.isEmpty() || onGenreClick == null) return
+    Row(modifier = modifier.fillMaxWidth()) {
+        androidx.compose.foundation.layout.Column(modifier = Modifier.fillMaxWidth()) {
+            Text(
+                text = stringResource(Res.string.home_genres_title),
+                style = MaterialTheme.typography.titleLarge,
+                color = MaterialTheme.colorScheme.onBackground,
+                modifier = Modifier
+                    .padding(start = sectionPadding, end = sectionPadding, bottom = 8.dp),
+            )
+            LazyRow(
+                contentPadding = PaddingValues(horizontal = sectionPadding),
+                horizontalArrangement = Arrangement.spacedBy(10.dp),
+                modifier = Modifier.fillMaxWidth(),
+            ) {
+                items(
+                    count = genres.size,
+                    key = { index -> "genre_${genres[index].name}" },
+                ) { index ->
+                    val genre = genres[index]
+                    GenreChip(
+                        genre = genre,
+                        onClick = { onGenreClick(genre.name) },
+                    )
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun GenreChip(
+    genre: GenreEntry,
+    onClick: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    Box(
+        modifier = modifier
+            .width(148.dp)
+            .height(84.dp)
+            .clip(RoundedCornerShape(12.dp))
+            .background(MaterialTheme.colorScheme.surfaceVariant)
+            .clickable(onClick = onClick),
+    ) {
+        genre.posterUrl?.let { posterUrl ->
+            AsyncImage(
+                model = posterUrl,
+                contentDescription = null,
+                contentScale = ContentScale.Crop,
+                modifier = Modifier
+                    .aspectRatio(16f / 9f)
+                    .fillMaxWidth()
+                    .height(84.dp),
+            )
+        }
+        Box(
+            modifier = Modifier
+                .matchParentSize()
+                .background(
+                    Brush.horizontalGradient(
+                        colors = listOf(
+                            Color.Black.copy(alpha = 0.72f),
+                            Color.Black.copy(alpha = 0.24f),
+                        ),
+                    ),
+                ),
+        )
+        Text(
+            text = genre.name,
+            style = MaterialTheme.typography.titleSmall,
+            fontWeight = FontWeight.SemiBold,
+            color = Color.White,
+            maxLines = 2,
+            overflow = TextOverflow.Ellipsis,
+            modifier = Modifier
+                .align(Alignment.CenterStart)
+                .padding(horizontal = 12.dp),
+        )
+    }
+}
diff --git a/composeApp/src/commonMain/kotlin/com/nuvio/app/features/genres/GenreIndex.kt b/composeApp/src/commonMain/kotlin/com/nuvio/app/features/genres/GenreIndex.kt
new file mode 100644
index 0000000..5c8be59
--- /dev/null
+++ b/composeApp/src/commonMain/kotlin/com/nuvio/app/features/genres/GenreIndex.kt
@@ -0,0 +1,130 @@
+package com.nuvio.app.features.genres
+
+import com.nuvio.app.core.time.EpisodeReleaseDatePlatform
+import com.nuvio.app.features.home.HomeRepository
+import com.nuvio.app.features.home.MetaPreview
+import com.nuvio.app.features.home.isUnreleased
+import com.nuvio.app.features.library.LibraryRepository
+import com.nuvio.app.features.library.toMetaPreview
+import com.nuvio.app.features.watchprogress.CurrentDateProvider
+import com.nuvio.app.features.watchprogress.WatchProgressRepository
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.collectLatest
+import kotlinx.coroutines.flow.combine
+import kotlinx.coroutines.launch
+import kotlin.concurrent.Volatile
+
+/** One browsable genre, derived locally from metadata the app has already fetched. */
+data class GenreEntry(
+    val name: String,
+    val count: Int,
+    val posterUrl: String?,
+)
+
+/**
+ * Nuvio fork: local genre index for the home "Genres" browse row and the Genres screen.
+ *
+ * Everything is derived from state the app has already fetched (home catalogs and hero, the saved
+ * library, continue-watching entries) — no new server calls. Unreleased titles are excluded so a
+ * genre page does not advertise items that cannot play yet.
+ */
+object GenreIndex {
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.Default)
+
+    private val _genres = MutableStateFlow<List<GenreEntry>>(emptyList())
+    val genres: StateFlow<List<GenreEntry>> = _genres.asStateFlow()
+
+    private val _itemsByGenre = MutableStateFlow<Map<String, List<MetaPreview>>>(emptyMap())
+    val itemsByGenre: StateFlow<Map<String, List<MetaPreview>>> = _itemsByGenre.asStateFlow()
+
+    @Volatile private var started = false
+
+    /** Starts the index once; safe to call from every home render. */
+    fun ensureStarted() {
+        if (started) return
+        started = true
+        scope.launch {
+            combine(
+                HomeRepository.uiState,
+                LibraryRepository.uiState,
+                WatchProgressRepository.uiState,
+            ) { home, library, progress ->
+                Triple(home, library.items, progress.entries)
+            }
+                .collectLatest { (home, libraryItems, progressEntries) ->
+                    rebuild(home.heroItems, home.sections.flatMap { it.items }, libraryItems, progressEntries)
+                }
+        }
+    }
+
+    fun onProfileChanged() {
+        _genres.value = emptyList()
+        _itemsByGenre.value = emptyMap()
+    }
+
+    private fun rebuild(
+        heroItems: List<MetaPreview>,
+        catalogItems: List<MetaPreview>,
+        libraryItems: List<com.nuvio.app.features.library.LibraryItem>,
+        progressEntries: List<com.nuvio.app.features.watchprogress.WatchProgressEntry>,
+    ) {
+        val nowEpochMs = EpisodeReleaseDatePlatform.nowEpochMs()
+        val todayIsoDate = CurrentDateProvider.todayIsoDate()
+        val itemsByGenre = LinkedHashMap<String, LinkedHashMap<String, MetaPreview>>()
+
+        fun add(preview: MetaPreview) {
+            if (preview.name.isBlank()) return
+            if (preview.poster.isNullOrBlank() && preview.banner.isNullOrBlank() &&
+                preview.landscapePoster.isNullOrBlank()
+            ) {
+                return
+            }
+            if (preview.isUnreleased(todayIsoDate, nowEpochMs)) return
+            preview.genres
+                .mapNotNull { genre -> genre.trim().takeIf { it.isNotEmpty() } }
+                .forEach { genre ->
+                    val bucket = itemsByGenre.getOrPut(genre) { LinkedHashMap() }
+                    bucket.putIfAbsent("${preview.type}:${preview.id}", preview)
+                }
+        }
+
+        progressEntries.forEach { entry ->
+            if (entry.title.isBlank()) return@forEach
+            add(
+                MetaPreview(
+                    id = entry.parentMetaId,
+                    type = entry.parentMetaType,
+                    name = entry.title,
+                    poster = entry.poster,
+                    banner = entry.background,
+                    posterShape = com.nuvio.app.features.home.PosterShape.Poster,
+                ),
+            )
+        }
+        libraryItems.forEach { item -> add(item.toMetaPreview()) }
+        heroItems.forEach(::add)
+        catalogItems.forEach(::add)
+
+        _itemsByGenre.value = itemsByGenre.mapValues { (_, bucket) -> bucket.values.toList() }
+        _genres.value = itemsByGenre
+            .map { (genre, bucket) ->
+                GenreEntry(
+                    name = genre,
+                    count = bucket.size,
+                    posterUrl = bucket.values.firstNotNullOfOrNull { preview ->
+                        preview.landscapePoster ?: preview.banner ?: preview.poster
+                    },
+                )
+            }
+            .sortedWith(compareByDescending<GenreEntry> { it.count }.thenBy { it.name.lowercase() })
+    }
+}
+
+/** The titles inside one genre, in a stable "poster" order for the browse grid. */
+internal fun genreItemsFor(genre: String): List<MetaPreview> =
+    GenreIndex.itemsByGenre.value[genre].orEmpty()
