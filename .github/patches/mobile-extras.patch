new file mode 100644
index 0000000..07a66d9
--- /dev/null
+++ b/composeApp/src/commonMain/kotlin/com/nuvio/app/features/reminders/ReleaseRemindersRepository.kt
@@ -0,0 +1,159 @@
+package com.nuvio.app.features.reminders
+
+import co.touchlab.kermit.Logger
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.launch
+import kotlinx.serialization.builtins.ListSerializer
+import kotlinx.serialization.json.Json
+import kotlin.concurrent.Volatile
+
+/**
+ * Nuvio fork: release reminders set from detail screens of unreleased titles. Reminders persist
+ * per profile and produce one local notification at the title's release instant; the list is
+ * managed from Settings > Notifications.
+ */
+object ReleaseRemindersRepository {
+    private val log = Logger.withTag("ReleaseReminders")
+
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.Default)
+    private val json = Json {
+        ignoreUnknownKeys = true
+        encodeDefaults = true
+    }
+
+    private val _uiState = MutableStateFlow(ReleaseRemindersUiState())
+    val uiState: StateFlow<ReleaseRemindersUiState> = _uiState.asStateFlow()
+
+    @Volatile private var hasLoaded = false
+
+    fun ensureLoaded() {
+        if (hasLoaded) return
+        hasLoaded = true
+        loadFromDisk()
+        refreshPermissionState()
+        // In-process safety net: re-schedule whatever WorkManager may have lost (e.g. work cleared
+        // by an aggressive vendor cleaner) whenever the app starts.
+        scheduleAll()
+    }
+
+    fun onProfileChanged() {
+        loadFromDisk()
+        refreshPermissionState()
+        scheduleAll()
+    }
+
+    fun clearLocalState() {
+        hasLoaded = false
+        _uiState.value = ReleaseRemindersUiState()
+        scope.launch {
+            runCatching { ReleaseReminderNotificationPlatform.clearAll() }
+                .onFailure { error -> log.w { "Failed to clear scheduled reminders: ${error.message}" } }
+        }
+    }
+
+    /** True when this exact item+release pairing already has a reminder. */
+    fun isReminded(itemId: String, releaseDateMs: Long): Boolean {
+        ensureLoaded()
+        return _uiState.value.reminders.any { reminder ->
+            reminder.itemId == itemId && reminder.releaseDateMs == releaseDateMs
+        }
+    }
+
+    fun setReminded(
+        itemId: String,
+        title: String,
+        releaseDateMs: Long,
+        posterUrl: String?,
+        reminded: Boolean,
+    ) {
+        ensureLoaded()
+        val current = _uiState.value.reminders
+        val updated = if (reminded) {
+            val reminder = ReleaseReminder(
+                itemId = itemId,
+                title = title,
+                releaseDateMs = releaseDateMs,
+                posterUrl = posterUrl?.takeIf { it.isNotBlank() },
+            )
+            current.filterNot { it.itemId == itemId } + reminder
+        } else {
+            current.filterNot { it.itemId == itemId }
+        }
+        _uiState.value = _uiState.value.copy(reminders = updated)
+        persist(updated)
+        scope.launch { scheduleAll() }
+    }
+
+    fun remove(itemId: String) {
+        setReminded(itemId = itemId, title = "", releaseDateMs = 0L, posterUrl = null, reminded = false)
+    }
+
+    fun refreshAsync() {
+        ensureLoaded()
+        scope.launch { scheduleAll() }
+    }
+
+    /** Requests notification permission through the shared runtime prompt flow. */
+    suspend fun requestPermission(): Boolean =
+        runCatching { com.nuvio.app.features.notifications.EpisodeReleaseNotificationPlatform.requestAuthorization() }
+            .onFailure { error ->
+                log.w { "Failed to request notification permission: ${error.message}" }
+            }
+            .getOrElse { false }
+            .also { granted ->
+                _uiState.value = _uiState.value.copy(permissionGranted = granted)
+            }
+
+    private fun refreshPermissionState() {
+        scope.launch {
+            val granted = runCatching { ReleaseReminderNotificationPlatform.notificationsAuthorized() }
+                .onFailure { error ->
+                    log.w { "Failed to read notification permission: ${error.message}" }
+                }
+                .getOrDefault(false)
+            _uiState.value = _uiState.value.copy(permissionGranted = granted)
+        }
+    }
+
+    private fun scheduleAll() {
+        val reminders = _uiState.value.reminders
+        scope.launch {
+            runCatching { ReleaseReminderNotificationPlatform.schedule(reminders) }
+                .onFailure { error ->
+                    log.w { "Failed to schedule release reminders: ${error.message}" }
+                }
+        }
+    }
+
+    private fun loadFromDisk() {
+        hasLoaded = true
+        val payload = ReleaseRemindersStorage.loadPayload().orEmpty().trim()
+        val reminders = payload.takeIf { it.isNotEmpty() }
+            ?.let { rawPayload ->
+                runCatching {
+                    json.decodeFromString(ListSerializer(ReleaseReminder.serializer()), rawPayload)
+                }.onFailure { error ->
+                    log.w { "Failed to decode release reminders payload: ${error.message}" }
+                }.getOrNull()
+            }
+            .orEmpty()
+            .filter { it.itemId.isNotBlank() && it.releaseDateMs > 0L }
+        _uiState.value = ReleaseRemindersUiState(reminders = reminders)
+    }
+
+    private fun persist(reminders: List<ReleaseReminder>) {
+        runCatching {
+            ReleaseRemindersStorage.savePayload(
+                json.encodeToString(
+                    ListSerializer(ReleaseReminder.serializer()),
+                    reminders.sortedBy { it.releaseDateMs },
+                ),
+            )
+        }
+    }
+}
