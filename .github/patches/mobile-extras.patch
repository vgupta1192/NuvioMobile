+package com.nuvio.app.features.highlights
+
+import co.touchlab.kermit.Logger
+import io.ktor.client.HttpClient
+import io.ktor.client.request.header
+import io.ktor.client.request.post
+import io.ktor.client.request.setBody
+import io.ktor.client.statement.bodyAsText
+import io.ktor.http.ContentType
+import io.ktor.http.HttpStatusCode
+import io.ktor.http.contentType
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+import kotlinx.serialization.json.add
+import kotlinx.serialization.json.buildJsonArray
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.int
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import kotlinx.serialization.json.put
+import kotlinx.serialization.json.putJsonObject
+
+/** One ranked candidate: the candidate list index plus a short "why" for the reason chip. */
+internal data class GeminiRankEntry(
+    val index: Int,
+    val reason: String,
+)
+
+/** Thrown when Gemini cannot serve a ranking; callers fall back to the unranked order silently. */
+internal class GeminiRankingException(val reason: Reason) : Exception(reason.name) {
+    enum class Reason { NO_KEY, AUTHENTICATION, RATE_LIMIT, UNAVAILABLE, INVALID_RESPONSE }
+}
+
+/**
+ * Nuvio fork: REST call to Gemini `generateContent` (v1beta, gemini-2.0-flash) that orders a
+ * compact candidate list and returns a short reason per pick. The key travels in the
+ * `x-goog-api-key` header only — never in a URL, a log line, or storage outside the scoped
+ * preference store. The response is shape-enforced with a responseSchema, and the parser is
+ * defensive: any malformed answer maps to [GeminiRankingException] so the rail can fall back.
+ */
+internal class GeminiRankingClient(
+    private val client: HttpClient = createGeminiHttpClient(),
+) {
+    fun hasKey(): Boolean = SmartHighlightsPreferences.hasApiKey()
+
+    /** Cheap round trip used by the settings screen to verify a key. */
+    suspend fun testConnection() {
+        val body = buildJsonObject {
+            put("contents", buildJsonArray {
+                add(buildJsonObject {
+                    put("parts", buildJsonArray {
+                        add(buildJsonObject { put("text", "Reply with the single word: ok") })
+                    })
+                })
+            })
+            putJsonObject("generationConfig") { put("maxOutputTokens", 8) }
+        }
+        post(body)
+    }
+
+    /**
+     * Ranks [candidates] (already formatted one-per-line, 1-based). Returns entries in the order
+     * Gemini preferred them, restricted to in-range indexes with a non-blank reason.
+     */
+    suspend fun rank(candidates: List<String>, pickCount: Int): List<GeminiRankEntry> {
+        if (candidates.isEmpty()) return emptyList()
+        val prompt = buildString {
+            append("You curate a short \"Smart Highlights\" row on a streaming app's home screen. ")
+            append("Below is a numbered list of titles from this viewer's own library and continue-watching progress. ")
+            append("Choose the ")
+            append(pickCount.coerceAtMost(candidates.size))
+            append(" most appealing titles to feature first — favour a good mix, momentum (things they are part way through) ")
+            append("and what fits together — and order them best first. ")
+            append("For each pick give a reason of at most 6 words, addressed like a note to the viewer (e.g. \"you left off mid-season\"). ")
+            append("Respond with the picks as a JSON array of {\"index\": <candidate number>, \"reason\": \"...\"} objects, best pick first.\n\n")
+            append(candidates.joinToString("\n"))
+        }
+        val schema = buildJsonObject {
+            put("type", "ARRAY")
+            put("items", buildJsonObject {
+                put("type", "OBJECT")
+                put("properties", buildJsonObject {
+                    put("index", buildJsonObject { put("type", "INTEGER") })
+                    put("reason", buildJsonObject { put("type", "STRING") })
+                })
+                put("required", buildJsonArray {
+                    add(JsonPrimitive("index"))
+                    add(JsonPrimitive("reason"))
+                })
+            })
+        }
+        val body = buildJsonObject {
+            put("contents", buildJsonArray {
+                add(buildJsonObject {
+                    put("parts", buildJsonArray {
+                        add(buildJsonObject { put("text", prompt) })
+                    })
+                })
+            })
+            putJsonObject("generationConfig") {
+                put("responseMimeType", "application/json")
+                put("responseSchema", schema)
+                put("temperature", 0.3)
+            }
+        }
+        return parse(post(body), candidates.size)
+    }
+
+    private suspend fun post(body: JsonObject): String {
+        val apiKey = SmartHighlightsPreferences.readApiKey()
+            ?: throw GeminiRankingException(GeminiRankingException.Reason.NO_KEY)
+        val response = runCatching {
+            client.post("$BASE_URL/models/$MODEL:generateContent") {
+                header("x-goog-api-key", apiKey)
+                contentType(ContentType.Application.Json)
+                setBody(body.toString())
+            }
+        }.getOrElse { error ->
+            log.w(error) { "Gemini ranking request failed" }
+            throw GeminiRankingException(GeminiRankingException.Reason.UNAVAILABLE)
+        }
+        when {
+            response.status == HttpStatusCode.OK ||
+                response.status == HttpStatusCode.Created -> Unit
+            response.status == HttpStatusCode.Unauthorized ||
+                response.status == HttpStatusCode.Forbidden ->
+                throw GeminiRankingException(GeminiRankingException.Reason.AUTHENTICATION)
+            response.status == HttpStatusCode.TooManyRequests ->
+                throw GeminiRankingException(GeminiRankingException.Reason.RATE_LIMIT)
+            else -> throw GeminiRankingException(GeminiRankingException.Reason.UNAVAILABLE)
+        }
+        val payload = response.bodyAsText()
+        val text = runCatching {
+            json.parseToJsonElement(payload)
+                .jsonObject["candidates"]?.jsonArray
+                ?.firstOrNull()?.jsonObject?.get("content")?.jsonObject
+                ?.get("parts")?.jsonArray?.firstOrNull()?.jsonObject
+                ?.get("text")?.jsonPrimitive?.content
+        }.getOrNull()
+        if (text.isNullOrBlank()) {
+            throw GeminiRankingException(GeminiRankingException.Reason.INVALID_RESPONSE)
+        }
+        return text
+    }
+
+    private fun parse(text: String, candidateCount: Int): List<GeminiRankEntry> {
+        val stripped = text.trim()
+            .removePrefix("```json").removePrefix("```").trim().removeSuffix("```")
+        val array = runCatching { json.parseToJsonElement(stripped).jsonArray }.getOrNull()
+            ?: throw GeminiRankingException(GeminiRankingException.Reason.INVALID_RESPONSE)
+        val out = ArrayList<GeminiRankEntry>(array.size)
+        for (element in array) {
+            val entry = element as? JsonObject ?: continue
+            val index = entry["index"]?.jsonPrimitive?.int?.minus(1) ?: continue
+            if (index < 0 || index >= candidateCount) continue
+            val reason = entry["reason"]?.jsonPrimitive?.content?.trim()?.takeIf { it.isNotEmpty() } ?: continue
+            out += GeminiRankEntry(index, reason.take(SMART_HIGHLIGHTS_MAX_REASON_LENGTH))
+        }
+        if (out.isEmpty()) {
+            throw GeminiRankingException(GeminiRankingException.Reason.INVALID_RESPONSE)
+        }
+        return out.distinctBy { it.index }
+    }
+
+    companion object {
+        private val log = Logger.withTag("GeminiRanking")
+        private val json = Json { ignoreUnknownKeys = true }
+        private const val BASE_URL = "https://generativelanguage.googleapis.com/v1beta"
+        private const val MODEL = "gemini-2.0-flash"
+    }
+}
