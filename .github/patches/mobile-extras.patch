+package com.nuvio.app.features.highlights
+
+import com.nuvio.app.features.home.MetaPreview
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.serialization.Serializable
+
+/** How many picks the Smart Highlights rail shows. */
+internal const val SMART_HIGHLIGHTS_MAX_PICKS = 6
+
+/** How many candidates at most are described to Gemini. */
+internal const val SMART_HIGHLIGHTS_MAX_CANDIDATES = 12
+
+/** In-progress and library candidates considered before the overall cap. */
+internal const val SMART_HIGHLIGHTS_MAX_PROGRESS_CANDIDATES = 8
+internal const val SMART_HIGHLIGHTS_MAX_LIBRARY_CANDIDATES = 8
+
+/** How long home waits after startup before the first ranking pass. */
+internal const val SMART_HIGHLIGHTS_STARTUP_DELAY_MS = 5_000L
+
+/** Reason chips are one short line; anything longer is clipped. */
+internal const val SMART_HIGHLIGHTS_MAX_REASON_LENGTH = 48
+
+/** One featured title with the short reason its chip shows. */
+data class SmartHighlightPick(
+    val item: MetaPreview,
+    val reason: String,
+    /** True when Gemini chose the position and wrote the reason; false for the fallback order. */
+    val ranked: Boolean,
+)
+
+/** A title eligible for the rail, before ranking. */
+internal data class SmartHighlightCandidate(
+    val item: MetaPreview,
+    /** 0..100 when the viewer is part way through, else null. */
+    val progressPercent: Int?,
+    /** True when the title comes from the saved library rather than playback progress. */
+    val fromLibrary: Boolean,
+) {
+    /** Stable identity of the candidate set membership; drives the ranking cache key. */
+    val cacheToken: String
+        get() = "${item.type}:${item.id}"
+}
+
+/**
+ * Nuvio fork: preferences for the Smart Highlights rail plus the per-profile Gemini API key.
+ * Defaults keep the behavior identical for anyone who never opens the new settings section.
+ */
+object SmartHighlightsPreferences {
+    private val _enabled = MutableStateFlow(true)
+    val enabled: StateFlow<Boolean> = _enabled.asStateFlow()
+
+    private val _apiKeyConfigured = MutableStateFlow(false)
+    /** Never the key itself: settings only learn whether one is configured. */
+    val apiKeyConfigured: StateFlow<Boolean> = _apiKeyConfigured.asStateFlow()
+
+    private var enabledLoaded = false
+    private var apiKeyLoaded = false
+
+    fun ensureLoaded() {
+        if (!enabledLoaded) {
+            enabledLoaded = true
+            _enabled.value = SmartHighlightsStorage.loadEnabled() ?: true
+        }
+        if (!apiKeyLoaded) {
+            apiKeyLoaded = true
+            _apiKeyConfigured.value = SmartHighlightsStorage.loadApiKey() != null
+        }
+    }
+
+    fun isEnabled(): Boolean {
+        ensureLoaded()
+        return _enabled.value
+    }
+
+    fun setEnabled(value: Boolean) {
+        ensureLoaded()
+        _enabled.value = value
+        SmartHighlightsStorage.saveEnabled(value)
+    }
+
+    fun hasApiKey(): Boolean {
+        ensureLoaded()
+        return _apiKeyConfigured.value
+    }
+
+    /** Reads the configured key for the active profile; only the ranking client consumes this. */
+    fun readApiKey(): String? = SmartHighlightsStorage.loadApiKey()
+
+    fun setApiKey(apiKey: String?) {
+        ensureLoaded()
+        SmartHighlightsStorage.saveApiKey(apiKey.orEmpty())
+        _apiKeyConfigured.value = apiKey != null
+    }
+
+    fun onProfileChanged() {
+        enabledLoaded = false
+        apiKeyLoaded = false
+        _enabled.value = true
+        _apiKeyConfigured.value = false
+        ensureLoaded()
+    }
+
+    fun clearLocalState() {
+        enabledLoaded = false
+        apiKeyLoaded = false
+        _enabled.value = true
+        _apiKeyConfigured.value = false
+        SmartHighlightsStorage.saveEnabled(true)
+        SmartHighlightsStorage.saveApiKey("")
+        SmartHighlightsStorage.clearRankingCache()
+    }
+}
+
+@Serializable
+internal data class StoredSmartHighlightsRanking(
+    val hash: String = "",
+    val savedAtMs: Long = 0L,
+    val entries: List<StoredSmartHighlightsRankEntry> = emptyList(),
+)
+
+@Serializable
+internal data class StoredSmartHighlightsRankEntry(
+    val index: Int,
+    val reason: String,
+)
