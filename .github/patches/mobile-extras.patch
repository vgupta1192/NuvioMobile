@@ -0,0 +1,184 @@
+package com.nuvio.app.features.reminders
+
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.content.Context
+import android.content.Intent
+import androidx.core.app.NotificationCompat
+import androidx.core.app.NotificationManagerCompat
+import androidx.work.Data
+import androidx.work.ExistingWorkPolicy
+import androidx.work.OneTimeWorkRequestBuilder
+import androidx.work.Operation
+import androidx.work.WorkManager
+import com.nuvio.app.core.deeplink.buildMetaDeepLinkUrl
+import com.nuvio.app.core.storage.ProfileScopedKey
+import com.nuvio.app.features.settings.AppIconPlatform
+import java.util.concurrent.TimeUnit
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.runBlocking
+import kotlinx.coroutines.withContext
+import nuvio.composeapp.generated.resources.Res
+import nuvio.composeapp.generated.resources.reminders_channel_description
+import nuvio.composeapp.generated.resources.reminders_channel_name
+import nuvio.composeapp.generated.resources.reminders_notification_body
+import nuvio.composeapp.generated.resources.reminders_notification_title_released
+import org.jetbrains.compose.resources.getString
+
+internal actual object ReleaseReminderNotificationPlatform {
+    private const val platformPreferencesName = "nuvio_release_reminders_platform"
+    private const val scheduledIdsKey = "scheduled_release_reminder_ids"
+    private const val workTag = "release_reminder_notifications"
+    internal const val channelId = "release_reminder_notifications"
+    internal const val workerItemIdKey = "item_id"
+    internal const val workerTitleKey = "title"
+    internal const val workerReleaseDateMsKey = "release_date_ms"
+
+    private var appContext: Context? = null
+
+    fun initialize(context: Context) {
+        appContext = context.applicationContext
+        ensureNotificationChannel()
+    }
+
+    internal suspend fun buildNotification(context: Context, reminder: ReleaseReminder): android.app.Notification {
+        val releaseDateText = formatReminderReleaseDate(reminder.releaseDateMs)
+        val title = runBlocking { getString(Res.string.reminders_notification_title_released, reminder.title) }
+        val body = runBlocking { getString(Res.string.reminders_notification_body, releaseDateText) }
+        val launchIntent = Intent().apply {
+            component = AppIconPlatform.currentLauncherComponent(context)
+            action = Intent.ACTION_VIEW
+            data = android.net.Uri.parse(
+                buildMetaDeepLinkUrl(type = reminder.itemType, id = reminder.contentId),
+            )
+            flags = Intent.FLAG_ACTIVITY_NEW_TASK or
+                Intent.FLAG_ACTIVITY_CLEAR_TOP or
+                Intent.FLAG_ACTIVITY_SINGLE_TOP
+        }
+        val pendingIntent = PendingIntent.getActivity(
+            context,
+            kotlin.math.abs(reminder.itemId.hashCode()),
+            launchIntent,
+            PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE,
+        )
+        return NotificationCompat.Builder(context, channelId)
+            .setSmallIcon(com.nuvio.app.R.drawable.ic_notification_small)
+            .setContentTitle(title)
+            .setContentText(body)
+            .setStyle(NotificationCompat.BigTextStyle().bigText(body))
+            .setAutoCancel(true)
+            .setPriority(NotificationCompat.PRIORITY_DEFAULT)
+            .setContentIntent(pendingIntent)
+            .build()
+    }
+
+    actual suspend fun notificationsAuthorized(): Boolean {
+        val context = appContext ?: return false
+        return androidx.core.app.NotificationManagerCompat.from(context).areNotificationsEnabled()
+    }
+
+    actual suspend fun requestAuthorization(): Boolean {
+        val context = appContext ?: return false
+        // Below Android 13 notifications are granted by default; from 13 on the runtime grant is
+        // requested by the shared episode-release permission flow, which this repository calls
+        // before scheduling. Nothing extra to do here besides reporting the current state.
+        ensureNotificationChannel()
+        return androidx.core.app.NotificationManagerCompat.from(context).areNotificationsEnabled()
+    }
+
+    actual suspend fun schedule(reminders: List<ReleaseReminder>) {
+        val context = appContext ?: return
+        ensureNotificationChannel()
+
+        withContext(Dispatchers.IO) {
+            val workManager = WorkManager.getInstance(context)
+            cancelTrackedWork(workManager)
+
+            val nowEpochMs = System.currentTimeMillis()
+            val scheduledIds = mutableListOf<String>()
+            reminders.forEach { reminder ->
+                val uniqueName = uniqueWorkName(reminder)
+                if (reminder.releaseDateMs <= nowEpochMs) {
+                    runCatching { workManager.cancelUniqueWork(uniqueName) }
+                    return@forEach
+                }
+                val initialDelayMs = reminder.releaseDateMs - nowEpochMs
+                val inputData = Data.Builder()
+                    .putString(workerItemIdKey, reminder.itemId)
+                    .putString(workerTitleKey, reminder.title)
+                    .putLong(workerReleaseDateMsKey, reminder.releaseDateMs)
+                    .build()
+                val workRequest = OneTimeWorkRequestBuilder<ReleaseReminderWorker>()
+                    .setInputData(inputData)
+                    .setInitialDelay(initialDelayMs, TimeUnit.MILLISECONDS)
+                    .addTag(workTag)
+                    .build()
+                awaitOperation(
+                    workManager.enqueueUniqueWork(
+                        uniqueName,
+                        ExistingWorkPolicy.REPLACE,
+                        workRequest,
+                    ),
+                )
+                scheduledIds += uniqueName
+            }
+
+            preferences(context)
+                .edit()
+                .putStringSet(ProfileScopedKey.of(scheduledIdsKey), scheduledIds.toSet())
+                .apply()
+        }
+    }
+
+    actual suspend fun clearAll() {
+        val context = appContext ?: return
+        withContext(Dispatchers.IO) {
+            val workManager = WorkManager.getInstance(context)
+            cancelTrackedWork(workManager)
+            preferences(context)
+                .edit()
+                .remove(ProfileScopedKey.of(scheduledIdsKey))
+                .apply()
+        }
+    }
+
+    private fun cancelTrackedWork(workManager: WorkManager) {
+        val context = appContext ?: return
+        preferences(context)
+            .getStringSet(ProfileScopedKey.of(scheduledIdsKey), emptySet())
+            .orEmpty()
+            .forEach { uniqueName ->
+                awaitOperation(workManager.cancelUniqueWork(uniqueName))
+            }
+    }
+
+    private fun awaitOperation(operation: Operation) {
+        operation.result.get()
+    }
+
+    private fun preferences(context: Context) =
+        context.getSharedPreferences(platformPreferencesName, Context.MODE_PRIVATE)
+
+    private fun uniqueWorkName(reminder: ReleaseReminder): String =
+        "$workTag:${buildReleaseReminderId(reminder)}"
+
+    private fun ensureNotificationChannel() {
+        val context = appContext ?: return
+        if (android.os.Build.VERSION.SDK_INT < android.os.Build.VERSION_CODES.O) return
+
+        val notificationManager = context.getSystemService(Context.NOTIFICATION_SERVICE) as? NotificationManager
+            ?: return
+        val existingChannel = notificationManager.getNotificationChannel(channelId)
+        if (existingChannel != null) return
+
+        val channel = NotificationChannel(
+            channelId,
+            runBlocking { getString(Res.string.reminders_channel_name) },
+            NotificationManager.IMPORTANCE_DEFAULT,
+        ).apply {
+            description = runBlocking { getString(Res.string.reminders_channel_description) }
+        }
+        notificationManager.createNotificationChannel(channel)
+    }
+}
