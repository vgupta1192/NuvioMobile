+package com.nuvio.app.features.highlights
+
+import kotlinx.serialization.json.Json
+
+/**
+ * Nuvio fork: persisted Gemini ranking for the Smart Highlights rail, scoped to the active
+ * profile through [SmartHighlightsStorage]. A ranking is valid for [TTL_MS] and only for the
+ * candidate set it was computed from (its [StoredSmartHighlightsRanking.hash]); a changed
+ * library or a changed progress picture simply misses the cache.
+ */
+internal class SmartHighlightsRankingCache(
+    private val nowEpochMs: () -> Long = { kotlin.time.Clock.System.now().toEpochMilliseconds() },
+) {
+    companion object {
+        /** How long a Gemini ranking is reused before home asks Gemini again. */
+        const val TTL_MS = 6L * 60L * 60L * 1000L
+    }
+
+    private val json = Json { ignoreUnknownKeys = true }
+
+    /** The cached ranking for [hash], or null when absent, stale, or unreadable. */
+    fun read(hash: String): List<GeminiRankEntry>? {
+        if (hash.isBlank()) return null
+        val payload = SmartHighlightsStorage.loadRankingCache().orEmpty().trim()
+        if (payload.isEmpty()) return null
+        val stored = runCatching {
+            json.decodeFromString<StoredSmartHighlightsRanking>(payload)
+        }.getOrNull() ?: return null
+        if (stored.hash != hash) return null
+        if (nowEpochMs() - stored.savedAtMs > TTL_MS) return null
+        val entries = stored.entries
+            .filter { it.index >= 0 && it.reason.isNotBlank() }
+            .map { GeminiRankEntry(it.index, it.reason.take(SMART_HIGHLIGHTS_MAX_REASON_LENGTH)) }
+        return entries.distinctBy { it.index }.takeIf { it.isNotEmpty() }
+    }
+
+    fun write(hash: String, ranking: List<GeminiRankEntry>) {
+        if (hash.isBlank() || ranking.isEmpty()) return
+        val payload = runCatching {
+            json.encodeToString(
+                StoredSmartHighlightsRanking.serializer(),
+                StoredSmartHighlightsRanking(
+                    hash = hash,
+                    savedAtMs = nowEpochMs(),
+                    entries = ranking.map { entry ->
+                        StoredSmartHighlightsRankEntry(
+                            index = entry.index,
+                            reason = entry.reason.replace("\n", " "),
+                        )
+                    },
+                ),
+            )
+        }.getOrNull() ?: return
+        SmartHighlightsStorage.saveRankingCache(payload)
+    }
+
+    /** Called when the key is removed so a stale ranking cannot resurface for this profile. */
+    fun clear() {
+        SmartHighlightsStorage.clearRankingCache()
+    }
+}
