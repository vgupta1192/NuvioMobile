+package com.nuvio.app.features.highlights
+
+/**
+ * Nuvio fork: per-profile persistence for the Smart Highlights rail. Values are stored under a
+ * profile-scoped key so switching profiles never leaks one profile's rail settings (or API key)
+ * into another. The API key is only ever handed to the ranking client as a request header; it is
+ * never logged and never displayed back.
+ */
+internal expect object SmartHighlightsStorage {
+    fun loadEnabled(): Boolean?
+    fun saveEnabled(enabled: Boolean)
+    fun loadApiKey(): String?
+    fun saveApiKey(apiKey: String)
+    /** Serialized [SmartHighlightsRankingCachePayload], or null when nothing is cached. */
+    fun loadRankingCache(): String?
+    fun saveRankingCache(payload: String)
+    fun clearRankingCache()
+}
