@@ -0,0 +1,45 @@
+package com.nuvio.app.features.reminders
+
+import androidx.core.app.NotificationManagerCompat
+import androidx.work.CoroutineWorker
+import androidx.work.WorkerParameters
+import kotlin.math.abs
+
+/**
+ * Nuvio fork: fires the local notification for one release reminder when WorkManager runs it at
+ * (or shortly after) the release instant.
+ */
+class ReleaseReminderWorker(
+    appContext: android.content.Context,
+    workerParameters: WorkerParameters,
+) : CoroutineWorker(appContext, workerParameters) {
+
+    override suspend fun doWork(): Result {
+        if (!ReleaseReminderNotificationPlatform.notificationsAuthorized()) {
+            return Result.success()
+        }
+
+        val itemId = inputData.getString(ReleaseReminderNotificationPlatform.workerItemIdKey)
+            ?: return Result.failure()
+        val title = inputData.getString(ReleaseReminderNotificationPlatform.workerTitleKey)
+            ?: return Result.failure()
+        val releaseDateMs = inputData.getLong(ReleaseReminderNotificationPlatform.workerReleaseDateMsKey, 0L)
+        if (releaseDateMs <= 0L) return Result.failure()
+
+        val reminder = ReleaseReminder(
+            itemId = itemId,
+            title = title,
+            releaseDateMs = releaseDateMs,
+        )
+
+        val notification = ReleaseReminderNotificationPlatform.buildNotification(
+            context = applicationContext,
+            reminder = reminder,
+        )
+
+        NotificationManagerCompat.from(applicationContext)
+            .notify(abs(buildReleaseReminderId(reminder).hashCode()), notification)
+
+        return Result.success()
+    }
+}
