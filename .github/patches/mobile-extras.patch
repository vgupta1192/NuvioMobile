+import com.nuvio.app.features.home.components.PosterGridRow
+import nuvio.composeapp.generated.resources.Res
+import nuvio.composeapp.generated.resources.home_genres_item_count
+import nuvio.composeapp.generated.resources.home_genres_title
+import org.jetbrains.compose.resources.stringResource
+
+/**
+ * Nuvio fork: the genres browse screen. With no [initialGenre] it lists every locally derived
+ * genre; with one it shows the grid of that genre's titles, reusing the existing poster grid UI.
+ * The genre level is internal state (system back returns to the list first), so home chips can
+ * deep-link straight into a genre without extra routes. No server calls: everything comes from
+ * the already-fetched home catalog, library and progress metadata.
+ */
+@Composable
+internal fun GenresScreen(
+    initialGenre: String?,
+    onBack: () -> Unit,
+    onPosterClick: ((MetaPreview) -> Unit)? = null,
+    onPosterLongClick: ((MetaPreview) -> Unit)? = null,
+    modifier: Modifier = Modifier,
+) {
+    var selectedGenre by rememberSaveable { mutableStateOf(initialGenre) }
+    // Only the internally opened genre level is popped by system back; a route opened directly on
+    // a genre leaves via navigation.
+    PlatformBackHandler(enabled = initialGenre == null && selectedGenre != null) {
+        selectedGenre = null
+    }
+
+    val itemsByGenre = GenreIndex.itemsByGenre.value
+    val genres = remember(itemsByGenre) {
+        itemsByGenre.entries
+            .map { (name, items) -> GenreEntry(name, items.size, null) }
+            .sortedWith(compareByDescending<GenreEntry> { it.count }.thenBy { it.name.lowercase() })
+    }
+
+    BoxWithConstraints(modifier = modifier.fillMaxSize()) {
+        val columns = posterGridColumnCountForWidth(maxWidth)
+        val gridRows = remember(itemsByGenre, selectedGenre, columns) {
+            selectedGenre?.let { genre -> itemsByGenre[genre].orEmpty().chunked(columns) }
+        }
+
+        NuvioScreen(
+            modifier = Modifier.fillMaxSize(),
+            listState = rememberLazyListState(),
+        ) {
+            stickyHeader {
+                NuvioScreenHeader(
+                    title = selectedGenre ?: stringResource(Res.string.home_genres_title),
+                    onBack = onBack,
+                )
+            }
+            val genre = selectedGenre
+            if (genre == null) {
+                if (genres.isEmpty()) {
+                    item(key = "genres_empty") {
+                        GenresEmptyLabel(modifier = Modifier)
+                    }
+                } else {
+                    items(
+                        count = genres.size,
+                        key = { index -> "genre_entry_${genres[index].name}" },
+                        contentType = { "genre_entry" },
+                    ) { index ->
+                        val entry = genres[index]
+                        Row(
+                            modifier = Modifier
+                                .fillMaxWidth()
+                                .clickable { selectedGenre = entry.name }
+                                .padding(horizontal = 16.dp, vertical = 14.dp),
+                            horizontalArrangement = androidx.compose.foundation.layout.Arrangement.SpaceBetween,
+                            verticalAlignment = Alignment.CenterVertically,
+                        ) {
+                            Text(
+                                text = entry.name,
+                                style = MaterialTheme.typography.bodyLarge,
+                                fontWeight = FontWeight.Medium,
+                                color = MaterialTheme.colorScheme.onSurface,
+                                maxLines = 1,
+                                overflow = TextOverflow.Ellipsis,
+                                modifier = Modifier.weight(1f),
+                            )
+                            Text(
+                                text = stringResource(Res.string.home_genres_item_count, entry.count),
+                                style = MaterialTheme.typography.bodySmall,
+                                color = MaterialTheme.colorScheme.onSurfaceVariant,
+                            )
+                        }
+                    }
+                }
+            } else {
+                val rows = gridRows.orEmpty()
+                if (rows.isEmpty()) {
+                    item(key = "genre_items_empty") {
+                        GenresEmptyLabel(modifier = Modifier)
+                    }
+                } else {
+                    items(
+                        count = rows.size,
+                        key = { index -> "genre_${genre}_row_$index" },
+                        contentType = { "genre_grid_row" },
+                    ) { index ->
+                        PosterGridRow(
+                            items = rows[index],
+                            columns = columns,
+                            modifier = Modifier.padding(horizontal = 16.dp, vertical = 6.dp),
+                            onPosterClick = onPosterClick,
+                            onPosterLongClick = onPosterLongClick,
+                        )
+                    }
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun GenresEmptyLabel(modifier: Modifier = Modifier) {
+    Text(
+        text = stringResource(Res.string.home_genres_empty),
+        style = MaterialTheme.typography.bodyMedium,
+        color = MaterialTheme.colorScheme.onSurfaceVariant,
+        textAlign = TextAlign.Center,
+        modifier = modifier
+            .fillMaxWidth()
+            .padding(horizontal = 16.dp, vertical = 48.dp),
+    )
+}
