+package com.nuvio.app.features.highlights
+
+import com.nuvio.app.core.storage.ProfileScopedKey
+import platform.Foundation.NSUserDefaults
+
+internal actual object SmartHighlightsStorage {
+    private const val enabledKey = "smart_highlights_enabled"
+    private const val apiKeyKey = "gemini_api_key"
+    private const val rankingCacheKey = "gemini_ranking_cache"
+
+    actual fun loadEnabled(): Boolean? =
+        NSUserDefaults.standardUserDefaults.objectForKey(ProfileScopedKey.of(enabledKey))?.let {
+            NSUserDefaults.standardUserDefaults.boolForKey(ProfileScopedKey.of(enabledKey))
+        }
+
+    actual fun saveEnabled(enabled: Boolean) {
+        NSUserDefaults.standardUserDefaults.setBool(enabled, forKey = ProfileScopedKey.of(enabledKey))
+    }
+
+    actual fun loadApiKey(): String? =
+        NSUserDefaults.standardUserDefaults.stringForKey(ProfileScopedKey.of(apiKeyKey))
+            ?.trim()
+            ?.takeIf { it.isNotEmpty() }
+
+    actual fun saveApiKey(apiKey: String) {
+        val defaults = NSUserDefaults.standardUserDefaults
+        val key = ProfileScopedKey.of(apiKeyKey)
+        val normalized = apiKey.trim()
+        if (normalized.isEmpty()) {
+            defaults.removeObjectForKey(key)
+        } else {
+            defaults.setObject(normalized, forKey = key)
+        }
+    }
+
+    actual fun loadRankingCache(): String? =
+        NSUserDefaults.standardUserDefaults.stringForKey(ProfileScopedKey.of(rankingCacheKey))
+
+    actual fun saveRankingCache(payload: String) {
+        NSUserDefaults.standardUserDefaults.setObject(payload, forKey = ProfileScopedKey.of(rankingCacheKey))
+    }
+
+    actual fun clearRankingCache() {
+        NSUserDefaults.standardUserDefaults.removeObjectForKey(ProfileScopedKey.of(rankingCacheKey))
+    }
+}
