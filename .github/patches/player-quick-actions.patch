+import androidx.compose.material3.MaterialTheme
+import androidx.compose.material3.Text
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.unit.dp
+import nuvio.composeapp.generated.resources.Res
+import nuvio.composeapp.generated.resources.player_video_quality
+import nuvio.composeapp.generated.resources.player_video_quality_auto
+import org.jetbrains.compose.resources.stringResource
+
+/** Fork: pick an HLS/DASH video variant (or Auto) from the player's quality button. */
+@Composable
+internal fun VideoQualityModal(
+    visible: Boolean,
+    videoController: PlayerEngineController?,
+    onDismiss: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    var qualities by remember(visible) {
+        mutableStateOf(if (visible) videoController?.getVideoQualities().orEmpty() else emptyList())
+    }
+    PlayerOverlayScaffold(
+        visible = visible,
+        onDismiss = onDismiss,
+        modifier = modifier,
+        contentPadding = PaddingValues(start = 44.dp, end = 44.dp, top = 28.dp, bottom = 64.dp),
+    ) {
+        BoxWithConstraints(modifier = Modifier.fillMaxSize()) {
+            val railWidth = minOf(maxWidth, 444.dp)
+            val railMaxHeight = (maxHeight - 64.dp).coerceAtLeast(120.dp).coerceAtMost(620.dp)
+            Column(
+                modifier = Modifier
+                    .width(railWidth)
+                    .fillMaxHeight()
+                    .align(Alignment.BottomStart),
+                verticalArrangement = Arrangement.Bottom,
+            ) {
+                Text(
+                    text = stringResource(Res.string.player_video_quality),
+                    color = Color.White,
+                    style = MaterialTheme.typography.headlineMedium,
+                    modifier = Modifier.padding(bottom = 8.dp),
+                )
+                val pinned = qualities.any { it.isSelected }
+                LazyColumn(
+                    modifier = Modifier.fillMaxWidth().heightIn(max = railMaxHeight),
+                    verticalArrangement = Arrangement.spacedBy(6.dp),
+                    contentPadding = PaddingValues(vertical = 8.dp),
+                ) {
+                    item(key = "auto") {
+                        QualityRow(
+                            label = stringResource(Res.string.player_video_quality_auto),
+                            isSelected = !pinned,
+                            onClick = {
+                                videoController?.selectVideoQuality(null)
+                                qualities = qualities.map { it.copy(isSelected = false) }
+                                onDismiss()
+                            },
+                        )
+                    }
+                    items(count = qualities.size) { index ->
+                        val option = qualities[index]
+                        QualityRow(
+                            label = option.label,
+                            isSelected = option.isSelected,
+                            onClick = {
+                                videoController?.selectVideoQuality(option.heightPx)
+                                qualities = qualities.map { it.copy(isSelected = it.heightPx == option.heightPx) }
+                                onDismiss()
+                            },
+                        )
+                    }
+                }
+            }
+        }
+    }
+}
