+package com.nuvio.app.features.livetv
+
+import com.nuvio.app.features.addons.httpGetText
+import com.nuvio.app.features.addons.httpGetTextWithHeaders
+import io.ktor.http.encodeURLParameter
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.builtins.ListSerializer
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonArray
+import kotlinx.serialization.json.JsonElement
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+import kotlinx.serialization.json.contentOrNull
+import kotlinx.serialization.json.jsonObject
+
+/**
+ * Fork feature: custom IPTV sources for Live TV next to the addon channels. A source is an M3U
+ * playlist URL, an Xtream Codes login or a Stalker (MAG) portal. Channels from every enabled
+ * source are merged into the same channel list, categories, favorites and programme guide.
+ */
+@Serializable
+enum class IptvKind { M3U, XTREAM, STALKER }
+
+@Serializable
+data class IptvSource(
+    val id: String,
+    val kind: IptvKind,
+    val name: String,
+    /** M3U playlist URL, Xtream server URL or Stalker portal URL. */
+    val url: String,
+    val username: String = "",
+    val password: String = "",
+    /** Stalker only. */
+    val mac: String = "",
+    /** Optional XMLTV guide URL (Xtream and M3U playlists often carry their own). */
+    val epgUrl: String = "",
+    val isEnabled: Boolean = true,
+) {
+    val isConfigured: Boolean
+        get() = when (kind) {
+            IptvKind.M3U -> url.isNotBlank()
+            IptvKind.XTREAM -> url.isNotBlank() && username.isNotBlank() && password.isNotBlank()
+            IptvKind.STALKER -> url.isNotBlank() && mac.isNotBlank()
+        }
+
+    val kindLabel: String
+        get() = when (kind) {
+            IptvKind.M3U -> "M3U playlist"
+            IptvKind.XTREAM -> "Xtream Codes"
+            IptvKind.STALKER -> "Stalker portal"
+        }
+}
+
+internal object IptvSourceStore {
+    private const val KEY = "iptv_sources"
+    private val json = Json { ignoreUnknownKeys = true; encodeDefaults = true }
+    private val serializer = ListSerializer(IptvSource.serializer())
+
+    fun load(): List<IptvSource> =
+        LiveTvStorage.loadString(KEY)
+            ?.takeIf { it.isNotBlank() }
+            ?.let { runCatching { json.decodeFromString(serializer, it) }.getOrNull() }
+            .orEmpty()
+
+    fun save(sources: List<IptvSource>) {
+        LiveTvStorage.saveString(KEY, json.encodeToString(serializer, sources))
+    }
+}
+
+/** What one source returned: its channels plus the XMLTV guide URLs it knows about. */
+internal data class IptvLoadResult(
+    val channels: List<LiveTvChannel>,
+    val epgUrls: List<String>,
+)
+
+/** A channel stream ready for the player. */
+internal data class IptvResolvedStream(
+    val url: String,
+    val headers: Map<String, String>,
+)
+
+internal object IptvProviders {
+    private val portalJson = Json { ignoreUnknownKeys = true; isLenient = true }
+    private val jsonHeaders = mapOf("Accept" to "application/json, text/plain, */*", "User-Agent" to "Nuvio/1.0")
+    private val streamHeaders = mapOf("User-Agent" to "Mozilla/5.0", "Accept" to "*/*")
+    private val stalkerSessions = mutableMapOf<String, StalkerSession>()
+
+    suspend fun load(source: IptvSource): IptvLoadResult = when (source.kind) {
+        IptvKind.M3U -> loadM3u(source)
+        IptvKind.XTREAM -> loadXtream(source)
+        IptvKind.STALKER -> loadStalker(source)
+    }
+
+    suspend fun resolve(source: IptvSource, channel: LiveTvChannel): IptvResolvedStream? {
+        val direct = channel.directUrl?.takeIf { it.isNotBlank() }
+        if (source.kind == IptvKind.STALKER) {
+            val command = channel.stalkerCommand?.takeIf { it.isNotBlank() }
+            if (command != null) {
+                val session = stalkerSession(source)
+                val result = stalkerRequest(source, session.token, "itv", "create_link", mapOf("cmd" to command)).js()
+                val url = (result.string("cmd") ?: result.string("url") ?: result.string("stream_url"))?.playableUrl()
+                val resolved = url?.takeIf { it.isNotBlank() } ?: direct ?: return null
+                return IptvResolvedStream(resolved, stalkerHeaders(source, session.token))
+            }
+        }
+        return direct?.let { IptvResolvedStream(it, channel.directHeaders) }
+    }
+
+    // ---- M3U ----
+
+    private suspend fun loadM3u(source: IptvSource): IptvLoadResult {
+        val text = httpGetText(source.url.trim())
+        return parseM3u(text, source)
+    }
+
+    internal fun parseM3u(text: String, source: IptvSource): IptvLoadResult {
+        val attrRegex = Regex("""([A-Za-z0-9_-]+)="([^"]*)"""")
+        val epgUrls = mutableListOf<String>()
+        val channels = mutableListOf<LiveTvChannel>()
+        var attrs: Map<String, String> = emptyMap()
+        var name: String? = null
+        var group: String? = null
+        var userAgent: String? = null
+        var referrer: String? = null
+        for (raw in text.lineSequence()) {
+            val line = raw.trim()
+            if (line.isEmpty()) continue
+            when {
+                line.startsWith("#EXTM3U", ignoreCase = true) -> {
+                    val header = attrRegex.findAll(line).associate { it.groupValues[1].lowercase() to it.groupValues[2] }
+                    (header["url-tvg"] ?: header["x-tvg-url"] ?: header["tvg-url"])
+                        ?.split(',', ' ')
+                        ?.map { it.trim() }
+                        ?.filter { it.startsWith("http", ignoreCase = true) }
+                        ?.let(epgUrls::addAll)
+                }
+                line.startsWith("#EXTINF", ignoreCase = true) -> {
+                    attrs = attrRegex.findAll(line).associate { it.groupValues[1].lowercase() to it.groupValues[2] }
+                    val tail = line.substringAfterLast('"', line)
+                    name = tail.substringAfter(',', "").trim().ifBlank { attrs["tvg-name"] }
+                    group = attrs["group-title"]?.trim()?.takeIf { it.isNotEmpty() }
+                }
+                line.startsWith("#EXTGRP:", ignoreCase = true) -> {
+                    if (group == null) group = line.substringAfter(':').trim().takeIf { it.isNotEmpty() }
+                }
+                line.startsWith("#EXTVLCOPT:", ignoreCase = true) -> {
+                    val option = line.substringAfter(':')
+                    when (option.substringBefore('=').lowercase()) {
+                        "http-user-agent" -> userAgent = option.substringAfter('=').trim()
+                        "http-referrer", "http-referer" -> referrer = option.substringAfter('=').trim()
+                    }
+                }
+                line.startsWith("#") -> Unit
+                else -> {
+                    val channelName = name
+                    if (channelName != null && channelName.isNotBlank()) {
+                        val headers = buildMap {
+                            userAgent?.takeIf { it.isNotBlank() }?.let { put("User-Agent", it) }
+                            referrer?.takeIf { it.isNotBlank() }?.let { put("Referer", it) }
+                        }
+                        val logo = attrs["tvg-logo"]?.takeIf { it.isNotBlank() }
+                        channels += iptvChannel(
+                            source = source,
+                            key = line,
+                            name = channelName,
+                            logo = logo,
+                            group = group,
+                            directUrl = line,
+                            headers = headers,
+                            epgId = attrs["tvg-id"]?.takeIf { it.isNotBlank() },
+                        )
+                    }
+                    attrs = emptyMap(); name = null; group = null; userAgent = null; referrer = null
+                }
+            }
+        }
+        return IptvLoadResult(channels.distinctBy { it.id }, epgUrls)
+    }
+
+    // ---- Xtream Codes ----
+
+    private suspend fun loadXtream(source: IptvSource): IptvLoadResult {
+        val server = source.url.trim().trimEnd('/').substringBefore("/player_api.php").trimEnd('/')
+        val user = source.username.trim()
+        val pass = source.password.trim()
+        suspend fun call(action: String): JsonElement {
+            val url = "$server/player_api.php?username=${user.encodeURLParameter()}&password=${pass.encodeURLParameter()}&action=${action.encodeURLParameter()}"
+            return portalJson.parseToJsonElement(httpGetTextWithHeaders(url, jsonHeaders))
+        }
+        val categories = call("get_live_categories").arrayOrEmpty().mapNotNull { element ->
+            val item = element as? JsonObject ?: return@mapNotNull null
+            val id = item.string("category_id") ?: item.string("id") ?: return@mapNotNull null
+            id to (item.string("category_name") ?: item.string("name") ?: id)
+        }.toMap()
+        val channels = call("get_live_streams").arrayOrEmpty().mapNotNull { element ->
+            val item = element as? JsonObject ?: return@mapNotNull null
+            val name = item.string("name") ?: return@mapNotNull null
+            val streamId = item.string("stream_id") ?: item.string("id") ?: return@mapNotNull null
+            val extension = item.string("container_extension")?.trim()?.trimStart('.')?.ifBlank { null } ?: "ts"
+            val direct = item.string("direct_source")?.takeIf { it.startsWith("http://") || it.startsWith("https://") }
+            val url = direct ?: "$server/live/${user.encodeURLParameter()}/${pass.encodeURLParameter()}/${streamId.encodeURLParameter()}.${extension.encodeURLParameter()}"
+            iptvChannel(
+                source = source,
+                key = "x$streamId",
+                name = name,
+                logo = item.string("stream_icon") ?: item.string("logo"),
+                group = item.string("category_id")?.let(categories::get),
+                directUrl = url,
+                headers = streamHeaders,
+                epgId = item.string("epg_channel_id"),
+            )
+        }.distinctBy { it.id }
+        val epg = source.epgUrl.trim().ifBlank {
+            "$server/xmltv.php?username=${user.encodeURLParameter()}&password=${pass.encodeURLParameter()}"
+        }
+        return IptvLoadResult(channels, listOf(epg))
+    }
+
+    // ---- Stalker (MAG) portal ----
+
+    private data class StalkerSession(val token: String)
+
+    private suspend fun loadStalker(source: IptvSource): IptvLoadResult {
+        stalkerSessions.remove(source.id)
+        val session = stalkerSession(source)
+        val genres = stalkerRequest(source, session.token, "itv", "get_genres").js().array("data").mapNotNull { element ->
+            val item = element as? JsonObject ?: return@mapNotNull null
+            val id = item.string("id") ?: item.string("alias") ?: return@mapNotNull null
+            id to (item.string("title") ?: item.string("name") ?: id)
+        }.toMap()
+        val channels = mutableListOf<LiveTvChannel>()
+        for (page in 1..60) {
+            val data = stalkerRequest(source, session.token, "itv", "get_ordered_list", mapOf("p" to page.toString()))
+                .js().array("data")
+            if (data.isEmpty()) break
+            data.forEachIndexed { index, element ->
+                val item = element as? JsonObject ?: return@forEachIndexed
+                val command = item.string("cmd") ?: item.string("mc_cmd") ?: item.string("url") ?: return@forEachIndexed
+                val name = item.string("name") ?: item.string("title") ?: return@forEachIndexed
+                val url = command.playableUrl()
+                channels += iptvChannel(
+                    source = source,
+                    key = "s${item.string("id") ?: "$page:$index"}",
+                    name = name,
+                    logo = item.string("logo") ?: item.string("logo_url"),
+                    group = (item.string("tv_genre_id") ?: item.string("genre_id"))?.let(genres::get),
+                    directUrl = url.takeIf { it.startsWith("http") },
+                    headers = stalkerHeaders(source, session.token),
+                    epgId = item.string("xmltv_id"),
+                    stalkerCommand = command,
+                )
+            }
+        }
+        return IptvLoadResult(channels.distinctBy { it.id }, listOfNotNull(source.epgUrl.trim().takeIf { it.isNotBlank() }))
+    }
+
+    private suspend fun stalkerSession(source: IptvSource): StalkerSession {
+        stalkerSessions[source.id]?.let { return it }
+        val token = stalkerRequest(source, null, "stb", "handshake").js().string("token").orEmpty()
+        require(token.isNotBlank()) { "Stalker portal did not return an authorization token" }
+        return StalkerSession(token).also { stalkerSessions[source.id] = it }
+    }
+
+    private suspend fun stalkerRequest(
+        source: IptvSource,
+        token: String?,
+        type: String,
+        action: String,
+        extra: Map<String, String> = emptyMap(),
+    ): JsonObject {
+        val parameters = buildMap {
+            put("type", type); put("action", action); put("JsHttpRequest", "1-xml")
+            if (!token.isNullOrBlank()) put("token", token)
+            if (source.username.isNotBlank()) put("login", source.username.trim())
+            if (source.password.isNotBlank()) put("password", source.password.trim())
+            putAll(extra)
+        }
+        val endpoint = stalkerEndpoint(source)
+        val query = parameters.entries.joinToString("&", prefix = if ('?' in endpoint) "&" else "?") { (key, value) ->
+            "${key.encodeURLParameter()}=${value.encodeURLParameter()}"
+        }
+        return portalJson.parseToJsonElement(httpGetTextWithHeaders(endpoint + query, stalkerHeaders(source, token))).jsonObject
+    }
+
+    private fun stalkerEndpoint(source: IptvSource): String {
+        val url = source.url.trim().trimEnd('/')
+        return when {
+            url.contains("portal.php", ignoreCase = true) -> url
+            url.contains("server/load.php", ignoreCase = true) -> url
+            url.endsWith("/c", ignoreCase = true) -> url.dropLast(2) + "/portal.php"
+            else -> "$url/portal.php"
+        }
+    }
+
+    private fun stalkerHeaders(source: IptvSource, token: String?): Map<String, String> = buildMap {
+        val base = source.url.trim().substringBefore("/portal.php").substringBefore("/server/load.php").trimEnd('/').removeSuffix("/c")
+        put("User-Agent", "Mozilla/5.0 (QtEmbedded; U; Linux; MAG254; en) AppleWebKit/533.3 MAG200 stbapp ver: 4 rev: 2721 Mobile Safari/533.3")
+        put("X-User-Agent", "Model: MAG254; Link: Ethernet")
+        put("Referer", "$base/c/")
+        put("Cookie", "mac=${source.mac.trim().uppercase()}; stb_lang=en; timezone=Europe%2FIstanbul")
+        if (!token.isNullOrBlank()) put("Authorization", "Bearer $token")
+    }
+
+    // ---- helpers ----
+
+    private fun iptvChannel(
+        source: IptvSource,
+        key: String,
+        name: String,
+        logo: String?,
+        group: String?,
+        directUrl: String?,
+        headers: Map<String, String>,
+        epgId: String?,
+        stalkerCommand: String? = null,
+    ): LiveTvChannel {
+        val category = group?.trim()?.takeIf { it.isNotEmpty() } ?: source.name
+        return LiveTvChannel(
+            id = "${source.id}:${key.hashCode()}",
+            type = "tv",
+            name = name.trim(),
+            poster = logo,
+            logo = logo,
+            genres = listOf(category),
+            addonName = source.name,
+            manifestUrl = "iptv:${source.id}",
+            catalogId = source.id,
+            catalogName = category,
+            directUrl = directUrl,
+            directHeaders = headers,
+            stalkerCommand = stalkerCommand,
+            epgId = epgId,
+            iptvSourceId = source.id,
+        )
+    }
+
+    private fun String.playableUrl() = trim().removePrefix("ffmpeg ").removePrefix("auto ").substringBefore(' ').trim()
+    private fun JsonObject.js() = (this["js"] as? JsonObject) ?: this
+    private fun JsonObject.string(key: String) = (this[key] as? JsonPrimitive)?.contentOrNull?.trim()?.takeIf { it.isNotBlank() }
+    private fun JsonObject.array(key: String) = (this[key] as? JsonArray)?.toList().orEmpty()
+    private fun JsonElement.arrayOrEmpty() = (this as? JsonArray)?.toList() ?: (this as? JsonObject)?.array("data").orEmpty()
+}
