+
+/** Sidebar block of the Live TV screen: the user's IPTV sources and the "add source" entry. */
+internal fun LazyListScope.iptvSidebarItems(state: LiveTvUiState) {
+    item(key = "iptv:label") {
+        Text(
+            text = "IPTV sources",
+            style = MaterialTheme.typography.labelMedium,
+            color = MaterialTheme.nuvio.colors.textMuted,
+            fontWeight = FontWeight.SemiBold,
+            modifier = Modifier.padding(start = 16.dp, end = 16.dp, top = 12.dp, bottom = 4.dp),
+        )
+    }
+    items(state.iptvSources, key = { "iptv:${it.id}" }) { source ->
+        IptvSourceRow(source = source, error = state.iptvErrors[source.id])
+    }
+    item(key = "iptv:add") {
+        var showDialog by remember { mutableStateOf(false) }
+        Text(
+            text = "+ Add M3U / Xtream / Stalker source",
+            style = MaterialTheme.typography.bodyMedium,
+            color = MaterialTheme.colorScheme.primary,
+            fontWeight = FontWeight.SemiBold,
+            modifier = Modifier
+                .fillMaxWidth()
+                .clickable { showDialog = true }
+                .padding(horizontal = 16.dp, vertical = 10.dp),
+        )
+        if (showDialog) {
+            IptvSourceDialog(
+                onDismiss = { showDialog = false },
+                onAdd = { source ->
+                    LiveTvRepository.addIptvSource(source)
+                    showDialog = false
+                },
+            )
+        }
+    }
+}
+
+@Composable
+private fun IptvSourceRow(source: IptvSource, error: String?) {
+    val tokens = MaterialTheme.nuvio
+    Row(
+        modifier = Modifier
+            .fillMaxWidth()
+            .clickable { LiveTvRepository.toggleIptvSource(source.id) }
+            .padding(horizontal = 8.dp),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        Checkbox(checked = source.isEnabled, onCheckedChange = { LiveTvRepository.toggleIptvSource(source.id) })
+        Column(modifier = Modifier.weight(1f)) {
+            Text(
+                text = source.name,
+                style = MaterialTheme.typography.bodyMedium,
+                color = tokens.colors.textPrimary,
+                maxLines = 1,
+                overflow = TextOverflow.Ellipsis,
+            )
+            Text(
+                text = error ?: source.kindLabel,
+                style = MaterialTheme.typography.bodySmall,
+                color = if (error != null) MaterialTheme.colorScheme.error else tokens.colors.textMuted,
+                maxLines = 2,
+                overflow = TextOverflow.Ellipsis,
+            )
+        }
+        IconButton(onClick = { LiveTvRepository.removeIptvSource(source.id) }) {
+            Icon(
+                imageVector = Icons.Rounded.Close,
+                contentDescription = "Remove source",
+                tint = tokens.colors.textMuted,
+                modifier = Modifier.size(18.dp),
+            )
+        }
+    }
+}
+
+@Composable
+private fun IptvSourceDialog(onDismiss: () -> Unit, onAdd: (IptvSource) -> Unit) {
+    var kind by remember { mutableStateOf(IptvKind.M3U) }
+    var name by remember { mutableStateOf("") }
+    var url by remember { mutableStateOf("") }
+    var username by remember { mutableStateOf("") }
+    var password by remember { mutableStateOf("") }
+    var mac by remember { mutableStateOf("00:1A:79:") }
+    var epgUrl by remember { mutableStateOf("") }
+
+    val draft = IptvSource(
+        id = "src" + kotlin.time.Clock.System.now().toEpochMilliseconds(),
+        kind = kind,
+        name = name.trim().ifBlank {
+            when (kind) {
+                IptvKind.M3U -> "M3U playlist"
+                IptvKind.XTREAM -> "Xtream"
+                IptvKind.STALKER -> "Stalker"
+            }
+        },
+        url = url.trim(),
+        username = username.trim(),
+        password = password.trim(),
+        mac = mac.trim(),
+        epgUrl = epgUrl.trim(),
+    )
+
+    AlertDialog(
+        onDismissRequest = onDismiss,
+        title = { Text("Add IPTV source") },
+        text = {
+            Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+                Row(horizontalArrangement = Arrangement.spacedBy(4.dp)) {
+                    IptvKind.entries.forEach { option ->
+                        TextButton(onClick = { kind = option }) {
+                            Text(
+                                text = when (option) {
+                                    IptvKind.M3U -> "M3U"
+                                    IptvKind.XTREAM -> "Xtream"
+                                    IptvKind.STALKER -> "Stalker"
+                                },
+                                fontWeight = if (option == kind) FontWeight.Bold else FontWeight.Normal,
+                                color = if (option == kind) MaterialTheme.colorScheme.primary else MaterialTheme.nuvio.colors.textMuted,
+                            )
+                        }
+                    }
+                }
+                NuvioInputField(value = name, onValueChange = { name = it }, placeholder = "Name (optional)")
+                NuvioInputField(
+                    value = url,
+                    onValueChange = { url = it },
+                    placeholder = when (kind) {
+                        IptvKind.M3U -> "Playlist URL (.m3u / .m3u8)"
+                        IptvKind.XTREAM -> "Server URL, e.g. http://host:8080"
+                        IptvKind.STALKER -> "Portal URL, e.g. http://host/c/"
+                    },
+                )
+                if (kind == IptvKind.XTREAM || kind == IptvKind.STALKER) {
+                    NuvioInputField(
+                        value = username,
+                        onValueChange = { username = it },
+                        placeholder = if (kind == IptvKind.XTREAM) "Username" else "Login (optional)",
+                    )
+                    NuvioInputField(
+                        value = password,
+                        onValueChange = { password = it },
+                        placeholder = if (kind == IptvKind.XTREAM) "Password" else "Password (optional)",
+                    )
+                }
+                if (kind == IptvKind.STALKER) {
+                    NuvioInputField(value = mac, onValueChange = { mac = it }, placeholder = "MAC address")
+                }
+                if (kind != IptvKind.STALKER) {
