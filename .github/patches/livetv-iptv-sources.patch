+                Spacer(Modifier.height(2.dp))
+            }
+        },
+        confirmButton = {
+            TextButton(enabled = draft.isConfigured, onClick = { onAdd(draft) }) { Text("Add") }
+        },
+        dismissButton = {
+            TextButton(onClick = onDismiss) { Text("Cancel") }
+        },
+    )
+}
