+package com.nuvio.app.features.settings
+
+import androidx.compose.foundation.layout.Spacer
+import androidx.compose.foundation.layout.height
+import androidx.compose.foundation.layout.padding
+import androidx.compose.foundation.lazy.LazyListScope
+import androidx.compose.material.icons.Icons
+import androidx.compose.material.icons.rounded.Add
+import androidx.compose.material.icons.rounded.Close
+import androidx.compose.material.icons.rounded.Refresh
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.material3.Text
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.unit.dp
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import com.nuvio.app.core.ui.NuvioTokens
+import com.nuvio.app.core.ui.nuvio
+import com.nuvio.app.features.livetv.IptvSourceDialog
+import com.nuvio.app.features.livetv.LiveTvRepository
+
+/** Settings, Live TV: add, switch on or off, remove and reload M3U / Xtream / Stalker sources. */
+internal fun LazyListScope.liveTvSettingsContent(isTablet: Boolean) {
+    item {
+        val uiState by remember {
+            LiveTvRepository.initialize()
+            LiveTvRepository.uiState
+        }.collectAsStateWithLifecycle()
+        var showDialog by remember { mutableStateOf(false) }
+
+        SettingsSection(
+            title = "IPTV sources",
+            isTablet = isTablet,
+        ) {
+            SettingsGroup(isTablet = isTablet) {
+                if (uiState.iptvSources.isEmpty()) {
+                    Text(
+                        text = "No IPTV sources yet. Add an M3U playlist, an Xtream Codes login or a Stalker portal.",
+                        style = MaterialTheme.typography.bodyMedium,
+                        color = MaterialTheme.nuvio.colors.textMuted,
+                        modifier = Modifier.padding(horizontal = 16.dp, vertical = 14.dp),
+                    )
+                }
+                uiState.iptvSources.forEachIndexed { index, source ->
+                    if (index > 0) SettingsGroupDivider(isTablet = isTablet)
+                    SettingsSwitchRow(
+                        title = source.name,
+                        description = uiState.iptvErrors[source.id] ?: source.kindLabel,
+                        checked = source.isEnabled,
+                        isTablet = isTablet,
+                        onCheckedChange = { LiveTvRepository.toggleIptvSource(source.id) },
+                    )
+                    SettingsGroupDivider(isTablet = isTablet)
+                    SettingsNavigationRow(
+                        title = "Remove ${source.name}",
+                        description = null,
+                        icon = Icons.Rounded.Close,
+                        isTablet = isTablet,
+                        onClick = { LiveTvRepository.removeIptvSource(source.id) },
+                    )
+                }
+            }
+        }
+
+        Spacer(modifier = Modifier.height(NuvioTokens.Space.s16))
+        SettingsSection(
+            title = "Manage",
+            isTablet = isTablet,
+        ) {
+            SettingsGroup(isTablet = isTablet) {
+                SettingsNavigationRow(
+                    title = "Add IPTV source",
+                    description = "M3U playlist link, Xtream Codes login or Stalker portal",
+                    icon = Icons.Rounded.Add,
+                    isTablet = isTablet,
+                    onClick = { showDialog = true },
+                )
+                if (uiState.iptvSources.isNotEmpty()) {
+                    SettingsGroupDivider(isTablet = isTablet)
+                    SettingsNavigationRow(
+                        title = "Reload IPTV sources",
+                        description = if (uiState.isLoadingIptv) "Loading channels..." else "Fetch the playlists and guides again",
+                        icon = Icons.Rounded.Refresh,
+                        enabled = !uiState.isLoadingIptv,
+                        isTablet = isTablet,
+                        onClick = { LiveTvRepository.refresh() },
+                    )
+                }
+            }
+        }
+
+        if (showDialog) {
+            IptvSourceDialog(
+                onDismiss = { showDialog = false },
+                onAdd = { source ->
+                    LiveTvRepository.addIptvSource(source)
+                    showDialog = false
+                },
+            )
+        }
+    }
+}
