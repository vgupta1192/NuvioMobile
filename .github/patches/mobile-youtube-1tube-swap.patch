-                if (items.isEmpty()) failed = true
-            } else {
-                items = (items + result.items).distinctBy { it.key }
-                token = result.continuation
-                FeedCache.put(key, items, token, listStateRef?.firstVisibleItemIndex ?: 0, listStateRef?.firstVisibleItemScrollOffset ?: 0)
-            }
-            loading = false
-        }
-    }
-
-    LaunchedEffect(key) { if (cached == null) startFetch(null) }
-    val listState = rememberLazyListState(cached?.index ?: 0, cached?.offset ?: 0)
-    listStateRef = listState
-    val itemsNow by rememberUpdatedState(items)
-    val tokenNow by rememberUpdatedState(token)
-    DisposableEffect(key) {
-        onDispose { if (itemsNow.isNotEmpty()) FeedCache.put(key, itemsNow, tokenNow, listState.firstVisibleItemIndex, listState.firstVisibleItemScrollOffset) }
-    }
-    val nearEnd by remember {
-        derivedStateOf {
-            val info = listState.layoutInfo
-            val last = info.visibleItemsInfo.lastOrNull()?.index ?: 0
