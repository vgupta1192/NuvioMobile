+    private fun translateAll(texts: List<String>, language: String): List<String>? {
+        val unique = texts.filter { it.isNotBlank() }.distinct()
+        val chunks = ArrayList<List<String>>()
+        var start = 0
+        while (start < unique.size) {
+            var end = start
+            var chars = 0
