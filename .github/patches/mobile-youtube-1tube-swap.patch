-    val visible = items.filter(keep)
-    val feedShorts = visible.filter { it.isShort && it.kind == YtKind.VIDEO }
-    // The home feed often carries no Shorts of its own; then the account's Shorts feed fills the panel.
-    val accountShorts by YouTubeRepository.shorts.collectAsState()
-    LaunchedEffect(shortsFallback) {
-        if (shortsFallback && YouTubeRepository.shorts.value.isEmpty()) YouTubeRepository.loadShorts()
-    }
-    val shorts = if (feedShorts.isEmpty() && shortsFallback) accountShorts.filter(keep) else feedShorts
-    val rest = visible.filterNot { it.isShort && it.kind == YtKind.VIDEO }
-    TrackInlinePreview(listState, rest)
-    LaunchedEffect(rest.firstOrNull()?.id) { YouTubePrewarm.warmFirst(rest) }
