+import org.jetbrains.compose.resources.stringResource
+
+/**
+ * Fork page: every setting this fork adds on top of upstream Nuvio lives under Features,
+ * grouped into Player, Home and library, and Tools sub-pages.
+ */
+internal fun LazyListScope.featuresSettingsContent(
+    isTablet: Boolean,
+    onPlayerClick: () -> Unit,
+    onHomeClick: () -> Unit,
+    onToolsClick: () -> Unit,
+    onPerformanceClick: () -> Unit,
+    onDebugLogsClick: () -> Unit,
+) {
+    item {
+        SettingsSection(title = "Fork features", isTablet = isTablet) {
+            SettingsGroup(isTablet = isTablet) {
+                SettingsNavigationRow(
+                    title = "Player",
+                    description = "Seek previews, volume boost, picture and sound, second subtitle, stream stats, subtitle font.",
+                    icon = Icons.Rounded.PlayArrow,
+                    isTablet = isTablet,
+                    onClick = onPlayerClick,
+                )
+                SettingsGroupDivider(isTablet = isTablet)
+                SettingsNavigationRow(
+                    title = "Home and library",
+                    description = "Hero, home rows, Netflix style, watched titles, look and feel, streams.",
+                    icon = Icons.Rounded.Home,
+                    isTablet = isTablet,
+                    onClick = onHomeClick,
+                )
+                SettingsGroupDivider(isTablet = isTablet)
+                SettingsNavigationRow(
+                    title = "Tools and data",
+                    description = "Backup and restore, DNS over HTTPS, app sounds, cache and updates.",
+                    icon = Icons.Rounded.Build,
+                    isTablet = isTablet,
+                    onClick = onToolsClick,
+                )
+                SettingsGroupDivider(isTablet = isTablet)
+                SettingsNavigationRow(
+                    title = "Performance",
+                    description = "Memory, image cache and playback tuning.",
+                    icon = Icons.Rounded.Speed,
+                    isTablet = isTablet,
+                    onClick = onPerformanceClick,
+                )
+                SettingsGroupDivider(isTablet = isTablet)
+                SettingsNavigationRow(
+                    title = "Debug logs",
+                    description = "Share logs for support.",
+                    icon = Icons.Rounded.BugReport,
+                    isTablet = isTablet,
+                    onClick = onDebugLogsClick,
+                )
+            }
+        }
+    }
+}
+
+internal fun LazyListScope.featuresPlayerSettingsContent(isTablet: Boolean) {
+    item { SeekPreviewSettingsSection(isTablet = isTablet) }
+    item { VolumeBoostSettingsSection(isTablet = isTablet) }
+    item { PictureSoundSettingsSection(isTablet = isTablet) }
+    item { DxSoundSettingsSection(isTablet = isTablet) }
+    item { DxEnhanceSettingsSection(isTablet = isTablet) }
+    item { DxRememberSettingsSection(isTablet = isTablet) }
+    item { DxSecondSubtitleSettingsSection(isTablet = isTablet) }
+    item { DxStatsSettingsSection(isTablet = isTablet) }
+    item { ForkPlayerPrefsSettingsSection(isTablet = isTablet) }
+    item { ConnectionFitSettingsSection(isTablet = isTablet) }
+    item { SubtitleFontSettingsSection(isTablet = isTablet) }
+}
+
+internal fun LazyListScope.featuresHomeSettingsContent(isTablet: Boolean) {
+    item {
+        SettingsSection(title = "Hero", isTablet = isTablet) {
+            SettingsGroup(isTablet = isTablet) {
+                HeroRotationSpeedRow(isTablet = isTablet)
+                HeroTrailerOptionRows(isTablet = isTablet)
+            }
+        }
+    }
+    item { ForkHomeRowsSettingsSection(isTablet = isTablet) }
+    item { NetflixStyleSection(isTablet = isTablet) }
+    item { DxWatchedTitlesSettingsSection(isTablet = isTablet) }
+    item { ForkLookSettingsSection(isTablet = isTablet) }
+}
+
+internal fun LazyListScope.featuresToolsSettingsContent(isTablet: Boolean) {
+    item { SettingsConfigBackupSection(isTablet = isTablet) }
+    item {
+        SettingsSection(title = "Network", isTablet = isTablet) {
+            SettingsGroup(isTablet = isTablet) {
+                DohSettingsRow(isTablet = isTablet)
+            }
+        }
+    }
+    item { DxSoundsSettingsSection(isTablet = isTablet) }
+    item { ForkAboutSettingsSection(isTablet = isTablet) }
+}
+
+/** Fork look and feel switches that used to sit on the Appearance and Streams pages. */
+@Composable
+private fun ForkLookSettingsSection(isTablet: Boolean) {
+    val dynamicArtworkBackground by com.nuvio.app.core.ui.DynamicArtworkBackgroundSetting.enabled.collectAsStateWithLifecycle()
+    LaunchedEffect(Unit) { com.nuvio.app.core.ui.DynamicArtworkBackgroundSetting.ensureLoaded() }
+    LaunchedEffect(Unit) { com.nuvio.app.core.ui.glass.LiquidGlassSettings.ensureLoaded() }
+    val streamSettings by remember {
+        StreamBadgeSettingsRepository.ensureLoaded()
+        StreamBadgeSettingsRepository.uiState
+    }.collectAsStateWithLifecycle()
+    SettingsSection(title = "Look and streams", isTablet = isTablet) {
+        SettingsGroup(isTablet = isTablet) {
+            SettingsSwitchRow(
+                title = stringResource(Res.string.settings_appearance_glass_effects),
+                description = stringResource(Res.string.settings_appearance_glass_effects_description),
+                checked = com.nuvio.app.core.ui.glass.LiquidGlassSettings.enabled,
+                isTablet = isTablet,
+                onCheckedChange = com.nuvio.app.core.ui.glass.LiquidGlassSettings::set,
+            )
+            SettingsGroupDivider(isTablet = isTablet)
+            SettingsSwitchRow(
+                title = stringResource(Res.string.settings_appearance_dynamic_artwork_background),
+                description = stringResource(Res.string.settings_appearance_dynamic_artwork_background_description),
+                checked = dynamicArtworkBackground,
+                isTablet = isTablet,
+                onCheckedChange = com.nuvio.app.core.ui.DynamicArtworkBackgroundSetting::set,
+            )
+            SettingsGroupDivider(isTablet = isTablet)
+            SettingsSwitchRow(
+                title = stringResource(Res.string.settings_stream_search_title),
+                description = stringResource(Res.string.settings_stream_search_description),
+                checked = streamSettings.showStreamSearch,
+                isTablet = isTablet,
+                onCheckedChange = StreamBadgeSettingsRepository::setShowStreamSearch,
+            )
+        }
+    }
+}
