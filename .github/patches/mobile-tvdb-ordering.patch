@@ -0,0 +1,31 @@
+package com.nuvio.app.features.tvdb
+
+import com.nuvio.app.features.profiles.ProfileRepository
+
+/**
+ * Per-profile TVDB v4 API key. Values are read from the profile-scoped storage and
+ * are never logged. `revision` lets callers detect credential changes mid-flight so
+ * a stale token or in-progress request cannot keep using old credentials; any save
+ * bumps the epoch for every profile (saves are user-driven and rare).
+ */
+object TvdbCredentialStore {
+    @Volatile
+    private var revisionEpoch = 0L
+
+    /** Keys are persisted under the active profile via ProfileScopedKey. */
+    fun read(profileId: Int): String? = TvdbSettingsStorage.loadApiKey()
+
+    fun revision(profileId: Int): Long = revisionEpoch
+
+    suspend fun save(profileId: Int, apiKey: String?) {
+        val normalized = apiKey?.trim()?.takeIf(String::isNotBlank)
+        TvdbSettingsStorage.saveApiKey(normalized)
+        revisionEpoch += 1L
+    }
+
+    fun savedKey(): String? = read(ProfileRepository.activeProfileId)
+
+    fun clearAllProfiles() {
+        revisionEpoch += 1_000_000L
+    }
+}
diff --git a/composeApp/src/commonMain/kotlin/com/nuvio/app/features/tvdb/TvdbEpisodeCorrespondence.kt b/composeApp/src/commonMain/kotlin/com/nuvio/app/features/tvdb/TvdbEpisodeCorrespondence.kt
new file mode 100644
index 0000000..f5fdedb
--- /dev/null
+++ b/composeApp/src/commonMain/kotlin/com/nuvio/app/features/tvdb/TvdbEpisodeCorrespondence.kt
@@ -0,0 +1,190 @@
+package com.nuvio.app.features.tvdb
+
+private val extendedLabel = Regex("\\s*\\((?:extended(?: cut| edition)?|superfan(?: episode)?)\\)\\s*$", RegexOption.IGNORE_CASE)
+private val partLabel = Regex("^(.*?)\\s*(?:\\((\\d+)\\)|[-:]?\\s*Part\\s+(\\d+))$", RegexOption.IGNORE_CASE)
+private val titleArticle = Regex("\\bthe\\b")
+private val titleSpaces = Regex("\\s+")
+
+/**
+ * Metadata correspondence between a TVDB episode and the metadata provider's
+ * catalog. Stable TVDB IDs lead; variant titles additionally require a unique
+ * title/air-date anchor, and numbered parts require a complete 1..N family rather
+ * than positional matching. This is a bounded metadata correspondence, not a
+ * second history store.
+ */
+
+private fun matchStem(title: String): String = normalizeEpisodeName(title)
+    .replace(titleArticle, " ")
+    .replace(titleSpaces, " ")
+    .trim()
+
+internal fun tvdbEpisodeMatchTitle(title: String): String {
+    val cut = title.replace(extendedLabel, "").trim()
+    val part = partLabel.matchEntire(cut)
+    return if (part == null) {
+        matchStem(cut)
+    } else {
+        matchStem(part.groupValues[1]) + " part " + part.groupValues[2].ifBlank { part.groupValues[3] }
+    }
+}
+
+internal fun tvdbEpisodeBaseTitle(title: String): String {
+    val cut = title.replace(extendedLabel, "").trim()
+    return matchStem(partLabel.matchEntire(cut)?.groupValues?.get(1) ?: cut)
+}
+
+internal fun tvdbEpisodePartNumber(title: String): Int? {
+    val part = partLabel.matchEntire(title.replace(extendedLabel, "").trim()) ?: return null
+    return part.groupValues[2].ifBlank { part.groupValues[3] }.toIntOrNull()
+}
+
+internal fun tvdbEpisodeFamilies(episodes: List<TvdbEpisode>): List<List<TvdbEpisode>> = episodes
+    .filter { tvdbEpisodePartNumber(it.title) != null }
+    .groupBy { tvdbEpisodeBaseTitle(it.title) to it.season }
+    .values.mapNotNull { rows ->
+        val sorted = rows.sortedBy { tvdbEpisodePartNumber(it.title) }
+        sorted.takeIf {
+            it.size > 1 && it.map { row -> tvdbEpisodePartNumber(row.title) } == (1..it.size).toList()
+        }
+    }
+
+/**
+ * Complete part families establish content boundaries; display numbers never do.
+ * `byId` maps every known TVDB episode (across the selected, official and related
+ * orders) to the physical content it covers.
+ */
+internal class TvdbContentCoverage(order: TvdbEpisodeOrder) {
+    private val records = (order.officialEpisodes + order.episodes + order.relatedOrders.values.flatten())
+        .distinctBy { it.id }
+    private val lists = listOf(order.officialEpisodes) +
+        order.relatedOrders.entries.sortedBy { if (it.key == "alternate") "0" else it.key }.map { it.value } +
+        listOf(order.episodes)
+    private val allFamilies = lists.flatMap(::tvdbEpisodeFamilies)
+        .filter { !it.first().aired.isNullOrBlank() }
+    private val anchors: Map<Long, Set<Triple<String, String?, Int>>> = allFamilies
+        .flatMap { family ->
+            family.map { row ->
+                row.id to Triple(
+                    tvdbEpisodeBaseTitle(family.first().title),
+                    family.first().aired?.take(10),
+                    family.size,
+                )
+            }
+        }
+        .groupBy({ it.first }, { it.second })
+        .mapValues { it.value.toSet() }
+    private val families = allFamilies
+        .distinctBy { tvdbEpisodeBaseTitle(it.first().title) to it.first().aired?.take(10) }
+    private val familiesByTitle = families.groupBy { tvdbEpisodeBaseTitle(it.first().title) }
+    private val official = order.officialEpisodes.associateBy { it.id }
+    private val scalar = tvdbEpisodeCorrespondence(order)
+    val byId: Map<Long, List<TvdbEpisode>> = records.mapNotNull { row ->
+        val baseTitle = tvdbEpisodeBaseTitle(row.title)
+        val family = familiesByTitle[baseTitle].orEmpty().filter { candidate ->
+            candidate.any { it.id == row.id } ||
+                (
+                    tvdbEpisodePartNumber(row.title) == null &&
+                        candidate.first().aired?.take(10) == row.aired?.take(10)
+                    ) ||
+                anchors[row.id].orEmpty().contains(
+                    Triple(
+                        tvdbEpisodeBaseTitle(candidate.first().title),
+                        candidate.first().aired?.take(10),
+                        candidate.size,
+                    ),
+                )
+        }.singleOrNull()
+        val coverage = if (family != null) {
+            val number = tvdbEpisodePartNumber(row.title)
+            if (number == null) {
+                family
+            } else {
+                family.singleOrNull { tvdbEpisodePartNumber(it.title) == number }?.let(::listOf)
+            }
+        } else {
+            official[row.id]?.let(::listOf) ?: scalar[row.id]?.let(::listOf)
+        }
+        coverage?.let { row.id to it }
+    }.toMap()
+
+    private val byTitleDate = records.groupBy { tvdbEpisodeMatchTitle(it.title) to it.aired?.take(10) }
+
+    /** Match a provider episode (title + air date) to the TVDB content it covers. */
+    fun match(title: String, date: String?): List<TvdbEpisode> {
+        if (date.isNullOrBlank()) return emptyList()
+        val signature = tvdbEpisodeMatchTitle(title)
+        if (signature.isBlank()) return emptyList()
+        val candidates = byTitleDate[signature to date.take(10)].orEmpty()
+            .mapNotNull { byId[it.id] }
+        return candidates.distinctBy { it.map(TvdbEpisode::id).toSet() }.singleOrNull().orEmpty()
+    }
+}
+
+/**
+ * Stable IDs lead. Variant names additionally require a unique official title/date
+ * anchor; numbered parts require a complete 1..N group, not positional matching.
+ */
+internal fun tvdbEpisodeCorrespondence(order: TvdbEpisodeOrder): Map<Long, TvdbEpisode> {
+    val official = order.officialEpisodes.groupBy { it.id }
+    val byTitle = order.officialEpisodes.groupBy { tvdbEpisodeMatchTitle(it.title) }
+    val result = order.episodes.mapNotNull { episode ->
+        official[episode.id]?.singleOrNull()?.let { episode.id to it }
+    }.toMap().toMutableMap()
+    val parts = mutableListOf<Triple<TvdbEpisode, String, Int>>()
+    for (episode in order.episodes) {
+        if (episode.id in result) continue
+        val title = episode.title.replace(extendedLabel, "").trim()
+        val exact = byTitle[tvdbEpisodeMatchTitle(title)].orEmpty().filter {
+            !it.aired.isNullOrBlank() && it.aired.take(10) == episode.aired?.take(10)
+        }.singleOrNull()
+        if (exact != null) {
+            result[episode.id] = exact
+            continue
+        }
+        val part = partLabel.matchEntire(title)
+        if (part != null) {
+            val number = (part.groupValues[2].ifBlank { part.groupValues[3] }).toIntOrNull() ?: continue
+            parts += Triple(episode, matchStem(part.groupValues[1]), number)
+        }
+    }
+    for (group in parts.groupBy { it.second to it.first.season }.values) {
+        val sorted = group.sortedBy { it.third }
+        if (sorted.size < 2 || sorted.map { it.third } != (1..sorted.size).toList()) continue
+        val anchor = sorted.first().first.aired?.take(10) ?: continue
+        val canonical = byTitle[sorted.first().second].orEmpty()
+            .filter { it.aired?.take(10) == anchor }
+            .singleOrNull() ?: continue
+        sorted.forEach { result[it.first.id] = canonical }
+    }
+    return result
+}
+
+private val episodeCombiningFold = buildMap {
+    val foldFrom = "ÀÁÂÃÄÅĀĂĄÇĆČĈĊĎĐÈÉÊËĒĖĘĚĜĞĠĢĤĦÌÍÎÏĨĪĮİĴĶĹĻĽŁŃŅŇÑÒÓÔÕÖØŌŎŐŔŖŘŚŜŞŠẞŢŤŦÙÚÛÜŨŪŮŰŲŴÝŸŶŹŻŽàáâãäåāăąçćčĉċďđèéêëēėęěĝğġģĥħìíîïĩīįıĵķĺļľłńņňñòóôõöøōŏőŕŗřśŝşšßţťŧùúûüũūůűųŵýÿŷźżž"
+    val foldTo = "AAAAAAAACCCCDDEEEEEEEEFGGGGHHIIIIIIIIJKLLLLNNNOOOOOOORRRSSSSSBTTTTUUUUUUUWYYYYZZZaaaaaaaaccccddddooooooorrrssssbttttuuuuuuuwyyyyzzz"
+    require(foldFrom.length == foldTo.length)
+    foldFrom.forEachIndexed { index, char -> put(char, foldTo[index]) }
+    put('Æ', 'A')
+    put('æ', 'a')
+    put('Œ', 'O')
+    put('œ', 'o')
+    put('Ø', 'O')
+    put('ø', 'o')
+    put('Đ', 'D')
+    put('đ', 'd')
+    put('Ł', 'L')
+    put('ł', 'l')
+}
+
+/**
+ * KMP-safe stand-in for the TV fork's `java.text.Normalizer` NFKD + mark-strip:
+ * a fixed Latin fold table plus punctuation collapsing. Titles that survive this
+ * normalization are the ones the correspondence relies on.
+ */
+internal fun normalizeEpisodeName(value: String): String = buildString {
+    for (raw in value.lowercase()) {
+        append(episodeCombiningFold[raw] ?: raw)
+    }
+}.replace(episodePunctuation, " ").trim()
+
+private val episodePunctuation = Regex("[^\\p{L}\\p{N}]+")
