+package com.nuvio.app.features.tvdb
+
+/**
+ * TVDB v4 alternative episode ordering (port of the ReSeq / TV-fork engine, mobile
+ * pragmatic scope): login with a per-profile API key, discover a series' episode
+ * orders, load paginated episodes with full-page validation, and project the detail
+ * screen's episode list onto the selected order.
+ *
+ * Deferred on mobile (not implemented here): tracker/cloud translation of history
+ * writes, continue-watching projection and player-side projection.
+ */
+
+class TvdbException(val reason: Reason) : Exception(reason.name) {
+    enum class Reason {
+        NO_KEY,
+        AUTHENTICATION,
+        RATE_LIMIT,
+        UNAVAILABLE,
+        NETWORK,
+        INVALID_RESPONSE,
+        CREDENTIALS_CHANGED,
+    }
+}
+
+data class TvdbOrder(val type: String, val name: String)
+
+data class TvdbEpisode(
+    val id: Long,
+    val season: Int,
+    val number: Int,
+    val title: String,
+    val overview: String?,
+    val image: String?,
+    val aired: String?,
+    val runtime: Int?,
+)
+
+data class TvdbEpisodeOrder(
+    val selectedType: String,
+    val effectiveType: String,
+    val episodes: List<TvdbEpisode>,
+    val officialEpisodes: List<TvdbEpisode>,
+    val stale: Boolean = false,
+    val relatedOrders: Map<String, List<TvdbEpisode>> = emptyMap(),
+)
+
+data class TvdbOrderPreference(val seriesId: Long, val orderType: String)
+
+internal fun normalizeTvdbOrderType(value: String?): String? =
+    value?.trim()?.takeIf { it.isNotEmpty() && it.matches(Regex("[A-Za-z0-9_-]+")) }
