@@ -0,0 +1,62 @@
+package com.nuvio.app.features.tvdb
+
+import android.content.Context
+import android.content.SharedPreferences
+import com.nuvio.app.core.storage.ProfileScopedKey
+
+internal actual object TvdbSettingsStorage {
+    private const val preferencesName = "nuvio_tvdb_settings"
+    private const val apiKeyKey = "tvdb_api_key"
+    private const val aliasKeyPrefix = "tvdb_series_"
+    private const val orderKeyPrefix = "tvdb_order_"
+
+    private var preferences: SharedPreferences? = null
+
+    fun initialize(context: Context) {
+        preferences = context.getSharedPreferences(preferencesName, Context.MODE_PRIVATE)
+    }
+
+    actual fun loadApiKey(): String? =
+        preferences?.getString(ProfileScopedKey.of(apiKeyKey), null)?.takeIf(String::isNotBlank)
+
+    actual fun saveApiKey(value: String?) {
+        preferences
+            ?.edit()
+            ?.apply {
+                val scopedKey = ProfileScopedKey.of(apiKeyKey)
+                if (value.isNullOrBlank()) remove(scopedKey) else putString(scopedKey, value.trim())
+            }
+            ?.apply()
+    }
+
+    actual fun loadAliasSeriesId(alias: String): Long? {
+        if (alias.isBlank()) return null
+        val key = ProfileScopedKey.of(aliasKeyPrefix + alias)
+        return preferences?.takeIf { it.contains(key) }?.getLong(key, 0L)?.takeIf { it > 0 }
+    }
+
+    actual fun saveAliasSeriesId(alias: String, seriesId: Long) {
+        if (alias.isBlank() || seriesId <= 0) return
+        preferences
+            ?.edit()
+            ?.putLong(ProfileScopedKey.of(aliasKeyPrefix + alias), seriesId)
+            ?.apply()
+    }
+
+    actual fun loadOrder(seriesId: Long): String? {
+        if (seriesId <= 0) return null
+        val key = ProfileScopedKey.of(orderKeyPrefix + seriesId)
+        return preferences?.getString(key, null)?.takeIf(String::isNotBlank)
+    }
+
+    actual fun saveOrder(seriesId: Long, order: String?) {
+        if (seriesId <= 0) return
+        preferences
+            ?.edit()
+            ?.apply {
+                val key = ProfileScopedKey.of(orderKeyPrefix + seriesId)
+                if (order.isNullOrBlank()) remove(key) else putString(key, order.trim())
+            }
+            ?.apply()
+    }
+}
