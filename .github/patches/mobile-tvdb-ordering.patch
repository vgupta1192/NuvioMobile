+package com.nuvio.app.features.tvdb
+
+/**
+ * Per-profile, per-series episode order selection. Selections are learned at
+ * explicit selection time only; reading never resolves IDs online.
+ */
+object TvdbOrderStore {
+    private val orderRegex = Regex("[A-Za-z0-9_-]+")
+
+    fun knownSeries(aliases: Collection<String>): Long? {
+        val ids = aliases.mapNotNull { alias ->
+            runCatching { TvdbSettingsStorage.loadAliasSeriesId(alias) }.getOrNull()
+        }.filter { it != null && it > 0 }.distinct()
+        return ids.singleOrNull()
+    }
+
+    fun selected(aliases: Collection<String>): TvdbOrderPreference? {
+        val id = knownSeries(aliases) ?: return null
+        val order = loadOrder(id) ?: return null
+        return TvdbOrderPreference(id, order)
+    }
+
+    fun loadOrder(seriesId: Long): String? {
+        if (seriesId <= 0) return null
+        return normalizeTvdbOrderType(
+            runCatching { TvdbSettingsStorage.loadOrder(seriesId) }.getOrNull(),
+        )
+    }
+
+    suspend fun save(seriesId: Long, order: String?, aliases: Collection<String>) {
+        require(seriesId > 0)
+        require(order == null || orderRegex.matches(order))
+        TvdbSettingsStorage.saveOrder(seriesId, order)
+        aliases.filter(String::isNotBlank).forEach { alias ->
+            runCatching { TvdbSettingsStorage.saveAliasSeriesId(alias, seriesId) }
+        }
+    }
+}
