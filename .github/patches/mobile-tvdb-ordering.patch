+package com.nuvio.app.features.tvdb
+
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.foundation.layout.padding
+import androidx.compose.foundation.lazy.LazyListScope
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.material3.Text
+import androidx.compose.material3.TextButton
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.rememberCoroutineScope
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.unit.dp
+import com.nuvio.app.features.profiles.ProfileRepository
+import com.nuvio.app.features.settings.SettingsGroup
+import com.nuvio.app.features.settings.SettingsSecretTextField
+import com.nuvio.app.features.settings.SettingsSection
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.launch
+
+/**
+ * TheTVDB episode ordering settings: per-profile API key with masked input and a
+ * test-connection action. The key is stored profile-scoped and never logged.
+ */
+internal fun LazyListScope.tvdbSettingsContent(isTablet: Boolean) {
+    item {
+        val scope = rememberCoroutineScope()
+        var apiKey by remember { mutableStateOf(TvdbCredentialStore.savedKey().orEmpty()) }
+        var testState by remember { mutableStateOf(TvdbTestState.Idle) }
+        SettingsSection(title = "TheTVDB Episode Ordering", isTablet = isTablet) {
+            SettingsGroup(isTablet = isTablet) {
+                SettingsSecretTextField(
+                    value = apiKey,
+                    onValueChange = { value ->
+                        apiKey = value
+                        testState = TvdbTestState.Idle
+                        scope.launch {
+                            TvdbCredentialStore.save(ProfileRepository.activeProfileId, value)
+                        }
+                    },
+                    label = "TVDB v4 API key",
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .padding(horizontal = 16.dp, vertical = 12.dp),
+                )
+                Text(
+                    text = "Powers alternative episode orders (DVD, absolute, aired) on series detail " +
+                        "screens. Each profile keeps its own key. Get a free key at thetvdb.com.",
+                    style = MaterialTheme.typography.bodySmall,
+                    color = MaterialTheme.colorScheme.onSurfaceVariant,
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .padding(horizontal = 16.dp),
+                )
+                TextButton(
+                    onClick = {
+                        if (testState == TvdbTestState.Testing) return@TextButton
+                        val key = apiKey.trim()
+                        if (key.isEmpty()) {
+                            testState = TvdbTestState.Failed("Enter an API key first.")
+                            return@TextButton
+                        }
+                        testState = TvdbTestState.Testing
+                        val profile = ProfileRepository.activeProfileId
+                        scope.launch {
+                            testState = try {
+                                TvdbClient(TvdbCredentialStore).testConnection(profile)
+                                TvdbTestState.Passed
+                            } catch (cancelled: CancellationException) {
+                                throw cancelled
+                            } catch (e: TvdbException) {
+                                TvdbTestState.Failed(tvdbTestFailureMessage(e.reason))
+                            } catch (_: Exception) {
+                                TvdbTestState.Failed(tvdbTestFailureMessage(TvdbException.Reason.NETWORK))
+                            }
+                        }
+                    },
+                    enabled = testState != TvdbTestState.Testing,
+                    modifier = Modifier.padding(horizontal = 8.dp),
+                ) {
+                    Text(
+                        text = when (testState) {
+                            TvdbTestState.Idle -> "Test connection"
+                            TvdbTestState.Testing -> "Testing…"
+                            TvdbTestState.Passed -> "Connected — try again"
+                            is TvdbTestState.Failed -> "Retry connection test"
+                        },
+                    )
+                }
+                when (val state = testState) {
+                    TvdbTestState.Idle -> Unit
+                    TvdbTestState.Testing -> Unit
+                    TvdbTestState.Passed -> Text(
+                        text = "Connection OK. The key is stored for this profile only.",
+                        style = MaterialTheme.typography.bodySmall,
+                        color = MaterialTheme.colorScheme.primary,
+                        modifier = Modifier.padding(horizontal = 16.dp),
+                    )
+                    is TvdbTestState.Failed -> Text(
+                        text = state.message,
+                        style = MaterialTheme.typography.bodySmall,
+                        color = MaterialTheme.colorScheme.error,
+                        modifier = Modifier.padding(horizontal = 16.dp),
+                    )
+                }
+                Text(
+                    text = "Pick an episode order per series from its detail screen.",
+                    style = MaterialTheme.typography.bodySmall,
+                    color = MaterialTheme.colorScheme.onSurfaceVariant,
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .padding(horizontal = 16.dp, vertical = 8.dp),
+                )
+            }
+        }
+    }
+}
+
+internal sealed class TvdbTestState {
+    data object Idle : TvdbTestState()
+    data object Testing : TvdbTestState()
+    data object Passed : TvdbTestState()
+    data class Failed(val message: String) : TvdbTestState()
+}
+
+private fun tvdbTestFailureMessage(reason: TvdbException.Reason): String = when (reason) {
+    TvdbException.Reason.NO_KEY -> "No API key configured."
+    TvdbException.Reason.AUTHENTICATION -> "TheTVDB rejected the key."
+    TvdbException.Reason.RATE_LIMIT -> "Rate limited by TheTVDB. Try again shortly."
+    TvdbException.Reason.UNAVAILABLE -> "TheTVDB endpoint is unavailable."
+    TvdbException.Reason.NETWORK -> "Network error reaching TheTVDB."
+    TvdbException.Reason.INVALID_RESPONSE -> "Unexpected response from TheTVDB."
+    TvdbException.Reason.CREDENTIALS_CHANGED -> "Key changed during the test."
+}
