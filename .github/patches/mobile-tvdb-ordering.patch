+package com.nuvio.app.features.tvdb
+
+import com.nuvio.app.features.details.MetaDetails
+import com.nuvio.app.features.details.MetaVideo
+import com.nuvio.app.features.details.TvdbEpisodeRef
+import com.nuvio.app.features.watchprogress.WatchProgressEntry
+import com.nuvio.app.features.watchprogress.buildPlaybackVideoId
+import com.nuvio.app.features.watched.watchedItemKey
+import com.nuvio.app.features.watched.watchedItemKeys
+
+/**
+ * Display projection of the provider's episode list onto a selected TVDB order.
+ *
+ * The projected rows are the TVDB episodes of the selected order, re-keyed to the
+ * order's season/episode numbers. Rows matched to the provider catalog (via the
+ * bounded metadata correspondence) carry the provider identity in [TvdbEpisodeRef]
+ * so watched badges, progress and stream requests resolve against the provider's
+ * actual season/episode. Unmatched rows keep TVDB numbering and surface a
+ * "Not matched" badge.
+ *
+ * Deferred on mobile: tracker/cloud translation, continue-watching projection and
+ * player-side projection are NOT implemented — history is only displayed here.
+ */
+class TvdbEpisodeProjection(
+    val provider: MetaDetails,
+    val seriesId: Long,
+    val order: TvdbEpisodeOrder,
+) {
+    private val coverage = TvdbContentCoverage(order)
+
+    private val genericEpisodeTitle = Regex("(?:episode|ep|e) ?\\d+")
+
+    /** Provider video for each TVDB episode id it verifiably covers. */
+    private val providerByTvdbId: Map<Long, MetaVideo> = buildMap {
+        for (video in provider.videos) {
+            if (video.id.isBlank()) continue
+            val season = video.season ?: continue
+            val episode = video.episode ?: continue
+            if (season < 0 || episode <= 0) continue
+            val date = video.released?.take(10)
+            val signature = tvdbEpisodeMatchTitle(video.title)
+            if (date == null || signature.isBlank() || genericEpisodeTitle.matches(signature)) continue
+            val covered = coverage.match(video.title, date)
+            val target = covered.singleOrNull() ?: continue
+            if (target.id !in this) this[target.id] = video
+        }
+    }
+
+    val rows: List<MetaVideo> = order.episodes
+        .map { episode ->
+            val source = providerByTvdbId[episode.id]
+            MetaVideo(
+                id = "tvdb:$seriesId:${episode.id}",
+                title = episode.title.ifBlank { source?.title ?: "Episode ${episode.number}" },
+                released = episode.aired ?: source?.released,
+                available = source?.available ?: true,
+                thumbnail = episode.image?.takeIf(String::isNotBlank) ?: source?.thumbnail,
+                season = episode.season,
+                episode = episode.number,
+                overview = episode.overview ?: source?.overview,
+                runtime = episode.runtime ?: source?.runtime,
+                rating = null,
+                tvdbOrder = TvdbEpisodeRef(
+                    seriesId = seriesId,
+                    episodeId = episode.id,
+                    orderType = order.effectiveType,
+                    matched = source != null,
+                    sourceVideoId = source?.id,
+                    sourceSeason = source?.season,
+                    sourceEpisode = source?.episode,
+                ),
+            )
+        }
+        .sortedWith(compareBy({ it.season ?: Int.MAX_VALUE }, { it.episode ?: Int.MAX_VALUE }))
+
+    val unmatchedCount: Int = rows.count { it.tvdbOrder?.matched != true }
+
+    val statusMessage: String? = listOfNotNull(
+        "Using the ${order.effectiveType} episode order from TheTVDB",
+        "Using cached TVDB metadata".takeIf { order.stale },
+        "$unmatchedCount episode(s) not matched; they keep TVDB numbering".takeIf { unmatchedCount > 0 },
+    ).joinToString(". ")
+
+    /** First provider season that corresponds to a TVDB season of this order. */
+    fun providerSeasonOf(tvdbSeason: Int): Int? = rows
+        .firstOrNull { it.season == tvdbSeason && it.tvdbOrder?.matched == true }
+        ?.tvdbOrder?.sourceSeason
+
+    /** Provider-season keys that do not appear in the selected TVDB order. */
+    fun droppedProviderSeasons(): Set<Int> {
+        val providerSeasons = provider.videos.mapNotNull { it.season?.let(::normalizeSeasonKey) }.toSet()
+        val projectedSeasons = rows.mapNotNull { it.season?.let(::normalizeSeasonKey) }.toSet()
+        return providerSeasons - projectedSeasons
+    }
+
+    private fun normalizeSeasonKey(season: Int): Int = if (season <= 0) 0 else season
+
+    /**
+     * Resolves the episode a play request should target. Matched rows map to the
+     * provider's actual season/episode (stream search stays physically correct);
+     * unmatched rows fall back to a provider-prefix request built from TVDB
+     * numbering. Rows from an unprojected list are returned unchanged.
+     */
+    fun resolvePlayback(row: MetaVideo): MetaVideo {
+        val ref = row.tvdbOrder ?: return row
+        if (ref.matched && ref.sourceVideoId != null && ref.sourceSeason != null && ref.sourceEpisode != null) {
+            return row.copy(
+                id = ref.sourceVideoId,
+                season = ref.sourceSeason,
+                episode = ref.sourceEpisode,
+            )
+        }
+        // Unmatched: TVDB numbering on the content id prefix, mirroring the TV fork.
+        return row.copy(id = "${provider.id}:${row.season}:${row.episode}")
+    }
+
+    /** The provider-equivalent of a projected row, for history-toggle actions. */
+    fun toProviderEpisode(row: MetaVideo): MetaVideo {
+        val ref = row.tvdbOrder ?: return row
+        if (!ref.matched) return row
+        val sourceSeason = ref.sourceSeason ?: return row
+        val sourceEpisode = ref.sourceEpisode ?: return row
+        return row.copy(
+            id = ref.sourceVideoId ?: row.id,
+            season = sourceSeason,
+            episode = sourceEpisode,
+        )
+    }
+
+    /** Watched keys re-keyed to the projected numbering (provider keys preserved). */
+    fun displayWatchedKeys(
+        metaType: String,
+        metaId: String,
+        providerWatched: Set<String>,
+        providerProgress: Map<String, WatchProgressEntry>,
+    ): Set<String> {
+        val extra = mutableSetOf<String>()
+        for (row in rows) {
+            val ref = row.tvdbOrder ?: continue
+            if (!ref.matched) continue
+            val sourceSeason = ref.sourceSeason ?: continue
+            val sourceEpisode = ref.sourceEpisode ?: continue
+            val watched = watchedItemKeys(metaType, metaId, sourceSeason, sourceEpisode)
+                .any(providerWatched::contains) ||
+                providerProgress[buildPlaybackVideoId(metaId, sourceSeason, sourceEpisode)]
+                    ?.isEffectivelyCompleted == true ||
+                ref.sourceVideoId?.let { providerProgress[it]?.isEffectivelyCompleted } == true
+            if (watched) {
+                extra += watchedItemKey(metaType, metaId, row.season, row.episode)
+            }
+        }
+        return if (extra.isEmpty()) providerWatched else providerWatched + extra
+    }
+
+    /** Progress entries re-keyed to the projected numbering (provider keys preserved). */
+    fun displayProgress(
+        metaId: String,
+        providerProgress: Map<String, WatchProgressEntry>,
+    ): Map<String, WatchProgressEntry> {
+        val extra = mutableMapOf<String, WatchProgressEntry>()
+        for (row in rows) {
+            val ref = row.tvdbOrder ?: continue
+            if (!ref.matched) continue
+            val sourceSeason = ref.sourceSeason
+            val sourceEpisode = ref.sourceEpisode
+            val entry = ref.sourceVideoId?.let(providerProgress::get)
+                ?: (if (sourceSeason != null && sourceEpisode != null) {
+                    providerProgress[buildPlaybackVideoId(metaId, sourceSeason, sourceEpisode)]
+                } else {
+                    null
+                }) ?: continue
+            extra["${metaId}:${row.season}:${row.episode}"] = entry
+        }
+        return if (extra.isEmpty()) providerProgress else providerProgress + extra
+    }
+}
