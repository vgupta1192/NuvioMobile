+package com.nuvio.app.features.tvdb
+
+/**
+ * Profile-scoped persistence for the TVDB integration. Keys are stored under the
+ * active profile (see ProfileScopedKey) so each profile carries its own API key and
+ * per-series order selections. Implementations must never log credential values.
+ */
+internal expect object TvdbSettingsStorage {
+    fun loadApiKey(): String?
+    fun saveApiKey(value: String?)
+
+    fun loadAliasSeriesId(alias: String): Long?
+    fun saveAliasSeriesId(alias: String, seriesId: Long)
+
+    fun loadOrder(seriesId: Long): String?
+    fun saveOrder(seriesId: Long, order: String?)
+}
