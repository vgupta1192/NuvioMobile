+package com.nuvio.app.features.tvdb
+
+import com.nuvio.app.features.details.MetaDetails
+import com.nuvio.app.features.details.MetaVideo
+import com.nuvio.app.features.profiles.ProfileRepository
+import com.nuvio.app.features.tmdb.TmdbService
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import kotlinx.coroutines.withTimeoutOrNull
+
+data class TvdbEpisodeOrderUiState(
+    val selection: TvdbOrderPreference? = null,
+    val projection: TvdbEpisodeProjection? = null,
+    val orders: List<TvdbOrder> = emptyList(),
+    val pickerOpen: Boolean = false,
+    val pickerBusy: Boolean = false,
+    val pickerError: String? = null,
+    val loading: Boolean = false,
+    val pickerSeriesId: Long? = null,
+    val hasCredential: Boolean = false,
+) {
+    val active: Boolean get() = selection != null && projection != null
+
+    val statusMessage: String? get() = projection?.statusMessage
+}
+
+private val seriesLikeTypes = setOf("series", "show", "tv", "tvshow")
+
+internal fun isTvdbSeriesLike(type: String): Boolean = type.trim().lowercase() in seriesLikeTypes
+
+internal fun extractTvdbImdbId(value: String?): String? =
+    value?.trim()?.takeIf { it.matches(Regex("tt\\d+")) }
+
+internal fun extractTvdbTmdbId(value: String?): Int? =
+    value?.trim()?.takeIf { it.startsWith("tmdb:") }
+        ?.substringAfter(':')?.substringBefore(':')?.toIntOrNull()?.takeIf { it > 0 }
+
+/**
+ * Screen-scoped controller for the alternative episode order: observes the
+ * per-profile selection, loads the selected TVDB order and projects the provider
+ * episode list onto it. The provider list stays authoritative whenever no order is
+ * selected — without a configured key and selection nothing changes.
+ */
+class TvdbEpisodeOrderController(
+    private val scope: CoroutineScope,
+) {
+    private val client = TvdbClient(TvdbCredentialStore)
+    private val repository = TvdbOrderRepository(client)
+
+    private val _state = MutableStateFlow(TvdbEpisodeOrderUiState())
+    val state: StateFlow<TvdbEpisodeOrderUiState> = _state.asStateFlow()
+
+    private var job: Job? = null
+    private var generation = 0
+    private var observedAliases: List<String>? = null
+    private var observedKey: String? = null
+    private var loadedProjectionKey: String? = null
+    private var lastAliases: List<String> = emptyList()
+    private var lastMeta: MetaDetails? = null
+
+    fun aliases(meta: MetaDetails?, routeId: String): List<String> = listOfNotNull(
+        routeId.takeIf(String::isNotBlank),
+        meta?.id?.takeIf(String::isNotBlank),
+        meta?.imdbId?.takeIf(String::isNotBlank),
+    ).distinct()
+
+    /**
+     * Re-reads the persisted selection. Cheap (local storage), called whenever the
+     * content identity or the active profile changes.
+     */
+    fun observeSelection(aliases: List<String>) {
+        val key = aliases.joinToString("|")
+        if (observedKey == key && observedAliases != null) return
+        observedKey = key
+        observedAliases = aliases
+        lastAliases = aliases
+        val profile = ProfileRepository.activeProfileId
+        val hasKey = !TvdbCredentialStore.read(profile).isNullOrBlank()
+        val selection = if (hasKey) TvdbOrderStore.selected(aliases) else null
+        if (selection == null) {
+            generation++
+            job?.cancel()
+            loadedProjectionKey = null
+            _state.value = TvdbEpisodeOrderUiState(hasCredential = hasKey)
+        } else {
+            _state.value = _state.value.copy(
+                hasCredential = hasKey,
+                selection = selection,
+                projection = _state.value.projection
+                    ?.takeIf { it.seriesId == selection.seriesId && it.order.effectiveType == selection.orderType },
+            )
+        }
+    }
+
+    /**
+     * Loads the selected order and projects the provider episodes onto it. No-ops
+     * when no order is selected or the same input was already projected.
+     */
+    fun loadProjection(aliases: List<String>, providerMeta: MetaDetails?) {
+        lastAliases = aliases
+        lastMeta = providerMeta
+        val selection = _state.value.selection ?: return
+        if (providerMeta == null || !isTvdbSeriesLike(providerMeta.type)) return
+        val key = listOf(
+            ProfileRepository.activeProfileId,
+            selection.seriesId,
+            selection.orderType,
+            providerMeta.id,
+            providerMeta.videos.size,
+            providerMeta.videos.hashCode(),
+        ).joinToString(":")
+        if (loadedProjectionKey == key && _state.value.projection != null) return
+        loadedProjectionKey = key
+        val request = ++generation
+        job?.cancel()
+        job = scope.launch {
+            _state.value = _state.value.copy(loading = true)
+            try {
+                val projection = withTimeoutOrNull(LOAD_TIMEOUT_MS) {
+                    withContext(kotlinx.coroutines.Dispatchers.Default) {
+                        val order = repository.load(
+                            profileId = ProfileRepository.activeProfileId,
+                            seriesId = selection.seriesId,
+                            selected = selection.orderType,
+                            includeRelated = true,
+                        )
+                        TvdbEpisodeProjection(providerMeta, selection.seriesId, order)
+                    }
+                } ?: throw TvdbException(TvdbException.Reason.NETWORK)
+                if (request == generation) {
+                    _state.value = _state.value.copy(
+                        projection = projection,
+                        loading = false,
+                        pickerError = null,
+                    )
+                }
+            } catch (cancelled: CancellationException) {
+                throw cancelled
+            } catch (_: Exception) {
+                if (request == generation) {
+                    _state.value = _state.value.copy(
+                        projection = null,
+                        loading = false,
+                        pickerError = TVDB_UNAVAILABLE_MESSAGE,
+                    )
+                }
+            }
+        }
+    }
+
+    fun openPicker(providerMeta: MetaDetails?) {
+        if (_state.value.pickerBusy) return
+        val meta = providerMeta ?: return
+        if (!isTvdbSeriesLike(meta.type)) return
+        val aliases = lastAliases.ifEmpty { aliases(meta, meta.id) }
+        val request = ++generation
+        job?.cancel()
+        job = scope.launch {
+            _state.value = _state.value.copy(pickerOpen = true, pickerBusy = true, pickerError = null)
+            try {
+                val profile = ProfileRepository.activeProfileId
+                val seriesId = resolveSeriesId(profile, meta, aliases)
+                    ?: error("This series could not be identified on TheTVDB.")
+                val orders = repository.available(profile, seriesId).filter { it.type != "default" }
+                if (request == generation) {
+                    _state.value = _state.value.copy(
+                        pickerOpen = true,
+                        pickerBusy = false,
+                        pickerSeriesId = seriesId,
+                        orders = (listOf(TvdbOrder("official", "TVDB Standard (Aired)")) + orders)
+                            .distinctBy { it.type },
+                    )
+                }
+            } catch (cancelled: CancellationException) {
+                throw cancelled
+            } catch (e: Exception) {
+                if (request == generation) {
+                    _state.value = _state.value.copy(
+                        pickerBusy = false,
+                        pickerError = when ((e as? TvdbException)?.reason) {
+                            TvdbException.Reason.NO_KEY ->
+                                "Configure your TVDB API key in Settings > Integrations > TheTVDB."
+                            TvdbException.Reason.AUTHENTICATION ->
+                                "TheTVDB rejected your key. Test the connection in Settings."
+                            else -> "Unable to load TheTVDB episode orders. Check the connection and try again."
+                        },
+                    )
+                }
+            }
+        }
+    }
+
+    fun closePicker() {
+        generation++
+        job?.cancel()
+        _state.value = _state.value.copy(pickerOpen = false, pickerBusy = false, pickerError = null)
+    }
+
+    fun select(type: String?, seriesIdHint: Long? = null) {
+        val seriesId = _state.value.selection?.seriesId
+            ?: _state.value.pickerSeriesId
+            ?: seriesIdHint
+            ?: return
+        if (_state.value.pickerBusy && type != null) return
+        val profile = ProfileRepository.activeProfileId
+        val request = ++generation
+        job?.cancel()
+        job = scope.launch {
+            _state.value = _state.value.copy(pickerBusy = true, pickerError = null)
+            try {
+                TvdbOrderStore.save(seriesId, type, lastAliases)
+                if (request == generation) {
+                    _state.value = _state.value.copy(
+                        pickerOpen = false,
+                        pickerBusy = false,
+                        pickerError = null,
+                    )
+                    observedKey = null
+                    loadedProjectionKey = null
+                    observedAliases?.let(::observeSelection)
+                    lastMeta?.let { loadProjection(lastAliases, it) }
+                }
+            } catch (cancelled: CancellationException) {
+                throw cancelled
+            } catch (_: Exception) {
+                if (request == generation) {
+                    _state.value = _state.value.copy(pickerBusy = false, pickerError = "Unable to save the episode order.")
+                }
+            }
+        }
+    }
+
+    private suspend fun resolveSeriesId(profile: Int, meta: MetaDetails, aliases: List<String>): Long? {
+        TvdbOrderStore.knownSeries(aliases)?.let { return it }
+        meta.id.takeIf { it.startsWith("tvdb:") }
+            ?.substringAfter(':')?.substringBefore(':')?.toLongOrNull()?.takeIf { it > 0 }
+            ?.let { return it }
+        val imdb = extractTvdbImdbId(meta.imdbId)
+            ?: extractTvdbImdbId(meta.id)
+            ?: extractTvdbTmdbId(meta.id)
+                ?.takeIf { TvdbCredentialStore.read(profile) != null }
+                ?.let { tmdbId -> TmdbService.tmdbToImdb(tmdbId, "series") }
+        return imdb?.let { client.seriesByRemoteId(profile, it) }
+    }
+
+    /** Screen-level helpers mirroring [TvdbEpisodeProjection] with a null-safe fallback. */
+    fun resolvePlayback(row: MetaVideo): MetaVideo = _state.value.projection?.resolvePlayback(row) ?: row
+
+    fun toProviderEpisode(row: MetaVideo): MetaVideo = _state.value.projection?.toProviderEpisode(row) ?: row
+
+    fun providerSeasonOf(tvdbSeason: Int): Int? = _state.value.projection?.providerSeasonOf(tvdbSeason)
+
+    private companion object {
+        const val LOAD_TIMEOUT_MS = 20_000L
+        const val TVDB_UNAVAILABLE_MESSAGE = "TheTVDB is unavailable. Showing metadata provider episodes."
+    }
+}
