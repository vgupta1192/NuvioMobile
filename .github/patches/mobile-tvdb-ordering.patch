@@ -0,0 +1,159 @@
+package com.nuvio.app.features.tvdb
+
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withTimeoutOrNull
+
+/**
+ * Bounded metadata cache for TVDB episode orders — not a separate episode or
+ * history database. Order data is fresh for 24 hours; authentication failures keep
+ * an existing complete cache usable with an explicit stale indication.
+ */
+class TvdbOrderRepository(private val api: TvdbClient) {
+    private data class Cached<T>(val value: T, val at: Long)
+
+    private val mutex = Mutex()
+    private val discoveries = LinkedHashMap<String, Cached<List<TvdbOrder>>>()
+    private val orders = LinkedHashMap<String, Cached<TvdbEpisodeOrder>>()
+
+    private fun <T> LinkedHashMap<String, T>.lruGet(key: String): T? {
+        val value = remove(key) ?: return null
+        put(key, value)
+        trim(LRU_LIMIT)
+        return value
+    }
+
+    private fun <T> LinkedHashMap<String, T>.lruPut(key: String, value: T) {
+        remove(key)
+        put(key, value)
+        trim(LRU_LIMIT)
+    }
+
+    private fun <T> LinkedHashMap<String, T>.trim(limit: Int) {
+        while (size > limit) remove(keys.first())
+    }
+
+    private fun fresh(at: Long): Boolean {
+        val age = nowEpochMs() - at
+        return age in 0 until FRESH_MS
+    }
+
+    private fun nowEpochMs(): Long = kotlin.time.Clock.System.now().toEpochMilliseconds()
+
+    suspend fun available(profileId: Int, seriesId: Long): List<TvdbOrder> = mutex.withLock {
+        discover(profileId, seriesId)
+    }
+
+    private suspend fun discover(profileId: Int, seriesId: Long): List<TvdbOrder> {
+        discoveries.lruGet(seriesId.toString())?.takeIf { fresh(it.at) }?.let { return it.value }
+        val result = api.orders(profileId, seriesId)
+        discoveries.lruPut(seriesId.toString(), Cached(result, nowEpochMs()))
+        return result
+    }
+
+    suspend fun load(
+        profileId: Int,
+        seriesId: Long,
+        selected: String,
+        language: String = "eng",
+        includeRelated: Boolean = false,
+    ): TvdbEpisodeOrder = mutex.withLock {
+        val current = loadBase(profileId, seriesId, selected, language)
+        if (!includeRelated) return@withLock current
+        val related = linkedMapOf(
+            "official" to current.officialEpisodes,
+            selected to current.episodes,
+        )
+        // Supplementary metadata must not turn a successful selected-order load
+        // into a timeout. Partial supplementary reads are safe.
+        withTimeoutOrNull(SUPPLEMENTARY_TIMEOUT_MS) {
+            for (type in discover(profileId, seriesId).map { it.type }) {
+                if (type in related) continue
+                try {
+                    val key = "$seriesId:$type:$language"
+                    val cached = orders.lruGet(key)?.takeIf { fresh(it.at) }?.value?.episodes
+                    val episodes = cached ?: api.episodes(profileId, seriesId, type, language).also { rows ->
+                        if (rows.isNotEmpty()) {
+                            orders.lruPut(
+                                key,
+                                Cached(
+                                    TvdbEpisodeOrder(type, type, rows, current.officialEpisodes),
+                                    nowEpochMs(),
+                                ),
+                            )
+                        }
+                    }
+                    if (episodes.isNotEmpty()) related[type] = episodes
+                } catch (cancelled: CancellationException) {
+                    throw cancelled
+                } catch (_: TvdbException) {
+                    // Only the selected order may perform an expensive season fallback.
+                }
+            }
+        }
+        current.copy(relatedOrders = related)
+    }
+
+    private suspend fun loadBase(
+        profileId: Int,
+        seriesId: Long,
+        selected: String,
+        language: String,
+    ): TvdbEpisodeOrder {
+        val key = "$seriesId:$selected:$language"
+        val cached = orders.lruGet(key)
+        cached?.takeIf { fresh(it.at) }?.let { return it.value }
+        return try {
+            val available = discover(profileId, seriesId)
+            // Only an affirmative discovery response establishes unavailability.
+            val effective = if (selected == "official" || available.any { it.type == selected }) selected else "official"
+            val officialKey = "$seriesId:official:$language"
+            val official = orders.lruGet(officialKey)?.takeIf { fresh(it.at) }?.value?.officialEpisodes
+                ?: api.episodes(profileId, seriesId, "official", language).also { rows ->
+                    if (rows.isNotEmpty()) {
+                        orders.lruPut(
+                            officialKey,
+                            Cached(
+                                TvdbEpisodeOrder("official", "official", rows, rows),
+                                nowEpochMs(),
+                            ),
+                        )
+                    }
+                }
+            var effectiveType = effective
+            var episodes = if (effective == "official") official else try {
+                api.episodes(profileId, seriesId, effective, language)
+            } catch (e: TvdbException) {
+                if (e.reason != TvdbException.Reason.UNAVAILABLE) throw e
+                emptyList()
+            }
+            if (episodes.isEmpty() && effective != "official") {
+                val base = official.associateBy { it.id }
+                episodes = api.episodesFromSeasons(profileId, seriesId, effective).map { episode ->
+                    base[episode.id]?.copy(season = episode.season, number = episode.number) ?: episode
+                }
+                if (episodes.isEmpty()) {
+                    effectiveType = "official"
+                    episodes = official
+                }
+            }
+            if (episodes.isEmpty() || official.isEmpty()) throw TvdbException(TvdbException.Reason.UNAVAILABLE)
+            TvdbEpisodeOrder(selected, effectiveType, episodes, official).also {
+                orders.lruPut(key, Cached(it, nowEpochMs()))
+            }
+        } catch (cancelled: CancellationException) {
+            throw cancelled
+        } catch (e: TvdbException) {
+            // Authentication errors are not treated as missing orders. Existing
+            // complete data remains usable with an explicit stale indication.
+            cached?.value?.copy(stale = true) ?: throw e
+        }
+    }
+
+    private companion object {
+        const val LRU_LIMIT = 32
+        const val FRESH_MS = 24L * 60 * 60 * 1000
+        const val SUPPLEMENTARY_TIMEOUT_MS = 5_000L
+    }
+}
