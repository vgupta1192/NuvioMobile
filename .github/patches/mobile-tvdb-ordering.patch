@@ -0,0 +1,58 @@
+package com.nuvio.app.features.tvdb
+
+import com.nuvio.app.core.storage.ProfileScopedKey
+import platform.Foundation.NSUserDefaults
+
+internal actual object TvdbSettingsStorage {
+    private const val apiKeyKey = "tvdb_api_key"
+    private const val aliasKeyPrefix = "tvdb_series_"
+    private const val orderKeyPrefix = "tvdb_order_"
+
+    actual fun loadApiKey(): String? =
+        NSUserDefaults.standardUserDefaults
+            .stringForKey(ProfileScopedKey.of(apiKeyKey))
+            ?.takeIf(String::isNotBlank)
+
+    actual fun saveApiKey(value: String?) {
+        val defaults = NSUserDefaults.standardUserDefaults
+        val scopedKey = ProfileScopedKey.of(apiKeyKey)
+        if (value.isNullOrBlank()) {
+            defaults.removeObjectForKey(scopedKey)
+        } else {
+            defaults.setObject(value.trim(), forKey = scopedKey)
+        }
+    }
+
+    actual fun loadAliasSeriesId(alias: String): Long? {
+        if (alias.isBlank()) return null
+        val key = ProfileScopedKey.of(aliasKeyPrefix + alias)
+        val defaults = NSUserDefaults.standardUserDefaults
+        if (defaults.objectForKey(key) == null) return null
+        return defaults.integerForKey(key).takeIf { it > 0 }
+    }
+
+    actual fun saveAliasSeriesId(alias: String, seriesId: Long) {
+        if (alias.isBlank() || seriesId <= 0) return
+        NSUserDefaults.standardUserDefaults
+            .setInteger(seriesId, forKey = ProfileScopedKey.of(aliasKeyPrefix + alias))
+    }
+
+    actual fun loadOrder(seriesId: Long): String? {
+        if (seriesId <= 0) return null
+        val key = ProfileScopedKey.of(orderKeyPrefix + seriesId)
+        return NSUserDefaults.standardUserDefaults
+            .stringForKey(key)
+            ?.takeIf(String::isNotBlank)
+    }
+
+    actual fun saveOrder(seriesId: Long, order: String?) {
+        if (seriesId <= 0) return
+        val defaults = NSUserDefaults.standardUserDefaults
+        val key = ProfileScopedKey.of(orderKeyPrefix + seriesId)
+        if (order.isNullOrBlank()) {
+            defaults.removeObjectForKey(key)
+        } else {
+            defaults.setObject(order.trim(), forKey = key)
+        }
+    }
