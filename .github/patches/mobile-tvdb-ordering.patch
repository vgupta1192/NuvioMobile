@@ -0,0 +1,274 @@
+package com.nuvio.app.features.tvdb
+
+import com.nuvio.app.core.network.createApiHttpClient
+import com.nuvio.app.core.network.readBoundedResponseBody
+import io.ktor.client.HttpClient
+import io.ktor.client.request.get
+import io.ktor.client.request.header
+import io.ktor.client.request.post
+import io.ktor.client.request.setBody
+import io.ktor.client.statement.HttpResponse
+import io.ktor.client.statement.bodyAsChannel
+import io.ktor.http.ContentType
+import io.ktor.http.contentLength
+import io.ktor.http.contentType
+import io.ktor.utils.io.errors.IOException
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonArray
+import kotlinx.serialization.json.JsonElement
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.contentOrNull
+import kotlinx.serialization.json.longOrNull
+import kotlinx.serialization.json.put
+
+/**
+ * TVDB v4 API client (ktor). Login exchanges the profile API key for a bearer token;
+ * the token is cached in memory only and never persisted or logged. Episode pages
+ * are validated in full: a failed page aborts the whole load instead of returning a
+ * truncated order.
+ */
+class TvdbClient(
+    private val credentials: TvdbCredentialStore,
+    private val nowEpochMs: () -> Long = { kotlin.time.Clock.System.now().toEpochMilliseconds() },
+) {
+    private class Token(val revision: Long, val value: String, val expiresAt: Long)
+
+    private val http: HttpClient by lazy { createApiHttpClient() }
+    private val mutex = Mutex()
+    private val tokens = mutableMapOf<Int, Token>()
+    private val json = Json { ignoreUnknownKeys = true }
+
+    /** Login only: never persists or exposes the bearer token. */
+    suspend fun testConnection(profileId: Int) {
+        mutex.withLock {
+            tokens.remove(profileId)
+            token(profileId)
+        }
+    }
+
+    suspend fun orders(profileId: Int, seriesId: Long): List<TvdbOrder> {
+        require(seriesId > 0)
+        val series = get(profileId, "series/$seriesId/extended").objectData()
+        val seasons = series["seasons"] as? JsonArray ?: return emptyList()
+        return seasons.mapNotNull { value ->
+            val type = (value as? JsonObject)?.get("type") as? JsonObject ?: return@mapNotNull null
+            val id = type["type"]?.string() ?: return@mapNotNull null
+            TvdbOrder(id, type["name"]?.string() ?: id)
+        }.distinctBy { it.type }
+    }
+
+    suspend fun seriesByRemoteId(profileId: Int, remoteId: String): Long? {
+        require(remoteId.matches(Regex("[A-Za-z0-9:_-]+")))
+        val data = get(profileId, "search/remoteid/$remoteId")["data"] as? JsonArray ?: return null
+        return data.mapNotNull { element ->
+            ((element as? JsonObject)?.get("series") as? JsonObject)?.get("id")?.long()
+        }.distinct().singleOrNull()
+    }
+
+    /** All pages must succeed; never return a truncated order after a page error. */
+    suspend fun episodes(
+        profileId: Int,
+        seriesId: Long,
+        order: String,
+        language: String = "eng",
+    ): List<TvdbEpisode> {
+        require(seriesId > 0)
+        require(order.matches(Regex("[a-zA-Z0-9_-]+")))
+        require(language.matches(Regex("[a-z]{3}")))
+        val revision = credentials.revision(profileId)
+        val result = mutableListOf<TvdbEpisode>()
+        val seenIds = mutableSetOf<Long>()
+        var page = 0
+        do {
+            val response = get(profileId, "series/$seriesId/episodes/$order/$language?page=$page")
+            val rows = response.objectData()["episodes"] as? JsonArray
+                ?: throw TvdbException(TvdbException.Reason.INVALID_RESPONSE)
+            val pageEpisodes = rows.map { parseTvdbEpisode(it as? JsonObject) }
+            if (pageEpisodes.isNotEmpty() && pageEpisodes.all { it.id in seenIds }) {
+                throw TvdbException(TvdbException.Reason.INVALID_RESPONSE)
+            }
+            pageEpisodes.forEach { seenIds += it.id }
+            result += pageEpisodes
+            val next = (response["links"] as? JsonObject)?.get("next")?.string()
+            if (next == null) break
+            if (rows.isEmpty() || ++page > MAX_PAGES) throw TvdbException(TvdbException.Reason.INVALID_RESPONSE)
+        } while (true)
+        if (result.groupBy { it.id }.any { it.value.distinct().size != 1 }) {
+            throw TvdbException(TvdbException.Reason.INVALID_RESPONSE)
+        }
+        checkRevision(profileId, revision)
+        val unique = result.distinctBy { it.id }
+        if (unique.groupBy { it.season to it.number }.any { it.value.size > 1 }) {
+            throw TvdbException(TvdbException.Reason.INVALID_RESPONSE)
+        }
+        return unique
+    }
+
+    /**
+     * Season fallback for orders the flat episodes endpoint does not serve: reads the
+     * series' seasons of the requested type and concatenates their episodes.
+     */
+    suspend fun episodesFromSeasons(profileId: Int, seriesId: Long, order: String): List<TvdbEpisode> {
+        require(seriesId > 0)
+        require(order.matches(Regex("[a-zA-Z0-9_-]+")))
+        val series = get(profileId, "series/$seriesId/extended").objectData()
+        val seasons = series["seasons"] as? JsonArray
+            ?: throw TvdbException(TvdbException.Reason.INVALID_RESPONSE)
+        val result = mutableListOf<TvdbEpisode>()
+        for (element in seasons) {
+            val season = element as? JsonObject ?: continue
+            val type = season["type"] as? JsonObject ?: continue
+            if (type["type"]?.string() != order) continue
+            val id = season["id"]?.long()?.takeIf { it > 0 } ?: continue
+            val number = season["number"]?.long()
+                ?: throw TvdbException(TvdbException.Reason.INVALID_RESPONSE)
+            val details = get(profileId, "seasons/$id/extended").objectData()
+            val episodes = details["episodes"] as? JsonArray ?: continue
+            for (episode in episodes) {
+                val row = episode as? JsonObject ?: continue
+                val withSeason = JsonObject(HashMap(row) + ("seasonNumber" to JsonPrimitive(number)))
+                result += parseTvdbEpisode(withSeason)
+            }
+        }
+        if (result.groupBy { it.id }.any { it.value.size > 1 } ||
+            result.groupBy { it.season to it.number }.any { it.value.size > 1 }
+        ) {
+            throw TvdbException(TvdbException.Reason.INVALID_RESPONSE)
+        }
+        return result
+    }
+
+    private suspend fun get(profileId: Int, path: String): JsonObject = mutex.withLock {
+        repeat(2) { attempt ->
+            val token = token(profileId)
+            val (code, body) = try {
+                execute { http.get("$BASE/$path") { header("Authorization", "Bearer ${token.value}") } }
+            } catch (cancelled: CancellationException) {
+                throw cancelled
+            } catch (_: IOException) {
+                throw TvdbException(TvdbException.Reason.NETWORK)
+            }
+            checkRevision(profileId, token.revision)
+            if (code == 401 && attempt == 0) {
+                tokens.remove(profileId)
+            } else {
+                checkStatus(code)
+                return@withLock decode(body)
+            }
+        }
+        throw TvdbException(TvdbException.Reason.AUTHENTICATION)
+    }
+
+    private suspend fun token(profileId: Int): Token {
+        val revision = credentials.revision(profileId)
+        tokens[profileId]?.takeIf { it.revision == revision && it.expiresAt > nowEpochMs() }?.let { return it }
+        val key = credentials.read(profileId) ?: throw TvdbException(TvdbException.Reason.NO_KEY)
+        // PIN deliberately omitted: API-key-only authentication is supported.
+        val (code, body) = try {
+            execute {
+                http.post("$BASE/login") {
+                    contentType(ContentType.Application.Json)
+                    setBody(buildLoginBody(key))
+                }
+            }
+        } catch (cancelled: CancellationException) {
+            throw cancelled
+        } catch (_: IOException) {
+            throw TvdbException(TvdbException.Reason.NETWORK)
+        }
+        checkRevision(profileId, revision)
+        checkStatus(code)
+        val value = decode(body).objectData()["token"]?.string()
+            ?: throw TvdbException(TvdbException.Reason.INVALID_RESPONSE)
+        return Token(revision, value, nowEpochMs() + TOKEN_LIFETIME_MS).also { tokens[profileId] = it }
+    }
+
+    private suspend fun execute(block: suspend () -> HttpResponse): Pair<Int, String> {
+        val response = block()
+        val code = response.status.value
+        val body = try {
+            readBoundedResponseBody(response.bodyAsChannel(), response.contentLength())
+        } catch (cancelled: CancellationException) {
+            throw cancelled
+        } catch (_: Exception) {
+            throw TvdbException(TvdbException.Reason.INVALID_RESPONSE)
+        }
+        return code to body
+    }
+
+    private fun checkRevision(profileId: Int, revision: Long) {
+        if (credentials.revision(profileId) != revision) {
+            throw TvdbException(TvdbException.Reason.CREDENTIALS_CHANGED)
+        }
+    }
+
+    private fun decode(body: String): JsonObject = try {
+        json.parseToJsonElement(body) as? JsonObject
+            ?: throw TvdbException(TvdbException.Reason.INVALID_RESPONSE)
+    } catch (cancelled: CancellationException) {
+        throw cancelled
+    } catch (_: Exception) {
+        throw TvdbException(TvdbException.Reason.INVALID_RESPONSE)
+    }
+
+    private fun checkStatus(code: Int) {
+        if (code in 200..299) return
+        throw TvdbException(
+            when (code) {
+                401, 403 -> TvdbException.Reason.AUTHENTICATION
+                404 -> TvdbException.Reason.UNAVAILABLE
+                429 -> TvdbException.Reason.RATE_LIMIT
+                else -> TvdbException.Reason.NETWORK
+            },
+        )
+    }
+
+    private companion object {
+        const val BASE = "https://api4.thetvdb.com/v4"
+        const val MAX_PAGES = 1000
+        const val TOKEN_LIFETIME_MS = 28L * 24 * 60 * 60 * 1000
+    }
+}
+
+private fun buildLoginBody(apiKey: String): String = buildJsonObject {
+    put("apikey", apiKey)
+}.toString()
+
+internal fun parseTvdbEpisode(row: JsonObject?): TvdbEpisode {
+    if (row == null) throw TvdbException(TvdbException.Reason.INVALID_RESPONSE)
+    val id = row["id"]?.long()?.takeIf { it > 0 }
+        ?: throw TvdbException(TvdbException.Reason.INVALID_RESPONSE)
+    val season = row["seasonNumber"]?.long()?.toInt()?.takeIf { it >= 0 }
+        ?: throw TvdbException(TvdbException.Reason.INVALID_RESPONSE)
+    val number = row["number"]?.long()?.toInt()?.takeIf { it > 0 }
+        ?: throw TvdbException(TvdbException.Reason.INVALID_RESPONSE)
+    return TvdbEpisode(
+        id = id,
+        season = season,
+        number = number,
+        title = row["name"]?.string().orEmpty(),
+        overview = row["overview"]?.string(),
+        image = row["image"]?.string()?.let { image ->
+            when {
+                image.startsWith("https://") || image.startsWith("http://") -> image
+                image.startsWith("//") -> "https:$image"
+                else -> "https://artworks.thetvdb.com/${image.trimStart('/')}"
+            }
+        },
+        aired = row["aired"]?.string(),
+        runtime = row["runtime"]?.long()?.toInt(),
+    )
+}
+
+private fun JsonObject.objectData(): JsonObject =
+    this["data"] as? JsonObject ?: throw TvdbException(TvdbException.Reason.INVALID_RESPONSE)
+
+private fun JsonElement?.string(): String? =
+    (this as? JsonPrimitive)?.contentOrNull?.takeIf(String::isNotBlank)
+
+private fun JsonElement?.long(): Long? = (this as? JsonPrimitive)?.longOrNull
