+package com.nuvio.app.features.addons
+
+import androidx.compose.runtime.Composable
+
+/** File save and open for the addon backup. Null where the platform has no picker. */
+internal class DxFileTransfer(
+    val saveText: (suggestedName: String, content: String, onDone: (Boolean) -> Unit) -> Unit,
+    val openText: (onText: (String?) -> Unit) -> Unit,
+)
+
+@Composable
+internal expect fun rememberDxFileTransfer(): DxFileTransfer?
