+package com.nuvio.app.features.addons
+
+import androidx.activity.compose.rememberLauncherForActivityResult
+import androidx.activity.result.contract.ActivityResultContracts
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.ui.platform.LocalContext
+
+@Composable
+internal actual fun rememberDxFileTransfer(): DxFileTransfer? {
+    val context = LocalContext.current
+    val pendingContent = remember { mutableStateOf<String?>(null) }
+    val onSaved = remember { mutableStateOf<((Boolean) -> Unit)?>(null) }
+    val onOpened = remember { mutableStateOf<((String?) -> Unit)?>(null) }
+    val createLauncher = rememberLauncherForActivityResult(ActivityResultContracts.CreateDocument("application/json")) { uri ->
+        val content = pendingContent.value
+        val callback = onSaved.value
+        pendingContent.value = null
+        onSaved.value = null
+        val ok = uri != null && content != null && runCatching {
+            context.contentResolver.openOutputStream(uri)?.use { it.write(content.toByteArray(Charsets.UTF_8)) } != null
+        }.getOrDefault(false)
+        callback?.invoke(ok)
+    }
+    val openLauncher = rememberLauncherForActivityResult(ActivityResultContracts.OpenDocument()) { uri ->
+        val callback = onOpened.value
+        onOpened.value = null
+        val text = uri?.let {
+            runCatching { context.contentResolver.openInputStream(it)?.use { stream -> stream.readBytes().toString(Charsets.UTF_8) } }.getOrNull()
+        }
+        callback?.invoke(text)
+    }
+    return remember(createLauncher, openLauncher) {
+        DxFileTransfer(
+            saveText = { name, content, done ->
+                pendingContent.value = content
+                onSaved.value = done
+                createLauncher.launch(name)
+            },
+            openText = { done ->
+                onOpened.value = done
+                openLauncher.launch(arrayOf("application/json", "text/plain", "*/*"))
+            },
+        )
+    }
+}
