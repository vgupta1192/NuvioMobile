+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import com.nuvio.app.core.storage.AppFileCache
+import com.nuvio.app.features.details.MetaDetailsRepository
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+/** dx.bi picture enhancement choices. Auto picks [DxEnhanceKind.ANIME] for anime and [DxEnhanceKind.SHARPEN] otherwise. */
+enum class DxEnhanceMode(val id: String, val label: String) {
+    OFF("off", "Off"),
+    AUTO("auto", "Auto"),
+    ANIME("anime", "Anime"),
+    SHARPEN("sharpen", "Sharpen");
+
+    companion object {
+        fun fromId(id: String?): DxEnhanceMode = values().firstOrNull { it.id == id } ?: OFF
+    }
+}
+
+/** What the engine actually applies for a title. */
+enum class DxEnhanceKind { NONE, SHARPEN, ANIME }
+
+internal object DxEnhance {
+    private const val PATH = "settings/dx_enhance"
+    private val _mode = MutableStateFlow(DxEnhanceMode.OFF)
+    val mode: StateFlow<DxEnhanceMode> = _mode.asStateFlow()
+    private val _buttonEnabled = MutableStateFlow(true)
+    val buttonEnabled: StateFlow<Boolean> = _buttonEnabled.asStateFlow()
+    private val _anime = MutableStateFlow(false)
+    val anime: StateFlow<Boolean> = _anime.asStateFlow()
+    private val _kind = MutableStateFlow(DxEnhanceKind.NONE)
+    val kind: StateFlow<DxEnhanceKind> = _kind.asStateFlow()
+    private var loaded = false
+
+    fun ensureLoaded() {
+        if (loaded) return
+        loaded = true
+        val values = HashMap<String, String>()
+        AppFileCache.read(PATH)?.lineSequence()?.forEach { line ->
+            val at = line.indexOf('=')
+            if (at > 0) values[line.substring(0, at)] = line.substring(at + 1)
+        }
+        _mode.value = DxEnhanceMode.fromId(values["mode"])
+        _buttonEnabled.value = values["button"] != "0"
+        recompute()
+    }
+
+    private fun save() {
+        val text = "mode=${_mode.value.id}\nbutton=${if (_buttonEnabled.value) 1 else 0}"
+        runCatching { AppFileCache.write(PATH, text) }
+    }
+
+    private fun recompute() {
+        _kind.value = if (!_buttonEnabled.value) {
+            DxEnhanceKind.NONE
+        } else when (_mode.value) {
+            DxEnhanceMode.OFF -> DxEnhanceKind.NONE
+            DxEnhanceMode.ANIME -> DxEnhanceKind.ANIME
+            DxEnhanceMode.SHARPEN -> DxEnhanceKind.SHARPEN
+            DxEnhanceMode.AUTO -> if (_anime.value) DxEnhanceKind.ANIME else DxEnhanceKind.SHARPEN
+        }
+    }
+
+    fun currentKind(): DxEnhanceKind = _kind.value
+
+    fun setMode(mode: DxEnhanceMode) {
+        ensureLoaded()
+        _mode.value = mode
+        save()
+        recompute()
+    }
+
+    fun setButtonEnabled(enabled: Boolean) {
+        ensureLoaded()
+        _buttonEnabled.value = enabled
+        save()
+        recompute()
+    }
+
+    fun setAnime(anime: Boolean) {
+        _anime.value = anime
+        recompute()
+    }
+
+    /** Off, Auto, Anime, Sharpen, round and round; returns the new mode. */
+    fun cycle(): DxEnhanceMode {
+        val all = DxEnhanceMode.values()
+        val next = all[(_mode.value.ordinal + 1) % all.size]
+        setMode(next)
+        return next
+    }
+
+    /** libmpv `sharpen` value for the current kind (0 when off). */
+    fun mpvSharpen(): Double = when (_kind.value) {
+        DxEnhanceKind.NONE -> 0.0
+        DxEnhanceKind.SHARPEN -> 0.5
+        DxEnhanceKind.ANIME -> 0.8
+    }
+
+    fun describe(): String {
+        val mode = _mode.value
+        return if (mode == DxEnhanceMode.AUTO) {
+            "Picture enhancement: Auto (${if (_kind.value == DxEnhanceKind.ANIME) "Anime" else "Sharpen"})"
+        } else {
+            "Picture enhancement: ${mode.label}"
+        }
+    }
+}
+
+/**
+ * Anime check for Auto: kitsu, mal, anilist or anidb ids, an anime content type, or an Anime genre on the title's
+ * metadata (loaded if it is not cached yet).
+ */
+internal suspend fun dxLooksLikeAnime(
+    parentMetaType: String,
+    parentMetaId: String,
+    videoId: String?,
+    contentType: String?,
+): Boolean {
+    val prefixes = listOf("kitsu:", "mal:", "anilist:", "anidb:")
+    if (prefixes.any { parentMetaId.startsWith(it, ignoreCase = true) || videoId?.startsWith(it, ignoreCase = true) == true }) return true
+    if (contentType.equals("anime", ignoreCase = true) || parentMetaType.equals("anime", ignoreCase = true)) return true
+    val meta = MetaDetailsRepository.peek(parentMetaType, parentMetaId)
+        ?: runCatching { MetaDetailsRepository.fetch(parentMetaType, parentMetaId) }.getOrNull()
+    return meta?.genres.orEmpty().any { it.equals("Anime", ignoreCase = true) }
+}
+
+/** Short text hint over the picture, shared by the dx.bi player features. */
+internal object DxPlayerHint {
+    private val _hint = MutableStateFlow(0 to "")
+    val hint: StateFlow<Pair<Int, String>> = _hint.asStateFlow()
+
+    fun show(text: String) {
+        _hint.value = (_hint.value.first + 1) to text
+    }
+}
+
+@Composable
+internal fun DxPlayerHintHost() {
+    val hint by DxPlayerHint.hint.collectAsStateWithLifecycle()
+    var visible by remember { mutableStateOf(false) }
+    LaunchedEffect(hint.first) {
+        if (hint.first == 0) return@LaunchedEffect
+        visible = true
+        delay(1_800)
+        visible = false
+    }
+    Box(modifier = Modifier.fillMaxSize().padding(top = 28.dp), contentAlignment = Alignment.TopCenter) {
+        AnimatedVisibility(visible = visible) {
+            Text(
+                text = hint.second,
+                color = Color.White,
+                fontSize = 14.sp,
+                fontWeight = FontWeight.Medium,
+                modifier = Modifier
+                    .background(Color.Black.copy(alpha = 0.7f), RoundedCornerShape(18.dp))
+                    .padding(horizontal = 16.dp, vertical = 8.dp),
+            )
+        }
+    }
+}
+
+private fun dxCycleEnhance() {
+    DxEnhance.cycle()
+    DxPlayerHint.show(DxEnhance.describe())
+}
+
+/** Header layout button: cycles Off, Auto, Anime, Sharpen. Only shown where the engine can enhance the picture. */
+@Composable
+internal fun DxEnhanceHeaderButton(metrics: PlayerLayoutMetrics) {
+    LaunchedEffect(Unit) { DxEnhance.ensureLoaded() }
+    val available by SmartEnhance.available.collectAsStateWithLifecycle()
+    val enabled by DxEnhance.buttonEnabled.collectAsStateWithLifecycle()
+    val mode by DxEnhance.mode.collectAsStateWithLifecycle()
+    if (!available || !enabled) return
+    PlayerHeaderIconButton(
+        icon = Icons.Rounded.AutoFixHigh,
+        contentDescription = "Picture enhancement",
+        buttonSize = metrics.headerIconSize + 16.dp,
+        iconSize = metrics.headerIconSize,
+        onClick = ::dxCycleEnhance,
+        tint = if (mode != DxEnhanceMode.OFF) MaterialTheme.colorScheme.primary else Color.White,
+    )
+}
+
+/** Toolbar button for the legacy layout. */
+@Composable
+internal fun DxEnhanceToolbarAction() {
+    LaunchedEffect(Unit) { DxEnhance.ensureLoaded() }
+    val available by SmartEnhance.available.collectAsStateWithLifecycle()
+    val enabled by DxEnhance.buttonEnabled.collectAsStateWithLifecycle()
+    val mode by DxEnhance.mode.collectAsStateWithLifecycle()
+    if (!available || !enabled) return
+    IconButton(onClick = ::dxCycleEnhance, modifier = Modifier.size(48.dp)) {
+        Icon(
+            imageVector = Icons.Rounded.AutoFixHigh,
+            contentDescription = "Picture enhancement",
+            tint = if (mode != DxEnhanceMode.OFF) MaterialTheme.colorScheme.primary else Color.White,
+            modifier = Modifier.size(24.dp),
+        )
+    }
+}
+
+/** Chips for the picture panel. */
+@Composable
+internal fun DxEnhanceRow() {
+    LaunchedEffect(Unit) { DxEnhance.ensureLoaded() }
+    val enabled by DxEnhance.buttonEnabled.collectAsStateWithLifecycle()
+    val mode by DxEnhance.mode.collectAsStateWithLifecycle()
+    if (!enabled) return
+    Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+        Text("Enhance", color = Color.White, fontSize = 15.sp)
+        Row(
+            modifier = Modifier.fillMaxWidth().horizontalScroll(rememberScrollState()),
+            horizontalArrangement = Arrangement.spacedBy(8.dp),
+        ) {
+            DxEnhanceMode.values().forEach { option ->
+                com.nuvio.app.core.ui.Chip(label = option.label, selected = mode == option, onClick = { DxEnhance.setMode(option) })
+            }
+        }
+        Text(
+            text = "Auto uses Anime for anime and Sharpen for everything else.",
+            color = Color.White.copy(alpha = 0.55f),
+            fontSize = 12.sp,
+        )
+    }
+}
