+package com.nuvio.app.features.player
+
+import android.graphics.Bitmap
+import android.os.Handler
+import android.os.Looper
+import android.view.PixelCopy
+import android.view.SurfaceView
+import android.view.TextureView
+import android.view.View
+import androidx.media3.common.util.UnstableApi
+import androidx.media3.ui.PlayerView
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.suspendCancellableCoroutine
+import kotlinx.coroutines.withContext
+import kotlin.coroutines.resume
+import kotlin.math.max
+import kotlin.math.roundToInt
+
+/** Luma picture of a decoded or captured frame, downscaled with the bitmap's own aspect. */
+internal fun Bitmap.toLumaFrame(): LumaFrame {
+    val pixels = IntArray(width * height)
+    getPixels(pixels, 0, width, 0, 0, width, height)
+    return LumaFrame(BlackBarDetector.lumaFromArgb(pixels, width, height), width, height)
+}
+
+/**
+ * Capture what the video surface shows (SurfaceView through PixelCopy, TextureView through
+ * getBitmap). View transforms (scale, translation) are not part of the capture.
+ */
+internal suspend fun View.captureVideoLuma(
+    maxDimension: Int = BlackBarTracker.SAMPLE_MAX_DIMENSION,
+): LumaFrame? = withContext(Dispatchers.Main) {
+    if (!isAttachedToWindow || width <= 0 || height <= 0) return@withContext null
+    val scale = maxDimension.toFloat() / max(width, height)
+    val captureWidth = (width * scale).roundToInt().coerceAtLeast(8)
+    val captureHeight = (height * scale).roundToInt().coerceAtLeast(8)
+    when (val view = this@captureVideoLuma) {
+        is TextureView -> {
+            if (!view.isAvailable) return@withContext null
+            val bitmap = runCatching { view.getBitmap(captureWidth, captureHeight) }.getOrNull()
+                ?: return@withContext null
+            bitmap.toLumaFrame().also { bitmap.recycle() }
+        }
+
+        is SurfaceView -> {
+            if (view.holder.surface?.isValid != true) return@withContext null
+            val bitmap = Bitmap.createBitmap(captureWidth, captureHeight, Bitmap.Config.ARGB_8888)
+            suspendCancellableCoroutine { continuation ->
+                runCatching {
+                    PixelCopy.request(
+                        view,
+                        bitmap,
+                        { result ->
+                            val frame = if (result == PixelCopy.SUCCESS) bitmap.toLumaFrame() else null
+                            bitmap.recycle()
+                            if (continuation.isActive) continuation.resume(frame)
+                        },
+                        Handler(Looper.getMainLooper()),
+                    )
+                }.onFailure {
+                    bitmap.recycle()
+                    if (continuation.isActive) continuation.resume(null)
+                }
+            }
+        }
+
+        else -> null
+    }
+}
+
+/**
+ * Custom Stretch for ExoPlayer: the content frame already fills the player (RESIZE_MODE_FILL),
+ * so scale it once more so only the picture area covers the player. PlayerView clips its
+ * children, and the subtitle view is a sibling, so subtitles keep their place.
+ */
+@androidx.annotation.OptIn(UnstableApi::class)
+internal fun PlayerView.applyCustomStretchTransform(rect: VideoContentRect?) {
+    val frame = findViewById<View>(androidx.media3.ui.R.id.exo_content_frame) ?: return
+    val frameWidth = frame.width
+    val frameHeight = frame.height
+    if (rect == null || frameWidth <= 0 || frameHeight <= 0 || rect.width <= 0f || rect.height <= 0f) {
+        frame.scaleX = 1f
+        frame.scaleY = 1f
+        frame.translationX = 0f
+        frame.translationY = 0f
+        return
+    }
+    val scaleX = 1f / rect.width
+    val scaleY = 1f / rect.height
+    frame.pivotX = frameWidth / 2f
+    frame.pivotY = frameHeight / 2f
+    frame.scaleX = scaleX
+    frame.scaleY = scaleY
+    frame.translationX = -((rect.left + rect.right) / 2f - 0.5f) * frameWidth * scaleX
+    frame.translationY = -((rect.top + rect.bottom) / 2f - 0.5f) * frameHeight * scaleY
+}
