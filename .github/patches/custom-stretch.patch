+
+@OptIn(ExperimentalForeignApi::class)
+private fun NSData.toLumaFrame(): LumaFrame? {
+    val size = length.toInt()
+    if (size <= 4) return null
+    val raw = ByteArray(size)
+    raw.usePinned { pinned -> memcpy(pinned.addressOf(0), bytes, length) }
+    val width = (raw[0].toInt() and 0xFF) or ((raw[1].toInt() and 0xFF) shl 8)
+    val height = (raw[2].toInt() and 0xFF) or ((raw[3].toInt() and 0xFF) shl 8)
+    if (width <= 0 || height <= 0 || size < 4 + width * height) return null
+    return LumaFrame(raw.copyOfRange(4, 4 + width * height), width, height)
