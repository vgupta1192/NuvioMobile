-/**
- * Per-profile TVDB v4 API key. Values are read from the profile-scoped storage and
- * are never logged. `revision` lets callers detect credential changes mid-flight so
- * a stale token or in-progress request cannot keep using old credentials; any save
- * bumps the epoch for every profile (saves are user-driven and rare).
- */
-object TvdbCredentialStore {
-    @Volatile
-    private var revisionEpoch = 0L
-
-    /** Keys are persisted under the active profile via ProfileScopedKey. */
-    fun read(profileId: Int): String? = TvdbSettingsStorage.loadApiKey()
-
-    fun revision(profileId: Int): Long = revisionEpoch
-
-    suspend fun save(profileId: Int, apiKey: String?) {
-        val normalized = apiKey?.trim()?.takeIf(String::isNotBlank)
-        TvdbSettingsStorage.saveApiKey(normalized)
-        revisionEpoch += 1L
-    }
-
-    fun savedKey(): String? = read(ProfileRepository.activeProfileId)
-
-    fun clearAllProfiles() {
-        revisionEpoch += 1_000_000L
-    }
-}
