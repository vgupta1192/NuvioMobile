+private const val TAG = "GeneratedSubs"
+
+/** A line Groq heard, in seconds from the start of the uploaded audio. */
+internal class GroqLine(val startSec: Double, val endSec: Double, val text: String, val language: String)
+
+internal class GeneratedFailure(message: String, val permanent: Boolean, val retryAfterMs: Long = 0L) : Exception(message)
+
+/** Whisper large-v3 on Groq (the user's own API key): a WAV of one window comes back as timed lines. */
+internal class GroqWhisperClientIos(private val key: String) {
+    suspend fun recognize(wav: ByteArray, seconds: Double, translate: Boolean, language: String): List<GroqLine> {
+        var attempt = 0
+        while (true) {
+            try {
+                return request(wav, seconds, translate, language)
+            } catch (failure: GeneratedFailure) {
+                if (failure.permanent || ++attempt >= RETRIES) throw failure
+                delay(maxOf(failure.retryAfterMs, RETRY_DELAY_MS * attempt))
+            }
+        }
+    }
+
+    private suspend fun request(wav: ByteArray, seconds: Double, translate: Boolean, language: String): List<GroqLine> {
+        val boundary = "nuvio-" + epochMs().toString(16) + wav.size.toString(16)
+        val chunks = ArrayList<ByteArray>()
+        fun field(name: String, value: String) {
+            chunks += "--$boundary\r\nContent-Disposition: form-data; name=\"$name\"\r\n\r\n$value\r\n".encodeToByteArray()
+        }
+        field("model", MODEL)
+        field("response_format", "verbose_json")
+        field("temperature", "0")
+        if (!translate && language.isNotBlank()) field("language", language)
+        chunks += (
+            "--$boundary\r\nContent-Disposition: form-data; name=\"file\"; filename=\"speech.wav\"\r\n" +
+                "Content-Type: audio/wav\r\n\r\n"
+            ).encodeToByteArray()
+        chunks += wav
+        chunks += "\r\n--$boundary--\r\n".encodeToByteArray()
+        val body = ByteArray(chunks.sumOf { it.size })
+        var at = 0
+        for (chunk in chunks) {
+            chunk.copyInto(body, at)
+            at += chunk.size
+        }
+        val response = try {
+            httpRequestRaw(
+                method = "POST",
+                url = if (translate) TRANSLATIONS else TRANSCRIPTIONS,
+                headers = mapOf(
+                    "Authorization" to "Bearer $key",
+                    "Content-Type" to "multipart/form-data; boundary=$boundary",
+                ),
+                body = "",
+                followRedirects = true,
+                maxResponseBodyBytes = 8_000_000,
+                bodyBytes = body,
+            )
+        } catch (cancelled: CancellationException) {
+            throw cancelled
+        } catch (error: Exception) {
+            throw GeneratedFailure("Groq unreachable: ${error.message}", permanent = false)
+        }
+        GeneratedUsage.recordGroq(
+            epochMs(),
+            seconds,
+            response.headers["x-ratelimit-remaining-requests"]?.toIntOrNull(),
+            response.headers["x-ratelimit-limit-requests"]?.toIntOrNull(),
+            success = response.status == 200,
+        )
+        when (response.status) {
+            200 -> Unit
+            401, 403 -> throw GeneratedFailure("Groq key rejected", permanent = true)
+            413 -> throw GeneratedFailure("Groq refused the audio size", permanent = false)
+            429 -> {
+                val wait = response.headers["retry-after"]?.toDoubleOrNull()?.let { (it * 1_000).toLong() } ?: 20_000L
+                throw GeneratedFailure("Groq rate limit reached", permanent = false, retryAfterMs = wait.coerceAtMost(120_000L))
+            }
+            else -> throw GeneratedFailure("Groq HTTP ${response.status}", permanent = response.status in 400..499)
+        }
+        return try {
+            val json = Json.parseToJsonElement(response.body).jsonObject
+            val language = json["language"]?.jsonPrimitive?.contentOrNull.orEmpty().lowercase()
+            val segments = json["segments"] as? JsonArray ?: return emptyList()
+            segments.map { it.jsonObject }
+                .filter { (it["no_speech_prob"]?.jsonPrimitive?.doubleOrNull ?: 0.0) < NO_SPEECH_LIMIT }
+                .map {
+                    GroqLine(
+                        startSec = it["start"]?.jsonPrimitive?.doubleOrNull ?: 0.0,
+                        endSec = it["end"]?.jsonPrimitive?.doubleOrNull ?: 0.0,
+                        text = it["text"]?.jsonPrimitive?.contentOrNull.orEmpty().trim(),
+                        language = language,
+                    )
+                }
+                .filter { it.text.isNotEmpty() }
+        } catch (error: Exception) {
+            throw GeneratedFailure("Groq answered something unexpected", permanent = false)
+        }
+    }
+
+    private companion object {
+        const val MODEL = "whisper-large-v3"
+        const val TRANSLATIONS = "https://api.groq.com/openai/v1/audio/translations"
+        const val TRANSCRIPTIONS = "https://api.groq.com/openai/v1/audio/transcriptions"
+        const val RETRIES = 3
+        const val RETRY_DELAY_MS = 3_000L
+        const val NO_SPEECH_LIMIT = 0.6
+    }
+}
+
+/** Translates lines to English with DeepL (the user's own API key), a window of lines at a time. */
+internal class DeepLTranslatorIos(private val key: String) {
+    private val endpoint = if (key.endsWith(":fx")) "https://api-free.deepl.com/v2/translate" else "https://api.deepl.com/v2/translate"
+
+    suspend fun translate(lines: List<String>, source: String?, context: String?): List<String> {
+        var attempt = 0
+        while (true) {
+            try {
+                return request(lines, source, context)
+            } catch (failure: GeneratedFailure) {
+                if (failure.permanent || ++attempt >= 3) throw failure
+                delay(2_000L * attempt)
+            }
+        }
+    }
+
+    private suspend fun request(lines: List<String>, source: String?, context: String?): List<String> {
+        val payload = buildJsonObject {
+            put("text", buildJsonArray { lines.forEach { add(JsonPrimitive(it)) } })
+            put("target_lang", JsonPrimitive("EN-US"))
+            if (source != null) put("source_lang", JsonPrimitive(source))
+            if (!context.isNullOrBlank()) put("context", JsonPrimitive(context))
+            put("preserve_formatting", JsonPrimitive(true))
+        }
+        val response = try {
+            httpRequestRaw(
+                method = "POST",
+                url = endpoint,
+                headers = mapOf("Authorization" to "DeepL-Auth-Key $key", "Content-Type" to "application/json"),
+                body = payload.toString(),
+            )
+        } catch (cancelled: CancellationException) {
+            throw cancelled
+        } catch (error: Exception) {
+            throw GeneratedFailure("DeepL unreachable: ${error.message}", permanent = false)
+        }
+        when (val code = response.status) {
+            200 -> Unit
+            403 -> throw GeneratedFailure("DeepL key rejected", permanent = true)
+            456 -> throw GeneratedFailure("DeepL monthly character limit reached", permanent = true)
+            400 -> throw GeneratedFailure("DeepL refused the request (language?)", permanent = true)
+            else -> throw GeneratedFailure("DeepL HTTP $code", permanent = false)
+        }
+        val translations = try {
+            Json.parseToJsonElement(response.body).jsonObject["translations"]!!.jsonArray
+        } catch (error: Exception) {
+            throw GeneratedFailure("DeepL answered something unexpected", permanent = false)
+        }
+        if (translations.size != lines.size) {
+            throw GeneratedFailure("DeepL answered ${translations.size} of ${lines.size} lines", permanent = false)
+        }
+        return translations.map { (it as JsonObject)["text"]?.jsonPrimitive?.contentOrNull.orEmpty().trim() }
+    }
+
+    companion object {
+        fun sourceCode(language: String?): String? = when (val code = language?.lowercase()) {
+            null, "", "auto" -> null
+            "yue", "cmn" -> "ZH"
+            "fil" -> "TL"
+            "iw" -> "HE"
+            "in" -> "ID"
+            else -> code.substringBefore('-').uppercase()
+        }
+    }
+}
+
+private class Cue(val startMs: Long, var endMs: Long, val text: String)
+
+/**
+ * Generates English subtitles ahead of the playhead on iOS: a headless libmpv reads a window of the
+ * stream's audio as WAV, Groq Whisper large-v3 hears it (translating to English itself, or writing it
+ * down for DeepL), and the lines are loaded into libmpv as a subtitle file that is replaced as new
+ * lines arrive. Only the online variant exists on iOS.
+ */
+internal class GeneratedSubtitleSessionIos(
+    private val scope: CoroutineScope,
+    private val generatedUrl: String,
+    private val sourceUrl: String,
+    private val headersJson: String?,
+    private val positionMs: () -> Long,
+    private val durationMs: () -> Long,
+    private val replaceExternalSubtitle: (replacedUrl: String, path: String) -> Unit,
+) {
+    private var job: Job? = null
+    private val cues = ArrayList<Cue>()
+    private val covered = ArrayList<LongArray>()
+    private var lastRef = generatedUrl
+    private var statusText: String? = null
+    private var lastBubbleText: String? = null
+    private var deeplContext = ""
+    private var deeplOff = false
+
+    fun start() {
+        stop()
+        job = scope.launch { run() }
+    }
+
+    fun stop() {
+        job?.cancel()
+        job = null
+    }
+
+    private fun bubble(kind: AutoSyncBubbleKind, text: String) {
+        if (text == lastBubbleText && kind == AutoSyncBubbleKind.Working) return
+        lastBubbleText = text
+        runCatching { AutoSyncBubbleToasts.post(kind, "Generated subtitles • $text") }
+    }
+
+    private fun status(text: String, failed: Boolean = false) {
+        statusText = text
+        bubble(if (failed) AutoSyncBubbleKind.Failure else AutoSyncBubbleKind.Working, text)
+    }
+
+    private suspend fun run() {
+        val groqKey = GeneratedSubtitles.groqKey.value.trim()
+        if (groqKey.isEmpty() || generatedUrl != GeneratedSubtitles.ONLINE_URL) {
+            status("Add a Groq key in Settings to generate subtitles", failed = true)
+            commit(positionMs())
+            return
+        }
+        val extractor = NuvioPcmExtractorRegistry.extractor
+        if (extractor == null) {
+            status("Couldn't read this stream's audio for generated subtitles", failed = true)
+            commit(positionMs())
+            return
+        }
+        val groq = GroqWhisperClientIos(groqKey)
+        val deepl = GeneratedSubtitles.deeplKey.value.trim().takeIf { it.isNotEmpty() }?.let(::DeepLTranslatorIos)
+        val hint = GeneratedSubtitles.spokenLanguage.value.takeUnless { it == GeneratedSubtitles.AUTO }.orEmpty()
+        Logger.i(TAG) { "started, language=${hint.ifEmpty { "auto" }} translation=${if (deepl != null) "DeepL" else "Groq"}" }
+        bubble(AutoSyncBubbleKind.Working, "Starting subtitles · online (Groq Whisper large-v3)")
+        status("Generating subtitles from the audio…")
+        commit(positionMs())
+        var failures = 0
+        try {
+            while (scope.isActive) {
+                val position = positionMs()
+                val duration = durationMs()
+                val from = nextUncovered(position)
+                if (from >= position + LOOKAHEAD_MS || (duration > 0 && from >= duration)) {
+                    if (duration > 0 && isFullyCovered(duration) && statusText != null) {
+                        statusText = null
+                        commit(position)
+                        bubble(AutoSyncBubbleKind.Success, "Subtitles ready • ${cues.size} lines")
+                    }
+                    delay(500L)
+                    continue
+                }
+                val window = if (from - position < FIRST_WINDOW_MS) FIRST_WINDOW_MS else WINDOW_MS
+                val to = if (duration > 0) minOf(from + window, duration) else from + window
+                val wav = withContext(Dispatchers.Default) { extractor.extractWav(sourceUrl, headersJson, from, to - from) }
+                currentCoroutineContext().ensureActive()
+                if (wav == null) {
+                    if (++failures >= MAX_FAILURES) {
+                        status("Couldn't read this stream's audio for generated subtitles", failed = true)
+                        commit(positionMs())
+                        return
+                    }
+                    delay(2_000L)
+                    continue
+                }
+                val bytes = wav.toByteArray()
+                val seconds = (to - from) / 1_000.0
+                val added = try {
+                    generate(groq, deepl.takeUnless { deeplOff }, bytes, seconds, hint, from)
+                } catch (failure: GeneratedFailure) {
+                    if (failure.permanent) {
+                        status("${failure.message}: check the Groq key in Settings", failed = true)
+                        commit(positionMs())
+                        return
+                    }
+                    status("${failure.message}, retrying…")
+                    delay(maxOf(failure.retryAfterMs, 5_000L))
+                    continue
+                }
+                failures = 0
+                addCovered(from, to)
+                Logger.i(TAG) { "${from / 1_000}-${to / 1_000}s -> $added lines" }
+                if (added > 0 || statusText != null) {
+                    if (cues.isNotEmpty()) statusText = null
+                    commit(positionMs())
+                }
+                if (duration > 0 && isFullyCovered(duration)) {
+                    bubble(AutoSyncBubbleKind.Success, "Subtitles ready • ${cues.size} lines")
+                } else {
+                    bubble(AutoSyncBubbleKind.Working, "Generating subtitles · read ${clock(from)} to ${clock(to)} · ${cues.size} lines")
+                }
+            }
+        } catch (cancelled: CancellationException) {
+            throw cancelled
+        } catch (error: Throwable) {
+            Logger.w(TAG, error) { "generation stopped" }
+            status("Generated subtitles stopped: ${error.message ?: "unknown error"}", failed = true)
+            commit(positionMs())
+        }
+    }
+
+    private suspend fun generate(
+        groq: GroqWhisperClientIos,
+        deepl: DeepLTranslatorIos?,
+        wav: ByteArray,
+        seconds: Double,
+        hint: String,
+        windowStartMs: Long,
+    ): Int {
+        var heard = groq.recognize(wav, seconds, translate = deepl == null, language = hint)
+        var english: List<String>? = null
+        if (deepl != null) {
+            val texts = heard.map { cleanText(it.text) ?: "" }
+            try {
+                english = deepl.translate(texts, DeepLTranslatorIos.sourceCode(whisperCode(heard.firstOrNull()?.language.orEmpty()).ifEmpty { hint }), deeplContext)
+                deeplContext = texts.filter { it.isNotEmpty() }.takeLast(DEEPL_CONTEXT_LINES).joinToString("\n")
+            } catch (failure: GeneratedFailure) {
+                if (failure.permanent) {
+                    deeplOff = true
+                    status("${failure.message}: Groq translates instead")
+                }
+                heard = groq.recognize(wav, seconds, translate = true, language = hint)
+            }
+        }
+        var added = 0
+        heard.forEachIndexed { index, line ->
+            val text = (english?.getOrNull(index) ?: line.text).let(::cleanText) ?: return@forEachIndexed
+            if (isWhisperFiller(text) || !looksEnglish(text)) return@forEachIndexed
+            val startMs = windowStartMs + (line.startSec * 1_000).toLong()
+            val endMs = maxOf(windowStartMs + (line.endSec * 1_000).toLong(), startMs + MIN_CUE_MS)
+            addLine(startMs, endMs, text)
+            added++
+        }
+        return added
+    }
+
+    private fun addLine(startMs: Long, endMs: Long, text: String) {
+        val pieces = splitForScreen(text)
+        val totalChars = pieces.sumOf { it.length }.coerceAtLeast(1)
+        val span = (endMs - startMs).coerceAtLeast(MIN_CUE_MS)
+        var at = startMs
+        val added = pieces.mapIndexed { index, piece ->
+            val length = (span * piece.length / totalChars).coerceAtLeast(MIN_CUE_MS / pieces.size)
+            Cue(at, at + length + if (index == pieces.lastIndex) LINGER_MS else 0L, piece).also { at += length }
+        }
+        cues.removeAll { existing -> added.any { it.startMs == existing.startMs } }
+        cues += added
+        cues.sortBy { it.startMs }
+        for (index in 0 until cues.size - 1) {
+            val next = cues[index + 1].startMs
+            if (cues[index].endMs > next && next > cues[index].startMs) cues[index].endMs = next
+        }
+    }
+
+    /** Writes the lines (plus a status line at the playhead while nothing covers it) and swaps the track. */
+    private fun commit(positionMs: Long) {
+        val list = ArrayList<Cue>(cues)
+        val status = statusText
+        if (status != null && list.none { it.startMs - 1_500L < positionMs && it.endMs > positionMs }) {
+            list += Cue((positionMs - 200L).coerceAtLeast(0L), positionMs + STATUS_SHOW_MS, status)
+            list.sortBy { it.startMs }
+        }
+        if (list.isEmpty()) list += Cue(0L, 100L, "…")
+        val srt = buildString {
+            list.forEachIndexed { index, cue ->
+                append(index + 1).append('\n')
+                append(srtTimestamp(cue.startMs)).append(" --> ").append(srtTimestamp(maxOf(cue.endMs, cue.startMs + 1L))).append('\n')
+                append(cue.text).append("\n\n")
+            }
+        }
+        val path = writeSubtitleFile(prefix = "generated_", text = srt, extension = "srt") ?: return
+        if (path == lastRef) return
+        replaceExternalSubtitle(lastRef, path)
+        lastRef = path
+    }
+
+    private fun nextUncovered(positionMs: Long): Long {
+        var at = (positionMs - 2_000L).coerceAtLeast(0L)
+        var moved = true
+        while (moved) {
+            moved = false
+            for (range in covered) {
+                if (at >= range[0] && at < range[1]) {
+                    at = range[1]
+                    moved = true
+                }
+            }
+        }
+        return at
+    }
+
+    private fun addCovered(fromMs: Long, toMs: Long) {
+        covered += longArrayOf(fromMs, toMs)
+        covered.sortBy { it[0] }
+        val merged = ArrayList<LongArray>()
+        for (range in covered) {
+            val last = merged.lastOrNull()
+            if (last != null && range[0] <= last[1]) last[1] = maxOf(last[1], range[1]) else merged += range.copyOf()
+        }
+        covered.clear()
+        covered += merged
+    }
+
+    private fun isFullyCovered(durationMs: Long): Boolean = nextUncovered(0L + 2_000L) >= durationMs
+
+    private fun clock(ms: Long): String {
+        val total = ms / 1_000L
+        val h = total / 3_600L
+        val m = (total % 3_600L) / 60L
+        val s = total % 60L
+        return if (h > 0) "$h:${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}" else "$m:${s.toString().padStart(2, '0')}"
+    }
+
+    private companion object {
+        const val LOOKAHEAD_MS = 120_000L
+        const val FIRST_WINDOW_MS = 20_000L
+        const val WINDOW_MS = 60_000L
+        const val MAX_FAILURES = 4
+        const val MIN_CUE_MS = 1_200L
+        const val LINGER_MS = 400L
+        const val MAX_LINE_CHARS = 42
+        const val STATUS_SHOW_MS = 2_500L
+        const val DEEPL_CONTEXT_LINES = 4
+
+        val WHISPER_FILLERS = setOf(
+            "thank you", "thanks", "thank you very much", "thanks for watching", "thank you for watching",
+            "you", "bye", "okay", "ok", "please subscribe", "subscribe", "music", "applause", "laughter",
+            "subtitles by the amara.org community", "so", "oh", "hmm", "uh", "um",
+            "ご視聴ありがとうございました", "ありがとうございました", "字幕", "谢谢观看", "謝謝觀看",
+            "感谢观看", "시청해주셔서 감사합니다", "구독과 좋아요", "धन्यवाद", "शुक्रिया",
+        )
+
+        fun isWhisperFiller(text: String): Boolean {
+            val plain = text.lowercase().filter { it.isLetterOrDigit() || it == ' ' }.trim()
+                .split(' ').filter { it.isNotEmpty() }.joinToString(" ")
+            val trimmed = text.trim()
+            return plain.isEmpty() || plain in WHISPER_FILLERS ||
+                (trimmed.startsWith("[") && trimmed.endsWith("]")) ||
+                (trimmed.startsWith("(") && trimmed.endsWith(")")) ||
+                text.contains('♪')
+        }
+
+        fun whisperCode(name: String): String = when (name.lowercase()) {
+            "japanese" -> "ja"; "chinese" -> "zh"; "cantonese" -> "yue"; "korean" -> "ko"; "hindi" -> "hi"
+            "urdu" -> "ur"; "bengali" -> "bn"; "tamil" -> "ta"; "telugu" -> "te"; "malayalam" -> "ml"
+            "kannada" -> "kn"; "marathi" -> "mr"; "gujarati" -> "gu"; "punjabi" -> "pa"; "thai" -> "th"
+            "indonesian" -> "id"; "malay" -> "ms"; "tagalog" -> "tl"; "vietnamese" -> "vi"; "turkish" -> "tr"
+            "arabic" -> "ar"; "persian" -> "fa"; "russian" -> "ru"; "ukrainian" -> "uk"; "polish" -> "pl"
+            "spanish" -> "es"; "portuguese" -> "pt"; "french" -> "fr"; "german" -> "de"; "italian" -> "it"
+            "dutch" -> "nl"; "swedish" -> "sv"; "greek" -> "el"; "hebrew" -> "he"; "english" -> "en"
+            else -> name.takeIf { it.length in 2..3 }.orEmpty()
+        }
+
+        fun looksEnglish(text: String): Boolean {
+            var letters = 0
+            var latin = 0
+            for (char in text) {
+                if (!char.isLetter()) continue
+                letters++
+                if (char.code < 0x250) latin++
+            }
+            return letters > 0 && latin * 10 >= letters * 8
+        }
+
+        fun cleanText(text: String): String? {
+            val trimmed = text.replace(Regex("<\\|[^|]*\\|>"), "").replace(Regex("<[A-Za-z_-]{1,12}>"), "").trim()
+            return trimmed.takeIf { value -> value.any { it.isLetterOrDigit() } }
+        }
+
+        fun splitForScreen(text: String): List<String> {
+            val words = text.split(Regex("\\s+")).filter { it.isNotEmpty() }
+            if (words.isEmpty()) return listOf(text)
+            val lines = ArrayList<String>()
+            val line = StringBuilder()
+            for (word in words) {
+                if (line.isNotEmpty() && line.length + 1 + word.length > MAX_LINE_CHARS) {
+                    lines += line.toString()
+                    line.setLength(0)
+                }
+                if (line.isNotEmpty()) line.append(' ')
+                line.append(word)
+            }
+            if (line.isNotEmpty()) lines += line.toString()
+            return lines.chunked(2) { it.joinToString("\n") }
+        }
+    }
+}
+
+@OptIn(ExperimentalForeignApi::class, BetaInteropApi::class)
+private fun NSData.toByteArray(): ByteArray {
+    val size = length.toInt()
+    if (size == 0) return ByteArray(0)
+    return bytes!!.readBytes(size)
+}
