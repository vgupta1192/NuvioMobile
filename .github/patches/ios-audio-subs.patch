+// MARK: - Headless audio extractor (generated subtitles)
+
+/// Decodes a stretch of a stream's audio with a second libmpv that has no video output and writes
+/// 16 kHz mono signed 16-bit PCM (as a WAV file) through the `pcm` audio output, faster than real time.
+final class MPVPcmExtractor: NSObject, NuvioPcmExtractor {
+    private let timeoutSeconds: TimeInterval = 150
+
+    func extractWav(url: String, headersJson: String?, startMs: Int64, durationMs: Int64) -> Data? {
+        guard durationMs > 0, let ctx = mpv_create() else { return nil }
+        let path = NSTemporaryDirectory() + "pcm_\(UUID().uuidString).wav"
+        defer { try? FileManager.default.removeItem(atPath: path) }
+
+        func option(_ name: String, _ value: String) { _ = mpv_set_option_string(ctx, name, value) }
+        option("config", "no")
+        option("load-scripts", "no")
+        option("ytdl", "no")
+        option("vo", "null")
+        option("vid", "no")
+        option("sid", "no")
+        option("ao", "pcm")
+        option("ao-pcm-file", path)
+        option("ao-pcm-waveheader", "yes")
+        option("audio-format", "s16")
+        option("audio-samplerate", "16000")
+        option("audio-channels", "mono")
+        option("network-timeout", "20")
+        option("cache", "no")
+        option("start", String(format: "%.3f", Double(startMs) / 1000.0))
+        option("length", String(format: "%.3f", Double(durationMs) / 1000.0))
+        if let headers = Self.serializedHeaders(headersJson) { option("http-header-fields", headers) }
+        guard mpv_initialize(ctx) >= 0 else {
+            mpv_terminate_destroy(ctx)
+            return nil
+        }
+
+        var cargs: [UnsafePointer<CChar>?] = ["loadfile", url, "replace", nil as String?]
+            .map { $0.flatMap { UnsafePointer<CChar>(strdup($0)) } }
+        let started = mpv_command(ctx, &cargs) >= 0
+        for ptr in cargs where ptr != nil { free(UnsafeMutablePointer(mutating: ptr!)) }
+        if started {
+            let deadline = Date().addingTimeInterval(timeoutSeconds)
+            waiting: while Date() < deadline {
+                guard let event = mpv_wait_event(ctx, 1.0) else { continue }
+                switch event.pointee.event_id {
+                case MPV_EVENT_END_FILE, MPV_EVENT_SHUTDOWN:
+                    break waiting
+                default:
+                    break
+                }
+            }
+        }
+        mpv_terminate_destroy(ctx)
+
+        guard let data = FileManager.default.contents(atPath: path), data.count > 44 else { return nil }
+        return data
+    }
+
+    private static func serializedHeaders(_ headersJson: String?) -> String? {
+        guard
+            let headersJson,
+            let data = headersJson.data(using: .utf8),
+            let raw = try? JSONSerialization.jsonObject(with: data) as? [String: Any]
+        else { return nil }
+        let pairs = raw.compactMap { key, value -> String? in
+            guard let text = value as? String else { return nil }
+            let name = key.trimmingCharacters(in: .whitespacesAndNewlines)
+            let content = text.trimmingCharacters(in: .whitespacesAndNewlines)
+            guard !name.isEmpty, !content.isEmpty, name.caseInsensitiveCompare("Range") != .orderedSame else { return nil }
+            let escaped = content.replacingOccurrences(of: "\\", with: "\\\\").replacingOccurrences(of: ",", with: "\\,")
+            return "\(name): \(escaped)"
+        }
+        return pairs.isEmpty ? nil : pairs.sorted().joined(separator: ",")
     }
 }
